/**
 * App 升级：
 * - 当前工程为 uni-app x VDOM：不支持 wgt 热更新，走 APK 整包（uni.installApk）
 * - 若以后切蒸汽模式(Vapor)：服务端 pkg_type=wgt 时走 uni.installWgt
 *
 * 接口：GET /api/v1/upgrade/version?platform=android|ios
 */
import { API_HOST } from './config.uts'
import { t } from './i18n.uts'

export type AppRemoteVersion = {
	has_update: boolean
	platform: string
	version_name: string
	version_code: number
	force: boolean
	title: string
	content: string
	pkg_type: string
	url: string
}

function pickStr(obj: UTSJSONObject | null, key: string): string {
	if (obj == null) return ''
	try {
		const v = obj[key]
		if (v != null) {
			const s = ('' + v).trim()
			if (s.length > 0 && s != 'null' && s != 'undefined') return s
		}
	} catch (e) {}
	return ''
}

function pickNum(obj: UTSJSONObject | null, key: string): number {
	if (obj == null) return 0
	try {
		const v = obj[key]
		if (v != null) {
			const n = parseFloat('' + v)
			if (n == n) return n
		}
	} catch (e) {}
	return 0
}

function pickBool(obj: UTSJSONObject | null, key: string): boolean {
	if (obj == null) return false
	try {
		const v = obj[key]
		if (v == true) return true
		const s = ('' + v).toLowerCase()
		return s == '1' || s == 'true' || s == 'yes'
	} catch (e) {}
	return false
}

/** 当前安装版本号（versionCode） */
export function localAppVersionCode(): number {
	// #ifdef APP
	try {
		const info = uni.getAppBaseInfo()
		const raw = '' + (info.appVersionCode != null ? info.appVersionCode : '0')
		const n = parseInt(raw)
		if (n == n && n > 0) return n
	} catch (e) {}
	// #endif
	return 0
}

export function localAppVersionName(): string {
	// #ifdef APP
	try {
		const info = uni.getAppBaseInfo()
		const n = info.appVersion
		if (n != null && ('' + n).length > 0) return '' + n
		const w = info.appWgtVersion
		if (w != null && ('' + w).length > 0) return '' + w
	} catch (e) {}
	// #endif
	return ''
}

function currentPlatform(): string {
	// #ifdef APP-IOS
	return 'ios'
	// #endif
	return 'android'
}

export async function fetchRemoteAppVersion(): Promise<AppRemoteVersion> {
	const platform = currentPlatform()
	const url = API_HOST + '/api/v1/upgrade/version?platform=' + encodeURIComponent(platform)
	const root = await new Promise<UTSJSONObject>((resolve, reject) => {
		uni.request({
			url: url,
			method: 'GET',
			timeout: 15000,
			success: (res) => {
				const code = res.statusCode
				if (code < 200 || code >= 300) {
					reject(new Error('HTTP_' + code))
					return
				}
				const data = res.data as UTSJSONObject
				if (data == null) {
					reject(new Error('empty'))
					return
				}
				resolve(data)
			},
			fail: (err) => {
				reject(new Error(err.errMsg))
			}
		})
	})
	const biz = pickNum(root, 'code')
	if (biz != 1 && biz != 0) {
		throw new Error(pickStr(root, 'msg').length > 0 ? pickStr(root, 'msg') : 'version api fail')
	}
	let data = root['data'] as UTSJSONObject | null
	if (data == null) data = root
	const out: AppRemoteVersion = {
		has_update: pickBool(data, 'has_update'),
		platform: pickStr(data, 'platform'),
		version_name: pickStr(data, 'version_name'),
		version_code: pickNum(data, 'version_code') as number,
		force: pickBool(data, 'force'),
		title: pickStr(data, 'title'),
		content: pickStr(data, 'content'),
		pkg_type: pickStr(data, 'pkg_type'),
		url: pickStr(data, 'url')
	}
	if (out.platform.length == 0) out.platform = platform
	if (out.pkg_type.length == 0) out.pkg_type = 'apk'
	if (out.title.length == 0) out.title = t('update.title')
	return out
}

export function needUpdate(remote: AppRemoteVersion): boolean {
	if (!remote.has_update) return false
	const local = localAppVersionCode()
	if (local <= 0) return remote.version_code > 0 && remote.url.length > 0
	return remote.version_code > local
}

function installLocalPackage(filePath: string, pkgType: string): Promise<void> {
	return new Promise((resolve, reject) => {
		// #ifdef APP-ANDROID
		const kind = pkgType.toLowerCase()
		// 当前工程为 VDOM：uni.installWgt 不可用，统一按 APK 安装
		if (kind == 'wgt') {
			reject(new Error(t('update.wgtUnsupported')))
			return
		}
		uni.installApk({
			filePath: filePath,
			success: (_ok) => {
				resolve()
			},
			fail: (err) => {
				reject(new Error(err.errMsg != null ? '' + err.errMsg : t('update.installFail')))
			}
		})
		return
		// #endif
		reject(new Error(t('update.platformUnsupported')))
	})
}

export async function downloadAndInstall(remote: AppRemoteVersion, onProgress: ((p: number) => void) | null = null): Promise<void> {
	const pkg = remote.pkg_type.toLowerCase()
	if (pkg == 'store') {
		if (remote.url.length == 0) throw new Error(t('update.noUrl'))
		try {
			uni.setClipboardData({ data: remote.url })
		} catch (e) {}
		uni.showToast({ title: t('update.openStore'), icon: 'none' })
		return
	}
	if (remote.url.length == 0) throw new Error(t('update.noUrl'))
	// #ifndef APP-ANDROID
	throw new Error(t('update.platformUnsupported'))
	// #endif
	// #ifdef APP-ANDROID
	const filePath = await new Promise<string>((resolve, reject) => {
		const task = uni.downloadFile({
			url: remote.url,
			timeout: 600000,
			success: (res) => {
				if (res.statusCode == 200 && res.tempFilePath.length > 0) {
					resolve(res.tempFilePath)
				} else {
					reject(new Error(t('update.downloadFail') + ' HTTP_' + res.statusCode))
				}
			},
			fail: (err) => {
				reject(new Error(err.errMsg != null ? '' + err.errMsg : t('update.downloadFail')))
			}
		})
		if (onProgress != null && task != null) {
			try {
				task.onProgressUpdate((r) => {
					onProgress!(r.progress)
				})
			} catch (eProg) {}
		}
	})
	await installLocalPackage(filePath, remote.pkg_type)
	// #endif
}

/**
 * 检查并弹窗引导更新。
 * silent=true：无更新时不 toast（启动静默检查）
 */
export async function checkAppUpdate(silent: boolean = true): Promise<boolean> {
	// #ifndef APP
	if (!silent) uni.showToast({ title: t('update.h5Skip'), icon: 'none' })
	return false
	// #endif
	// #ifdef APP
	try {
		const remote = await fetchRemoteAppVersion()
		if (!needUpdate(remote)) {
			if (!silent) uni.showToast({ title: t('update.latest'), icon: 'none' })
			return false
		}
		const title = remote.title.length > 0 ? remote.title : t('update.title')
		let body = remote.content
		if (body.length == 0) {
			body = t('update.contentTpl')
			const i = body.indexOf('{v}')
			if (i >= 0) body = body.substring(0, i) + remote.version_name + body.substring(i + 3)
		} else if (remote.version_name.length > 0) {
			body = body + '\n\nv' + remote.version_name
		}
		const force = remote.force
		const go = await new Promise<boolean>((resolve) => {
			uni.showModal({
				title: title,
				content: body,
				showCancel: !force,
				confirmText: t('update.now'),
				cancelText: t('update.later'),
				success: (res) => {
					resolve(res.confirm == true)
				},
				fail: () => {
					resolve(false)
				}
			})
		})
		if (!go) return false
		uni.showLoading({ title: t('update.downloading'), mask: true })
		try {
			await downloadAndInstall(remote, (p) => {
				if (p > 0 && p < 100) {
					uni.showLoading({ title: t('update.downloading') + ' ' + p + '%', mask: true })
				}
			})
			uni.hideLoading()
			uni.showToast({ title: t('update.installing'), icon: 'none' })
			return true
		} catch (eDl) {
			uni.hideLoading()
			uni.showToast({ title: '' + eDl, icon: 'none', duration: 2800 })
			return false
		}
	} catch (e) {
		console.warn('[update] check fail', e)
		if (!silent) uni.showToast({ title: t('update.checkFail'), icon: 'none' })
		return false
	}
	// #endif
}
