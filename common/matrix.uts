/**
 * Matrix 客户端核心模块
 * 封装 Matrix Client-Server API v3
 * 文档：https://spec.matrix.org/latest/client-server-api/
 */

import { loadSyncSince, saveSyncSince, SessionInfo } from './storage.uts'

export type UtsErr = {
	message: string
	errcode: string
}

export function errText(e: any | null, fallback: string): string {
	if (e == null) return fallback
	let s = ''
	try {
		s = '' + e
	} catch (x) {
		s = ''
	}
	if (s.indexOf('Error: ') == 0) s = s.substring(7)
	if (s.indexOf('Error:') == 0) s = s.substring(6).trim()
	if (s.indexOf('M_LIMIT_EXCEEDED') >= 0) return '请求太频繁，请稍后再试'
	if (s.length == 0) return fallback
	return s
}

export function errCode(e: any | null): string {
	const s = errText(e, '')
	if (s.length == 0) return ''
	if (s.indexOf('[') != 0) return ''
	const end = s.indexOf(']')
	if (end <= 1) return ''
	return s.substring(1, end)
}

