	async uploadKeys(authData: UTSJSONObject): Promise<UTSJSONObject> {
		return await this.request('POST', '/_matrix/client/v3/keys/upload', authData)
	}

	async queryKeys(userIds: Array<string>): Promise<UTSJSONObject> {
		const deviceKeys: UTSJSONObject = {}
		for (let i = 0; i < userIds.length; i++) {
			const empty: Array<string> = []
			deviceKeys[userIds[i]] = empty
		}
		const body: UTSJSONObject = {}
		body['device_keys'] = deviceKeys
		return await this.request('POST', '/_matrix/client/v3/keys/query', body)
	}

	async sendToDevice(eventType: string, content: UTSJSONObject): Promise<void> {
		await this.request(
			'PUT',
			`/_matrix/client/v3/sendToDevice/${encodeURIComponent(eventType)}/${Date.now().toString()}`,
			content
		)
	}

	async sendToDeviceUser(userId: string, eventType: string, eventContent: UTSJSONObject): Promise<void> {
		if (userId.length == 0) return
		const devices: UTSJSONObject = {}
		devices['*'] = eventContent
		const messages: UTSJSONObject = {}
		messages[userId] = devices
		const body: UTSJSONObject = {}
		body['messages'] = messages
		await this.sendToDevice(eventType, body)
	}

	// ============================================================
	// 已读 / 未读便捷方法
	// ============================================================

	/**
	 * 发送公共已读回执（m.read），告诉房间所有人"我读到了"
	 * 用于列表页（联系人/消息列表）显示"已读"
	 */
	async sendPublicReadReceipt(roomId: string, eventId: string): Promise<void> {
		await this.request(
			'POST',
			`/_matrix/client/v3/rooms/${encodeURIComponent(roomId)}/receipt/m.read/${encodeURIComponent(eventId)}`,
			null
		)
	}

	/**
	 * 发送私有已读回执（m.read.private），仅服务器看，不广播
	 * 用于跨设备同步未读数（"在另一个设备读了"）
	 */
	async sendPrivateReadReceipt(roomId: string, eventId: string): Promise<void> {
		await this.request(
			'POST',
			`/_matrix/client/v3/rooms/${encodeURIComponent(roomId)}/receipt/m.read.private/${encodeURIComponent(eventId)}`,
			null
		)
	}

	// ============================================================
	// 房间扩展信息（标签、是否收藏、是否低优先级）
	// ============================================================

	/**
	 * 一键打标签：m.favourite（收藏）/ m.lowpriority（低优）
	 * 内部其实就是 addRoomTag 的封装
	 */
	async favouriteRoom(roomId: string, favourite: boolean): Promise<void> {
		if (favourite) {
			await this.addRoomTag(roomId, 'm.favourite', 0.0)
		} else {
			await this.removeRoomTag(roomId, 'm.favourite')
		}
	}

	async setRoomLowPriority(roomId: string, low: boolean): Promise<void> {
		if (low) {
			await this.addRoomTag(roomId, 'm.lowpriority', 0.9)
		} else {
			await this.removeRoomTag(roomId, 'm.lowpriority')
		}
	}

	genTxnId(): string {
		this.txnCounter += 1
		return `tx_${Date.now()}_${this.txnCounter}`
	}
}

// ============================================================
// 全局单例
// ============================================================
let _instance: MatrixClient | null = null
let _voipSink: ((event: MatrixEvent, roomId: string) => void) | null = null

function flushVoipQueue(client: MatrixClient, fn: (event: MatrixEvent, roomId: string) => void): void {
	if (client.pendingVoipEvents.length == 0) return
	const evs = client.pendingVoipEvents
	const rooms = client.pendingVoipRooms
	const emptyEv: Array<MatrixEvent> = []
	const emptyRid: Array<string> = []
	client.pendingVoipEvents = emptyEv
	client.pendingVoipRooms = emptyRid
	console.log('[sync] flush voip sink', evs.length)
	for (let i = 0; i < evs.length; i++) {
		try { fn(evs[i], rooms[i]) } catch (e) { console.error('voip sink error', e) }
	}
}

export function setVoipSink(fn: (event: MatrixEvent, roomId: string) => void): void {
	_voipSink = fn
	const client = _instance
	if (client != null) {
		flushVoipQueue(client, fn)
	}
}

export function getMatrix(): MatrixClient | null {
	return _instance
}

export function setMatrix(client: MatrixClient): void {
	const prev = _instance
	if (prev != null && prev != client) {
		const sink = _voipSink
		if (sink != null) {
			flushVoipQueue(prev, sink)
		}
		prev.stopSync()
	}
	_instance = client
	const sink2 = _voipSink
	if (sink2 != null) {
		flushVoipQueue(client, sink2)
	}
}

export function clearMatrix(): void {
	const client = _instance
	if (client != null) {
		client.stopSync()
	}
	_instance = null
}

/**
 * 把 Matrix 消息 body 里的 HTML 实体反转义回原始字符
 * 处理：
 *   &lt; &gt; &quot; &#39; &amp;
 *   &amp;#40; → &#40; （这一层故意保留，用于 fallback）
 *   但因为客户端收到的 body 里 escape 的其实就是原文，我们解一层就够
 */
export function unescapeMatrixBody(body: string): string {
	if (body == null || body.length == 0) return body
	const froms: Array<string> = ['&lt;', '&gt;', '&quot;', '&apos;', '&#39;', '&nbsp;']
	const tos: Array<string> = ['<', '>', '"', "'", "'", ' ']
	let out = body
	for (let i = 0; i < froms.length; i++) {
		out = out.split(froms[i]).join(tos[i])
	}
	out = out.split('&amp;').join('&')
	return out
}
