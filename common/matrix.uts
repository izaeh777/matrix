	/**
	 * 查询某用户的在线状态
	 * 默认 online/offline/unavailable 三档
	 * 服务器可以支持自定义 presence（如 Element 的 busy、away）
	 */
	async getPresence(userId: string): Promise<PresenceInfo> {
		return (await this.request(
			'GET',
			`/_matrix/client/v3/presence/${encodeURIComponent(userId)}/status`,
			null
		)) as PresenceInfo
	}

	/**
	 * 设置自己的在线状态
	 * @param presence 'online' | 'offline' | 'unavailable' 或 'org.matrix.msc3026.busy' 等
	 * @param statusMsg 自定义状态消息（可选）
	 */
	async setPresence(presence: string, statusMsg: string = ''): Promise<void> {
		const body: UTSJSONObject = { presence: presence }
		if (statusMsg.length > 0) {
			body['status_msg'] = statusMsg
		}
		await this.request(
			'PUT',
			`/_matrix/client/v3/presence/${encodeURIComponent(this.userId)}/status`,
			body
		)
	}

	// ============================================================
	// 推送 / 通知
	// ============================================================

	/**
	 * 注册一个系统推送通道（APNs / FCM / UniPush 等）
	 * Matrix 服务器收到新消息后，会调用 pusher 里的 url 把消息推过来。
	 * @param pusher { kind, app_id, pushkey, app_display_name, device_display_name, data }
	 *   - kind: 'http' 或 'email'
	 *   - app_id: 你的 App 包名（com.xxx.app）
	 *   - pushkey: 来自 APNs/FCM/UniPush 的设备标识
	 *   - data.url: Matrix 推送网关地址（UniPush 模式下用 https://push-helper.dcloud.io/notify）
	 *   - data.format: 'event_id_only' 表示只推 eventId，App 收到后自己去 /sync 拉
	 */
	async setPusher(pusher: UTSJSONObject): Promise<void> {
		await this.request('POST', '/_matrix/client/v3/pushers/set', pusher)
	}

	/**
	 * 注销/删除一个推送通道
	 * @param pushkey 设备标识
	 * @param appId App 包名
	 */
	async removePusher(pushkey: string, appId: string): Promise<void> {
		await this.request(
			'POST',
			'/_matrix/client/v3/pushers/set',
			{ kind: null, app_id: appId, pushkey: pushkey, app_display_name: '', device_display_name: '', data: {} }
		)
	}

	async getPushers(): Promise<UTSJSONObject> {
		return await this.request('GET', '/_matrix/client/v3/pushers', null)
	}

	async getPushRules(): Promise<UTSJSONObject> {
		return await this.request('GET', '/_matrix/client/v3/pushrules/', null)
	}

	async setPushRule(kind: string, ruleId: string, actions: Array<string>): Promise<void> {
		await this.request(
			'PUT',
			`/_matrix/client/v3/pushrules/global/${encodeURIComponent(kind)}/${encodeURIComponent(ruleId)}`,
			{ actions: actions }
		)
	}

	// ============================================================
	// 设备管理（查看/远程登出登录过的设备）
	// ============================================================

	/**
	 * 列出当前账号下所有登录的设备
	 */
	async getDevices(): Promise<Array<DeviceInfo>> {
		const data = (await this.request('GET', '/_matrix/client/v3/devices', null)) as UTSJSONObject
		const devices = data['devices'] as Array<UTSJSONObject> ?? []
		const result: Array<DeviceInfo> = []
		for (const d of devices) {
			result.push({
				device_id: d['device_id'] as string ?? '',
				user_id: d['user_id'] as string,
				display_name: d['display_name'] as string,
				last_seen_ip: (d['last_seen_ip'] as string),
				last_seen_ts: (d['last_seen_ts'] as number),
				app_id: (d['app'] as UTSJSONObject)?.['app_id'] as string,
				version: (d['app'] as UTSJSONObject)?.['version'] as string
			})
		}
		return result
	}

	/**
	 * 获取单个设备详情
	 */
	async getDevice(deviceId: string): Promise<DeviceInfo> {
		return (await this.request('GET', `/_matrix/client/v3/devices/${encodeURIComponent(deviceId)}`, null)) as DeviceInfo
	}

	/**
	 * 修改设备显示名（"我的 iPhone 14" 之类的）
	 */
	async updateDevice(deviceId: string, displayName: string): Promise<void> {
		await this.request(
			'PUT',
			`/_matrix/client/v3/devices/${encodeURIComponent(deviceId)}`,
			{ display_name: displayName }
		)
	}

	completePasswordAuth(authData: UTSJSONObject): UTSJSONObject {
		const auth: UTSJSONObject = {}
		const t = jsonStr(authData, 'type')
		const password = jsonStr(authData, 'password')
		const session = jsonStr(authData, 'session')
		if (t.length > 0) auth['type'] = t
		if (password.length > 0) auth['password'] = password
		if (session.length > 0) auth['session'] = session
		if (t == 'm.login.password') {
			auth['user'] = this.userId
			const ident: UTSJSONObject = {
				type: 'm.id.user',
				user: this.userId
			}
			auth['identifier'] = ident
		}
		return auth
	}

	/**
	 * 远程登出某一个设备（需要 UIA 二次验证时填 authData）
	 * spec: DELETE body 为 { auth?: Authentication Data }
	 */
	async deleteDevice(deviceId: string, authData: UTSJSONObject): Promise<void> {
		const body: UTSJSONObject = {}
		if (jsonKeys(authData).length > 0) {
			body['auth'] = this.completePasswordAuth(authData)
		}
		await this.request('DELETE', `/_matrix/client/v3/devices/${encodeURIComponent(deviceId)}`, body)
	}

	/**
	 * 远程登出所有设备（除了当前），相当于把账号在其他地方都踢下线
	 * spec: POST /_matrix/client/v3/delete_devices
	 * body: { devices: string[], auth?: Authentication Data }
	 */
	async deleteAllDevices(authData: UTSJSONObject): Promise<void> {
		const list = await this.getDevices()
		const ids: Array<string> = []
		let i = 0
		while (i < list.length) {
			const id = list[i].device_id
			if (id.length > 0 && id != this.deviceId) ids.push(id)
			i++
		}
		if (ids.length == 0) return
		const body: UTSJSONObject = {}
		body['devices'] = ids
		if (jsonKeys(authData).length > 0) {
			body['auth'] = this.completePasswordAuth(authData)
		}
		await this.request('POST', '/_matrix/client/v3/delete_devices', body)
	}

	// ============================================================
	// 账号安全（密码 / 注销 / 3PID）
