	/**
	 * 改密码
	 * 改完之后当前 access_token 会失效，需要重新登录
	 */
	async changePassword(newPassword: string, authData: UTSJSONObject): Promise<void> {
		await this.request('POST', '/_matrix/client/v3/account/password', {
			new_password: newPassword,
			auth: authData
		})
	}

	/**
	 * 注销账号（不可逆！）
	 * 需要 UIA auth（密码 / 验证码）
	 */
	async deactivateAccount(authData: UTSJSONObject, idServer: string): Promise<void> {
		const body: UTSJSONObject = { auth: authData, erase: false }
		if (idServer.length > 0) {
			body['id_server'] = idServer
		}
		await this.request('POST', '/_matrix/client/v3/account/deactivate', body)
	}

	/**
	 * 获取账号下绑定的第三方账号（邮箱 / 手机）
	 */
	async get3PIDs(): Promise<Array<ThreepidInfo>> {
		const data = (await this.request('GET', '/_matrix/client/v3/account/3pid', null)) as UTSJSONObject
		const list = (data['threepids'] as Array<UTSJSONObject>) ?? []
		const out: Array<ThreepidInfo> = []
		for (let i = 0; i < list.length; i++) {
			const t = list[i]
			const item: ThreepidInfo = {
				medium: (t['medium'] as string) ?? '',
				address: (t['address'] as string) ?? '',
				validated_at: (t['validated_at'] as number) ?? 0
			}
			out.push(item)
		}
		return out
	}

	/**
	 * 查询服务器能力（看支持哪些功能）
	 * 比如 { 'm.change_password': { enabled: true }, 'm.room_versions': {...} }
	 */
	async getCapabilities(): Promise<UTSJSONObject> {
		return await this.request('GET', '/_matrix/client/v3/capabilities', null)
	}

	// ============================================================
	// 公共房间 / TURN（音视频通话用）
	// ============================================================

	/**
	 * 浏览服务器上所有公开的房间
	 * @param limit 每页条数（默认 20）
	 * @param since 翻页 token
	 * @param searchTerm 关键词（按房间名搜索）
	 */
	async listPublicRooms(
		limit: number = 20,
		since: string = '',
		searchTerm: string = ''
	): Promise<PublicRoomsPage> {
		const body: UTSJSONObject = { limit: limit }
		if (since.length > 0) body['since'] = since
		if (searchTerm.length > 0) body['filter'] = { generic_search_term: searchTerm }
		const data = (await this.request('POST', '/_matrix/client/v3/publicRooms', body)) as UTSJSONObject
		const chunk: Array<PublicRoom> = []
		const raw = data.getArray('chunk')
		if (raw != null) {
			for (let i = 0; i < raw.length; i++) {
				const item = toJsonObj(raw[i])
				const roomId = jsonStr(item, 'room_id')
				if (roomId.length == 0) continue
				const row: PublicRoom = {
					room_id: roomId,
					canonical_alias: jsonStr(item, 'canonical_alias'),
					name: jsonStr(item, 'name'),
					topic: jsonStr(item, 'topic'),
					avatar_url: jsonStr(item, 'avatar_url'),
					num_joined_members: jsonNum(item, 'num_joined_members'),
					world_readable: jsonBool(item, 'world_readable'),
					guest_can_join: jsonBool(item, 'guest_can_join')
				}
				chunk.push(row)
			}
		}
		const next = jsonStr(data, 'next_batch')
		return {
			chunk: chunk,
			next_batch: next,
			total_room_count_estimate: jsonNum(data, 'total_room_count_estimate')
		}
	}

