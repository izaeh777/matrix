export class MatrixClient {
	homeserver: string = ''
	accessToken: string = ''
	userId: string = ''
	deviceId: string = ''
	txnCounter: number = 0
	requestCount: number = 0
	// 用户显示名缓存：userId → displayname
	userDisplayNames: Map<string, string> = new Map()
	userAvatars: Map<string, string> = new Map()
	// 每房间最后一条消息预览（sync 时实时更新，避免 getMessages(1) 取不到）
	roomLastMessage: Map<string, LastMessagePreview> = new Map()
	// getRoomSummary 内存缓存：用并行数组存 (keys, entries)，避开 Map 和动态索引的兼容问题
	cacheKeys: Array<string> = []
	cacheEntries: Array<UTSJSONObject> = []
	// listRooms 去重锁：避免并发调用导致重复打 N 个 state
	listRoomsInflight: Promise<MatrixRoom[]> | null = null
	// 同步状态
	isSyncing: boolean = false
	syncEpoch: number = 0
	syncAbort: (() => void) | null = null
	since: string = ''
	// 事件回调（向后兼容：onRoomTimeline 等同于 _timelineHandlers 的最后一项）
	onRoomTimeline: ((event: MatrixEvent, roomId: string) => void) | null = null
	onRoomListEvent: ((event: MatrixEvent, roomId: string) => void) | null = null
	onRoomInvite: ((roomId: string) => void) | null = null
	onSyncStateChange: ((state: string, error: string) => void) | null = null
	onTyping: ((userIds: Array<string>, roomId: string) => void) | null = null
	onReaction: ((event: MatrixEvent, roomId: string) => void) | null = null
	onRedaction: ((redaction: UTSJSONObject, roomId: string) => void) | null = null
	onUnread: ((roomId: string, count: number) => void) | null = null
	onPresence: ((content: UTSJSONObject) => void) | null = null
	// 多订阅者列表（推荐用法）
	timelineHandlers: Array<(event: MatrixEvent, roomId: string) => void> = []
	voipHandlers: Array<(event: MatrixEvent, roomId: string) => void> = []
	pendingVoipEvents: Array<MatrixEvent> = []
	pendingVoipRooms: Array<string> = []
	onVoipEvent: ((event: MatrixEvent, roomId: string) => void) | null = null
	voipHold: any | null = null
	callSnap: UTSJSONObject | null = null
	callActiveId: string = ''
	callPollOn: boolean = false
	inviteHandlers: Array<(roomId: string) => void> = []
	syncStateHandlers: Array<(state: string, error: string) => void> = []
	typingHandlers: Array<(userIds: Array<string>, roomId: string) => void> = []
	reactionHandlers: Array<(event: MatrixEvent, roomId: string) => void> = []
	redactionHandlers: Array<(redaction: UTSJSONObject, roomId: string) => void> = []
	unreadHandlers: Array<(roomId: string, count: number) => void> = []
	presenceHandlers: Array<(content: UTSJSONObject) => void> = []
	decryptHandlers: Array<(event: MatrixEvent, roomId: string) => void> = []
	// 房间成员缓存（key: 'joined_members:<roomId>'）
	memberCache: Map<string, MemberCacheEntry> = new Map()
	// 房间事件缓冲（任何房间的事件都会暂存）
	roomTimelines: Map<string, Array<UTSJSONObject>> = new Map()
	// 已知房间 ID 集合（来自 sync 推送）；listRooms 用它补全 /joined_rooms 可能漏掉的房间
	knownRoomIds: Set<string> = new Set<string>()
	// 邀请状态房间（用户还未 join 的房间，含邀请者）
	invitedRoomCache: Map<string, InvitedRoomInfo> = new Map()
	stateEventHandlers: Array<(ev: UTSJSONObject, rid: string) => void> = []
	// 心跳 timer
	pollTimer: number | null = null
	lastTypingAt: number = 0

	/**
	 * 构造：创建实例
	 */
	constructor() {
	}

	applySession(sessionHomeserver: string, accessToken: string, userId: string, deviceId: string): void {
		this.homeserver = sessionHomeserver.replace(/\/$/, '')
		this.accessToken = accessToken
		this.userId = userId
		this.deviceId = deviceId
		this.since = loadSyncSince()
	}

	// ============================================================
	// 服务器发现
	// ============================================================

	/**
	 * 从 Matrix ID 中提取 server name 并发现 homeserver
	 * @param matrixId 例如 "@user:matrix.org"
	 */
	async discoverHomeserver(matrixId: string): Promise<string> {
		const parts = matrixId.split(':')
		if (parts.length < 2) {
			throw new Error('Matrix ID 格式错误，应为 @user:server')
		}
		const serverName = parts[parts.length - 1]

		// 1. 尝试 .well-known
		try {
			const empty: UTSJSONObject = {}
			const res = await httpJson('https://' + serverName + '/.well-known/matrix/client', 'GET', empty, empty, 10000)
			const hs = toJsonObj(res.json['m.homeserver'])
			const base = hs['base_url'] as string | null
			if (base != null && base.length > 0) {
				const ok = await this.validateHomeserver(base)
				if (ok) return base.replace(/\/$/, '')
			}
		} catch (e) {
			console.warn(TAG, '.well-known 请求失败，回退到直接域名', e)
		}

		// 2. 回退：直接用 server name 作为 homeserver
		const fallback = `https://${serverName}`
		const ok = await this.validateHomeserver(fallback)
		if (ok) return fallback
		throw new Error('无法发现可用的 homeserver')
	}

	async validateHomeserver(baseUrl: string): Promise<boolean> {
		try {
			const empty: UTSJSONObject = {}
			const res = await httpJson(baseUrl + '/_matrix/client/versions', 'GET', empty, empty, 8000)
			return res.statusCode == 200
		} catch (e) {
			return false
		}
	}

	// ============================================================
	// 登录 / 注册
	// ============================================================

	async login(homeserver: string, username: string, password: string): Promise<SessionInfo> {
		const url = `${homeserver.replace(/\/$/, '')}/_matrix/client/v3/login`

		// 支持 username 是完整 @user:server，也支持纯 local part
		let loginUser = username.trim()
		const hsUrl = homeserver.replace(/\/$/, '')

		if (loginUser.startsWith('@') && loginUser.indexOf(':') > 0) {
			const atIdx = loginUser.indexOf(':')
			loginUser = loginUser.substring(1, atIdx)
		}
		if (loginUser.indexOf(':') > 0) {
			loginUser = loginUser.substring(0, loginUser.indexOf(':'))
		}

		const ident: UTSJSONObject = {
			type: 'm.id.user',
			user: loginUser
		}
		const body: UTSJSONObject = {
			type: 'm.login.password',
			identifier: ident,
			password: password
		}
		const header: UTSJSONObject = {
			'Content-Type': 'application/json'
		}
		const res = await httpJson(url, 'POST', header, body, 20000)
		const data = res.json
		if (res.statusCode != 200) {
			const errcode = jsonStr(data, 'errcode')
			const code = errcode.length > 0 ? errcode : 'UNKNOWN'
			if (code == 'M_LIMIT_EXCEEDED') {
				const wait = jsonNum(data, 'retry_after_ms')
				let sec = 30
				if (wait > 0) {
					sec = Math.ceil(wait / 1000)
				}
				throw new Error('请求太频繁，请 ' + sec + ' 秒后再试')
			}
			const error = jsonStr(data, 'error')
			throw new Error('[' + code + '] ' + (error.length > 0 ? error : '登录失败'))
		}
		const session: SessionInfo = {
			homeserver: homeserver.replace(/\/$/, ''),
			user_id: jsonStr(data, 'user_id'),
			access_token: jsonStr(data, 'access_token'),
			device_id: jsonStr(data, 'device_id'),
			display_name: '',
			avatar_url: ''
		}
		if (session.access_token.length == 0) {
			throw new Error('登录失败：未返回 access_token')
		}
		this.homeserver = session.homeserver
		this.accessToken = session.access_token
		this.userId = session.user_id
		this.deviceId = session.device_id
		return session
	}

	async logout(): Promise<void> {
		if (this.accessToken.length == 0) return
		try {
			await this.request('POST', '/_matrix/client/v3/logout', null)
		} catch (e) {
			console.warn(TAG, 'logout 请求失败，继续清理本地', e)
		}
		this.accessToken = ''
		this.userId = ''
		this.deviceId = ''
		this.stopSync()
	}

	// ============================================================
	// HTTP 工具
	// ============================================================

	async request(
		method: string,
		path: string,
		body: UTSJSONObject | null = null,
		query: UTSJSONObject | null = null,
		timeoutMs: number = 30000
	): Promise<any> {
		let url = `${this.homeserver}${path}`
		if (query != null) {
			const qs = queryString(query)
			if (qs.length > 0) {
				url += (path.indexOf('?') >= 0 ? '&' : '?') + qs
			}
		}
		this.requestCount = this.requestCount + 1
		if (path.indexOf('/sync') < 0) {
			console.log('[REQ#' + this.requestCount + ']', method, path)
		}
		const header: UTSJSONObject = {
			'Content-Type': 'application/json',
			'Authorization': `Bearer ${this.accessToken}`
		}
		const waitMs = timeoutMs > 0 ? timeoutMs : 30000
		const payload: UTSJSONObject = body != null ? (body as UTSJSONObject) : {}
		const res = await httpJson(url, method, header, payload, waitMs)
		const parsed = res.json
		if (res.statusCode >= 200 && res.statusCode < 300) {
			return parsed
		}
		const errcode = jsonStr(parsed, 'errcode')
		const code = errcode.length > 0 ? errcode : ('HTTP_' + res.statusCode)
		const error = jsonStr(parsed, 'error')
		throw new Error('[' + code + '] ' + (error.length > 0 ? error : '请求失败'))
	}

	async requestList(
		method: string,
		path: string,
		body: UTSJSONObject | null = null,
		query: UTSJSONObject | null = null,
		timeoutMs: number = 30000
	): Promise<Array<UTSJSONObject>> {
		let url = `${this.homeserver}${path}`
		if (query != null) {
			const qs = queryString(query)
			if (qs.length > 0) {
				url += (path.indexOf('?') >= 0 ? '&' : '?') + qs
			}
		}
		this.requestCount = this.requestCount + 1
		console.log('[REQ#' + this.requestCount + ']', method, path)
		const header: UTSJSONObject = {
			'Content-Type': 'application/json',
			'Authorization': `Bearer ${this.accessToken}`
		}
		const waitMs = timeoutMs > 0 ? timeoutMs : 30000
		const payload: UTSJSONObject = body != null ? (body as UTSJSONObject) : {}
		const res = await httpJson(url, method, header, payload, waitMs)
		if (res.statusCode >= 200 && res.statusCode < 300) {
			return res.list
		}
		const parsed = res.json
		const errcode = jsonStr(parsed, 'errcode')
		const code = errcode.length > 0 ? errcode : ('HTTP_' + res.statusCode)
		const error = jsonStr(parsed, 'error')
		throw new Error('[' + code + '] ' + (error.length > 0 ? error : '请求失败'))
	}

	// ============================================================
	// 当前用户信息
	// ============================================================

	async whoami(): Promise<UTSJSONObject> {
		return await this.request('GET', '/_matrix/client/v3/account/whoami', null)
	}

	async searchUsers(searchTerm: string): Promise<Array<DirectoryUser>> {
		const res = await this.request('POST', '/_matrix/client/v3/user_directory/search', {
			search_term: searchTerm,
			limit: 20
		}) as UTSJSONObject
		const results = (res['results'] as Array<UTSJSONObject>) ?? []
		const out: Array<DirectoryUser> = []
		for (let i = 0; i < results.length; i++) {
			const u = results[i]
			const item: DirectoryUser = {
				user_id: (u['user_id'] as string) ?? '',
				display_name: (u['display_name'] as string) ?? '',
				avatar_url: (u['avatar_url'] as string) ?? ''
			}
			out.push(item)
		}
		return out
	}

	async getProfile(userId: string): Promise<ProfileInfo> {
		const res = await this.request(
			'GET',
			`/_matrix/client/v3/profile/${encodeURIComponent(userId)}`,
			null
		)
		const obj = res as UTSJSONObject
		const dn = jsonStr(obj, 'displayname')
		return {
			display_name: dn.length > 0 ? dn : userId,
			avatar_url: jsonStr(obj, 'avatar_url')
		}
	}

	async setDisplayName(name: string): Promise<void> {
		await this.request(
			'PUT',
			`/_matrix/client/v3/profile/${encodeURIComponent(this.userId)}/displayname`,
			{ displayname: name }
		)
	}

	async setAvatarUrl(mxc: string): Promise<void> {
		await this.request(
			'PUT',
			`/_matrix/client/v3/profile/${encodeURIComponent(this.userId)}/avatar_url`,
			{ avatar_url: mxc }
		)
	}

	// ============================================================
	// Sync（长轮询）
	// ============================================================

	startSync(): void {
		if (this.isSyncing) return
		this.isSyncing = true
		this.syncEpoch = this.syncEpoch + 1
		this.syncLoop(this.syncEpoch)
	}

	stopSync(): void {
		this.isSyncing = false
		this.syncEpoch = this.syncEpoch + 1
		if (this.pollTimer != null) {
			const t = this.pollTimer
			clearTimeout(t)
			this.pollTimer = null
		}
		if (this.syncAbort != null) {
			this.syncAbort()
			this.syncAbort = null
		}
	}

	async syncLoop(epoch: number): Promise<void> {
		const fireState = (state: string, error: string): void => {
			for (const h of this.syncStateHandlers) {
				try { h(state, error) } catch (e) { console.error('sync handler error', e) }
			}
			if (this.onSyncStateChange != null) {
				try { this.onSyncStateChange(state, error) } catch (e) { console.error('legacy sync handler error', e) }
			}
		}

		let failCount = 0
		let timeoutHits = 0
		while (this.isSyncing && this.syncEpoch == epoch) {
			try {
				fireState('SYNCING', '')
				const first = this.since.length == 0
				// 服务端长轮询最多等 20s；HTTP 必须更长，且不能超过 App 端 60s 上限
				const query: UTSJSONObject = { timeout: first ? '0' : '20000' }
				if (this.since.length > 0) query['since'] = this.since
				query['filter'] = '{"presence":{"not_types":["*"]},"room":{"state":{"lazy_load_members":true},"timeline":{"limit":100,"lazy_load_members":true}}}'
				const httpMs = 60000
				const data = (await this.request(
					'GET',
					'/_matrix/client/v3/sync',
					null,
					query,
					httpMs
				)) as UTSJSONObject

				if (!this.isSyncing || this.syncEpoch != epoch) break

				const nextVal = data.getString('next_batch')
				if (nextVal != null && nextVal.length > 0) {
					this.since = nextVal
					saveSyncSince(nextVal)
				}

				await this.processSyncResponse(data)
				failCount = 0
				timeoutHits = 0
				fireState('PREPARED', '')
			} catch (e) {
				if (!this.isSyncing || this.syncEpoch != epoch) break
				const msg = `${e}`
				if (isRequestTimeout(msg)) {
					timeoutHits = timeoutHits + 1
					if (timeoutHits == 1 || timeoutHits % 10 == 0) {
						console.warn(TAG, 'sync idle timeout, retry', timeoutHits)
					}
					continue
				}
				console.error(TAG, 'sync error:', msg)
				fireState('ERROR', msg)
				if (msg.indexOf('M_UNKNOWN_TOKEN') >= 0) {
					this.stopSync()
					break
				}
				failCount = failCount + 1
				let wait = 2000 * failCount
				if (wait > 15000) wait = 15000
				await this.sleep(wait)
			}
		}
	}

	async processSyncResponse(data: UTSJSONObject): Promise<void> {
		const toDevice = jsonObj(data, 'to_device')
		const tdEvents = jsonArr(toDevice, 'events')
		for (let ti = 0; ti < tdEvents.length; ti++) {
			const ev = tdEvents[ti]
			const evType = jsonStr(ev, 'type')
			if (evType.indexOf('m.call.') != 0) continue
			const parsedTd = this.parseEvent(ev)
			const ccTd = jsonObj(ev, 'content')
			let ridTd = jsonStr(ccTd, 'room_id')
			if (ridTd.length == 0) ridTd = jsonStr(ev, 'room_id')
			console.log('[sync] to-device voip', evType, 'call_id=', jsonStr(ccTd, 'call_id'), 'from=', jsonStr(ev, 'sender'), 'room=', ridTd)
			this.fireVoip(parsedTd, ridTd)
		}
		const rooms = jsonObj(data, 'rooms')
		const join = jsonObj(rooms, 'join')
		const roomIds = jsonKeys(join)
		if (roomIds.length > 0) {
			for (let ri = 0; ri < roomIds.length; ri++) {
				const roomId = roomIds[ri]
				const room = jsonObj(join, roomId)
				this.knownRoomIds.add(roomId)

				const timeline = jsonObj(room, 'timeline')
				const events = jsonArr(timeline, 'events')
				if (events.length > 0) {
					let buf: Array<UTSJSONObject> = []
					const existing = this.roomTimelines.get(roomId)
					if (existing != null) {
						buf = existing
					} else {
						this.roomTimelines.set(roomId, buf)
					}
					for (let ei = 0; ei < events.length; ei++) {
						const ev = events[ei]
						const parsed = this.parseEvent(ev)
						const evType = jsonStr(ev, 'type')
						if (evType.indexOf('m.call.') == 0) {
							const cc = jsonObj(ev, 'content')
							console.log('[sync] voip', evType, 'call_id=', jsonStr(cc, 'call_id'), 'from=', jsonStr(ev, 'sender'), 'room=', roomId)
							this.fireVoip(parsed, roomId)
						}

						if (evType == 'm.room.redaction') {
							const redacts = jsonStr(ev, 'redacts')
							if (redacts.length > 0) {
								for (let i = 0; i < buf.length; i++) {
									const item = buf[i]
									if (jsonStr(item, 'event_id') == redacts) {
										item['redacted'] = true
										item['body'] = '（消息已撤回）'
										buf[i] = item
										break
									}
								}
								const handler: UTSJSONObject = {
									kind: 'redaction',
									redacts: redacts,
									sender: jsonStr(ev, 'sender')
								}
								const reasonObj = jsonObj(ev, 'content')
								const reason = jsonStr(reasonObj, 'reason')
								if (reason.length > 0) handler['reason'] = reason
								for (let hi = 0; hi < this.redactionHandlers.length; hi++) {
									try { this.redactionHandlers[hi](handler, roomId) } catch (e) { console.error(e) }
								}
								continue
							}
						}

						if (evType == 'm.room.message') {
							const content = jsonObj(ev, 'content')
							const relates = jsonObj(content, 'm.relates_to')
							if (jsonStr(relates, 'rel_type') == 'm.replace') {
								const origId = jsonStr(relates, 'event_id')
								const newContent = jsonObj(content, 'm.new_content')
								for (let i = 0; i < buf.length; i++) {
									const item = buf[i]
									if (jsonStr(item, 'event_id') == origId) {
										const nb = jsonStr(newContent, 'body')
										if (nb.length > 0) item['body'] = nb
										item['edited'] = true
										buf[i] = item
										break
									}
								}
							}
						}

						if (evType == 'm.reaction') {
							for (let hi = 0; hi < this.reactionHandlers.length; hi++) {
								try { this.reactionHandlers[hi](parsed, roomId) } catch (e) { console.error(e) }
							}
						}

						buf.push(ev)
						if (evType == 'm.room.message' || evType == 'm.room.encrypted') {
							const sender = jsonStr(ev, 'sender')
							const c = jsonObj(ev, 'content')
							let body = jsonStr(c, 'body')
							const mt = jsonStr(c, 'msgtype')
							if (evType == 'm.room.encrypted') body = '[加密消息]'
							else if (mt == 'm.audio') body = '[语音]'
							else if (mt == 'm.image') body = '[图片]'
							else if (mt == 'm.file') body = '[文件]'
							else if (mt == 'm.call' && body.length == 0) body = '[通话]'
							const ts = jsonNum(ev, 'origin_server_ts')
							this.roomLastMessage.set(roomId, { body: body, ts: ts, sender: sender })
						}
						const directTl = this.onRoomTimeline
						if (directTl != null) {
							try { directTl(parsed, roomId) } catch (e0) { console.error('timeline direct error', e0) }
						}
						const listSink = this.onRoomListEvent
						if (listSink != null) {
							try { listSink(parsed, roomId) } catch (e0b) { console.error('room list event error', e0b) }
						}
						for (let hi = 0; hi < this.timelineHandlers.length; hi++) {
							try { this.timelineHandlers[hi](parsed, roomId) } catch (e1) { console.error('handler error', e1) }
						}
						if (evType != 'm.room.message' && evType != 'm.reaction' && evType != 'm.room.redaction') {
							for (let hi = 0; hi < this.stateEventHandlers.length; hi++) {
								try { this.stateEventHandlers[hi](ev, roomId) } catch (e) { console.error('stateEvent handler error', e) }
							}
						}
					}
				}

				const ephemeral = jsonObj(room, 'ephemeral')
				const typing = jsonArr(ephemeral, 'events')
				for (let ti = 0; ti < typing.length; ti++) {
					const ev = typing[ti]
					if (jsonStr(ev, 'type') == 'm.typing') {
						const content = jsonObj(ev, 'content')
						const userIds = jsonStrArr(content, 'user_ids')
						for (let hi = 0; hi < this.typingHandlers.length; hi++) {
							try { this.typingHandlers[hi](userIds, roomId) } catch (e) { console.error(e) }
						}
						if (this.onTyping != null) {
							try { this.onTyping(userIds, roomId) } catch (e) { console.error(e) }
						}
					}
				}

				const unread = jsonObj(room, 'unread_notifications')
				const count = jsonNum(unread, 'notification_count')
				const unreadDirect = this.onUnread
				if (unreadDirect != null) {
					try { unreadDirect(roomId, count) } catch (eU0) { console.error(eU0) }
				}
				for (let hi = 0; hi < this.unreadHandlers.length; hi++) {
					try { this.unreadHandlers[hi](roomId, count) } catch (e) { console.error(e) }
				}
			}
		}

		const invite = jsonObj(rooms, 'invite')
		const inviteIds = jsonKeys(invite)
		for (let ii = 0; ii < inviteIds.length; ii++) {
			const roomId = inviteIds[ii]
			const inviteRoom = jsonObj(invite, roomId)
			const inviteStateWrap = jsonObj(inviteRoom, 'invite_state')
			const inviteState = jsonArr(inviteStateWrap, 'events')
			let inviter = ''
			let roomName = ''
			for (let si = 0; si < inviteState.length; si++) {
				const ev = inviteState[si]
				const t = jsonStr(ev, 'type')
				const c = jsonObj(ev, 'content')
				if (t == 'm.room.member' && jsonStr(c, 'membership') == 'invite') {
					inviter = jsonStr(ev, 'sender')
				}
				if (t == 'm.room.name') {
					roomName = jsonStr(c, 'name')
				}
			}
			this.invitedRoomCache.set(roomId, { room_id: roomId, name: roomName, inviter: inviter })
			const joinedNow = jsonObj(rooms, 'join')
			if (jsonKeys(joinedNow).indexOf(roomId) >= 0) {
				this.invitedRoomCache.delete(roomId)
			}

			for (let hi = 0; hi < this.inviteHandlers.length; hi++) {
				try { this.inviteHandlers[hi](roomId) } catch (e) { console.error('invite handler error', e) }
			}
			if (this.onRoomInvite != null) {
				try { this.onRoomInvite(roomId) } catch (e) { console.error('legacy onRoomInvite error', e) }
			}
		}

		const presence = jsonObj(data, 'presence')
		const presenceEvents = jsonArr(presence, 'events')
		for (let pi = 0; pi < presenceEvents.length; pi++) {
			const ev = presenceEvents[pi]
			for (let hi = 0; hi < this.presenceHandlers.length; hi++) {
				try { this.presenceHandlers[hi](ev) } catch (e) { console.error(e) }
			}
			const legacy = this.onPresence
			if (legacy != null) {
				try { legacy(ev) } catch (e) { console.error(e) }
			}
		}
	}

	/**
	 * 读取指定房间的缓冲事件（不清空）
	 */
	getBufferedEvents(roomId: string): Array<MatrixEvent> {
		const out: Array<MatrixEvent> = []
		const src = this.roomTimelines.get(roomId)
		if (src == null) return out
		for (let i = 0; i < src.length; i++) {
			out.push(this.parseEvent(src[i]))
		}
		return out
	}

	/**
	 * 取出并清空指定房间的缓冲事件
	 */
	drainBufferedEvents(roomId: string): Array<MatrixEvent> {
		const out = this.getBufferedEvents(roomId)
		const emptyDrain: Array<UTSJSONObject> = []
		this.roomTimelines.set(roomId, emptyDrain)
		return out
	}

	/**
	 * 订阅房间消息事件，返回取消订阅的函数
	 */
	onTimeline(handler: (event: MatrixEvent, roomId: string) => void): () => void {
		this.timelineHandlers.push(handler)
		return () => {
			const idx = this.timelineHandlers.indexOf(handler)
			if (idx >= 0) this.timelineHandlers.splice(idx, 1)
		}
	}

	onVoip(handler: (event: MatrixEvent, roomId: string) => void): () => void {
		this.voipHandlers.push(handler)
		if (this.pendingVoipEvents.length > 0) {
			const evs = this.pendingVoipEvents
			const rooms = this.pendingVoipRooms
			const emptyEv: Array<MatrixEvent> = []
			const emptyRid: Array<string> = []
			this.pendingVoipEvents = emptyEv
			this.pendingVoipRooms = emptyRid
			console.log('[sync] flush queued voip', evs.length)
			for (let i = 0; i < evs.length; i++) {
				try { handler(evs[i], rooms[i]) } catch (e) { console.error('voip handler error', e) }
			}
		}
		return () => {
			const idx = this.voipHandlers.indexOf(handler)
			if (idx >= 0) this.voipHandlers.splice(idx, 1)
		}
	}

	fireVoip(event: MatrixEvent, roomId: string): void {
		const sink = _voipSink
		if (sink != null) {
			try { sink(event, roomId) } catch (e) { console.error('voip sink error', e) }
			return
		}
		const direct = this.onVoipEvent
		if (direct != null) {
			try { direct(event, roomId) } catch (e) { console.error('voip direct error', e) }
			return
		}
		if (this.voipHandlers.length == 0) {
			this.pendingVoipEvents.push(event)
			this.pendingVoipRooms.push(roomId)
			if (this.pendingVoipEvents.length > 40) {
				this.pendingVoipEvents.splice(0, 1)
				this.pendingVoipRooms.splice(0, 1)
			}
			console.warn('[sync] voip queued (no handler)', event.type)
			return
		}
		for (let hi = 0; hi < this.voipHandlers.length; hi++) {
			try { this.voipHandlers[hi](event, roomId) } catch (e) { console.error('voip handler error', e) }
		}
	}

	/**
	 * 订阅 state event 变化（包括 m.room.calling / m.room.power_levels 等）
	 */
	onStateEvent(handler: (event: UTSJSONObject, roomId: string) => void): () => void {
		this.stateEventHandlers.push(handler)
		return () => {
			const idx = this.stateEventHandlers.indexOf(handler)
			if (idx >= 0) this.stateEventHandlers.splice(idx, 1)
		}
	}

	/**
	 * 拿到房间已加入的成员（从 cache 取或单次 /joined_members）
	 */
	async getJoinedMembers(roomId: string): Promise<Array<string>> {
		const cacheKey = 'joined_members:' + roomId
		const cached = this.memberCache.get(cacheKey)
		if (cached != null) {
			if (Date.now() - cached.loaded_at < 60000) {
				return cached.members
			}
		}
		const url = `/_matrix/client/v3/rooms/${encodeURIComponent(roomId)}/joined_members`
		const res = (await this.request('GET', url)) as UTSJSONObject
		const joined = jsonObj(res, 'joined')
		const members = jsonKeys(joined)
		this.memberCache.set(cacheKey, { members: members, loaded_at: Date.now() })
		return members
	}

	/**
	 * 订阅同步状态变化
	 */
	onSync(handler: (state: string, error: string) => void): () => void {
		this.syncStateHandlers.push(handler)
		return () => {
			const idx = this.syncStateHandlers.indexOf(handler)
			if (idx >= 0) this.syncStateHandlers.splice(idx, 1)
		}
	}

	onPresence(handler: (content: UTSJSONObject) => void): () => void {
		this.presenceHandlers.push(handler)
		return () => {
			const idx = this.presenceHandlers.indexOf(handler)
			if (idx >= 0) this.presenceHandlers.splice(idx, 1)
		}
	}

	/**
	 * 订阅房间邀请
	 */
	onInvite(handler: (roomId: string) => void): () => void {
		this.inviteHandlers.push(handler)
		return () => {
			const idx = this.inviteHandlers.indexOf(handler)
			if (idx >= 0) this.inviteHandlers.splice(idx, 1)
		}
	}

	parseEvent(ev: UTSJSONObject): MatrixEvent {
		const content = jsonObj(ev, 'content')
		const sender = jsonStr(ev, 'sender')
		const evType = jsonStr(ev, 'type')
		if (sender.length > 0 && evType == 'm.room.member') {
			const dn = jsonStr(content, 'displayname')
			const av = jsonStr(content, 'avatar_url')
			if (dn.length > 0) this.userDisplayNames.set(sender, dn)
			if (av.length > 0) this.userAvatars.set(sender, av)
		}
		const row: MatrixEvent = {
			type: evType,
			sender: sender,
			event_id: jsonStr(ev, 'event_id'),
			origin_server_ts: jsonNum(ev, 'origin_server_ts'),
			content: content,
			state_key: jsonStr(ev, 'state_key')
		}
		return row
	}

	cacheUserName(userId: string, displayName: string): void {
		if (userId != null && displayName != null && displayName.length > 0) {
			this.userDisplayNames.set(userId, displayName)
		}
	}

	getCachedUserName(userId: string): string {
		return this.userDisplayNames.get(userId) ?? ''
	}

	// ============================================================
	// 房间操作
	// ============================================================

	// listRooms 整列表缓存：避免重复的 N 次 /state + /messages
	listRoomsCache: RoomListCache | null = null

	async listRooms(): Promise<MatrixRoom[]> {
		// 并发去重：如果已有在飞的 listRooms，直接复用同一个 Promise
		if (this.listRoomsInflight != null) {
			console.log('[listRooms] INFLIGHT_DEDUP')
			return this.listRoomsInflight
		}
		// 整列表缓存：30 秒内复用，避免反复打 N 个 /state + N 个 /messages
		const now = Date.now()
		if (this.listRoomsCache != null && now - this.listRoomsCache.loaded_at < 30000) {
			console.log('[listRooms] CACHE_HIT')
			const cachedRooms = this.listRoomsCache.rooms
			for (let ci = 0; ci < cachedRooms.length; ci++) {
				const last = this.roomLastMessage.get(cachedRooms[ci].room_id)
				if (last == null) continue
				cachedRooms[ci].last_message_preview = last.body
				cachedRooms[ci].last_message_ts = last.ts
				cachedRooms[ci].last_message_sender = last.sender
			}
			cachedRooms.sort((a, b) => (b.last_message_ts ?? 0) - (a.last_message_ts ?? 0))
			return cachedRooms
		}
		console.log('[listRooms] called')
		// 用 inflight 去重锁：把整个 listRooms 过程打包成一个 Promise
		this.listRoomsInflight = (async () => {
			const query: UTSJSONObject = {}
			if (this.since.length > 0) query['since'] = this.since
			// 使用 /joined_rooms 拉所有已加入的房间 ID
			const data = (await this.request(
				'GET',
				'/_matrix/client/v3/joined_rooms',
				null
			)) as UTSJSONObject
			const joinedArr = jsonStrArr(data, 'joined_rooms')
			const joinedRoomIds: Array<string> = []
			for (let i = 0; i < joinedArr.length; i++) {
				const id = joinedArr[i]
				if (id != null && id.length > 0) joinedRoomIds.push(id)
			}
			this.knownRoomIds.forEach((k: string) => {
				if (joinedRoomIds.indexOf(k) < 0) joinedRoomIds.push(k)
			})
			console.log('[listRooms] joined:', joinedArr.length, 'union known:', this.knownRoomIds.size, 'final:', joinedRoomIds.length)
			const rooms: MatrixRoom[] = []
			for (let i = 0; i < joinedRoomIds.length; i++) {
				const rid = joinedRoomIds[i]
				try {
					const summary = await this.getRoomSummary(rid)
					rooms.push(summary)
				} catch (e) {
					console.warn(TAG, 'listRooms: 获取房间详情失败', rid, e)
				}
			}
			for (let li = 0; li < rooms.length; li++) {
				const last = this.roomLastMessage.get(rooms[li].room_id)
				if (last == null) continue
				rooms[li].last_message_preview = last.body
				rooms[li].last_message_ts = last.ts
				rooms[li].last_message_sender = last.sender
			}
			// 按最后消息时间倒序
			rooms.sort((a, b) => (b.last_message_ts ?? 0) - (a.last_message_ts ?? 0))
			this.listRoomsCache = { rooms, loaded_at: Date.now() }
			return rooms
		})()
		try {
			return await this.listRoomsInflight
		} finally {
			this.listRoomsInflight = null
		}
	}

	async getRoomSummary(roomId: string): Promise<MatrixRoom> {
		// 内存缓存：30 秒内复用，避免 sync 期间重复打 /state + /messages
		// 用模块级 const 变量（UTSJSONObject）+ JSON.stringify/setItem 风格的赋值
		const now = Date.now()
		// 把 roomId 当成单层 key（不含特殊字符，Matrix ID 都是安全的 !xxx:domain 形式）
		const cachedRaw = summaryCache[roomId]
		if (cachedRaw != null) {
			const cachedEntry = cachedRaw as UTSJSONObject
			const loadedAtVal = cachedEntry['loaded_at'] as number
			const loadedAt = loadedAtVal != null ? loadedAtVal : 0
			if (now - loadedAt < 30000) {
				console.log('[getRoomSummary]', roomId, 'CACHE_HIT', (now - loadedAt) + 'ms')
				const cachedRoom = cachedEntry['summary'] as MatrixRoom
				const lastHit = this.roomLastMessage.get(roomId)
				if (lastHit != null) {
					cachedRoom.last_message_preview = lastHit.body
					cachedRoom.last_message_ts = lastHit.ts
					cachedRoom.last_message_sender = lastHit.sender
				}
				return cachedRoom
			}
		}
		this.requestCount = this.requestCount + 1
		console.log('[getRoomSummary]', roomId, 'CACHE_MISS', 'total_requests=', this.requestCount)

		const state = await this.requestList(
			'GET',
			`/_matrix/client/v3/rooms/${encodeURIComponent(roomId)}/state`,
			null
		)
		const room: MatrixRoom = { room_id: roomId }
		for (let si = 0; si < state.length; si++) {
			const ev = state[si]
			const type = jsonStr(ev, 'type')
			const content = jsonObj(ev, 'content')
			if (type == 'm.room.name') {
				const n = jsonStr(content, 'name')
				if (n.length > 0) room.name = n
			} else if (type == 'm.room.topic') {
				room.topic = jsonStr(content, 'topic')
			} else if (type == 'm.room.canonical_alias') {
				room.canonical_alias = jsonStr(content, 'alias')
			} else if (type == 'm.room.avatar') {
				room.avatar_url = jsonStr(content, 'avatar_url')
			} else if (type == 'm.room.encryption') {
				room.encrypted = true
			} else if (type == 'm.room.member') {
				const sk = jsonStr(ev, 'state_key')
				if (sk.length > 0 && sk != this.userId) {
					room.other_user_id = sk
					const dn = jsonStr(content, 'displayname')
					const av = jsonStr(content, 'avatar_url')
					if (dn.length > 0) room.other_displayname = dn
					if (av.length > 0) room.other_avatar = av
				}
			}
		}

		// 私聊识别：state 中只看到 2 个不同 user（包含自己）的 event 就当作 DM
		let otherUserIds = new Set<string>()
		for (let sj = 0; sj < state.length; sj++) {
			const ev2 = state[sj]
			if (jsonStr(ev2, 'type') == 'm.room.member') {
				const sk = jsonStr(ev2, 'state_key')
				if (sk.length > 0 && sk != this.userId) otherUserIds.add(sk)
			}
		}
		const isDM = otherUserIds.size == 1

		// DM 情况下，强制用对方 displayname 覆盖
		if (isDM && room.other_user_id != null) {
			// 优先用缓存的 displayname
			const cached = this.userDisplayNames.get(room.other_user_id) ?? ''
			if (cached.length > 0) {
				room.other_displayname = cached
				room.name = cached
			} else if (room.other_displayname != null && room.other_displayname.length > 0) {
				room.name = room.other_displayname
				this.userDisplayNames.set(room.other_user_id, room.other_displayname)
			} else {
				const local = room.other_user_id.split(':')[0].replace('@', '')
				room.name = local
			}
			const cachedAv = this.userAvatars.get(room.other_user_id) ?? ''
			if (cachedAv.length > 0) {
				room.other_avatar = cachedAv
				room.avatar_url = cachedAv
			} else if (room.other_avatar != null && room.other_avatar.length > 0) {
				room.avatar_url = room.other_avatar
			}
			// DM 尝试 profile 接口补一次
			if ((room.other_displayname == null || room.other_displayname.length == 0) && room.other_user_id != null) {
				try {
					const profile = (await this.request(
						'GET',
						`/_matrix/client/v3/profile/${encodeURIComponent(room.other_user_id)}`,
						null
					)) as UTSJSONObject
					const dn = jsonStr(profile, 'displayname')
					if (dn.length > 0) {
						room.name = dn
						room.other_displayname = dn
						this.userDisplayNames.set(room.other_user_id, dn)
					}
					const av = jsonStr(profile, 'avatar_url')
					if (av.length > 0 && (room.avatar_url == null || room.avatar_url.length == 0)) {
						room.avatar_url = av
						room.other_avatar = av
						this.userAvatars.set(room.other_user_id, av)
					}
				} catch (e: any) {
					console.warn(TAG, 'getRoomSummary DM profile fallback 失败', e)
				}
			}
		} else {
			if (room.name == null || room.name.length == 0) {
				room.name = room.canonical_alias ?? roomId
			}
		}

		// 最后一条消息预览（优先用 sync 缓存，确保"暂无消息"不再误显示）
		const cachedLast = this.roomLastMessage.get(roomId)
		if (cachedLast != null) {
			room.last_message_preview = cachedLast.body
			room.last_message_ts = cachedLast.ts
		}

		// 写入缓存（30 秒内复用）
		const wrap: UTSJSONObject = {}
		wrap['summary'] = room
		wrap['loaded_at'] = Date.now()
		summaryCache[roomId] = wrap
	console.log('[getRoomSummary]', roomId, 'CACHED', 'cache_size=', jsonKeys(summaryCache).length)
	return room
	}

	// 返回当前用户处于 invited 状态的所有房间
	listInvitedRooms(): Array<InvitedRoomInfo> {
		const list: Array<InvitedRoomInfo> = []
		this.invitedRoomCache.forEach((v: InvitedRoomInfo) => {
			list.push(v)
		})
		return list
	}

	async joinRoom(roomIdOrAlias: string): Promise<RoomIdResult> {
		const data = (await this.request(
			'POST',
			`/_matrix/client/v3/join/${encodeURIComponent(roomIdOrAlias)}`,
			{}
		)) as UTSJSONObject
		// 加入成功后从邀请缓存移除
		this.invitedRoomCache.delete(roomIdOrAlias)
		return { room_id: (data['room_id'] as string) ?? roomIdOrAlias }
	}

	async createRoom(opts: CreateRoomOpts): Promise<string> {
		let preset = opts.preset
		if (preset.length == 0) preset = 'private_chat'
		const body: UTSJSONObject = {
			preset: preset,
			name: opts.name,
			topic: opts.topic
		}
		if (opts.invite.length > 0) {
			body['invite'] = opts.invite
		}
		if (opts.is_direct == true) {
			body['is_direct'] = true
		}
		const data = (await this.request(
			'POST',
			'/_matrix/client/v3/createRoom',
			body
		)) as UTSJSONObject
		return (data['room_id'] as string) ?? ''
	}

	async inviteUser(roomId: string, userId: string): Promise<void> {
		await this.request('POST', '/_matrix/client/v3/rooms/' + encodeURIComponent(roomId) + '/invite', {
			user_id: userId
		})
	}

	async leaveRoom(roomId: string): Promise<void> {
		await this.request(
			'POST',
			`/_matrix/client/v3/rooms/${encodeURIComponent(roomId)}/leave`,
			{}
		)
	}

	async startDM(targetUserId: string): Promise<string> {
		// 检查是否已有私聊房间
		const existing = await this.listRooms()
		for (const r of existing) {
			try {
				const members = await this.request('GET', `/_matrix/client/v3/rooms/${encodeURIComponent(r.room_id)}/members`, null) as UTSJSONObject
				const chunk = (members['chunk'] as Array<UTSJSONObject>) ?? []
				const userIds: Array<string> = []
				for (let i = 0; i < chunk.length; i++) {
					const sk = chunk[i]['state_key'] as string
					if (sk != null && sk.length > 0) userIds.push(sk)
				}
				if (userIds.length == 2 && userIds.includes(this.userId) && userIds.includes(targetUserId)) {
					return r.room_id
				}
			} catch (e) {}
		}
		// 没有则创建
		const dmOpts: CreateRoomOpts = {
			name: '',
			topic: '',
			preset: 'private_chat',
			invite: [targetUserId],
			is_direct: true
		}
		return await this.createRoom(dmOpts)
	}

	// ============================================================
	// 消息
	// ============================================================

	async getMessages(roomId: string, limit: number = 30, from: string = ''): Promise<MatrixMessage[]> {
		const page = await this.getMessagesPage(roomId, limit, from)
		return page.messages
	}

	/**
	 * GET /rooms/{roomId}/messages
	 * spec: dir 必填；filter.lazy_load_members 避免把整房成员塞进响应
	 */
	async getMessagesPage(roomId: string, limit: number = 30, from: string = ''): Promise<MessagesPage> {
		const filter = JSON.stringify({
			lazy_load_members: true,
			types: ['m.room.message', 'm.room.encrypted']
		})
		const query: UTSJSONObject = {
			dir: 'b',
			limit: `${limit}`,
			filter: filter
		}
		if (from.length > 0) query['from'] = from
		const data = (await this.request(
			'GET',
			`/_matrix/client/v3/rooms/${encodeURIComponent(roomId)}/messages`,
			null,
			query
		)) as UTSJSONObject
		const chunk = jsonArr(data, 'chunk')
		const msgs: MatrixMessage[] = []
		for (let i = 0; i < chunk.length; i++) {
			const ev = chunk[i]
			const evType = jsonStr(ev, 'type')
			if (evType == 'm.room.message') {
				const c = jsonObj(ev, 'content')
				const rawBody = jsonStr(c, 'body')
				const info = jsonObj(c, 'info')
				msgs.push({
					event_id: jsonStr(ev, 'event_id'),
					sender: jsonStr(ev, 'sender'),
					type: evType,
					body: unescapeMatrixBody(rawBody),
					msgtype: jsonStr(c, 'msgtype').length > 0 ? jsonStr(c, 'msgtype') : 'm.text',
					mxc: jsonStr(c, 'url'),
					mimetype: jsonStr(info, 'mimetype'),
					info: info,
					ts: jsonNum(ev, 'origin_server_ts'),
					formatted_body: jsonStr(c, 'formatted_body'),
					formatted_type: jsonStr(c, 'format')
				})
			} else if (evType == 'm.room.encrypted') {
				msgs.push({
					event_id: jsonStr(ev, 'event_id'),
					sender: jsonStr(ev, 'sender'),
					type: evType,
					body: '加密消息，当前版本无法解密',
					msgtype: 'm.encrypted',
					mxc: '',
					mimetype: '',
					info: {},
					ts: jsonNum(ev, 'origin_server_ts')
				})
			}
		}
		msgs.sort((a, b) => a.ts - b.ts)
		return {
			messages: msgs,
			end: jsonStr(data, 'end')
		}
	}

	async getCallEvents(roomId: string): Promise<Array<MatrixEvent>> {
		const out: Array<MatrixEvent> = []
		if (roomId.length == 0) return out
		const filter = JSON.stringify({
			types: ['m.call.invite', 'm.call.answer', 'm.call.hangup', 'm.call.reject', 'm.call.candidates', 'm.call.negotiate']
		})
		const query: UTSJSONObject = {
			dir: 'b',
			limit: '12',
			filter: filter
		}
		try {
			const data = (await this.request(
				'GET',
				`/_matrix/client/v3/rooms/${encodeURIComponent(roomId)}/messages`,
				null,
				query
			)) as UTSJSONObject
			const chunk = jsonArr(data, 'chunk')
			for (let i = 0; i < chunk.length; i++) {
				const ev = chunk[i]
				const evType = jsonStr(ev, 'type')
				if (evType.indexOf('m.call.') != 0) continue
				out.push(this.parseEvent(ev))
			}
		} catch (e) {}
		return out
	}

	getCachedRoomName(roomId: string): string {
		const cachedRaw = summaryCache[roomId]
		if (cachedRaw != null) {
			const cachedEntry = cachedRaw as UTSJSONObject
			const summary = cachedEntry['summary'] as MatrixRoom
			if (summary != null && summary.name != null && summary.name.length > 0) return summary.name
		}
		if (this.listRoomsCache != null) {
			const hit = this.listRoomsCache.rooms.find((r: MatrixRoom) => r.room_id == roomId)
			if (hit != null && hit.name != null && hit.name.length > 0) return hit.name
		}
		return ''
	}

	async getRoomTitle(roomId: string): Promise<string> {
		const cached = this.getCachedRoomName(roomId)
		if (cached.length > 0) return cached
		try {
			const ev = (await this.request(
				'GET',
				`/_matrix/client/v3/rooms/${encodeURIComponent(roomId)}/state/m.room.name/`,
				null
			)) as UTSJSONObject
			const n = (ev['name'] as string) ?? ''
			if (n.length > 0) return n
		} catch (e) {}
		return roomId
	}

	async sendText(roomId: string, text: string): Promise<MatrixEvent> {
		return await this.sendMessage(roomId, { msgtype: 'm.text', body: text })
	}

	async sendMessage(roomId: string, content: UTSJSONObject): Promise<MatrixEvent> {
		this.txnCounter += 1
		const txnId = `${Date.now()}_${this.txnCounter}_${Math.floor(Math.random() * 1000)}`
		const url = `/_matrix/client/v3/rooms/${encodeURIComponent(roomId)}/send/m.room.message/${txnId}`
		const data = (await this.request('PUT', url, content)) as UTSJSONObject
		const row: MatrixEvent = {
			type: 'm.room.message',
			event_id: jsonStr(data, 'event_id'),
			sender: this.userId,
			origin_server_ts: Date.now(),
			content: content
		}
		return row
	}

	async typing(roomId: string, isTyping: boolean): Promise<void> {
		if (isTyping) {
			const now = Date.now()
			if (now - this.lastTypingAt < 4000) return
			this.lastTypingAt = now
		} else {
			this.lastTypingAt = 0
		}
		try {
			this.request(
				'PUT',
				`/_matrix/client/v3/rooms/${encodeURIComponent(roomId)}/typing/${encodeURIComponent(this.userId)}`,
				{ typing: isTyping }
			)
		} catch (e) {
			// typing 失败不致命
		}
	}

	async readReceipt(roomId: string, eventId: string): Promise<void> {
		try {
			await this.request(
				'POST',
				`/_matrix/client/v3/rooms/${encodeURIComponent(roomId)}/receipt/m.read/${encodeURIComponent(eventId)}`,
				{}
			)
		} catch (e) {
			// 忽略
		}
	}

	// ============================================================
	// 工具
	// ============================================================

	async sleep(ms: number): Promise<void> {
		return new Promise(resolve => {
			setTimeout(() => resolve(), ms)
		})
	}

	mxcToHttp(mxc: string, width: number = 96, height: number = 96): string {
		if (mxc == null || mxc.length == 0) return ''
		if (mxc.startsWith('http://') || mxc.startsWith('https://')) return mxc
		// mxc://server.name/mediaid
		const withoutScheme = mxc.replace('mxc://', '')
		const parts = withoutScheme.split('/')
		if (parts.length < 2) return ''
		const server = parts[0]
		const mediaId = parts.slice(1).join('/')
		// itiklink 的媒体存储在 /_matrix/client/v1/media/download（thumbnail 端点报 400）
		return `${this.homeserver}/_matrix/client/v1/media/download/${server}/${mediaId}`
	}

	// ============================================================
	// 媒体上传（图片 / 文件 / 音频）
	// ============================================================

	async uploadMedia(localPath: string, mimeType: string, fileName: string): Promise<string> {
		const fileName2 = (fileName.length > 0) ? fileName : 'file'
		const uploadUrl = this.homeserver.replace(/\/$/, '') + '/_matrix/media/v3/upload?filename=' + encodeURIComponent(fileName2)

		// #ifdef H5
		// H5：blob URL → fetch 直接上传二进制（不要用 FormData，itiklink 需直传）
		const resp = await fetch(localPath)
		if (!resp.ok) throw new Error('fetch 文件失败 ' + resp.status)
		const blob = await resp.blob()
		const h5Res = await fetch(uploadUrl, {
			method: 'POST',
			headers: {
				'Authorization': 'Bearer ' + this.accessToken,
				'Content-Type': 'application/octet-stream'
			},
			body: blob
		} as any)
		if (!h5Res.ok) {
			const text = await h5Res.text()
			throw new Error('上传失败 ' + h5Res.status + ' ' + h5Res.statusText + ' | ' + text)
		}
		const h5Json = await h5Res.json() as UTSJSONObject
		return (h5Json['content_uri'] as string) ?? ''
		// #endif

		// #ifndef H5
		// Matrix 媒体接口要原始字节。uni.uploadFile 是 multipart，
		// 再覆盖 Content-Type 会丢掉 boundary，homeserver 直接 415。
		return await httpRawUpload(uploadUrl, this.accessToken, localPath)
		// #endif
	}

	// 直接发送 mxc（已上传后的 content_uri）
	async sendImage(roomId: string, mxc: string, mimeType: string, width: number, height: number, sizeBytes: number): Promise<MatrixMessage> {
		const txnId = Date.now().toString() + Math.floor(Math.random() * 10000).toString()
		const content: UTSJSONObject = {
			msgtype: 'm.image',
			body: '图片',
			url: mxc,
			info: {
				mimetype: mimeType,
				w: width,
				h: height,
				size: sizeBytes
			}
		}
		return await this.sendRawEvent(roomId, 'm.room.message', content, txnId)
	}

	async sendFile(roomId: string, mxc: string, mimeType: string, sizeBytes: number, fileName: string): Promise<MatrixMessage> {
		const txnId = Date.now().toString() + Math.floor(Math.random() * 10000).toString()
		const content: UTSJSONObject = {
			msgtype: 'm.file',
			body: fileName,
			filename: fileName,
			url: mxc,
			info: {
				mimetype: mimeType,
				size: sizeBytes
			}
		}
		return await this.sendRawEvent(roomId, 'm.room.message', content, txnId)
	}

	async sendAudio(roomId: string, mxc: string, mimeType: string, duration: number): Promise<MatrixMessage> {
		const txnId = Date.now().toString() + Math.floor(Math.random() * 10000).toString()
		const durMs = duration > 1000 ? duration : duration * 1000
		const voiceFlag: UTSJSONObject = {}
		const audioMeta: UTSJSONObject = {}
		audioMeta['duration'] = durMs
		const fileMeta: UTSJSONObject = {}
		fileMeta['url'] = mxc
		fileMeta['mimetype'] = mimeType
		const info: UTSJSONObject = {}
		info['mimetype'] = mimeType
		info['duration'] = durMs
		info['org.matrix.msc1767.audio'] = audioMeta
		const content: UTSJSONObject = {}
		content['msgtype'] = 'm.audio'
		content['body'] = '语音'
		content['url'] = mxc
		content['info'] = info
		content['org.matrix.msc3245.voice'] = voiceFlag
		content['org.matrix.msc1767.audio'] = audioMeta
		content['org.matrix.msc1767.file'] = fileMeta
		return await this.sendRawEvent(roomId, 'm.room.message', content, txnId)
	}

	async sendLocation(roomId: string, lat: number, lon: number, label: string): Promise<MatrixMessage> {
		const txnId = Date.now().toString() + Math.floor(Math.random() * 10000).toString()
		const content: UTSJSONObject = {
			msgtype: 'm.location',
			body: label,
			geo_uri: 'geo:' + lat + ',' + lon,
			'org.matrix.msc3488.location': {
				uri: 'geo:' + lat + ',' + lon,
				description: label
			}
		}
		return await this.sendRawEvent(roomId, 'm.room.message', content, txnId)
	}

	// ============================================================
	// 通用 raw event 发送（编辑/回复/反应都靠这个）
	// ============================================================

	async sendRawEvent(roomId: string, eventType: string, content: UTSJSONObject, txnId: string = ''): Promise<MatrixMessage> {
		let tid = txnId
		if (tid.length == 0) tid = this.genTxnId()
		const url = `/_matrix/client/v3/rooms/${encodeURIComponent(roomId)}/send/${encodeURIComponent(eventType)}/${tid}`
		const data = (await this.request('PUT', url, content)) as UTSJSONObject
		const mid: MatrixMessage = {
			event_id: jsonStr(data, 'event_id'),
			sender: this.userId,
			type: eventType,
			body: jsonStr(content, 'body'),
			msgtype: jsonStr(content, 'msgtype'),
			ts: Date.now()
		}
		return mid
	}

	// ============================================================
	// 消息编辑 / 撤回 / 反应 / 回复
	// ============================================================

	async editMessage(roomId: string, originalEventId: string, newContent: UTSJSONObject): Promise<MatrixMessage> {
		const content: UTSJSONObject = {}
		const msgtype = newContent['msgtype'] as string
		const body = newContent['body'] as string
		if (msgtype != null) content['msgtype'] = msgtype
		if (body != null) content['body'] = body
		content['m.new_content'] = newContent
		const rel: UTSJSONObject = {}
		rel['rel_type'] = 'm.replace'
		rel['event_id'] = originalEventId
		content['m.relates_to'] = rel
		return await this.sendRawEvent(roomId, 'm.room.message', content, this.genTxnId())
	}

	async redactEvent(roomId: string, eventId: string, reason: string): Promise<void> {
		const content: UTSJSONObject = {}
		if (reason != null && reason.length > 0) content['reason'] = reason
		const tid = Date.now().toString() + Math.floor(Math.random() * 10000).toString()
		await this.request(
			'PUT',
			`/_matrix/client/v3/rooms/${encodeURIComponent(roomId)}/redact/${encodeURIComponent(eventId)}/${tid}`,
			content
		)
	}

	async sendReaction(roomId: string, eventId: string, emoji: string): Promise<void> {
		const content: UTSJSONObject = {
			'm.relates_to': {
				rel_type: 'm.annotation',
				event_id: eventId,
				key: emoji
			}
		}
		await this.sendRawEvent(roomId, 'm.reaction', content, this.genTxnId())
	}

	async sendReply(roomId: string, replyToEventId: string, text: string): Promise<MatrixMessage> {
		const content: UTSJSONObject = {
			msgtype: 'm.text',
			body: text,
			'm.relates_to': {
				'm.in_reply_to': {
					event_id: replyToEventId
				}
			}
		}
		return await this.sendRawEvent(roomId, 'm.room.message', content, this.genTxnId())
	}

	// ============================================================
	// 房间成员 / 头像 / 状态
	// ============================================================

	async getRoomMembers(roomId: string): Promise<RoomMember[]> {
		const data = (await this.request(
			'GET',
			`/_matrix/client/v3/rooms/${encodeURIComponent(roomId)}/members?not_membership=leave`,
			null
		)) as UTSJSONObject
		const chunk = (data['chunk'] as Array<UTSJSONObject>) ?? []
		const result: RoomMember[] = []
		for (let i = 0; i < chunk.length; i++) {
			const m = chunk[i]
			const content = (m['content'] as UTSJSONObject) ?? {}
			const item: RoomMember = {
				user_id: (m['state_key'] as string) ?? '',
				membership: (content['membership'] as string) ?? 'join',
				display_name: content['displayname'] as string,
				avatar_url: content['avatar_url'] as string
			}
			result.push(item)
		}
		return result
	}

