	// ============================================================
	// 关系集合（拉 reactions / 编辑历史）
	// ============================================================

	async getRelations(roomId: string, eventId: string, relType: string, eventType: string): Promise<UTSJSONObject> {
		let url = `/_matrix/client/v3/rooms/${encodeURIComponent(roomId)}/relations/${encodeURIComponent(eventId)}/${encodeURIComponent(relType)}`
		if (eventType.length > 0) {
			url += `/${encodeURIComponent(eventType)}`
		}
		return await this.request('GET', url, null)
	}

	/**
	 * 搜索消息（关键词 + 可选房间范围）
	 * @param searchTerm 关键词
	 * @param roomIds 可选：在指定房间内搜索；空数组 = 全局
	 * @param limit 每页条数（默认 20）
	 * @param nextBatch 翻页 token（上一页返回的 next_batch）
	 */
	async searchMessages(
		searchTerm: string,
		roomIds: Array<string> = [],
		limit: number = 20,
		nextBatch: string = ''
	): Promise<SearchResult> {
		const filter: UTSJSONObject = { limit: limit }
		if (roomIds.length > 0) {
			filter['rooms'] = roomIds
		}
		const roomEvents: UTSJSONObject = {
			search_term: searchTerm,
			filter: filter,
			order_by: 'recent',
			groupings: { room_id: {} }
		}
		if (nextBatch.length > 0) {
			roomEvents['next_batch'] = nextBatch
		}
		const body: UTSJSONObject = {
			search_categories: {
				room_events: roomEvents
			}
		}
		const data = (await this.request('POST', '/_matrix/client/v3/search', body)) as UTSJSONObject
		// 解析结果（只取第一组 group 简化结构）
		const categories = data['search_categories'] as UTSJSONObject ?? {}
		const events = categories['room_events'] as UTSJSONObject ?? {}
		const rawResults = (events['results'] as Array<UTSJSONObject>) ?? []
		const results: Array<SearchHit> = []
		for (let i = 0; i < rawResults.length; i++) {
			const r = rawResults[i]
			const result = (r['result'] as UTSJSONObject) ?? {}
			const ev = (result['event'] as UTSJSONObject) ?? {}
			const content = (ev['content'] as UTSJSONObject) ?? {}
			const hl = r['highlights'] as Array<string> | null
			const hit: SearchHit = {
				event_id: (ev['event_id'] as string) ?? '',
				room_id: (result['room_id'] as string) ?? '',
				sender: (ev['sender'] as string) ?? '',
				type: (ev['type'] as string) ?? '',
				body: (content['body'] as string) ?? '',
				ts: (ev['origin_server_ts'] as number) ?? 0,
				highlight: (hl != null) ? hl : ([] as Array<string>),
				context: (r['context'] as UTSJSONObject) ?? ({} as UTSJSONObject)
			}
			results.push(hit)
		}
		const groups = events['groups'] as UTSJSONObject ?? {}
		const roomGroup = groups['room_id'] as UTSJSONObject ?? {}
		const count = (roomGroup['count'] as number) ?? results.length
		return {
			results: results,
			count: count,
			highlights: (events['highlights'] as Array<string>) ?? ([] as Array<string>),
			next_batch: (events['next_batch'] as string) ?? ''
		}
	}

