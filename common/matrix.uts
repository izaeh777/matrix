const TAG = 'MatrixClient'

function jsonBodyText(raw: any | null): string {
	if (raw == null) return ''
	let text = ''
	try {
		const s = JSON.stringify(raw)
		if (s != null) text = s.trim()
	} catch (e) {
		text = ''
	}
	if (text.length == 0) return ''
	const c0 = text.charAt(0)
	if (c0 == '{' || c0 == '[') return text
	if (c0 == '"') {
		try {
			const inner = JSON.parse(text)
			if (inner == null) return ''
			const innerText = ('' + inner).trim()
			const i0 = innerText.charAt(0)
			if (i0 == '{' || i0 == '[') return innerText
		} catch (e2) {
			return ''
		}
	}
	return ''
}

function toJsonObj(raw: any | null): UTSJSONObject {
	const empty: UTSJSONObject = {}
	const text = jsonBodyText(raw)
	if (text.length == 0) return empty
	if (text.charAt(0) != '{') return empty
	try {
		return JSON.parse(text) as UTSJSONObject
	} catch (e3) {
		return empty
	}
}

function toJsonList(raw: any | null): Array<UTSJSONObject> {
	const out: Array<UTSJSONObject> = []
	const text = jsonBodyText(raw)
	if (text.length == 0) return out
	if (text.charAt(0) != '[') return out
	try {
		const arr = JSON.parse(text) as Array<any>
		if (arr == null) return out
		for (let i = 0; i < arr.length; i++) {
			out.push(toJsonObj(arr[i]))
		}
	} catch (e3) {
		return out
	}
	return out
}

type HttpResult = {
	statusCode: number
	json: UTSJSONObject
	list: Array<UTSJSONObject>
}

function clampHttpTimeout(timeoutMs: number): number {
	// uni-app x Android：超过 60s 常被当成非法值，请求会立刻 request:fail timeout
	if (timeoutMs < 8000) return 8000
	if (timeoutMs > 60000) return 60000
	return timeoutMs
}

function isRequestTimeout(msg: string): boolean {
	return msg.indexOf('timeout') >= 0 || msg.indexOf('TIMEOUT') >= 0
}

function httpRawUpload(url: string, token: string, filePath: string): Promise<string> {
	return new Promise((resolve, reject) => {
		let path = filePath
		if (path.indexOf('file://') == 0) {
			path = path.substring(7)
		}
		const header: UTSJSONObject = {
			'Authorization': 'Bearer ' + token,
			'Content-Type': 'application/octet-stream'
		}
		const fs = uni.getFileSystemManager()
		fs.readFile({
			filePath: path,
			success: (rf) => {
				uni.request({
					url: url,
					method: 'POST',
					header: header,
					data: rf.data,
					sslVerify: false,
					timeout: 60000,
					success: (up: RequestSuccess<any>) => {
						let code = 0
						try {
							code = up.statusCode
						} catch (e0) {
							code = 0
						}
						if (code < 200 || code >= 300) {
							reject(new Error('上传失败 ' + code))
							return
						}
						try {
							const resBody = toJsonObj(up.data)
							const uri = jsonStr(resBody, 'content_uri')
							if (uri.length == 0) {
								reject(new Error('上传失败 无 content_uri'))
								return
							}
							resolve(uri)
						} catch (e1) {
							reject(new Error('上传失败 解析响应'))
						}
					},
					fail: (err: RequestFail) => {
						reject(new Error(err.errMsg))
					}
				})
			},
			fail: (_err) => {
				reject(new Error('读取文件失败'))
			}
		})
	})
}

function httpJson(url: string, method: string, header: UTSJSONObject, body: UTSJSONObject, timeoutMs: number): Promise<HttpResult> {
	const waitMs = clampHttpTimeout(timeoutMs)
	return new Promise((resolve, reject) => {
		const onOk = (res: RequestSuccess<any>) => {
			try {
				let code = 0
				try {
					code = res.statusCode
				} catch (e0) {
					code = 0
				}
				let text = ''
				try {
					text = jsonBodyText(res.data)
				} catch (e1) {
					text = ''
				}
				const emptyObj: UTSJSONObject = {}
				const emptyList: Array<UTSJSONObject> = []
				const row: HttpResult = {
					statusCode: code,
					json: (text.length > 0 && text.charAt(0) == '{') ? toJsonObj(res.data) : emptyObj,
					list: (text.length > 0 && text.charAt(0) == '[') ? toJsonList(res.data) : emptyList
				}
				resolve(row)
			} catch (e2) {
				reject(new Error('解析响应失败'))
			}
		}
		const onBad = (err: RequestFail) => {
			reject(new Error(err.errMsg))
		}
		if (method == 'GET') {
			// GET 不要带 data，否则部分 App 端会再拼一次 query，长轮询更容易超时
			uni.request({
				url: url,
				method: 'GET',
				header: header,
				sslVerify: false,
				timeout: waitMs,
				success: onOk,
				fail: onBad
			})
		} else if (method == 'PUT') {
			uni.request({
				url: url,
				method: 'PUT',
				header: header,
				data: body,
				sslVerify: false,
				timeout: waitMs,
				success: onOk,
				fail: onBad
			})
		} else if (method == 'DELETE') {
			uni.request({
				url: url,
				method: 'DELETE',
				header: header,
				data: body,
				sslVerify: false,
				timeout: waitMs,
				success: onOk,
				fail: onBad
			})
		} else {
			uni.request({
				url: url,
				method: 'POST',
				header: header,
				data: body,
				sslVerify: false,
				timeout: waitMs,
				success: onOk,
				fail: onBad
			})
		}
	})
}

function jsonKeys(obj: UTSJSONObject): Array<string> {
	const out: Array<string> = []
	const m = obj.toMap()
	m.forEach((_v: any | null, k: string) => {
		out.push(k)
	})
	return out
}

function jsonStr(obj: UTSJSONObject, key: string): string {
	const v = obj.getString(key)
	if (v == null) return ''
	return v
}

function jsonNum(obj: UTSJSONObject, key: string): number {
	const v = obj.getNumber(key)
	if (v == null) return 0
	return v
}

function jsonBool(obj: UTSJSONObject, key: string): boolean {
	const v = obj.getBoolean(key)
	if (v == null) return false
	return v
}

function jsonArr(obj: UTSJSONObject, key: string): Array<UTSJSONObject> {
	const raw = obj.getArray(key)
	const out: Array<UTSJSONObject> = []
	if (raw == null) return out
	for (let i = 0; i < raw.length; i++) {
		out.push(toJsonObj(raw[i]))
	}
	return out
}

function jsonStrArr(obj: UTSJSONObject, key: string): Array<string> {
	const raw = obj.getArray(key)
	const out: Array<string> = []
	if (raw == null) return out
	for (let i = 0; i < raw.length; i++) {
		const one = raw[i]
		if (one == null) continue
		const s = '' + one
		if (s.length > 0 && s != 'null') out.push(s)
	}
	return out
}

function jsonObj(obj: UTSJSONObject, key: string): UTSJSONObject {
	const nested = obj.getJSON(key)
	if (nested == null) return {}
	return nested
}

function queryString(query: UTSJSONObject): string {
	const names: Array<string> = ['timeout', 'since', 'from', 'dir', 'limit', 'filter', 'not_membership']
	const parts: Array<string> = []
	for (let i = 0; i < names.length; i++) {
		const key = names[i]
		const val = query[key]
		if (val != null) {
			parts.push(encodeURIComponent(key) + '=' + encodeURIComponent(`${val}`))
		}
	}
	return parts.join('&')
}

