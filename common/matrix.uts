// 模块级（文件级）变量：getRoomSummary 缓存
// 避开 class field (Array/Map/Object) 在 UTS H5 上的索引不稳定问题
// 结构：{ [roomId: string]: { summary: MatrixRoom, loaded_at: number } }
const summaryCache: UTSJSONObject = {}

export type PublicRoom = {
	room_id: string
	canonical_alias: string
	name: string
	topic: string
	avatar_url: string
