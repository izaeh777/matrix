/**
 * 平台认证（itiklink /api/v1/auth）
 * 鉴权头: token: <access_token>
 */

const API_HOST = 'https://m.itiklink.com'
const KEY_PLATFORM = 'platform_session_v1'

function isH5DevHost(host: string): boolean {
	if (host == 'localhost' || host == '127.0.0.1' || host == '[::1]' || host == '::1') return true
	if (host.endsWith('.localhost')) return true
	if (host.startsWith('192.168.') || host.startsWith('10.')) return true
	if (host.startsWith('172.')) {
		const parts = host.split('.')
		if (parts.length > 1) {
			const n = parseInt(parts[1])
			if (n >= 16 && n <= 31) return true
		}
	}
	return false
}

function apiBase(): string {
	// #ifdef H5
	try {
		const loc = (window as any).location
		if (loc != null && isH5DevHost('' + loc.hostname)) return ''
	} catch (e0) {}
	// #endif
	return API_HOST
}

export type PlatformSession = {
	token: string
	email: string
	nickname: string
	user_id: string
	matrix_user_id: string
	matrix_token: string
	matrix_homeserver: string
}

function pickStr(obj: UTSJSONObject, key: string): string {
	try {
		const v = obj[key]
		if (v != null) {
			const s = '' + v
			if (s.length > 0 && s != 'null' && s != 'undefined' && s != '[object Object]') return s
		}
	} catch (e0) {}
	try {
		const s2 = obj.getString(key)
		if (s2 != null && s2.length > 0 && s2 != 'null') return s2
	} catch (e1) {}
	return ''
}

function pickNum(obj: UTSJSONObject, key: string): number {
	try {
		const n = obj.getNumber(key)
		if (n != null) return n
	} catch (e0) {}
	try {
		const raw = obj[key]
		if (raw == null) return 0
		const n = parseFloat('' + raw)
		if (n == n) return n
	} catch (e1) {}
	return 0
}

export function savePlatformSession(session: PlatformSession): void {
	try {
		uni.setStorageSync(KEY_PLATFORM, JSON.stringify(session))
	} catch (e) {
		console.error('savePlatformSession fail', e)
	}
}

export function loadPlatformSession(): PlatformSession | null {
	try {
		const raw = uni.getStorageSync(KEY_PLATFORM)
		if (raw == null) return null
		const text = ('' + raw).trim()
		if (text.length == 0 || text.charAt(0) != '{') return null
		const obj = JSON.parse(text) as UTSJSONObject
		const token = pickStr(obj, 'token')
		if (token.length == 0) return null
		const s: PlatformSession = {
			token: token,
			email: pickStr(obj, 'email'),
			nickname: pickStr(obj, 'nickname'),
			user_id: pickStr(obj, 'user_id'),
			matrix_user_id: pickStr(obj, 'matrix_user_id'),
			matrix_token: pickStr(obj, 'matrix_token'),
			matrix_homeserver: pickStr(obj, 'matrix_homeserver')
		}
		return s
	} catch (e) {
		return null
	}
}

export function clearPlatformSession(): void {
	try {
		uni.removeStorageSync(KEY_PLATFORM)
	} catch (e) {}
}

export function platformToken(): string {
	const s = loadPlatformSession()
	if (s == null) return ''
	return s.token
}

function httpPostJson(path: string, body: UTSJSONObject, withAuth: boolean): Promise<UTSJSONObject> {
	const url = apiBase() + path
	const header: UTSJSONObject = {
		'Content-Type': 'application/json'
	}
	if (withAuth) {
		const t = platformToken()
		if (t.length > 0) header['token'] = t
	}
	return new Promise((resolve, reject) => {
		uni.request({
			url: url,
			method: 'POST',
			timeout: 20000,
			header: header,
			data: body,
			success: (res) => {
				try {
					const code = res.statusCode
					if (code < 200 || code >= 300) {
						reject(new Error('HTTP_' + code))
						return
					}
					const data = res.data as UTSJSONObject
					if (data == null) {
						reject(new Error('empty'))
						return
					}
					resolve(data)
				} catch (e) {
					reject(new Error('parse fail'))
				}
			},
			fail: (err) => {
				reject(new Error(err.errMsg))
			}
		})
	})
}

function httpPostForm(path: string, fields: UTSJSONObject, withAuth: boolean): Promise<UTSJSONObject> {
	const url = apiBase() + path
	const header: UTSJSONObject = {
		'Content-Type': 'application/x-www-form-urlencoded'
	}
	if (withAuth) {
		const t = platformToken()
		if (t.length > 0) header['token'] = t
	}
	return new Promise((resolve, reject) => {
		uni.request({
			url: url,
			method: 'POST',
			timeout: 20000,
			header: header,
			data: fields,
			success: (res) => {
				try {
					const code = res.statusCode
					if (code < 200 || code >= 300) {
						reject(new Error('HTTP_' + code))
						return
					}
					const data = res.data as UTSJSONObject
					if (data == null) {
						reject(new Error('empty'))
						return
					}
					resolve(data)
				} catch (e) {
					reject(new Error('parse fail'))
				}
			},
			fail: (err) => {
				reject(new Error(err.errMsg))
			}
		})
	})
}

function assertOk(root: UTSJSONObject, fallback: string): UTSJSONObject {
	const code = pickNum(root, 'code')
	if (code != 1) {
		const msg = pickStr(root, 'msg')
		throw new Error(msg.length > 0 ? msg : fallback)
	}
	const data = root['data'] as UTSJSONObject
	if (data == null) {
		const empty: UTSJSONObject = {}
		return empty
	}
	return data
}

function parseSession(data: UTSJSONObject, emailFallback: string): PlatformSession {
	let token = pickStr(data, 'token')
	if (token.length == 0) token = pickStr(data, 'access_token')
	if (token.length == 0) {
		const user = data['user'] as UTSJSONObject
		if (user != null) {
			token = pickStr(user, 'token')
			if (token.length == 0) token = pickStr(user, 'access_token')
		}
	}
	if (token.length == 0) throw new Error('登录成功但未返回 token')

	let email = pickStr(data, 'email')
	let nickname = pickStr(data, 'nickname')
	if (nickname.length == 0) nickname = pickStr(data, 'username')
	if (nickname.length == 0) nickname = pickStr(data, 'name')
	let userId = pickStr(data, 'user_id')
	if (userId.length == 0) {
		const idNum = pickNum(data, 'id')
		if (idNum > 0) userId = '' + idNum
	}
	const userObj = data['user'] as UTSJSONObject
	if (userObj != null) {
		if (email.length == 0) email = pickStr(userObj, 'email')
		if (nickname.length == 0) {
			nickname = pickStr(userObj, 'nickname')
			if (nickname.length == 0) nickname = pickStr(userObj, 'username')
		}
		if (userId.length == 0) {
			userId = pickStr(userObj, 'id')
			if (userId.length == 0) {
				const n = pickNum(userObj, 'id')
				if (n > 0) userId = '' + n
			}
		}
	}
	if (email.length == 0) email = emailFallback

	// matrix 子对象：聊天（Matrix）凭证
	let matrixUserId = ''
	let matrixToken = ''
	let matrixHomeserver = ''
	const mx = data['matrix'] as UTSJSONObject
	if (mx != null) {
		matrixUserId = pickStr(mx, 'user_id')
		matrixToken = pickStr(mx, 'access_token')
		// base_url 带 https 前缀，直接可用作 homeserver
		matrixHomeserver = pickStr(mx, 'base_url')
		if (matrixHomeserver.length == 0) matrixHomeserver = pickStr(mx, 'home_server')
	}

	const out: PlatformSession = {
		token: token,
		email: email,
		nickname: nickname,
		user_id: userId,
		matrix_user_id: matrixUserId,
		matrix_token: matrixToken,
		matrix_homeserver: matrixHomeserver
	}
	return out
}

/** 发送邮箱验证码 event=register|login|resetpwd */
export async function sendEmailCode(email: string, event: string): Promise<void> {
	const fields: UTSJSONObject = {
		email: email,
		event: event
	}
	const root = await httpPostForm('/api/v1/auth/email/send-code', fields, false)
	assertOk(root, '验证码发送失败')
}

/** 邮箱验证码登录 */
export async function emailLogin(email: string, code: string): Promise<PlatformSession> {
	const fields: UTSJSONObject = {
		email: email,
		code: code
	}
	const root = await httpPostForm('/api/v1/auth/email/login', fields, false)
	const data = assertOk(root, '登录失败')
	const session = parseSession(data, email)
	savePlatformSession(session)
	return session
}

/** 邮箱注册 */
export async function emailRegister(email: string, code: string, password: string, nickname: string): Promise<PlatformSession> {
	const fields: UTSJSONObject = {
		email: email,
		code: code,
		password: password,
		nickname: nickname
	}
	const root = await httpPostForm('/api/v1/auth/email/register', fields, false)
	const data = assertOk(root, '注册失败')
	// 注册成功后可能不带 token，再走一次登录
	let token = pickStr(data, 'token')
	if (token.length == 0) token = pickStr(data, 'access_token')
	if (token.length > 0) {
		const session = parseSession(data, email)
		savePlatformSession(session)
		return session
	}
	return await emailLogin(email, code)
}

export async function platformLogout(): Promise<void> {
	try {
		const fields: UTSJSONObject = {}
		await httpPostForm('/api/v1/auth/logout', fields, true)
	} catch (e) {}
	clearPlatformSession()
}

export type WalletChallenge = {
	message: string
	nonce: string
}

/** Step1: 获取 SIWE Challenge（EIP-4361） */
export async function walletChallenge(address: string): Promise<WalletChallenge> {
	const body: UTSJSONObject = {
		address: address
	}
	const root = await httpPostJson('/api/v1/auth/wallet/challenge', body, false)
	const data = assertOk(root, '获取钱包挑战失败')
	const message = pickStr(data, 'message')
	const nonce = pickStr(data, 'nonce')
	if (message.length == 0) throw new Error('挑战消息为空')
	const out: WalletChallenge = {
		message: message,
		nonce: nonce
	}
	return out
}

/**
 * Step3: 校验签名并登录/注册
 * 对接: POST /api/v1/auth/wallet/verify
 */
export async function walletVerify(address: string, signature: string, inviteCode: string = ''): Promise<PlatformSession> {
	const body: UTSJSONObject = {
		address: address,
		signature: signature
	}
	const inv = inviteCode.trim()
	if (inv.length > 0) body['invite_code'] = inv
	const root = await httpPostJson('/api/v1/auth/wallet/verify', body, false)
	const data = assertOk(root, '钱包登录失败')
	const session = parseSession(data, address)
	savePlatformSession(session)
	return session
}

/** 平台查找好友（username 精准匹配） */
export type FindFriendItem = {
	id: string
	username: string
	nickname: string
	imUser: string
}

function parseFindFriendItem(obj: UTSJSONObject): FindFriendItem | null {
	const imUser = pickStr(obj, 'imUser')
	if (imUser.length == 0) return null
	let id = pickStr(obj, 'id')
	if (id.length == 0) {
		const n = pickNum(obj, 'id')
		if (n > 0) id = '' + n
	}
	const username = pickStr(obj, 'username')
	const nickname = pickStr(obj, 'nickname')
	const item: FindFriendItem = {
		id: id,
		username: username,
		nickname: nickname,
		imUser: imUser
	}
	return item
}

function dataObjectKeys(obj: UTSJSONObject): Array<string> {
	const out: Array<string> = [] as string[]
	try {
		const text = JSON.stringify(obj)
		if (text != null && text.charAt(0) == '{') {
			const parsed = JSON.parse(text)
			const ks = Object.keys(parsed)
			for (let i = 0; i < ks.length; i++) out.push(ks[i])
		}
	} catch (e0) {}
	return out
}

export async function findFriendByUsername(username: string): Promise<Array<FindFriendItem>> {
	const name = username.trim()
	if (name.length == 0) return [] as FindFriendItem[]
	const fields: UTSJSONObject = {
		username: name
	}
	const root = await httpPostForm('/api/v1/users/find-fri', fields, true)
	const data = assertOk(root, '查找好友失败')
	const out: Array<FindFriendItem> = [] as FindFriendItem[]

	// data 可能是数组 [{...}] 或对象 { "146": {...} }
	try {
		const text = JSON.stringify(data)
		if (text != null && text.charAt(0) == '[') {
			const arr = JSON.parse(text) as Array<UTSJSONObject>
			if (arr != null) {
				for (let i = 0; i < arr.length; i++) {
					const row = arr[i] as UTSJSONObject
					if (row == null) continue
					const item = parseFindFriendItem(row)
					if (item != null) out.push(item)
				}
				return out
			}
		}
	} catch (eArr) {}

	const keys = dataObjectKeys(data)
	for (let ki = 0; ki < keys.length; ki++) {
		const key = keys[ki]
		const row = data[key] as UTSJSONObject
		if (row == null) continue
		const item = parseFindFriendItem(row)
		if (item != null) out.push(item)
	}
	return out
}
