/**
 * 全局 Matrix 通话
 * 任意页面都可响铃；H5 使用 WebRTC，信令走 m.call.*
 */
import { getMatrix, MatrixEvent, setVoipSink } from './matrix.uts'
import { tuneCallWebView, pullCallHtmlMsg, destroyCallEngine } from './call-webview.uts'

export type CallSnapshot = {
	phase: string
	roomId: string
	callId: string
	peerName: string
	isVideo: boolean
	isIncoming: boolean
	sub: string
	muted: boolean
	cameraOff: boolean
}

type PageRef = {
	route: string
}

type CallListener = (s: CallSnapshot) => void

function localPart(userId: string): string {
	if (userId.length == 0) return '对方'
	return userId.split(':')[0].replace('@', '')
}

function webrtcReady(): boolean {
	// #ifdef H5
	try {
		const w = window as any
		if (w == null) return false
		if (typeof w.RTCPeerConnection != 'function') return false
		if (w.navigator == null) return false
		if (w.navigator.mediaDevices == null) return false
		return true
	} catch (e) {
		return false
	}
	// #endif
	return true
}

function fieldStr(obj: UTSJSONObject, key: string): string {
	const s = obj.getString(key)
	if (s != null && s.length > 0) return s
	const v = obj[key]
	if (v != null) {
		const t = '' + v
		if (t.length > 0 && t != 'null' && t != 'undefined' && t != '[object Object]') return t
	}
	try {
		const m = obj.toMap()
		let found = ''
		m.forEach((val: any | null, k: string) => {
			if (k == key && val != null) {
				const t2 = '' + val
				if (t2.length > 0 && t2 != 'null' && t2 != '[object Object]') found = t2
			}
		})
		if (found.length > 0) return found
	} catch (e) {}
	return ''
}

function makePartyId(): string {
	const n = Date.now().toString()
	const r = Math.floor(Math.random() * 1000000).toString()
	return 'p' + n + r
}

function formatCallDur(sec: number): string {
	let s = sec
	if (s < 0) s = 0
	const m = Math.floor(s / 60)
	const r = s - m * 60
	const mm = (m < 10 ? '0' : '') + m.toString()
	const ss = (r < 10 ? '0' : '') + r.toString()
	return mm + ':' + ss
}

export class CallManager {
	phase: string = 'idle'
	roomId: string = ''
	callId: string = ''
	peerName: string = ''
	isVideo: boolean = false
	isIncoming: boolean = false
	sub: string = ''
	muted: boolean = false
	cameraOff: boolean = false
	partyId: string = 'p' + Date.now().toString()

	listeners: Array<CallListener> = []
	bound: boolean = false
	boundToken: string = ''
	offTimeline: (() => void) | null = null

	rtcPc: any | null = null
	localStream: any | null = null
	pendingRemoteSdp: string = ''
	pendingIce: Array<UTSJSONObject> = []
	remoteDescReady: boolean = false
	timer: number | null = null
	navigating: boolean = false
	pageOpen: boolean = false
	leaving: boolean = false
	htmlEval: ((js: string) => void) | null = null
	htmlReady: boolean = false
	htmlLoaded: boolean = false
	offerSent: boolean = false
	offerStarted: boolean = false
	answerStarted: boolean = false
	answerSent: boolean = false
	htmlPollN: number = 0
	lastHangAt: number = 0
	inviteeId: string = ''
	peerUserId: string = ''
	streamId: string = 'usermedia'
	htmlBoot: string = ''
	turnIce: string = '[{"urls":"stun:stun.l.google.com:19302"}]'
	turnBusy: boolean = false
	invitePosted: boolean = false
	connectedAt: number = 0
	initiatorId: string = ''
	outgoingReady: boolean = false
	lastInvite: UTSJSONObject | null = null
	leaveGen: number = 0
	signalTimer: number | null = null
	signalBusy: boolean = false
	seenVoip: Array<string> = []

	getSnapshot(): CallSnapshot {
		return {
			phase: this.phase,
			roomId: this.roomId,
			callId: this.callId,
			peerName: this.peerName,
			isVideo: this.isVideo,
			isIncoming: this.isIncoming,
			sub: this.sub,
			muted: this.muted,
			cameraOff: this.cameraOff
		}
	}

	onChange(fn: CallListener): () => void {
		this.listeners.push(fn)
		return () => {
			const i = this.listeners.indexOf(fn)
			if (i >= 0) this.listeners.splice(i, 1)
		}
	}

	noteConnected(): void {
		if (this.connectedAt == 0) this.connectedAt = Date.now()
		this.phase = 'connected'
		this.sub = this.isVideo ? '视频通话中' : '语音通话中'
	}

	emit(): void {
		const snap = this.getSnapshot()
		for (let i = 0; i < this.listeners.length; i++) {
			try { this.listeners[i](snap) } catch (e) {}
		}
		this.saveSnap()
	}

	saveSnap(): void {
		if (this.phase == 'idle' || this.phase == 'ended') {
			this.clearSnap()
			return
		}
		const snap: UTSJSONObject = {}
		snap['phase'] = this.phase
		snap['callId'] = this.callId
		snap['roomId'] = this.roomId
		snap['sdp'] = this.pendingRemoteSdp
		snap['name'] = this.peerName
		snap['sub'] = this.sub
		snap['peer'] = this.peerUserId
		snap['incoming'] = this.isIncoming ? '1' : '0'
		snap['video'] = this.isVideo ? '1' : '0'
		snap['ts'] = Date.now().toString()
		const matrix = getMatrix()
		if (matrix != null) {
			matrix.callSnap = snap
			matrix.callActiveId = this.callId
			matrix.voipHold = this
		}
		try {
			uni.setStorageSync('mx_active_call', JSON.stringify(snap))
		} catch (e) {}
	}

	clearSnap(): void {
		const matrix = getMatrix()
		if (matrix != null) {
			matrix.callSnap = null
			matrix.callActiveId = ''
		}
		try {
			uni.removeStorageSync('mx_active_call')
		} catch (e) {}
	}

	applySnap(snap: UTSJSONObject): void {
		const cid = fieldStr(snap, 'callId')
		if (cid.length == 0) return
		const tsRaw = fieldStr(snap, 'ts')
		if (tsRaw.length > 0) {
			const ts = parseInt(tsRaw)
			if (ts > 0 && Date.now() - ts > 120000) return
		}
		this.phase = fieldStr(snap, 'phase')
		if (this.phase.length == 0) this.phase = 'ringing'
		this.callId = cid
		this.roomId = fieldStr(snap, 'roomId')
		this.pendingRemoteSdp = fieldStr(snap, 'sdp')
		this.peerName = fieldStr(snap, 'name')
		this.sub = fieldStr(snap, 'sub')
		this.peerUserId = fieldStr(snap, 'peer')
		this.isIncoming = fieldStr(snap, 'incoming') == '1'
		this.isVideo = fieldStr(snap, 'video') == '1'
		this.htmlBoot = this.isIncoming ? 'in' : 'out'
		console.log('[call] adopt', this.phase, this.callId, this.pendingRemoteSdp.length)
	}

	adoptIfIdle(): void {
		if (this.phase != 'idle') return
		const matrix = getMatrix()
		if (matrix != null && matrix.callSnap != null) {
			this.applySnap(matrix.callSnap as UTSJSONObject)
			if (this.phase != 'idle') return
		}
		try {
			const raw = uni.getStorageSync('mx_active_call')
			const s = (raw != null) ? ('' + raw) : ''
			if (s.length > 8 && s != 'null') {
				const parsed = JSON.parse(s)
				const snap = parsed as UTSJSONObject
				if (snap != null) this.applySnap(snap)
			}
		} catch (e) {}
	}

	unbind(): void {
		const poll = this.signalTimer
		if (poll != null) {
			clearInterval(poll)
			this.signalTimer = null
		}
		if (this.offTimeline != null) {
			try { this.offTimeline() } catch (e) {}
			this.offTimeline = null
		}
		this.bound = false
		this.boundToken = ''
	}

	bindMatrix(): void {
		const matrix = getMatrix()
		if (matrix == null) return
		const token = matrix.userId + '|' + matrix.deviceId
		matrix.onVoipEvent = (event: MatrixEvent, rid: string): void => {
			getCallManager().handleEvent(event, rid)
		}
		if (matrix.pendingVoipEvents.length > 0) {
			const evs = matrix.pendingVoipEvents
			const rooms = matrix.pendingVoipRooms
			const emptyEv: Array<MatrixEvent> = []
			const emptyRid: Array<string> = []
			matrix.pendingVoipEvents = emptyEv
			matrix.pendingVoipRooms = emptyRid
			console.log('[call] flush queued voip', evs.length)
			for (let i = 0; i < evs.length; i++) {
				getCallManager().handleEvent(evs[i], rooms[i])
			}
		}
		if (this.bound && this.offTimeline != null && this.boundToken == token) return
		if (this.offTimeline != null) {
			try { this.offTimeline() } catch (e) {}
			this.offTimeline = null
		}
		this.bound = true
		this.boundToken = token
		this.offTimeline = matrix.onVoip((event: MatrixEvent, rid: string) => {
			const t = event.type
			if (t.indexOf('m.call.') != 0) return
			console.log('[call] voip', t, rid)
			getCallManager().handleEvent(event, rid)
		})
		this.startSignalPoll()
		console.log('[call] voip handler bound', matrix.userId)
	}

	startSignalPoll(): void {
		const matrix = getMatrix()
		if (matrix != null) {
			if (matrix.callPollOn) return
			matrix.callPollOn = true
		}
		if (this.signalTimer != null) return
		this.signalTimer = setInterval(() => {
			this.tickSignalPoll()
		}, 4000)
	}

	async tickSignalPoll(): Promise<void> {
		if (this.signalBusy) return
		const matrix = getMatrix()
		if (matrix == null) return
		this.signalBusy = true
		try {
			const rooms: Array<string> = []
			if (this.roomId.length > 0) rooms.push(this.roomId)
			try {
				const last = uni.getStorageSync('last_chat_room')
				const s = (last != null) ? ('' + last) : ''
				if (s.length > 0 && s != 'null' && rooms.indexOf(s) < 0) rooms.push(s)
			} catch (e0) {}
			for (let i = 0; i < rooms.length; i++) {
				const evs = await matrix.getCallEvents(rooms[i])
				for (let j = 0; j < evs.length; j++) {
					const t = evs[j].type
					if (t == 'm.call.candidates') continue
					if (t == 'm.call.invite') continue
					this.handleEvent(evs[j], rooms[i])
				}
			}
		} catch (e) {}
		this.signalBusy = false
	}

	countCallPages(): number {
		let n = 0
		try {
			const pages = getCurrentPages()
			for (let i = 0; i < pages.length; i++) {
				const cur = pages[i] as PageRef
				if (cur.route.indexOf('pages/call/call') >= 0) n++
			}
		} catch (e) {}
		return n
	}

	openPage(): void {
		if (this.phase == 'idle') return
		this.leaving = false
		if (this.pageOpen || this.navigating) return
		if (this.countCallPages() > 0) {
			this.pageOpen = true
			console.log('[call] call page already in stack')
			return
		}
		this.navigating = true
		this.pageOpen = true
		console.log('[call] navigate to call page')
		const mode = this.isIncoming ? 'in' : 'out'
		uni.navigateTo({
			url: '/pages/call/call?m=' + mode,
			success: () => {
				this.navigating = false
				console.log('[call] call page opened')
			},
			fail: () => {
				console.warn('[call] navigateTo fail, try redirectTo')
				uni.redirectTo({
					url: '/pages/call/call?m=' + mode,
					success: () => {
						this.navigating = false
						console.log('[call] call page redirected')
					},
					fail: () => {
						this.navigating = false
						this.pageOpen = false
						console.warn('[call] redirectTo fail')
						uni.showToast({ title: '无法打开通话页', icon: 'none' })
					}
				})
			}
		})
	}

	leavePageIfNeeded(): void {
		this.pageOpen = false
		this.leaving = true
		this.leaveGen = this.leaveGen + 1
		const gen = this.leaveGen
		setTimeout(() => {
			if (gen != this.leaveGen) return
			if (this.phase != 'idle') return
			try {
				const pages = getCurrentPages()
				if (pages.length > 1) {
					const last = pages[pages.length - 1] as PageRef
					if (last.route.indexOf('pages/call/call') >= 0) {
						uni.navigateBack()
					}
				}
			} catch (e) {}
			this.leaving = false
		}, 600)
	}

	async send(type: string, content: UTSJSONObject): Promise<void> {
		const matrix = getMatrix()
		const rid = this.roomId
		if (matrix == null || rid.length == 0) return
		content['room_id'] = rid
		const peer = this.peerUserId.length > 0 ? this.peerUserId : this.inviteeId
		if (peer.length > 0 && (type == 'm.call.hangup' || type == 'm.call.reject' || type == 'm.call.invite' || type == 'm.call.answer' || type == 'm.call.candidates' || type == 'm.call.negotiate')) {
			try {
				await matrix.sendToDeviceUser(peer, type, content)
				console.log('[call] to-device', type, '->', peer)
			} catch (e2) {
				console.warn('[call] to-device fail', type, e2)
			}
		} else if (type == 'm.call.invite') {
			console.warn('[call] invite without peer, to-device skipped')
		}
		try {
			await matrix.sendRawEvent(rid, type, content, matrix.genTxnId())
			console.log('[call] sent', type)
		} catch (e) {
			console.error('[call] send fail', type, e)
			throw e
		}
	}

	async notifyCall(type: string, content: UTSJSONObject, roomId: string, peerId: string): Promise<void> {
		const matrix = getMatrix()
		if (matrix == null) return
		if (roomId.length > 0) content['room_id'] = roomId
		if (roomId.length > 0) {
			try {
				await matrix.sendRawEvent(roomId, type, content, matrix.genTxnId())
				console.log('[call] sent', type)
			} catch (e) {
				console.error('[call] send fail', type, e)
			}
		}
		if (peerId.length > 0) {
			try {
				await matrix.sendToDeviceUser(peerId, type, content)
				console.log('[call] to-device', type, '->', peerId)
			} catch (e2) {
				console.warn('[call] to-device fail', type, e2)
			}
		}
	}

	streamMeta(): UTSJSONObject {
		const info: UTSJSONObject = {}
		info['purpose'] = 'm.usermedia'
		info['audio_muted'] = this.muted
		info['video_muted'] = this.isVideo ? this.cameraOff : true
		const meta: UTSJSONObject = {}
		meta[this.streamId] = info
		return meta
	}

	baseCallContent(): UTSJSONObject {
		const payload: UTSJSONObject = {}
		payload['call_id'] = this.callId
		payload['version'] = '1'
		payload['party_id'] = this.partyId
		return payload
	}

	async buildIce(): Promise<Array<UTSJSONObject>> {
		const list: Array<UTSJSONObject> = []
		const stun: UTSJSONObject = {}
		stun['urls'] = 'stun:stun.l.google.com:19302'
		list.push(stun)
		try {
			const matrix = getMatrix()
			if (matrix != null) {
				const turn = await matrix.getTurnServer()
				const uris: Array<string> = []
				const urisRaw = turn.getArray('uris')
				if (urisRaw != null) {
					for (let i = 0; i < urisRaw.length; i++) {
						const one = urisRaw[i]
						if (one == null) continue
						const s = '' + one
						if (s.length > 0 && s != 'null') uris.push(s)
					}
				}
				const usernameVal = turn.getString('username')
				const credentialVal = turn.getString('password')
				const username = (usernameVal != null) ? usernameVal : ''
				const credential = (credentialVal != null) ? credentialVal : ''
				if (uris.length > 0) {
					const item: UTSJSONObject = {}
					item['urls'] = uris
					item['username'] = username
					item['credential'] = credential
					list.push(item)
				}
			}
		} catch (e) {
			console.warn('[call] TURN 不可用，仅 STUN', e)
		}
		return list
	}

	attachDom(): void {
		const stream = this.localStream
		if (stream != null && this.isVideo) this.attachStream('.call-local', stream, true)
	}

	attachStream(selector: string, stream: any, muted: boolean): void {
		// #ifdef H5
		try {
			const doc = (window as any).document
			if (doc == null) return
			let el = doc.querySelector(selector)
			const host = doc.querySelector('.call-stage')
			if (el == null && host != null) {
				el = doc.createElement('video')
				el.setAttribute('class', selector.replace('.', ''))
				el.autoplay = true
				el.playsInline = true
				el.muted = muted
				if (muted) {
					el.style.cssText = 'position:absolute;right:24px;top:80px;width:120px;height:160px;object-fit:cover;border-radius:12px;background:#000;z-index:2;'
				} else {
					el.style.cssText = 'position:absolute;left:0;top:0;width:100%;height:100%;object-fit:cover;background:#111;z-index:1;'
				}
				host.appendChild(el)
			}
			if (el != null) {
				el.srcObject = stream
				el.play?.()
			}
		} catch (e) {
			console.warn('[call] attach stream', e)
		}
		// #endif
	}

	clearDom(): void {
		// #ifdef H5
		try {
			const host = (window as any).document?.querySelector('.call-stage')
			if (host != null) host.innerHTML = ''
		} catch (e) {}
		// #endif
	}

	async ensurePeer(): Promise<boolean> {
		if (this.rtcPc != null) return true
		if (!webrtcReady()) {
			uni.showToast({ title: '当前环境不支持通话，请用系统浏览器打开', icon: 'none' })
			return false
		}
		// #ifdef H5
		const ice = await this.buildIce()
		this.rtcPc = new (window as any).RTCPeerConnection({ iceServers: ice })
		this.rtcPc.onicecandidate = (ev: any) => {
			if (ev == null || ev.candidate == null) return
			const c = this.baseCallContent()
			const one: UTSJSONObject = {}
			one['candidate'] = ev.candidate.candidate
			one['sdpMid'] = ev.candidate.sdpMid
			one['sdpMLineIndex'] = ev.candidate.sdpMLineIndex
			const arr: Array<UTSJSONObject> = []
			arr.push(one)
			c['candidates'] = arr
			this.send('m.call.candidates', c)
		}
		this.rtcPc.ontrack = (ev: any) => {
			const stream = (ev.streams != null && ev.streams.length > 0) ? ev.streams[0] : new (window as any).MediaStream([ev.track])
			this.attachStream('.call-remote', stream, false)
		}
		this.rtcPc.onconnectionstatechange = () => {
			try {
				const s = this.rtcPc.connectionState as string
				if (s == 'connected') {
					this.noteConnected()
					this.emit()
				} else if (s == 'failed') {
					this.sub = '连接失败'
					this.emit()
					this.hangup(true)
				}
			} catch (e) {}
		}
		return true
		// #endif
		return true
	}

	async addLocalMedia(): Promise<boolean> {
		// #ifdef H5
		try {
			this.localStream = await (window as any).navigator.mediaDevices.getUserMedia({
				audio: true,
				video: this.isVideo ? { facingMode: 'user' } : false
			})
			const stream = this.localStream
			const pc = this.rtcPc
			if (pc != null && stream != null) {
				const tracks = stream.getTracks()
				for (let i = 0; i < tracks.length; i++) {
					pc.addTrack(tracks[i], stream)
				}
			}
			if (stream != null) {
				const sid = stream.id
				if (sid != null && ('' + sid).length > 0) this.streamId = '' + sid
			}
			if (this.isVideo && stream != null) this.attachStream('.call-local', stream, true)
			return true
		} catch (e) {
			uni.showToast({ title: '无法打开麦克风/摄像头', icon: 'none' })
			return false
		}
		// #endif
		return false
	}

	async flushIce(): Promise<void> {
		// #ifdef H5
		const pc = this.rtcPc
		if (pc == null || !this.remoteDescReady) return
		for (let i = 0; i < this.pendingIce.length; i++) {
			try { await pc.addIceCandidate(this.pendingIce[i]) } catch (e) {}
		}
		this.pendingIce = []
		// #endif
	}

	requestCallPerms(): void {
		// #ifdef APP-ANDROID
		try {
			const act = UTSAndroid.getUniActivity()
			if (act == null) return
			const permissionNeed: Array<string> = ['android.permission.CAMERA', 'android.permission.RECORD_AUDIO']
			UTSAndroid.requestSystemPermission(act, permissionNeed, (_ok: boolean, _list: Array<string>) => {
				console.log('[call] perm ok')
			}, (_again: boolean, _denied: Array<string>) => {
				console.warn('[call] perm denied')
			})
		} catch (e) {}
		// #endif
	}

	async startOutgoing(roomId: string, isVideo: boolean): Promise<boolean> {
		this.bindMatrix()
		if (Date.now() - this.lastHangAt < 1500) return false
		if (this.phase != 'idle') {
			uni.showToast({ title: '已在通话中', icon: 'none' })
			return false
		}
		if (!webrtcReady()) {
			uni.showToast({ title: '当前环境不支持通话，请用系统浏览器打开', icon: 'none' })
			return false
		}
		this.phase = 'outgoing'
		this.leaving = false
		this.pageOpen = false
		this.connectedAt = 0
		this.initiatorId = ''
		this.roomId = roomId
		this.isVideo = isVideo
		this.isIncoming = false
		this.callId = 'c' + Date.now().toString()
		this.partyId = makePartyId()
		this.offerSent = false
		this.offerStarted = false
		this.answerStarted = false
		this.answerSent = false
		this.htmlPollN = 0
		this.inviteeId = ''
		this.outgoingReady = false
		this.lastInvite = null
		this.streamId = 'usermedia'
		this.sub = isVideo ? '正在呼叫（视频）…' : '正在呼叫（语音）…'
		this.muted = false
		this.cameraOff = false
		this.peerName = '对方'
		this.emit()
		// #ifdef APP-ANDROID
		try {
			await new Promise((resolve: (ok: boolean) => void) => {
				const act = UTSAndroid.getUniActivity()
				if (act == null) {
					resolve(true)
					return
				}
				const permissionNeed: Array<string> = ['android.permission.CAMERA', 'android.permission.RECORD_AUDIO']
				UTSAndroid.requestSystemPermission(act, permissionNeed, (_ok: boolean, _list: Array<string>) => {
					resolve(true)
				}, (_again: boolean, _denied: Array<string>) => {
					resolve(true)
				})
			})
		} catch (e) {}
		// #endif
		const matrix = getMatrix()
		if (matrix == null) {
			this.hangup(false)
			return false
		}
		this.initiatorId = matrix.userId
		try {
			const members = await matrix.getJoinedMembers(roomId)
			const others: Array<string> = []
			for (let i = 0; i < members.length; i++) {
				const u = members[i]
				if (u != matrix.userId) others.push(u)
			}
			if (others.length > 0) {
				this.inviteeId = others[0]
				this.peerUserId = others[0]
			}
			console.log('[call] room members', members.length, 'peers', others.length, others.join(','))
			if (others.length == 0) {
				uni.showToast({ title: '对方不在房间内，无法呼叫', icon: 'none' })
			}
			if (others.length > 0) {
				const u0 = others[0]
				const cached = matrix.getCachedUserName(u0)
				if (cached.length > 0) this.peerName = cached
				else this.peerName = localPart(u0)
				this.emit()
			}
		} catch (e) {}
		this.outgoingReady = true
		this.htmlBoot = 'out'
		this.openPage()
		this.placeOutgoing()
		return true
	}

	async placeOutgoing(): Promise<void> {
		if (this.phase != 'outgoing') return
		if (!this.outgoingReady) return
		// #ifdef H5
		if (this.offerStarted) return
		this.offerStarted = true
		if (!(await this.ensurePeer())) { this.hangup(false); return }
		if (!(await this.addLocalMedia())) { this.hangup(false); return }
		try {
			const pc = this.rtcPc
			if (pc == null) { this.hangup(false); return }
			const offer = await pc.createOffer()
			await pc.setLocalDescription(offer)
			const sdp = `${offer.sdp}`
			await this.sendInvite(sdp)
		} catch (e) {
			uni.showToast({ title: `${e}`, icon: 'none' })
			this.hangup(false)
			return
		}
		this.armTimeout()
		// #endif
		// #ifndef H5
		await this.appOffer()
		// #endif
	}

	htmlStr(msg: UTSJSONObject, key: string): string {
		const gs = msg.getString(key)
		if (gs != null && gs.length > 0 && gs != 'null') return gs
		const v = msg[key]
		if (v == null) return ''
		const s = '' + v
		if (s.length == 0 || s == 'null' || s == 'undefined') return ''
		return s
	}

	packHtmlMsg(msg: UTSJSONObject): string {
		const keys: Array<string> = ['cmd', 'ice', 'video', 'sdp', 'hs', 'token', 'room', 'call', 'party', 'invitee', 'name', 'sub', 'phase', 'incoming', 'candidate', 'sdpMid']
		const parts: Array<string> = []
		for (let i = 0; i < keys.length; i++) {
			const k = keys[i]
			const s = this.htmlStr(msg, k)
			if (s.length == 0) continue
			parts.push('"' + k + '":' + JSON.stringify(s))
		}
		const mid = msg['sdpMLineIndex']
		if (mid != null) {
			parts.push('"sdpMLineIndex":' + ('' + mid))
		}
		return '{' + parts.join(',') + '}'
	}

	sendToHtml(msg: UTSJSONObject): void {
		const fn = this.htmlEval
		if (fn == null) {
			if (this.htmlStr(msg, 'cmd') != 'hangup' && this.htmlStr(msg, 'cmd') != 'unlock') {
				console.warn('[call] htmlEval null', this.htmlStr(msg, 'cmd'))
			}
			return
		}
		const text = this.packHtmlMsg(msg)
		if (text == '{}') {
			console.warn('[call] empty html payload')
			return
		}
		console.log('[call] eval', this.htmlStr(msg, 'cmd'), text.length)
		fn('window.__callJson(' + text + ')')
	}

	pushUi(): void {
		const msg: UTSJSONObject = {}
		msg['cmd'] = 'ui'
		msg['name'] = this.peerName
		msg['sub'] = this.sub
		msg['phase'] = this.phase
		msg['incoming'] = this.isIncoming ? '1' : '0'
		this.sendToHtml(msg)
	}

	waitHtmlLoop(n: number): Promise<boolean> {
		return new Promise((resolve: (ok: boolean) => void) => {
			if (this.htmlEval != null) {
				this.htmlReady = true
				resolve(true)
				return
			}
			if (n >= 80) {
				resolve(false)
				return
			}
			setTimeout(() => {
				this.waitHtmlLoop(n + 1).then((ok: boolean) => {
					resolve(ok)
				})
			}, 100)
		})
	}

	waitHtml(): Promise<boolean> {
		return this.waitHtmlLoop(0)
	}

	buildHtmlStart(cmd: string, sdp: string): UTSJSONObject {
		const msg: UTSJSONObject = {}
		msg['cmd'] = cmd
		msg['ice'] = '[]'
		msg['video'] = this.isVideo ? '1' : '0'
		if (sdp.length > 0) msg['sdp'] = sdp
		const matrix = getMatrix()
		if (matrix != null) {
			msg['hs'] = matrix.homeserver
			msg['token'] = matrix.accessToken
		}
		msg['room'] = this.roomId
		msg['call'] = this.callId
		msg['party'] = this.partyId
		msg['invitee'] = this.inviteeId
		return msg
	}

	packUiBoot(): string {
		const msg: UTSJSONObject = {}
		msg['cmd'] = 'ui'
		msg['name'] = this.peerName
		msg['sub'] = this.sub
		msg['phase'] = this.phase
		msg['incoming'] = this.isIncoming ? '1' : '0'
		msg['video'] = this.isVideo ? '1' : '0'
		const matrix = getMatrix()
		if (matrix != null) {
			msg['hs'] = matrix.homeserver
			msg['token'] = matrix.accessToken
		}
		msg['room'] = this.roomId
		msg['call'] = this.callId
		msg['party'] = this.partyId
		msg['invitee'] = this.inviteeId
		return this.packHtmlMsg(msg)
	}

	kickTurn(): void {
		if (this.turnBusy) return
		const matrix = getMatrix()
		if (matrix == null) return
		this.turnBusy = true
		matrix.getTurnServer().then((turn: UTSJSONObject) => {
			this.turnBusy = false
			try {
				const uris: Array<string> = []
				const urisRaw = turn.getArray('uris')
				if (urisRaw != null) {
					for (let i = 0; i < urisRaw.length; i++) {
						const one = urisRaw[i]
						if (one == null) continue
						const s = '' + one
						if (s.length > 0 && s != 'null') uris.push(s)
					}
				}
				if (uris.length == 0) return
				const usernameVal = turn.getString('username')
				const credentialVal = turn.getString('password')
				const username = (usernameVal != null) ? usernameVal : ''
				const credential = (credentialVal != null) ? credentialVal : ''
				const item: UTSJSONObject = {}
				item['urls'] = uris
				item['username'] = username
				item['credential'] = credential
				const stun: UTSJSONObject = {}
				stun['urls'] = 'stun:stun.l.google.com:19302'
				const list: Array<UTSJSONObject> = []
				list.push(stun)
				list.push(item)
				const encoded = JSON.stringify(list)
				if (encoded.length > 8) this.turnIce = encoded
				console.log('[call] TURN cached', uris.length)
			} catch (e) {}
		}).catch((e) => {
			this.turnBusy = false
			console.warn('[call] TURN fail', e)
		})
	}

	fillHtmlIce(msg: UTSJSONObject): void {
		if (this.turnIce.length < 8) {
			this.turnIce = '[{"urls":"stun:stun.l.google.com:19302"}]'
		}
		msg['ice'] = this.turnIce
		this.kickTurn()
	}

	async appOffer(): Promise<void> {
		if (this.phase != 'outgoing') return
		if (this.offerSent || this.invitePosted) return
		if (this.htmlEval == null || this.htmlLoaded == false) {
			console.log('[call] startOffer wait engine')
			return
		}
		if (this.offerStarted) return
		this.offerStarted = true
		const msg = this.buildHtmlStart('startOffer', '')
		this.fillHtmlIce(msg)
		this.sendToHtml(msg)
		this.armTimeout()
		this.sub = '正在呼叫…'
		this.emit()
		this.pushUi()
		this.htmlPollN = 0
		this.scheduleHtmlPoll()
		console.log('[call] startOffer sent to engine')
	}

	async appAnswer(): Promise<void> {
		if (this.answerStarted) return
		if (this.pendingRemoteSdp.length == 0) {
			console.warn('[call] appAnswer without remote sdp')
			return
		}
		if (this.htmlEval == null || this.htmlLoaded == false) {
			console.log('[call] startAnswer wait engine')
			return
		}
		this.answerStarted = true
		const sdp = this.pendingRemoteSdp
		if (sdp.length == 0) {
			this.answerStarted = false
			return
		}
		const msg = this.buildHtmlStart('startAnswer', sdp)
		this.fillHtmlIce(msg)
		this.sendToHtml(msg)
		this.flushAppIce()
		this.htmlPollN = 0
		this.scheduleHtmlPoll()
		console.log('[call] startAnswer sent to engine, sdp', sdp.length)
	}

	async armIncoming(): Promise<void> {
		if (this.phase != 'ringing') return
		if (this.pendingRemoteSdp.length == 0) return
		if (this.htmlEval == null || this.htmlLoaded == false) {
			console.log('[call] armIncoming wait engine')
			return
		}
		const msg = this.buildHtmlStart('armAnswer', this.pendingRemoteSdp)
		this.fillHtmlIce(msg)
		msg['name'] = this.peerName
		msg['sub'] = this.sub
		msg['phase'] = this.phase
		msg['incoming'] = '1'
		this.sendToHtml(msg)
		this.pushUi()
		console.log('[call] incoming armed', this.pendingRemoteSdp.length)
	}

	scheduleHtmlPoll(): void {
		const n = this.htmlPollN
		if (n == 0) tuneCallWebView()
		if (n > 20) return
		setTimeout(() => {
			if (this.phase != 'outgoing' && this.phase != 'connecting') return
			if (this.connectedAt > 0) return
			if (this.phase == 'outgoing' && this.invitePosted) return
			const flush: UTSJSONObject = {}
			flush['cmd'] = 'flush'
			this.sendToHtml(flush)
			pullCallHtmlMsg((kind: string, payload: string, cand: UTSJSONObject): void => {
				this.onHtmlMessage(kind, payload, cand)
			})
			this.htmlPollN = n + 1
			this.scheduleHtmlPoll()
		}, 400)
	}

	flushAppIce(): void {
		for (let i = 0; i < this.pendingIce.length; i++) {
			const ice = this.pendingIce[i]
			const msg: UTSJSONObject = {}
			msg['cmd'] = 'ice'
			msg['candidate'] = (ice['candidate'] as string) ?? ''
			msg['sdpMid'] = '' + ice['sdpMid']
			msg['sdpMLineIndex'] = ice['sdpMLineIndex']
			this.sendToHtml(msg)
		}
		this.pendingIce = []
	}

	async trySendInvite(sdp: string): Promise<void> {
		try {
			await this.sendInvite(sdp)
		} catch (e) {
			uni.showToast({ title: '发起通话失败', icon: 'none' })
		}
	}

	async sendInvite(sdp: string): Promise<void> {
		if (sdp.length == 0) return
		if (this.invitePosted) {
			await this.sendNegotiate(sdp)
			return
		}
		this.offerSent = true
		this.invitePosted = true
		const payload = this.baseCallContent()
		payload['lifetime'] = 90000
		const offerObj: UTSJSONObject = {}
		offerObj['type'] = 'offer'
		offerObj['sdp'] = sdp
		payload['offer'] = offerObj
		const meta = this.streamMeta()
		payload['sdp_stream_metadata'] = meta
		payload['org.matrix.msc2746.sdp_stream_metadata'] = meta
		if (this.inviteeId.length > 0) payload['invitee'] = this.inviteeId
		payload['room_id'] = this.roomId
		this.lastInvite = payload
		await this.send('m.call.invite', payload)
		this.sub = '等待对方接听…'
		this.emit()
		uni.showToast({ title: '已向对方发起通话', icon: 'none' })
	}

	async sendNegotiate(sdp: string): Promise<void> {
		if (sdp.length == 0) return
		const payload = this.baseCallContent()
		payload['lifetime'] = 90000
		const desc: UTSJSONObject = {}
		desc['type'] = 'offer'
		desc['sdp'] = sdp
		payload['description'] = desc
		await this.send('m.call.negotiate', payload)
	}

	async sendAnswer(sdp: string): Promise<void> {
		if (this.answerSent) return
		if (sdp.length < 80) {
			console.warn('[call] skip short answer', sdp.length)
			return
		}
		this.answerSent = true
		const payload = this.baseCallContent()
		const answerObj: UTSJSONObject = {}
		answerObj['type'] = 'answer'
		answerObj['sdp'] = sdp
		payload['answer'] = answerObj
		const meta = this.streamMeta()
		payload['sdp_stream_metadata'] = meta
		payload['org.matrix.msc2746.sdp_stream_metadata'] = meta
		await this.send('m.call.answer', payload)
		this.noteConnected()
		this.emit()
		this.pushUi()
	}

	onHtmlMessage(kind: string, payload: string, cand: UTSJSONObject): void {
		console.log('[call] html msg', kind, payload.length)
		if (kind == 'ready') {
			this.htmlReady = true
			this.htmlLoaded = true
			console.log('[call] engine ready', this.phase)
			if (this.phase == 'outgoing') this.placeOutgoing()
			else if (this.phase == 'ringing') this.armIncoming()
			else if (this.phase == 'connecting') this.appAnswer()
			else this.pushUi()
			return
		}
		if (kind == 'offer') {
			this.trySendInvite(payload)
			return
		}
		if (kind == 'invited') {
			this.sub = '等待对方接听…'
			this.emit()
			uni.showToast({ title: '已向对方发起通话', icon: 'none' })
			return
		}
		if (kind == 'answer') {
			this.sendAnswer(payload)
			return
		}
		if (kind == 'ice') {
			const c = this.baseCallContent()
			const one: UTSJSONObject = {}
			one['candidate'] = payload
			one['sdpMid'] = '' + cand['sdpMid']
			one['sdpMLineIndex'] = cand['sdpMLineIndex']
			const arr: Array<UTSJSONObject> = []
			arr.push(one)
			c['candidates'] = arr
			this.send('m.call.candidates', c)
			return
		}
		if (kind == 'connected') {
			this.noteConnected()
			this.emit()
			this.pushUi()
			return
		}
		if (kind == 'failed') {
			this.sub = '连接失败'
			this.emit()
			this.hangup(true)
			return
		}
		if (kind == 'error') {
			uni.showToast({ title: payload.length > 0 ? payload : '通话失败', icon: 'none' })
			this.hangup(false)
			return
		}
		if (kind == 'ui') {
			if (payload == 'accept') this.accept()
			if (payload == 'reject') this.reject()
			if (payload == 'hang') this.hangup(true)
		}
	}

	async accept(): Promise<void> {
		if (this.phase != 'ringing') return
		if (!webrtcReady()) {
			uni.showToast({ title: '当前环境不支持通话', icon: 'none' })
			return
		}
		this.phase = 'connecting'
		this.sub = '正在接通…'
		this.emit()
		this.openPage()
		// #ifndef H5
		await this.appAnswer()
		return
		// #endif
		// #ifdef H5
		if (this.pendingRemoteSdp.length == 0) return
		if (!(await this.ensurePeer())) return
		if (!(await this.addLocalMedia())) return
		try {
			const pc = this.rtcPc
			if (pc == null) return
			const offerDesc: UTSJSONObject = {}
			offerDesc['type'] = 'offer'
			offerDesc['sdp'] = this.pendingRemoteSdp
			await pc.setRemoteDescription(offerDesc)
			this.remoteDescReady = true
			await this.flushIce()
			const answer = await pc.createAnswer()
			await pc.setLocalDescription(answer)
			await this.sendAnswer(`${answer.sdp}`)
			this.noteConnected()
			this.emit()
		} catch (e) {
			uni.showToast({ title: `${e}`, icon: 'none' })
			this.hangup(true)
		}
		// #endif
	}

	reject(): void {
		this.endCall(true, 'm.call.reject', 'rejected')
	}

	sendHangup(reason: string): void {
		const hang = this.baseCallContent()
		hang['reason'] = reason
		this.send('m.call.hangup', hang)
	}

	sendReject(): void {
		const rej = this.baseCallContent()
		this.send('m.call.reject', rej)
	}

	hangup(notify: boolean): void {
		this.endCall(notify, 'm.call.hangup', '')
	}

	async sendCallRecord(roomId: string, isVideo: boolean, status: string, duration: number, initiator: string, callId: string): Promise<void> {
		const matrix = getMatrix()
		if (matrix == null || roomId.length == 0) return
		const kind = isVideo ? '视频通话' : '语音通话'
		let body = '[' + kind + ']'
		if (status == 'answered') {
			body = '[' + kind + '] ' + formatCallDur(duration)
		} else if (status == 'cancelled') {
			body = '[' + kind + '] 已取消'
		} else if (status == 'rejected') {
			body = '[' + kind + '] 已拒绝'
		} else if (status == 'missed') {
			body = '[' + kind + '] 未接听'
		}
		const info: UTSJSONObject = {}
		info['call_type'] = isVideo ? 'video' : 'voice'
		info['call_status'] = status
		info['call_duration'] = duration
		info['call_initiator'] = initiator
		info['call_id'] = callId
		const content: UTSJSONObject = {}
		content['msgtype'] = 'm.call'
		content['body'] = body
		content['call_type'] = isVideo ? 'video' : 'voice'
		content['call_status'] = status
		content['call_duration'] = duration
		content['call_initiator'] = initiator
		content['call_id'] = callId
		content['info'] = info
		const ev: MatrixEvent = {
			type: 'm.room.message',
			event_id: matrix.genTxnId(),
			sender: matrix.userId,
			origin_server_ts: Date.now(),
			content: content
		}
		try {
			for (let hi = 0; hi < matrix.timelineHandlers.length; hi++) {
				try { matrix.timelineHandlers[hi](ev, roomId) } catch (e0) {}
			}
			const legacy = matrix.onRoomTimeline
			if (legacy != null) {
				try { legacy(ev, roomId) } catch (e1) {}
			}
		} catch (e2) {
			console.warn('[call] record local ui', e2)
		}
		try {
			await matrix.sendMessage(roomId, content)
			console.log('[call] record sent', status, body)
		} catch (e) {
			console.warn('[call] record fail', e)
		}
	}

	async endCall(notify: boolean, signalType: string, statusHint: string): Promise<void> {
		if (this.phase == 'idle' || this.phase == 'ended') {
			this.leavePageIfNeeded()
			return
		}
		const rid = this.roomId
		const cid = this.callId
		const peer = this.peerUserId.length > 0 ? this.peerUserId : this.inviteeId
		const wasVideo = this.isVideo
		const wasIncoming = this.isIncoming
		const connectedAt = this.connectedAt
		let initiator = this.initiatorId
		const matrixNow = getMatrix()
		if (initiator.length == 0 && matrixNow != null) {
			initiator = wasIncoming ? peer : matrixNow.userId
		}
		let status = statusHint
		if (status.length == 0) {
			if (connectedAt > 0) status = 'answered'
			else if (signalType == 'm.call.reject') status = 'rejected'
			else if (wasIncoming) status = 'rejected'
			else status = 'cancelled'
		}
		let duration = 0
		if (connectedAt > 0) {
			duration = Math.floor((Date.now() - connectedAt) / 1000)
			if (duration < 1) duration = 1
		}
		const hang = this.baseCallContent()
		hang['reason'] = signalType == 'm.call.reject' ? 'user_busy' : 'user_hangup'
		hang['room_id'] = rid
		const shouldNotify = notify && cid.length > 0
		this.lastHangAt = Date.now()
		this.clearTimer()
		const hangMsg: UTSJSONObject = {}
		hangMsg['cmd'] = 'hangup'
		this.sendToHtml(hangMsg)
		this.htmlEval = null
		this.htmlReady = false
		this.htmlLoaded = false
		destroyCallEngine()
		// #ifdef H5
		try {
			const stream = this.localStream
			if (stream != null) {
				const tracks = stream.getTracks()
				for (let i = 0; i < tracks.length; i++) {
					try { tracks[i].stop() } catch (e) {}
				}
			}
		} catch (e) {}
		try {
			const pc = this.rtcPc
			if (pc != null) pc.close()
		} catch (e) {}
		// #endif
		this.rtcPc = null
		this.localStream = null
		this.pendingRemoteSdp = ''
		this.pendingIce = []
		this.remoteDescReady = false
		this.offerSent = false
		this.offerStarted = false
		this.answerStarted = false
		this.answerSent = false
		this.htmlPollN = 0
		this.invitePosted = false
		this.outgoingReady = false
		this.lastInvite = null
		this.htmlBoot = ''
		this.htmlLoaded = false
		this.connectedAt = 0
		this.initiatorId = ''
		this.clearDom()
		if (shouldNotify) {
			this.sendCallRecord(rid, wasVideo, status, duration, initiator, cid)
			this.notifyCall(signalType, hang, rid, peer)
		}
		this.inviteeId = ''
		this.peerUserId = ''
		this.phase = 'idle'
		this.callId = ''
		this.roomId = ''
		this.sub = ''
		this.peerName = ''
		this.isIncoming = false
		this.pageOpen = false
		this.clearSnap()
		this.emit()
		this.leavePageIfNeeded()
	}

	toggleMute(): void {
		this.muted = !this.muted
		// #ifndef H5
		const m: UTSJSONObject = {}
		m['cmd'] = 'mute'
		this.sendToHtml(m)
		// #endif
		// #ifdef H5
		try {
			const stream = this.localStream
			if (stream != null) {
				const tracks = stream.getAudioTracks()
				for (let i = 0; i < tracks.length; i++) {
					tracks[i].enabled = !this.muted
				}
			}
		} catch (e) {}
		// #endif
		this.emit()
	}

	toggleCamera(): void {
		this.cameraOff = !this.cameraOff
		// #ifdef H5
		try {
			const stream = this.localStream
			if (stream != null) {
				const tracks = stream.getVideoTracks()
				for (let i = 0; i < tracks.length; i++) {
					tracks[i].enabled = !this.cameraOff
				}
			}
		} catch (e) {}
		// #endif
		this.emit()
	}

	armTimeout(): void {
		this.clearTimer()
		this.timer = setTimeout((): void => {
			if (this.phase == 'outgoing' || this.phase == 'ringing') {
				this.sub = this.phase == 'outgoing' ? '无人接听' : '未接听'
				this.emit()
				this.endCall(this.phase == 'outgoing', 'm.call.hangup', 'missed')
			}
		}, 90000)
	}

	clearTimer(): void {
		const t = this.timer
		if (t != null) {
			clearTimeout(t)
			this.timer = null
		}
	}

	replayRoom(rid: string): void {
		const matrix = getMatrix()
		if (matrix == null) return
		if (this.phase != 'idle') return
		const events = matrix.getBufferedEvents(rid)
		let i = 0
		while (i < events.length) {
			const ev = events[i]
			const t = ev.type
			if (t.indexOf('m.call.') == 0) this.handleEvent(ev, rid)
			i++
		}
	}

	alreadySeen(key: string): boolean {
		if (key.length == 0) return false
		for (let i = 0; i < this.seenVoip.length; i++) {
			if (this.seenVoip[i] == key) return true
		}
		this.seenVoip.push(key)
		if (this.seenVoip.length > 80) {
			this.seenVoip.splice(0, 20)
		}
		return false
	}

	handleEvent(event: MatrixEvent, rid: string): void {
		const type = event.type
		const sender = (event.sender != null) ? event.sender : ''
		const empty: UTSJSONObject = {}
		const content = (event.content != null) ? event.content : empty
		let roomId = rid
		if (roomId.length == 0) roomId = fieldStr(content, 'room_id')
		const callId = fieldStr(content, 'call_id')
		if (callId.length == 0) return
		const matrix0 = getMatrix()
		const activeId = (matrix0 != null) ? matrix0.callActiveId : ''
		if (type == 'm.call.invite' && activeId.length > 0 && activeId == callId) return
		if (type == 'm.call.invite' && this.callId == callId && this.phase != 'idle') return
		const eid = (event.event_id != null) ? event.event_id : ''
		const ts0 = event.origin_server_ts != null ? event.origin_server_ts : 0
		let key = eid
		if (key.length == 0) key = type + '|' + callId + '|' + ('' + ts0)
		if (this.alreadySeen(key)) return
		console.log('[call] handle', type, 'id=', callId, 'from=', sender, 'room=', roomId)
		const matrix = getMatrix()
		const myId = (matrix != null) ? matrix.userId : ''
		if (sender == myId) {
			console.log('[call] ignore own event', type)
			return
		}

		if (type == 'm.call.invite') {
			if (this.callId.length > 0 && callId == this.callId) return
			console.log('[call] recv invite from', sender, 'call', callId)
			const tsRaw = event.origin_server_ts != null ? event.origin_server_ts : 0
			let ts = tsRaw
			if (ts > 0 && ts < 1000000000000) ts = ts * 1000
			if (ts > 0 && Date.now() - ts > 120000) {
				console.log('[call] invite expired', Date.now() - ts)
				return
			}
			const invitee = fieldStr(content, 'invitee')
			if (invitee.length > 0 && invitee.indexOf('@') == 0 && myId.length > 0 && invitee != myId) {
				console.log('[call] invitee mismatch', invitee, myId)
				return
			}
			if (this.phase != 'idle' && this.phase != 'ringing') {
				const live = this.connectedAt > 0 || this.invitePosted || this.answerSent
				if (live) {
					console.warn('[call] busy, phase', this.phase)
					this.sendBusy(roomId, callId)
					return
				}
				console.log('[call] drop zombie', this.phase, this.callId)
				this.phase = 'idle'
				this.callId = ''
				this.answerStarted = false
				this.answerSent = false
				this.offerStarted = false
				this.invitePosted = false
				this.connectedAt = 0
				this.htmlEval = null
				this.htmlReady = false
				this.htmlLoaded = false
				this.clearSnap()
			}
			const offer = content.getJSON('offer')
			let sdp = ''
			if (offer != null) sdp = fieldStr(offer, 'sdp')
			if (sdp.length == 0) sdp = fieldStr(content, 'sdp')
			if (sdp.length < 80 || sdp.indexOf('ice-ufrag:stub') >= 0) {
				console.warn('[call] ignore invalid invite sdp', sdp.length)
				return
			}
			this.pendingRemoteSdp = sdp
			this.roomId = roomId
			this.callId = callId
			this.partyId = makePartyId()
			this.isVideo = sdp.indexOf('m=video') >= 0
			this.isIncoming = true
			this.phase = 'ringing'
			this.inviteeId = ''
			this.peerUserId = sender
			this.initiatorId = sender
			this.connectedAt = 0
			this.leaving = false
			this.offerSent = false
			this.offerStarted = false
			this.answerStarted = false
			this.answerSent = false
			this.htmlPollN = 0
			this.invitePosted = false
			const cached = matrix != null ? matrix.getCachedUserName(sender) : ''
			this.peerName = cached.length > 0 ? cached : localPart(sender)
			this.sub = this.isVideo ? '邀请你视频通话' : '邀请你语音通话'
			this.muted = false
			this.cameraOff = false
			this.htmlBoot = 'in'
			this.emit()
			this.armTimeout()
			this.openPage()
			this.requestCallPerms()
			return
		}

		if (this.callId.length > 0 && callId != this.callId) return
		if (Date.now() - this.lastHangAt < 1500 && this.phase == 'idle') return

		if (type == 'm.call.answer') {
			const answer = content.getJSON('answer')
			let sdp = ''
			if (answer != null) sdp = fieldStr(answer, 'sdp')
			// #ifdef H5
			const pc = this.rtcPc
			if (pc != null && sdp.length > 0) {
				const desc: UTSJSONObject = {}
				desc['type'] = 'answer'
				desc['sdp'] = sdp
				pc.setRemoteDescription(desc).then(() => {
					this.remoteDescReady = true
					this.flushIce()
					this.noteConnected()
					this.emit()
				}).catch((e) => console.warn('[call] answer', e))
			}
			// #endif
			// #ifndef H5
			if (sdp.length > 0) {
				const msg: UTSJSONObject = {}
				msg['cmd'] = 'remoteAnswer'
				msg['sdp'] = sdp
				this.sendToHtml(msg)
				this.remoteDescReady = true
				this.flushAppIce()
				this.noteConnected()
				this.emit()
				this.pushUi()
			}
			// #endif
			return
		}

		if (type == 'm.call.negotiate') {
			const desc = content.getJSON('description')
			let sdp = ''
			if (desc != null) sdp = fieldStr(desc, 'sdp')
			if (sdp.length == 0) return
			this.pendingRemoteSdp = sdp
			if (sdp.indexOf('m=video') >= 0) this.isVideo = true
			if (this.phase == 'ringing') return
			// #ifndef H5
			const neg: UTSJSONObject = {}
			neg['cmd'] = 'remoteOffer'
			neg['sdp'] = sdp
			this.sendToHtml(neg)
			// #endif
			return
		}

		if (type == 'm.call.candidates') {
			const raw = content.getArray('candidates')
			if (raw == null) return
			for (let i = 0; i < raw.length; i++) {
				const one = raw[i]
				if (one == null) continue
				const c = one as UTSJSONObject
				const cand = fieldStr(c, 'candidate')
				if (cand.length == 0) continue
				const ice: UTSJSONObject = {}
				ice['candidate'] = cand
				ice['sdpMid'] = fieldStr(c, 'sdpMid')
				const midIdx = c.getNumber('sdpMLineIndex')
				ice['sdpMLineIndex'] = (midIdx != null) ? midIdx : 0
				// #ifdef H5
				const pc = this.rtcPc
				if (pc != null && this.remoteDescReady) {
					pc.addIceCandidate(ice)
				} else {
					this.pendingIce.push(ice)
				}
				// #endif
				// #ifndef H5
				if (this.htmlEval != null) {
					const msg: UTSJSONObject = {}
					msg['cmd'] = 'ice'
					msg['candidate'] = cand
					msg['sdpMid'] = fieldStr(c, 'sdpMid')
					msg['sdpMLineIndex'] = ice['sdpMLineIndex']
					this.sendToHtml(msg)
				} else {
					this.pendingIce.push(ice)
				}
				// #endif
			}
			return
		}

		if (type == 'm.call.hangup' || type == 'm.call.reject') {
			if (this.callId.length > 0 && callId != this.callId) return
			if (this.phase == 'idle' || this.phase == 'ended') {
				this.leavePageIfNeeded()
				return
			}
			console.log('[call] peer ended', type)
			uni.showToast({ title: type == 'm.call.reject' ? '对方已拒绝' : '对方已挂断', icon: 'none' })
			this.endCall(false, 'm.call.hangup', '')
		}
	}

	sendBusy(roomId: string, callId: string): void {
		const hang: UTSJSONObject = {}
		hang['call_id'] = callId
		hang['version'] = '1'
		hang['party_id'] = this.partyId
		hang['reason'] = 'user_busy'
		const matrix = getMatrix()
		if (matrix == null) return
		matrix.sendRawEvent(roomId, 'm.call.hangup', hang, matrix.genTxnId())
	}
}

let gCall: CallManager | null = null

function attachVoipSink(): void {
	setVoipSink((event: MatrixEvent, roomId: string): void => {
		const mgr = getCallManager()
		mgr.handleEvent(event, roomId)
	})
}

export function getCallManager(): CallManager {
	const matrix = getMatrix()
	if (matrix != null) {
		const held = matrix.voipHold
		if (held != null) {
			const fromHs = held as CallManager
			gCall = fromHs
			fromHs.adoptIfIdle()
			return fromHs
		}
	}
	let mgr = gCall
	if (mgr == null) {
		mgr = new CallManager()
		gCall = mgr
		attachVoipSink()
	}
	if (matrix != null) {
		matrix.voipHold = mgr
	}
	mgr.adoptIfIdle()
	return mgr
}

export function bindCallToMatrix(): void {
	const mgr = getCallManager()
	attachVoipSink()
	mgr.bindMatrix()
}
