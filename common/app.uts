/**
 * 全局应用状态管理
 * 用 uni-app 的 getApp() globalData 模式
 */
import { MatrixClient, setMatrix, clearMatrix, getMatrix } from './matrix.uts'
	import { t } from '@/common/i18n.uts'
import { saveSession, loadSession, clearSession, SessionInfo } from './storage.uts'
import { loadPlatformSession } from './platform.uts'
import { bindCallToMatrix, getCallManager } from './call.uts'

export function bootstrapMatrix(): MatrixClient | null {
	const session = loadSession()
	if (session == null) return null
	const client = new MatrixClient()
	client.applySession(session.homeserver, session.access_token, session.user_id, session.device_id)
	setMatrix(client)
	bindCallToMatrix()
	return client
}

/** 是否已有平台邮箱登录态（不含 Matrix） */
export function hasPlatformLogin(): boolean {
	return loadPlatformSession() != null
}

/** 用平台登录返回的 Matrix 凭证（data.matrix）启动聊天会话，成功返回 true */
export function startMatrixFromPlatform(): boolean {
	const p = loadPlatformSession()
	if (p == null) return false
	if (p.matrix_token.length == 0 || p.matrix_user_id.length == 0 || p.matrix_homeserver.length == 0) return false
	const s: SessionInfo = {
		homeserver: p.matrix_homeserver,
		user_id: p.matrix_user_id,
		access_token: p.matrix_token,
		device_id: '',
		display_name: p.nickname,
		avatar_url: ''
	}
	startMatrixSession(s)
	return true
}

/** 引导补登 Matrix（聊天账号），不清除平台 session */
export function openMatrixLogin(): void {
	uni.showToast({ title: t('app.needMatrix'), icon: 'none' })
	uni.navigateTo({ url: '/pages/login/login-email' })
}

/**
 * 确保 Matrix 可用。
 * 仅平台登录时不踢到登录首页（避免“被退出”），改为引导 Matrix 登录。
 */
export function ensureMatrixClient(): MatrixClient | null {
	let matrix = getMatrix()
	if (matrix == null) matrix = bootstrapMatrix()
	if (matrix != null) return matrix
	// 优先用平台登录时返回的 Matrix 凭证自动拉起聊天会话
	if (startMatrixFromPlatform()) return getMatrix()
	if (hasPlatformLogin()) {
		openMatrixLogin()
		return null
	}
	uni.reLaunch({ url: '/pages/login/login' })
	return null
}

export function startMatrixSession(session: SessionInfo): MatrixClient {
	try { getCallManager().unbind() } catch (e) {}
	const client = new MatrixClient()
	client.applySession(session.homeserver, session.access_token, session.user_id, session.device_id)
	setMatrix(client)
	saveSession(session)
	bindCallToMatrix()
	client.startSync()
	return client
}

export function endMatrixSession(): void {
	try { getCallManager().hangup(false) } catch (e) {}
	try { getCallManager().unbind() } catch (e) {}
	clearSession()
	clearMatrix()
}

export function openChat(roomId: string, highlight: string = ''): void {
	uni.setStorageSync('pending_chat_room', roomId)
	uni.setStorageSync('last_chat_room', roomId)
	uni.setStorageSync('pending_chat_highlight', highlight)
	let url = '/pages/chat/chat?roomId=' + encodeURIComponent(roomId)
	if (highlight.length > 0) url += '&highlight=' + encodeURIComponent(highlight)
	uni.navigateTo({ url: url })
}

export function openGroupInfo(roomId: string): void {
	uni.navigateTo({ url: '/pages/group/group?roomId=' + encodeURIComponent(roomId) })
}

export function openGroupPick(mode: string, roomId: string = ''): void {
	let url = '/pages/group/pick?mode=' + encodeURIComponent(mode)
	if (roomId.length > 0) url += '&roomId=' + encodeURIComponent(roomId)
	uni.navigateTo({ url: url })
}
