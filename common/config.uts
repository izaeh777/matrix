/**
 * 全局环境域名（改这里即可同步平台 / CMS / Matrix / TP 回调）
 * H5 本地开发仍走 manifest.json → h5.devServer.proxy，勿改相对路径逻辑。
 */
export const API_HOST = 'https://m.itiklink.com'
export const CMS_HOST = API_HOST
export const MATRIX_HOMESERVER = 'https://matrix.itiklink.com'
/** MXID 域名部分，不含协议，如 @user:matrix.itiklink.com */
export const MATRIX_SERVER_NAME = 'matrix.itiklink.com'

export const DAPP_FAVICON = API_HOST + '/favicon.ico'
export const DAPP_LOGO = API_HOST + '/assets/img/logo.png'
export const TP_LOGIN_CALLBACK = API_HOST + '/api/v1/auth/wallet/tp-login'
export const TP_WALLET_CALLBACK = API_HOST + '/api/v1/auth/wallet/tp-callback'
export const OPENAPI_YAML = API_HOST + '/openapi.yaml'

/** localpart → 完整 Matrix ID；已是 @… 则原样返回 */
export function toMatrixUserId(localOrMxid: string): string {
	let raw = localOrMxid.trim()
	if (raw.length == 0) return ''
	if (raw.indexOf('@') == 0) return raw
	raw = raw.toLowerCase()
	return '@' + raw + ':' + MATRIX_SERVER_NAME
}
