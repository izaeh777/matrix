/**
 * 默认头像：tk1 / tk2 / tk3
 * 有 seed（userId / roomId）时稳定映射，同一人始终同一张。
 */

const AVATARS: Array<string> = [
	'/static/login/tk1.jpg',
	'/static/login/tk2.jpg',
	'/static/login/tk3.jpg'
]

/** 无 seed 时的兜底 */
export const DEFAULT_AVATAR: string = '/static/login/tk1.jpg'

export function defaultAvatar(seed: string = ''): string {
	if (seed.length == 0) return DEFAULT_AVATAR
	let h = 0
	for (let i = 0; i < seed.length; i++) {
		const code = seed.charCodeAt(i)
		h = ((h << 5) - h) + (code != null ? code : 0)
		h = h | 0
	}
	if (h < 0) h = -h
	const idx = h % AVATARS.length
	return AVATARS[idx]
}
