/**
 * TokenPocket App 钱包：优先 Mobile-SDK（authorize / ethPersonalSign）
 * DeepLink 仅作兜底（需 callbackUrl + 自定义 scheme）
 *
 * SDK 文档: https://help.tokenpocket.pro/developer-cn/mobile-wallet/mobile-sdk/android
 */
import {
	tpAuthorize as sdkAuthorize,
	tpPersonalSign as sdkPersonalSign,
	tpTransfer as sdkTransfer,
	tpIsInstalled as sdkIsInstalled,
	tpDeliverSchema as sdkDeliverSchema,
	TpSdkResult
} from '@/uni_modules/tp-wallet-sdk'

// #ifdef APP-ANDROID
import Intent from 'android.content.Intent'
import Uri from 'android.net.Uri'
// #endif

const TP_PKG = 'vip.mytokenpocket'
const ASSIST_CLASS = 'uts.sdk.modules.tpWalletSdk.TpAssistActivity'

const DAPP_NAME = 'i-tiklink'
const DAPP_ICON = 'https://m.itiklink.com/favicon.ico'
export const TP_CALLBACK_SCHEMA = 'itiklink://tp-wallet'
/** DeepLink 兜底用；SDK 主路径不依赖它 */
export const TP_CALLBACK_URL = 'https://m.itiklink.com/api/v1/auth/wallet/tp-callback'
const PENDING_KEY = 'tp_wallet_pending'
const LAST_CB_KEY = 'tp_last_callback_uri'

export type TpPending = {
	step: string
	actionId: string
	address: string
	message: string
	nonce: string
	createdAt: number
}

export type TpCallbackResult = {
	ok: boolean
	action: string
	actionId: string
	wallet: string
	signature: string
	raw: string
}

function pickStr(obj: UTSJSONObject, key: string): string {
	try {
		const v = obj[key]
		if (v != null) {
			const s = '' + v
			if (s.length > 0 && s != 'null' && s != 'undefined') return s
		}
	} catch (e0) {}
	return ''
}

function sdkToCallback(r: TpSdkResult): TpCallbackResult {
	const out: TpCallbackResult = {
		ok: r.code == 0 && (r.wallet.length > 0 || r.signature.length > 0 || r.raw.length > 0),
		action: r.action,
		actionId: r.actionId,
		wallet: r.wallet,
		signature: r.signature,
		raw: r.raw
	}
	return out
}

export function newActionId(): string {
	return 'itik-' + Date.now() + '-' + Math.floor(Math.random() * 100000)
}

export function saveTpPending(p: TpPending): void {
	try {
		const row: UTSJSONObject = {
			step: p.step,
			actionId: p.actionId,
			address: p.address,
			message: p.message,
			nonce: p.nonce,
			createdAt: p.createdAt
		}
		uni.setStorageSync(PENDING_KEY, JSON.stringify(row))
	} catch (e) {}
}

export function loadTpPending(): TpPending | null {
	try {
		const raw = uni.getStorageSync(PENDING_KEY)
		if (raw == null) return null
		const text = '' + raw
		if (text.length < 2) return null
		const o = JSON.parse(text) as UTSJSONObject
		const step = pickStr(o, 'step')
		const actionId = pickStr(o, 'actionId')
		if (step.length == 0 || actionId.length == 0) return null
		let createdAt = 0
		try {
			const n = o['createdAt']
			if (n != null) createdAt = parseFloat('' + n)
		} catch (e1) {}
		const out: TpPending = {
			step: step,
			actionId: actionId,
			address: pickStr(o, 'address'),
			message: pickStr(o, 'message'),
			nonce: pickStr(o, 'nonce'),
			createdAt: createdAt
		}
		return out
	} catch (e) {
		return null
	}
}

export function clearTpPending(): void {
	try { uni.removeStorageSync(PENDING_KEY) } catch (e) {}
}

export function isTpSdkAvailable(): boolean {
	// #ifdef APP-ANDROID
	try {
		return true
	} catch (e) {}
	// #endif
	return false
}

export function isTpAppInstalled(): boolean {
	try {
		return sdkIsInstalled()
	} catch (e) {
		return false
	}
}

const KEY_TP_WALLET = 'tp_wallet_address_v1'
/** 与登录一致：BSC */
export const TP_PAY_CHAIN_ID = '56'
/** BSC USDT（Binance-Peg） */
export const TP_USDT_CONTRACT = '0x55d398326f99059fF775485246999027B3197955'
export const TP_USDT_DECIMALS = 18

export function saveTpWalletAddress(addr: string): void {
	try {
		if (addr.length > 0) uni.setStorageSync(KEY_TP_WALLET, addr)
	} catch (e) {}
}

export function loadTpWalletAddress(): string {
	try {
		const raw = uni.getStorageSync(KEY_TP_WALLET)
		if (raw == null) return ''
		const s = ('' + raw).trim()
		return s
	} catch (e) {
		return ''
	}
}

/** Mobile-SDK 授权登录 → 钱包地址（chain 与服务端 SIWE 一致用 56） */
export async function tpSdkAuthorize(): Promise<TpCallbackResult> {
	const actionId = newActionId()
	const r = await sdkAuthorize(actionId, '56', DAPP_NAME, DAPP_ICON, 'itiklink-auth-login')
	const out = sdkToCallback(r)
	if (out.ok && out.wallet.length > 0) saveTpWalletAddress(out.wallet)
	return out
}

export type TpTransferResult = {
	ok: boolean
	txHash: string
	wallet: string
	raw: string
}

/** 优先国内/公共可达节点；binance 官方 seed 在部分网络会连不上 */
const BSC_RPCS: Array<string> = [
	'https://bsc-dataseed1.ninicoin.io/',
	'https://bsc-dataseed3.defibit.io/',
	'https://bsc-dataseed4.defibit.io/',
	'https://bscrpc.com',
	'https://1rpc.io/bnb',
	'https://bsc.publicnode.com',
	'https://rpc.ankr.com/bsc',
	'https://bsc-dataseed.binance.org/'
]

function sleepMs(ms: number): Promise<void> {
	return new Promise((resolve) => {
		setTimeout(() => {
			resolve()
		}, ms)
	})
}

function rpcPostUni(url: string, jsonBody: string): Promise<UTSJSONObject> {
	return new Promise((resolve, reject) => {
		uni.request({
			url: url,
			method: 'POST',
			timeout: 8000,
			header: {
				'Content-Type': 'application/json',
				'Accept': 'application/json'
			},
			data: jsonBody,
			success: (res) => {
				try {
					const code = res.statusCode
					if (code < 200 || code >= 300) {
						reject(new Error('RPC_HTTP_' + code))
						return
					}
					const raw = res.data
					if (raw == null) {
						reject(new Error('RPC empty'))
						return
					}
					try {
						const asStr = '' + raw
						if (asStr.length > 0 && asStr.charAt(0) == '{') {
							resolve(JSON.parse(asStr) as UTSJSONObject)
							return
						}
					} catch (eStr) {}
					resolve(raw as UTSJSONObject)
				} catch (e) {
					reject(new Error('RPC parse fail'))
				}
			},
			fail: (err) => {
				reject(new Error(err.errMsg))
			}
		})
	})
}

function httpGetUni(url: string): Promise<string> {
	return new Promise((resolve, reject) => {
		uni.request({
			url: url,
			method: 'GET',
			timeout: 8000,
			header: { 'Accept': 'application/json' },
			success: (res) => {
				try {
					const code = res.statusCode
					if (code < 200 || code >= 300) {
						reject(new Error('HTTP_' + code))
						return
					}
					resolve('' + res.data)
				} catch (e) {
					reject(new Error('HTTP parse fail'))
				}
			},
			fail: (err) => {
				reject(new Error(err.errMsg))
			}
		})
	})
}

async function rpcPostJson(url: string, jsonBody: string): Promise<UTSJSONObject> {
	return await rpcPostUni(url, jsonBody)
}

function parseReceiptStatus(root: UTSJSONObject): string {
	const errObj = root['error']
	if (errObj != null) return 'error'
	const result = root['result']
	if (result == null) return 'pending'
	try {
		const receipt = result as UTSJSONObject
		const v = receipt['status']
		if (v != null) return ('' + v).toLowerCase()
	} catch (e0) {}
	return 'unknown'
}

/** BscScan 公共接口兜底（不依赖 JSON-RPC） */
async function checkBscScanStatus(txHash: string): Promise<string> {
	try {
		const url = 'https://api.bscscan.com/api?module=transaction&action=gettxreceiptstatus&txhash=' + txHash
		const text = await httpGetUni(url)
		if (text.length == 0) return 'error'
		const o = JSON.parse(text) as UTSJSONObject
		const data = o['result']
		if (data == null) return 'pending'
		const row = data as UTSJSONObject
		const st = '' + (row['status'] != null ? row['status'] : '')
		console.log('[tp] bscscan status=', st)
		if (st == '1') return '0x1'
		if (st == '0') return '0x0'
		return 'pending'
	} catch (e) {
		console.warn('[tp] bscscan fail', e)
	}
	return 'error'
}

export type TxConfirmResult = {
	/** confirmed | failed | timeout | network */
	status: string
	txHash: string
	message: string
}

/**
 * 等待 BSC 交易回执。网络不可达时返回 network，由 UI 决定是否手动继续同步。
 */
export async function waitBscTxConfirmed(txHash: string, maxWaitMs: number = 45000): Promise<TxConfirmResult> {
	const out: TxConfirmResult = {
		status: 'timeout',
		txHash: txHash,
		message: ''
	}
	if (txHash.length < 66 || txHash.indexOf('0x') != 0) {
		out.status = 'failed'
		out.message = '无效交易哈希'
		return out
	}
	await sleepMs(1200)
	const started = Date.now()
	let rpcIdx = 0
	let netFails = 0
	let pendingHits = 0
	const jsonBody = '{"jsonrpc":"2.0","id":1,"method":"eth_getTransactionReceipt","params":["' + txHash + '"]}'
	while (Date.now() - started < maxWaitMs) {
		const rpc = BSC_RPCS[rpcIdx % BSC_RPCS.length]
		rpcIdx++
		try {
			const root = await rpcPostJson(rpc, jsonBody)
			const st = parseReceiptStatus(root)
			console.log('[tp] receipt', rpc, 'st=', st)
			if (st == '0x1' || st == '0x01' || st == '1') {
				out.status = 'confirmed'
				out.message = '链上已确认'
				return out
			}
			if (st == '0x0' || st == '0x00' || st == '0') {
				out.status = 'failed'
				out.message = '链上交易失败（已回滚）'
				return out
			}
			if (st == 'pending' || st == 'unknown') {
				pendingHits++
				netFails = 0
			}
			if (st == 'error') netFails++
		} catch (e) {
			netFails++
			console.warn('[tp] wait receipt', rpc, e)
		}
		// 每轮失败多时试 BscScan
		if (netFails > 0 && netFails % 3 == 0) {
			const bs = await checkBscScanStatus(txHash)
			if (bs == '0x1') {
				out.status = 'confirmed'
				out.message = '链上已确认(BscScan)'
				return out
			}
			if (bs == '0x0') {
				out.status = 'failed'
				out.message = '链上交易失败（BscScan）'
				return out
			}
		}
		await sleepMs(2000)
	}
	// 超时：若几乎全是网络失败 → network；若见过 pending → timeout
	if (pendingHits == 0 && netFails > 0) {
		out.status = 'network'
		out.message = '无法连接 BSC 节点确认交易，可到钱包/BscScan 核对后手动同步'
	} else {
		out.status = 'timeout'
		out.message = '等待确认超时，请到 BscScan 核对：' + txHash
	}
	return out
}

/**
 * 拉起 TP 转 USDT（BSC）
 * to=收款地址 amount=人类可读数量（如 "100"）
 */
export async function tpTransferUsdt(to: string, amount: string, desc: string = ''): Promise<TpTransferResult> {
	if (to.length == 0) throw new Error('收款地址为空')
	if (amount.length == 0) throw new Error('金额为空')
	let from = loadTpWalletAddress()
	if (from.length == 0) {
		// 未缓存地址时先授权拿 from
		const auth = await tpSdkAuthorize()
		if (!auth.ok || auth.wallet.length == 0) throw new Error('请先连接钱包')
		from = auth.wallet
	}
	const actionId = newActionId()
	const memo = desc.length > 0 ? desc : 'itiklink-usdt-pay'
	const r = await sdkTransfer(
		from,
		to,
		TP_USDT_CONTRACT,
		amount,
		'' + TP_USDT_DECIMALS,
		'USDT',
		memo,
		actionId,
		TP_PAY_CHAIN_ID,
		DAPP_NAME,
		DAPP_ICON
	)
	if (r.wallet.length > 0) saveTpWalletAddress(r.wallet)
	let tx = extractTxHash(r.signature, r.raw)
	const out: TpTransferResult = {
		ok: r.code == 0 && tx.length > 0,
		txHash: tx,
		wallet: r.wallet.length > 0 ? r.wallet : from,
		raw: r.raw
	}
	if (!out.ok && r.code == 0) {
		throw new Error('转账已提交但未解析到交易哈希，请稍后在钱包核对')
	}
	if (!out.ok) throw new Error(r.raw.length > 0 ? r.raw : '转账失败')
	return out
}

/** 从 TP 回包抽出 0x 交易哈希，禁止把整段 JSON 当 trade_no */
function extractTxHash(sig: string, raw: string): string {
	if (sig.length >= 66 && sig.indexOf('0x') == 0 && sig.indexOf('{') < 0) return sig
	const text = raw.length > 0 ? raw : sig
	if (text.length == 0) return ''
	if (text.indexOf('{') == 0) {
		try {
			const o = JSON.parse(text) as UTSJSONObject
			let h = pickStr(o, 'txID')
			if (h.length == 0) h = pickStr(o, 'txId')
			if (h.length == 0) h = pickStr(o, 'txHash')
			if (h.length == 0) h = pickStr(o, 'hash')
			if (h.length == 0) h = pickStr(o, 'transactionHash')
			if (h.length >= 66 && h.indexOf('0x') == 0) return h
		} catch (e) {}
	}
	// 兜底：在文本里找 0x + 64 hex
	const idx = text.indexOf('0x')
	if (idx >= 0 && text.length >= idx + 66) {
		const cand = text.substring(idx, idx + 66)
		if (cand.indexOf('{') < 0 && cand.indexOf('"') < 0) return cand
	}
	return ''
}

/** Mobile-SDK ethPersonalSign（用于 SIWE challenge.message） */
export async function tpSdkPersonalSign(message: string): Promise<TpCallbackResult> {
	const actionId = newActionId()
	const r = await sdkPersonalSign(message, actionId, '56', DAPP_NAME, DAPP_ICON, 'itiklink-siwe', 'ethPersonalSign')
	return sdkToCallback(r)
}

/** tp-login：用 ticket 作 actionId，挂 pendingCb 等 Assist 回传签名 */
export async function tpSdkSignTicket(message: string, ticket: string): Promise<TpCallbackResult> {
	if (message.length == 0 || ticket.length == 0) {
		const empty: TpCallbackResult = { ok: false, action: '', actionId: '', wallet: '', signature: '', raw: '' }
		return empty
	}
	const r = await sdkPersonalSign(message, ticket, '56', DAPP_NAME, DAPP_ICON, 'itiklink-tp-login', 'ethPersonalSign')
	return sdkToCallback(r)
}

/** 解析服务端 deeplink 的 param JSON（兼容 + 表示空格） */
export function parseTpDeeplinkParam(deeplink: string): UTSJSONObject | null {
	const marker = 'param='
	const idx = deeplink.indexOf(marker)
	if (idx < 0) return null
	let enc = deeplink.substring(idx + marker.length)
	const amp = enc.indexOf('&')
	if (amp >= 0) enc = enc.substring(0, amp)
	// application/x-www-form-urlencoded：+ = 空格
	const fixed = enc.split('+').join('%20')
	try {
		const decoded = decodeURIComponent(fixed)
		if (decoded == null || decoded.length < 2) return null
		return JSON.parse(decoded) as UTSJSONObject
	} catch (e) {
		return null
	}
}

/**
 * 只补 signType（服务端常缺），尽量不改其它字段。
 * 不注入 callbackSchema：部分 TP 校验失败时会只进首页不弹窗；票务流靠 HTTPS callbackUrl。
 */
export function enrichTpLoginDeeplink(deeplink: string): string {
	if (deeplink.length == 0) return deeplink
	const o = parseTpDeeplinkParam(deeplink)
	if (o == null) {
		console.warn('[tp] enrich parse fail, use raw')
		return deeplink
	}
	try {
		const action = pickStr(o, 'action')
		const st0 = pickStr(o, 'signType')
		if (st0.length == 0 && action == 'sign') {
			o['signType'] = 'ethPersonalSign'
			o['hash'] = false
		}
		// 保留 HTTPS 给服务端验票；schema 仅用于签完跳回 App
		o['callbackSchema'] = TP_CALLBACK_SCHEMA
		const cb = pickStr(o, 'callbackUrl')
		if (cb.indexOf('http') != 0) {
			o['callbackUrl'] = 'https://m.itiklink.com/api/v1/auth/wallet/tp-login'
		}
		const msg = pickStr(o, 'message')
		console.log(
			'[tp] enrich action=', action,
			'signType=', pickStr(o, 'signType'),
			'msgLen=', msg.length,
			'cb=', cb.substring(0, 40)
		)
		const json = JSON.stringify(o)
		// 文档要求 encodeURIComponent（H5 同款）；勿用 URLEncoder 的 + 空格
		return 'tpoutside://pull.activity?param=' + encodeURIComponent(json)
	} catch (e) {
		return deeplink
	}
}

/**
 * 拉起 TP PullUpActivity（官方 SDK 同款 extras）。
 */
export function openTpPullUri(deeplink: string): boolean {
	if (deeplink.length == 0) return false
	console.log('[tp] openPull len=', deeplink.length, 'head=', deeplink.substring(0, 48))
	// #ifdef APP-ANDROID
	try {
		const act = UTSAndroid.getUniActivity()
		if (act == null) return false
		const intent = new Intent(Intent.ACTION_VIEW, Uri.parse(deeplink))
		intent.setClassName(TP_PKG, 'com.tokenbank.pull.PullUpActivity')
		intent.putExtra('packageName', act.getPackageName())
		intent.putExtra('className', ASSIST_CLASS)
		intent.putExtra('appName', DAPP_NAME)
		try {
			const ri = intent.resolveActivity(act.getPackageManager())
			console.log('[tp] resolve=', ri != null ? ('' + ri) : 'null')
		} catch (eR) {}
		act.startActivity(intent)
		return true
	} catch (e1) {
		console.warn('[tp] openPull className fail', e1)
		try {
			const act2 = UTSAndroid.getUniActivity()
			if (act2 == null) return false
			const intent2 = new Intent(Intent.ACTION_VIEW, Uri.parse(deeplink))
			intent2.putExtra('packageName', act2.getPackageName())
			intent2.putExtra('className', ASSIST_CLASS)
			intent2.putExtra('appName', DAPP_NAME)
			act2.startActivity(intent2)
			return true
		} catch (e2) {
			console.warn('[tp] openPull retry fail', e2)
			return false
		}
	}
	// #endif
	return openExternalUrl(deeplink)
}

/** 走官方 applink 页（文档写明 DeepLink 面向系统浏览器；App 内直调常只进首页） */
export function openTpUniversalLink(deeplink: string): boolean {
	const p = parseTpDeeplinkParam(deeplink)
	if (p == null) return false
	const st = pickStr(p, 'signType')
	if (st.length == 0 && pickStr(p, 'action') == 'sign') {
		p['signType'] = 'ethPersonalSign'
		p['hash'] = false
	}
	const enc = encodeURIComponent(JSON.stringify(p))
	const link = 'https://tokenpocket.github.io/applink?param=' + enc
	console.log('[tp] open universal len=', link.length)
	// #ifdef APP-ANDROID
	try {
		const act = UTSAndroid.getUniActivity()
		if (act == null) return false
		const intent = new Intent(Intent.ACTION_VIEW, Uri.parse(link))
		act.startActivity(intent)
		return true
	} catch (e) {
		console.warn('[tp] universal fail', e)
		return false
	}
	// #endif
	return openExternalUrl(link)
}

/**
 * 无服务端 deeplink 时：本地拼 sign 协议再拉起
 */
export function openTpTicketSign(
	message: string,
	actionId: string,
	callbackUrl: string,
	chainId: string
): boolean {
	if (message.length == 0 || actionId.length == 0) return false
	const cb = callbackUrl.length > 0 ? callbackUrl : 'https://m.itiklink.com/api/v1/auth/wallet/tp-login'
	const cid = chainId.length > 0 ? chainId : '56'
	const chains: Array<UTSJSONObject> = []
	const c1: UTSJSONObject = { chainId: cid, network: 'ethereum' }
	chains.push(c1)
	const param: UTSJSONObject = {
		protocol: 'TokenPocket',
		version: '1.0',
		dappName: 'ITIK',
		dappIcon: 'https://m.itiklink.com/assets/img/logo.png',
		action: 'sign',
		actionId: actionId,
		message: message,
		signType: 'ethPersonalSign',
		hash: false,
		callbackUrl: cb,
		callbackSchema: TP_CALLBACK_SCHEMA,
		blockchains: chains
	}
	const json = JSON.stringify(param)
	console.log('[tp] pullTicketSign jsonLen=', json.length, 'chain=', cid)
	const link = 'tpoutside://pull.activity?param=' + encodeURIComponent(json)
	return openTpUniversalLink(link) || openTpPullUri(link)
}

function buildPullUrl(paramObj: UTSJSONObject): string {
	const json = JSON.stringify(paramObj)
	return 'tpoutside://pull.activity?param=' + encodeURIComponent(json)
}

export function buildTpLoginUrl(actionId: string): string {
	const chains: Array<UTSJSONObject> = []
	const c1: UTSJSONObject = { chainId: '1', network: 'ethereum' }
	chains.push(c1)
	const param: UTSJSONObject = {
		protocol: 'TokenPocket',
		version: '2.0',
		dappName: DAPP_NAME,
		dappIcon: DAPP_ICON,
		action: 'login',
		actionId: actionId,
		memo: 'itiklink-auth-login',
		callbackUrl: TP_CALLBACK_URL,
		callbackSchema: TP_CALLBACK_SCHEMA,
		blockchains: chains
	}
	return buildPullUrl(param)
}

export function buildTpSignUrl(actionId: string, message: string): string {
	const chains: Array<UTSJSONObject> = []
	const c1: UTSJSONObject = { chainId: '1', network: 'ethereum' }
	chains.push(c1)
	const param: UTSJSONObject = {
		protocol: 'TokenPocket',
		version: '2.0',
		dappName: DAPP_NAME,
		dappIcon: DAPP_ICON,
		action: 'sign',
		actionId: actionId,
		signType: 'ethPersonalSign',
		hash: false,
		memo: 'itiklink-siwe',
		message: message,
		callbackUrl: TP_CALLBACK_URL,
		callbackSchema: TP_CALLBACK_SCHEMA,
		blockchains: chains
	}
	return buildPullUrl(param)
}

export function openExternalUrl(url: string): boolean {
	if (url.length == 0) return false
	if (url.indexOf('tpoutside://') == 0 || url.indexOf('tp://') == 0) {
		return openTpPullUri(url)
	}
	// #ifdef APP-ANDROID
	try {
		const act = UTSAndroid.getUniActivity()
		if (act == null) return false
		const intent = new Intent(Intent.ACTION_VIEW, Uri.parse(url))
		act.startActivity(intent)
		return true
	} catch (eAd) {
		console.warn('[tp] open android fail', eAd)
		return false
	}
	// #endif
	// #ifdef H5
	try {
		const w = window as any
		if (w != null && w.location != null) {
			w.location.href = url
			return true
		}
	} catch (eH5) {}
	// #endif
	return false
}

function parseQuery(url: string): UTSJSONObject {
	const out: UTSJSONObject = {}
	let q = ''
	const qi = url.indexOf('?')
	if (qi >= 0) q = url.substring(qi + 1)
	else if (url.indexOf('=') > 0 && url.indexOf('://') < 0) q = url
	if (q.length == 0) return out
	const parts = q.split('&')
	for (let i = 0; i < parts.length; i++) {
		const p = parts[i]
		const ei = p.indexOf('=')
		if (ei <= 0) continue
		let k = p.substring(0, ei)
		let v = p.substring(ei + 1)
		try {
			const dk = decodeURIComponent(k)
			if (dk != null && dk.length > 0) k = dk
		} catch (e1) {}
		try {
			const dv = decodeURIComponent(v)
			if (dv != null) v = dv
		} catch (e2) {}
		out[k] = v
	}
	return out
}

function extractSignature(signField: string): string {
	if (signField.length == 0) return ''
	if (signField.indexOf('0x') == 0 && signField.indexOf('{') < 0) return signField
	try {
		const o = JSON.parse(signField) as UTSJSONObject
		const s1 = pickStr(o, 'signature')
		if (s1.length > 0) return s1
		const s2 = pickStr(o, 'sign')
		if (s2.length > 0) return s2
	} catch (e) {}
	return signField
}

export function parseTpCallback(urlOrQuery: string): TpCallbackResult {
	const empty: TpCallbackResult = {
		ok: false,
		action: '',
		actionId: '',
		wallet: '',
		signature: '',
		raw: urlOrQuery
	}
	if (urlOrQuery.length == 0) return empty
	const q = parseQuery(urlOrQuery)
	let wallet = pickStr(q, 'wallet')
	if (wallet.length == 0) wallet = pickStr(q, 'account')
	if (wallet.length == 0) wallet = pickStr(q, 'publickey')
	const action = pickStr(q, 'action')
	const actionId = pickStr(q, 'actionId')
	let signature = extractSignature(pickStr(q, 'sign'))
	if (signature.length == 0) signature = extractSignature(pickStr(q, 'signature'))
	const resultRaw = pickStr(q, 'result')
	const ok = resultRaw == '1' || resultRaw.toLowerCase() == 'true' || wallet.length > 0 || signature.length > 0
	const out: TpCallbackResult = {
		ok: ok,
		action: action,
		actionId: actionId,
		wallet: wallet,
		signature: signature,
		raw: urlOrQuery
	}
	return out
}

export function readAndroidLaunchUri(): string {
	// #ifdef APP-ANDROID
	try {
		const act = UTSAndroid.getUniActivity()
		if (act == null) return ''
		const intent = act.getIntent()
		if (intent == null) return ''
		try {
			const data = intent.getData()
			if (data != null) {
				const s = data.toString()
				if (s != null && ('' + s).length > 0) return '' + s
			}
		} catch (e0) {}
		try {
			const ds = intent.getDataString()
			if (ds != null && ('' + ds).length > 0) return '' + ds
		} catch (e1) {}
	} catch (e) {
		console.warn('[tp] read intent fail', e)
	}
	// #endif
	return ''
}

export function captureTpCallbackFromIntent(): string {
	const uri = readAndroidLaunchUri()
	if (uri.length > 0 && uri.indexOf('itiklink://') >= 0) {
		try { uni.setStorageSync(LAST_CB_KEY, uri) } catch (e) {}
		// 若 SDK Promise 还在等，把 schema 结果喂回去
		try { sdkDeliverSchema(uri) } catch (e0) {}
		return uri
	}
	return ''
}

export function loadCapturedTpCallback(): string {
	try {
		const raw = uni.getStorageSync(LAST_CB_KEY)
		if (raw == null) return ''
		return '' + raw
	} catch (e) {
		return ''
	}
}

export function clearCapturedTpCallback(): void {
	try { uni.removeStorageSync(LAST_CB_KEY) } catch (e) {}
}

export function takeTpCallbackUri(): string {
	const live = captureTpCallbackFromIntent()
	if (live.length > 0) return live
	return loadCapturedTpCallback()
}

/** @deprecated 主路径已改 SDK；保留 DeepLink 兜底 */
export function openTpLogin(actionId: string): boolean {
	return openExternalUrl(buildTpLoginUrl(actionId))
}

/** @deprecated 主路径已改 SDK */
export function openTpSign(actionId: string, message: string): boolean {
	return openExternalUrl(buildTpSignUrl(actionId, message))
}
