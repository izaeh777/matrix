/**
 * 本地存储工具
 * 封装 uni-app 的 uni.setStorage / uni.getStorage，自动做 JSON 转换
 */

const KEY_SESSION = 'matrix_session_v1'
const KEY_SYNC_SINCE = 'matrix_sync_since_v1'

function storeStr(obj: UTSJSONObject, key: string): string {
	try {
		const v = obj[key]
		if (v != null) {
			const t = '' + v
			if (t.length > 0 && t != 'null' && t != 'undefined') return t
		}
	} catch (e0) {}
	try {
		const s = obj.getString(key)
		if (s != null && s.length > 0) return s
	} catch (e1) {}
	return ''
}

export type SessionInfo = {
	homeserver: string
	user_id: string
	access_token: string
	device_id: string
	display_name: string
	avatar_url: string
}

type SessionSaveHook = () => void
let _afterSessionSave: SessionSaveHook | null = null

/** 多账号：Matrix 会话落盘后回调（由 accounts 注册） */
export function setAfterSessionSave(fn: SessionSaveHook | null): void {
	_afterSessionSave = fn
}

export function saveSession(session: SessionInfo): void {
	try {
		uni.setStorageSync(KEY_SESSION, JSON.stringify(session))
	} catch (e) {
		console.error('saveSession 失败', e)
	}
	try {
		const after = _afterSessionSave
		if (after != null) after()
	} catch (e2) {}
}

export function loadSession(): SessionInfo | null {
	try {
		const raw = uni.getStorageSync(KEY_SESSION)
		if (raw == null) return null
		let text = ''
		try {
			text = ('' + raw).trim()
		} catch (e0) {
			text = ''
		}
		if (text.length == 0) return null
		if (text.charAt(0) != '{') {
			try {
				text = JSON.stringify(raw).trim()
			} catch (e1) {
				return null
			}
		}
		if (text.charAt(0) != '{') return null
		const obj = JSON.parse(text) as UTSJSONObject
		const token = storeStr(obj, 'access_token')
		const hs = storeStr(obj, 'homeserver')
		const uid = storeStr(obj, 'user_id')
		const did = storeStr(obj, 'device_id')
		if (token.length == 0) return null
		if (hs.length == 0) return null
		if (uid.length == 0) return null
		const session: SessionInfo = {
			homeserver: hs,
			user_id: uid,
			access_token: token,
			device_id: did,
			display_name: storeStr(obj, 'display_name'),
			avatar_url: storeStr(obj, 'avatar_url')
		}
		return session
	} catch (e) {
		console.error('loadSession 失败', e)
	}
	return null
}

export function saveSyncSince(since: string): void {
	try {
		if (since != null && since.length > 0) {
			uni.setStorageSync(KEY_SYNC_SINCE, since)
		}
	} catch (e) {}
}

export function loadSyncSince(): string {
	try {
		const raw = uni.getStorageSync(KEY_SYNC_SINCE)
		if (typeof raw === 'string' && raw.length > 0) return raw
	} catch (e) {}
	return ''
}

export function clearSyncSince(): void {
	try {
		uni.removeStorageSync(KEY_SYNC_SINCE)
	} catch (e) {}
}

/**
 * 清除当前 Matrix 会话。
 * wipeAllChats=false 时保留各账号聊天缓存（多账号切换 / 仅退当前号）。
 */
export function clearSession(wipeAllChats: boolean = true): void {
	try {
		uni.removeStorageSync(KEY_SESSION)
		uni.removeStorageSync(KEY_SYNC_SINCE)
		if (wipeAllChats) clearRoomChats()
	} catch (e) {
		console.error('clearSession 失败', e)
	}
}

const KEY_CHAT_PREFIX = 'matrix_chat_v1:'
const KEY_ROOM_LIST_PREFIX = 'matrix_rooms_v1:'

export type CachedRoomChat = {
	prev: string
	msgs: Array<UTSJSONObject>
}

/** 进程内缓存：离开聊天页再进时先命中内存，避免每次都等磁盘/网络 */
const memRoomChat: Map<string, CachedRoomChat> = new Map()

function roomChatKey(userId: string, roomId: string): string {
	return userId + ':' + roomId
}

export function saveRoomChat(userId: string, roomId: string, prev: string, msgs: Array<UTSJSONObject>): void {
	if (userId.length == 0 || roomId.length == 0) return
	const key = roomChatKey(userId, roomId)
	const snap: CachedRoomChat = {
		prev: prev,
		msgs: msgs
	}
	memRoomChat.set(key, snap)
	const body: UTSJSONObject = {}
	body['prev'] = prev
	body['msgs'] = msgs
	try {
		uni.setStorageSync(KEY_CHAT_PREFIX + key, JSON.stringify(body))
	} catch (e) {
		console.warn('saveRoomChat fail', e)
	}
}

export function loadRoomChat(userId: string, roomId: string): CachedRoomChat | null {
	if (userId.length == 0 || roomId.length == 0) return null
	const key = roomChatKey(userId, roomId)
	const mem = memRoomChat.get(key)
	if (mem != null && mem.msgs.length > 0) {
		return mem
	}
	try {
		const raw = uni.getStorageSync(KEY_CHAT_PREFIX + key)
		if (raw == null) return null
		let text = ''
		try {
			text = ('' + raw).trim()
		} catch (e0) {
			text = ''
		}
		if (text.length == 0 || text.charAt(0) != '{') return null
		const obj = JSON.parse(text) as UTSJSONObject
		const prev = storeStr(obj, 'prev')
		const msgs: Array<UTSJSONObject> = []
		let rawArr: Array<any> | null = null
		try {
			const v = obj['msgs']
			if (v != null) rawArr = v as Array<any>
		} catch (e1) {
			rawArr = null
		}
		if (rawArr == null) {
			try {
				const got = obj.getArray('msgs')
				if (got != null) {
					const tmp: Array<any> = []
					for (let gi = 0; gi < got.length; gi++) {
						tmp.push(got[gi] as any)
					}
					rawArr = tmp
				}
			} catch (e2) {
				rawArr = null
			}
		}
		if (rawArr != null) {
			for (let i = 0; i < rawArr.length; i++) {
				const one = rawArr[i]
				if (one == null) continue
				msgs.push(one as UTSJSONObject)
			}
		}
		if (msgs.length == 0) return null
		const out: CachedRoomChat = {
			prev: prev,
			msgs: msgs
		}
		memRoomChat.set(key, out)
		return out
	} catch (e) {
		console.warn('loadRoomChat fail', e)
	}
	return null
}

export function saveRoomList(userId: string, rooms: Array<UTSJSONObject>): void {
	if (userId.length == 0) return
	const body: UTSJSONObject = {}
	body['rooms'] = rooms
	try {
		uni.setStorageSync(KEY_ROOM_LIST_PREFIX + userId, JSON.stringify(body))
	} catch (e) {
		console.warn('saveRoomList fail', e)
	}
}

export function loadRoomList(userId: string): Array<UTSJSONObject> {
	const out: Array<UTSJSONObject> = []
	if (userId.length == 0) return out
	try {
		const raw = uni.getStorageSync(KEY_ROOM_LIST_PREFIX + userId)
		if (raw == null) return out
		let text = ''
		try {
			text = ('' + raw).trim()
		} catch (e0) {
			text = ''
		}
		if (text.length == 0 || text.charAt(0) != '{') return out
		const obj = JSON.parse(text) as UTSJSONObject
		let rawArr: Array<any> | null = null
		try {
			const v = obj['rooms']
			if (v != null) rawArr = v as Array<any>
		} catch (e1) {
			rawArr = null
		}
		if (rawArr == null) {
			try {
				const got = obj.getArray('rooms')
				if (got != null) {
					const tmp: Array<any> = []
					for (let gi = 0; gi < got.length; gi++) {
						tmp.push(got[gi] as any)
					}
					rawArr = tmp
				}
			} catch (e2) {
				rawArr = null
			}
		}
		if (rawArr == null) return out
		for (let i = 0; i < rawArr.length; i++) {
			const one = rawArr[i]
			if (one == null) continue
			out.push(one as UTSJSONObject)
		}
	} catch (e) {
		console.warn('loadRoomList fail', e)
	}
	return out
}

export function clearRoomChats(): void {
	memRoomChat.clear()
	try {
		const info = uni.getStorageInfoSync()
		const keys = info.keys
		for (let i = 0; i < keys.length; i++) {
			const k = keys[i]
			if (k.indexOf(KEY_CHAT_PREFIX) == 0 || k.indexOf(KEY_ROOM_LIST_PREFIX) == 0) {
				uni.removeStorageSync(k)
			}
		}
	} catch (e) {}
}

/** 只清某个 Matrix 用户的房间列表 / 聊天缓存（多账号切换时用） */
export function clearUserRoomCaches(userId: string): void {
	if (userId.length == 0) return
	const chatPref = KEY_CHAT_PREFIX + userId + ':'
	const roomKey = KEY_ROOM_LIST_PREFIX + userId
	const dropKeys: Array<string> = []
	memRoomChat.forEach((_v: CachedRoomChat, k: string) => {
		if (k.indexOf(userId + ':') == 0) dropKeys.push(k)
	})
	for (let di = 0; di < dropKeys.length; di++) {
		memRoomChat.delete(dropKeys[di])
	}
	try {
		const info = uni.getStorageInfoSync()
		const keys = info.keys
		for (let i = 0; i < keys.length; i++) {
			const k = keys[i]
			if (k == roomKey || k.indexOf(chatPref) == 0) {
				uni.removeStorageSync(k)
			}
		}
	} catch (e) {}
}
