let _readyZhTw = false
function ensureZhTw(): void {
	if (_readyZhTw) return
	_readyZhTw = true
	fillZhTwP0()
	fillZhTwP1()
	fillZhTwP2()
	fillZhTwP3()
	fillZhTwP4()
	fillZhTwP5()
}

