let _readyZhCn = false
function ensureZhCn(): void {
	if (_readyZhCn) return
	_readyZhCn = true
	fillZhCnP0()
	fillZhCnP1()
	fillZhCnP2()
	fillZhCnP3()
	fillZhCnP4()
	fillZhCnP5()
}

