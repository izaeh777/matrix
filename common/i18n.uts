	'pub.submit', 'Gửi duyệt',
	'pub.submitting', 'Đang gửi…',
	'pub.visitorBlock', 'Khách không thể đăng. Vui lòng đăng ký gói.',
	'api.visitor', 'Khách',
	'api.normalUser', 'Thường',
	'api.member', 'Hội viên',
	'api.owner', 'Chủ dự án',
	'api.leader', 'Trưởng cộng đồng',
	'api.subActive', 'Đang hiệu lực',
	'api.subNone', 'Chưa có gói',
	'api.subExpired', 'Gói đã hết hạn',
	'api.pendingPay', 'Chờ thanh toán',
	'api.periodRange', 'Hiệu lực: {s} – {e}',
	'api.periodUntil', 'Đến {e}',
	'api.remainDays', 'Còn {n} ngày',
	'api.goSubscribe', 'Đăng ký',
