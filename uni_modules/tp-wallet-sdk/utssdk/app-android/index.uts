import {
	TpAuthorize,
	TpPersonalSign,
	TpTransfer,
	TpIsInstalled,
	TpDeliverSchema,
	TpSdkResult
} from '../interface.uts'
import { TpWalletNative } from 'uts.sdk.modules.tpWalletSdk'

const DEFAULT_DAPP = 'i-tiklink'
const DEFAULT_ICON = 'https://m.itiklink.com/favicon.ico'
const DEFAULT_CHAIN = '1'

function pickStr(obj: UTSJSONObject, key: string): string {
	try {
		const v = obj[key]
		if (v != null) {
			const s = '' + v
			if (s.length > 0 && s != 'null' && s != 'undefined' && s.indexOf('[object') < 0) return s
		}
	} catch (e0) {}
	return ''
}

function extractSignature(signField: string): string {
	if (signField.length == 0) return ''
	if (signField.indexOf('0x') == 0 && signField.indexOf('{') < 0) return signField
	try {
		const o = JSON.parse(signField) as UTSJSONObject
		const s1 = pickStr(o, 'signature')
		if (s1.length > 0) return s1
		const s2 = pickStr(o, 'sign')
		if (s2.length > 0) return s2
	} catch (e) {}
	return signField
}

/** sign 字段可能是字符串，也可能已是嵌套对象 */
function pickSignature(obj: UTSJSONObject): string {
	try {
		const v = obj['sign']
		if (v != null) {
			try {
				const nested = v as UTSJSONObject
				const s1 = pickStr(nested, 'signature')
				if (s1.length > 0) return s1
				const s2 = pickStr(nested, 'sign')
				if (s2.length > 0) return extractSignature(s2)
			} catch (eN) {}
			const asStr = pickStr(obj, 'sign')
			if (asStr.length > 0) return extractSignature(asStr)
		}
	} catch (e0) {}
	try {
		const v2 = obj['signature']
		if (v2 != null) {
			try {
				const nested2 = v2 as UTSJSONObject
				const s3 = pickStr(nested2, 'signature')
				if (s3.length > 0) return s3
			} catch (eN2) {}
			return extractSignature(pickStr(obj, 'signature'))
		}
	} catch (e1) {}
	return ''
}

function parseSdkPayload(code: number, raw: string): TpSdkResult {
	let wallet = ''
	let signature = ''
	let action = ''
	let actionId = ''
	const text = raw != null ? ('' + raw) : ''
	if (text.length > 0) {
		// 错误文案可能含 Java 堆栈，勿当 JSON 强解
		const looksJson = text.indexOf('{') == 0 || text.indexOf('[') == 0
		if (looksJson) {
			try {
				const o = JSON.parse(text) as UTSJSONObject
				wallet = pickStr(o, 'wallet')
				if (wallet.length == 0) wallet = pickStr(o, 'account')
				if (wallet.length == 0) wallet = pickStr(o, 'publickey')
				action = pickStr(o, 'action')
				actionId = pickStr(o, 'actionId')
				signature = pickSignature(o)
			} catch (e1) {}
		} else if (code == 0 && text.indexOf('0x') == 0 && text.length >= 42) {
			wallet = text.substring(0, 42)
		}
	}
	const out: TpSdkResult = {
		code: code,
		raw: text,
		wallet: wallet,
		signature: signature,
		action: action,
		actionId: actionId
	}
	return out
}

function newActionId(): string {
	return 'itik-' + Date.now() + '-' + Math.floor(Math.random() * 100000)
}

function orDefault(v: string, def: string): string {
	if (v != null && v.length > 0) return v
	return def
}

function friendlyErr(raw: string): string {
	const t = raw != null ? ('' + raw) : ''
	if (t.indexOf('NoClassDefFoundError') >= 0 || t.indexOf('com.tokenpocket.opensdk') >= 0) {
		return '当前自定义基座未包含 TokenPocket SDK。请在 HBuilderX：运行 → 制作自定义调试基座（抬高版本号后重装），再用新基座测试。'
	}
	if (t.indexOf('gasLimit is too low') >= 0 || t.indexOf('gasLimit') >= 0 && t.indexOf('too low') >= 0) {
		return '钱包估算 Gas 失败（gasLimit 过低）。请确认 TP 已切到 BSC，账户有少量 BNB 作手续费后重试。'
	}
	if (t.indexOf('insufficient funds') >= 0 || t.indexOf('Insufficient') >= 0) {
		return '余额不足（USDT 或 BNB 手续费）'
	}
	// 尝试从 TP 返回 JSON 里抽出 message.error
	try {
		const o = JSON.parse(t) as UTSJSONObject
		let msg = pickStr(o, 'message')
		if (msg.indexOf('{') == 0) {
			try {
				const inner = JSON.parse(msg) as UTSJSONObject
				const err = pickStr(inner, 'error')
				if (err.length > 0) msg = err
			} catch (e1) {}
		}
		if (msg.length > 0) {
			if (msg.length > 160) return msg.substring(0, 160) + '…'
			return msg
		}
	} catch (e0) {}
	if (t.length > 180) return t.substring(0, 180) + '…'
	return t.length > 0 ? t : 'TokenPocket 调用失败'
}

export const tpAuthorize: TpAuthorize = function (
	actionId: string,
	chainId: string,
	dappName: string,
	dappIcon: string,
	memo: string
): Promise<TpSdkResult> {
	return new Promise<TpSdkResult>((resolve, reject) => {
		const aid = orDefault(actionId, newActionId())
		const cid = orDefault(chainId, DEFAULT_CHAIN)
		const name = orDefault(dappName, DEFAULT_DAPP)
		const icon = orDefault(dappIcon, DEFAULT_ICON)
		const m = orDefault(memo, 'itiklink-auth-login')
		console.log('[tp-sdk] authorize', aid, cid)
		TpWalletNative.authorize(aid, name, icon, m, cid, (code: number, data: string) => {
			const result = parseSdkPayload(code, data)
			console.log('[tp-sdk] authorize result', code, 'wallet=', result.wallet, 'sigLen=', result.signature.length)
			if (code == 0) {
				resolve(result)
			} else if (code == 2) {
				reject('用户取消授权')
			} else {
				reject(friendlyErr(result.raw))
			}
		})
	})
}

export const tpPersonalSign: TpPersonalSign = function (
	message: string,
	actionId: string,
	chainId: string,
	dappName: string,
	dappIcon: string,
	memo: string,
	signType: string
): Promise<TpSdkResult> {
	return new Promise<TpSdkResult>((resolve, reject) => {
		if (message == null || message.length == 0) {
			reject('签名消息为空')
			return
		}
		const aid = orDefault(actionId, newActionId())
		const cid = orDefault(chainId, DEFAULT_CHAIN)
		const name = orDefault(dappName, DEFAULT_DAPP)
		const icon = orDefault(dappIcon, DEFAULT_ICON)
		const m = orDefault(memo, 'itiklink-siwe')
		const st = orDefault(signType, 'ethPersonalSign')
		console.log('[tp-sdk] personalSign', aid, 'msgLen=', message.length)
		TpWalletNative.personalSign(message, aid, name, icon, m, cid, st, (code: number, data: string) => {
			const result = parseSdkPayload(code, data)
			console.log('[tp-sdk] sign result', code, 'wallet=', result.wallet, 'sigLen=', result.signature.length)
			if (code == 0) {
				resolve(result)
			} else if (code == 2) {
				reject('用户取消签名')
			} else {
				reject(friendlyErr(result.raw))
			}
		})
	})
}

export const tpTransfer: TpTransfer = function (
	from: string,
	to: string,
	contract: string,
	amount: string,
	decimalStr: string,
	symbol: string,
	desc: string,
	actionId: string,
	chainId: string,
	dappName: string,
	dappIcon: string
): Promise<TpSdkResult> {
	return new Promise<TpSdkResult>((resolve, reject) => {
		if (to == null || to.length == 0) {
			reject('收款地址为空')
			return
		}
		if (amount == null || amount.length == 0) {
			reject('支付金额为空')
			return
		}
		const aid = orDefault(actionId, newActionId())
		const cid = orDefault(chainId, '56')
		const name = orDefault(dappName, DEFAULT_DAPP)
		const icon = orDefault(dappIcon, DEFAULT_ICON)
		let dec: Int = 18
		try {
			const n = parseInt(decimalStr)
			if (n > 0) dec = n as Int
		} catch (e0) {}
		const sym = orDefault(symbol, 'USDT')
		const d = orDefault(desc, 'itiklink-pay')
		const fr = from != null ? from : ''
		const ct = contract != null ? contract : ''
		console.log('[tp-sdk] transfer', aid, 'to=', to, 'amt=', amount, 'chain=', cid)
		TpWalletNative.transfer(fr, to, ct, amount, dec, sym, d, aid, name, icon, cid, (code: number, data: string) => {
			const parsed = parseSdkPayload(code, data)
			let tx = parsed.signature
			// 仅当已是 0x 哈希时保留；否则从 raw JSON 抽 txID（TP 常用大写 ID）
			if (tx.indexOf('{') >= 0 || tx.indexOf('0x') != 0) tx = ''
			if (tx.length == 0 && parsed.raw.length > 0) {
				try {
					const o = JSON.parse(parsed.raw) as UTSJSONObject
					tx = pickStr(o, 'txID')
					if (tx.length == 0) tx = pickStr(o, 'txId')
					if (tx.length == 0) tx = pickStr(o, 'txHash')
					if (tx.length == 0) tx = pickStr(o, 'hash')
					if (tx.length == 0) tx = pickStr(o, 'transactionHash')
					if (tx.length == 0) tx = pickStr(o, 'transaction_id')
				} catch (e1) {}
			}
			const result: TpSdkResult = {
				code: parsed.code,
				raw: parsed.raw,
				wallet: parsed.wallet,
				signature: tx,
				action: parsed.action,
				actionId: parsed.actionId
			}
			console.log('[tp-sdk] transfer result', code, 'tx=', result.signature)
			if (code == 0) {
				resolve(result)
			} else if (code == 2) {
				reject('用户取消转账')
			} else {
				reject(friendlyErr(result.raw))
			}
		})
	})
}

export const tpIsInstalled: TpIsInstalled = function (): boolean {
	try {
		return TpWalletNative.isTpInstalled()
	} catch (e) {
		return false
	}
}

export const tpDeliverSchema: TpDeliverSchema = function (urlOrQuery: string): boolean {
	try {
		return TpWalletNative.deliverFromSchema(urlOrQuery)
	} catch (e) {
		return false
	}
}
