/**
 * 非 Android 平台占位：TP Mobile-SDK 仅 App-Android 可用
 * 不 export type（H5 会擦除导致 value import 白屏）；用本地 type 作返回值即可
 */
type TpStubResult = {
	code: number
	raw: string
	wallet: string
	signature: string
	action: string
	actionId: string
}

function unsupported(): Promise<TpStubResult> {
	return new Promise<TpStubResult>((_resolve, reject) => {
		reject('TokenPocket Mobile-SDK 仅支持 Android App')
	})
}

export function tpAuthorize(
	_actionId: string,
	_chainId: string,
	_dappName: string,
	_dappIcon: string,
	_memo: string
): Promise<TpStubResult> {
	return unsupported()
}

export function tpPersonalSign(
	_message: string,
	_actionId: string,
	_chainId: string,
	_dappName: string,
	_dappIcon: string,
	_memo: string,
	_signType: string
): Promise<TpStubResult> {
	return unsupported()
}

export function tpTransfer(
	_from: string,
	_to: string,
	_contract: string,
	_amount: string,
	_decimalStr: string,
	_symbol: string,
	_desc: string,
	_actionId: string,
	_chainId: string,
	_dappName: string,
	_dappIcon: string
): Promise<TpStubResult> {
	return unsupported()
}

export function tpIsInstalled(): boolean {
	return false
}

export function tpDeliverSchema(_urlOrQuery: string): boolean {
	return false
}
