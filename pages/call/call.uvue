<template>
	<view class="call-page">
		<!-- #ifndef H5 -->
		<web-view
			id="callWeb"
			class="call-engine"
			:src="engineSrc"
			:style="'width:750rpx;height:' + engineH + 'px'"
			@message="onWebMsg"
			@on-post-message="onWebMsg"
			@load="onWebLoad"
			@error="onWebError"
		></web-view>
		<!-- #endif -->
		<!-- #ifdef H5 -->
		<view class="call-mask">
			<text class="call-name">{{ ui.peerName }}</text>
			<text class="call-sub">{{ ui.sub }}</text>
			<view class="call-actions">
				<view v-if="ui.phase == 'ringing' && ui.isIncoming" class="call-btn call-btn-accept" @click="onAccept">
					<text class="call-btn-text">接听</text>
				</view>
				<view v-if="ui.phase == 'ringing' && ui.isIncoming" class="call-btn call-btn-hang" @click="onReject">
					<text class="call-btn-text">拒绝</text>
				</view>
				<view v-if="showHangBtn()" class="call-btn call-btn-mute" @click="onMute">
					<text class="call-btn-text">{{ ui.muted ? '取消静音' : '静音' }}</text>
				</view>
				<view v-if="showCamBtn()" class="call-btn call-btn-cam" @click="onCam">
					<text class="call-btn-text">{{ ui.cameraOff ? '开摄像头' : '关摄像头' }}</text>
				</view>
				<view v-if="showHangBtn()" class="call-btn call-btn-hang" @click="onHang">
					<text class="call-btn-text">挂断</text>
				</view>
			</view>
		</view>
		<!-- #endif -->
	</view>
</template>

<script setup lang="uts">
	import { ref, onMounted, onUnmounted, nextTick, getCurrentInstance } from 'vue'
	import { getCallManager, CallManager, CallSnapshot } from '@/common/call.uts'
	import { tuneCallWebView, makeNativeEval, pingCallEngine, ensureCallEngine, destroyCallEngine } from '@/common/call-webview.uts'
	// #ifdef APP-ANDROID
	import WebView from 'android.webkit.WebView'
	import FrameLayout from 'android.widget.FrameLayout'
	import ViewGroup from 'android.view.ViewGroup'
	// #endif

	const ui = ref<CallSnapshot>({
		phase: 'idle', roomId: '', callId: '', peerName: '', isVideo: false,
		isIncoming: false, sub: '', muted: false, cameraOff: false
	})
	let off: (() => void) | null = null
	let closing: boolean = false
	let webCtx: WebViewContext | null = null
	let engineH = 800
	try {
		const info = uni.getSystemInfoSync()
		if (info.windowHeight > 200) engineH = info.windowHeight
	} catch (e) {}

	function makeEngineSrc(): string {
		return '/static/call-engine.html'
	}
	const engineSrc = ref<string>(makeEngineSrc())

	function refreshEngineSrc(): void {
		const next = makeEngineSrc()
		if (engineSrc.value == next) return
		engineSrc.value = next
		getCallManager().htmlLoaded = false
	}

	function showInCall(): boolean {
		const p = ui.value.phase
		if (p == 'outgoing') return true
		if (p == 'connected') return true
		return false
	}
	function showCamBtn(): boolean {
		if (ui.value.isVideo == false) return false
		return showInCall()
	}
	function showHangBtn(): boolean {
		const p = ui.value.phase
		if (p == 'idle') return false
		if (p == 'ringing' && ui.value.isIncoming) return false
		return true
	}
	function showEngine(): boolean {
		return ui.value.phase != 'idle'
	}

	function stopOff(handler: (() => void) | null): void {
		if (handler == null) return
		try { handler() } catch (e) {}
	}

	function bindCallEval(evalFn: (js: string) => void, how: string): boolean {
		const mgr = getCallManager()
		mgr.htmlEval = evalFn
		mgr.htmlReady = true
		console.log('[call] bind', how)
		return true
	}

	function bindWeb(): boolean {
		const mgr = getCallManager()
		if (mgr.htmlEval != null) return true
		console.log('[call] bind v4')
		try {
			const inst = getCurrentInstance()
			if (inst != null && inst.proxy != null) {
				const page = inst.proxy.$page
				if (page != null) {
					const pageEl = page.getElementById('callWeb')
					if (pageEl != null) {
						const wv = pageEl as UniWebViewElement
						return bindCallEval((js: string): void => { wv.evalJS(js) }, 'page-element')
					}
				}
			}
		} catch (ePage) {}
		try {
			const el = uni.getElementById('callWeb')
			if (el != null) {
				const wv = el as UniWebViewElement
				return bindCallEval((js: string): void => { wv.evalJS(js) }, 'element')
			}
		} catch (e0) {}
		try {
			const inst2 = getCurrentInstance()
			const proxy = (inst2 != null) ? inst2.proxy : null
			const u = uni as any
			let ctx: WebViewContext | null = null
			try {
				if (proxy != null) ctx = u.createWebviewContext('callWeb', proxy) as WebViewContext
			} catch (eH0) {}
			if (ctx == null) {
				try { ctx = u.createWebviewContext('callWeb') as WebViewContext } catch (eH1) {}
			}
			if (ctx == null) {
				try {
					if (proxy != null) ctx = u.createWebViewContext('callWeb', proxy) as WebViewContext
				} catch (eA0) {}
			}
			if (ctx == null) {
				try { ctx = u.createWebViewContext('callWeb') as WebViewContext } catch (eA1) {}
			}
			if (ctx != null) {
				webCtx = ctx
				const bound = ctx
				return bindCallEval((js: string): void => { bound.evalJS(js) }, 'context')
			}
		} catch (e) {}
		try {
			const nativeFn = makeNativeEval()
			if (nativeFn != null) {
				return bindCallEval(nativeFn, 'native')
			}
		} catch (e2) {}
		return false
	}

	// #ifdef APP-ANDROID
	let pageWv: WebView | null = null
	function bindPageWv(wv: WebView): void {
		const mgr = getCallManager()
		mgr.htmlEval = (js: string): void => {
			try {
				wv.evaluateJavascript(js, (_v: string) => {})
			} catch (e) {}
		}
		mgr.htmlReady = true
		console.log('[call] page eval bound')
	}
	function pingPageWv(wv: WebView): void {
		try {
			wv.evaluateJavascript('(function(){try{return window.__callJson?"1":"0";}catch(e){return "0";}})()', (value: string) => {
				const v = (value != null) ? value : ''
				console.log('[call] page ping', v)
				if (v.indexOf('1') < 0) return
				const m3 = getCallManager()
				m3.htmlLoaded = true
				if (m3.phase == 'outgoing') m3.placeOutgoing()
				else if (m3.phase == 'connecting') m3.appAnswer()
				else if (m3.phase == 'ringing') m3.armIncoming()
				else m3.pushUi()
			})
		} catch (e) {
			console.warn('[call] page ping fail', e)
		}
	}
	function pageEnsureEngine(): void {
		console.log('[call] pageEnsureEngine')
		const existed = pageWv
		if (existed != null) {
			bindPageWv(existed)
			pingPageWv(existed)
			return
		}
		try {
			const act = UTSAndroid.getUniActivity()
			if (act == null) {
				console.warn('[call] no activity')
				return
			}
			const wv = new WebView(act)
			const s = wv.getSettings()
			s.setJavaScriptEnabled(true)
			s.setDomStorageEnabled(true)
			s.setMediaPlaybackRequiresUserGesture(false)
			s.setAllowFileAccess(true)
			s.setAllowContentAccess(true)
			s.setAllowFileAccessFromFileURLs(true)
			s.setAllowUniversalAccessFromFileURLs(true)
			s.setMixedContentMode(0)
			const lp = new FrameLayout.LayoutParams(-1, -1)
			act.addContentView(wv, lp)
			pageWv = wv
			wv.bringToFront()
			bindPageWv(wv)
			console.log('[call] page injected webview')
			const fs = uni.getFileSystemManager()
			fs.readFile({
				filePath: '/static/call-engine.html',
				encoding: 'utf-8',
				success: (res) => {
					const html = '' + res.data
					console.log('[call] page load html', html.length)
					wv.loadDataWithBaseURL('https://call.local/', html, 'text/html', 'UTF-8', '')
					setTimeout(() => { pingPageWv(wv) }, 400)
					setTimeout(() => { pingPageWv(wv) }, 1200)
				},
				fail: (err) => {
					console.warn('[call] page read html fail', err.errMsg)
					wv.loadUrl('file:///android_asset/static/call-engine.html')
					setTimeout(() => { pingPageWv(wv) }, 800)
				}
			})
		} catch (e) {
			console.warn('[call] page inject fail', e)
		}
	}
	function pageDestroyEngine(): void {
		const wv = pageWv
		pageWv = null
		if (wv == null) {
			destroyCallEngine()
			return
		}
		try {
			const parent = wv.getParent()
			if (parent != null && parent instanceof ViewGroup) {
				const g = parent as ViewGroup
				g.removeView(wv)
			}
		} catch (e) {}
		try { wv.destroy() } catch (e2) {}
		destroyCallEngine()
	}
	// #endif
	// #ifndef APP-ANDROID
	function pageEnsureEngine(): void {
		console.log('[call] pageEnsureEngine skip')
	}
	function pageDestroyEngine(): void {}
	// #endif

	function runEngineCmd(): void {
		const mgr = getCallManager()
		if (mgr.phase == 'outgoing') {
			mgr.placeOutgoing()
		} else if (mgr.phase == 'connecting') {
			mgr.appAnswer()
		} else if (mgr.phase == 'ringing') {
			mgr.armIncoming()
		} else {
			mgr.pushUi()
		}
	}

	function kickEngine(): void {
		const mgr = getCallManager()
		if (mgr.phase == 'idle') return
		let ok = bindWeb()
		if (!ok) {
			console.log('[call] ensure engine')
			try { ensureCallEngine() } catch (e0) { console.warn('[call] ensure fail', e0) }
			ok = bindWeb()
			if (!ok) pageEnsureEngine()
			ok = bindWeb()
		}
		console.log('[call] kickEngine', mgr.phase, 'bind', ok, 'loaded', mgr.htmlLoaded)
		try { tuneCallWebView() } catch (e1) {}
		try {
			pingCallEngine((ready: boolean): void => {
				if (ready) {
					mgr.htmlLoaded = true
					console.log('[call] engine ping ready', mgr.phase)
				}
				runEngineCmd()
			})
		} catch (e2) {
			runEngineCmd()
		}
		if (ok && mgr.htmlLoaded) runEngineCmd()
		if (!ok || mgr.htmlLoaded == false) {
			setTimeout(() => {
				const ok2 = bindWeb()
				console.log('[call] rebind', ok2)
				if (ok2) runEngineCmd()
			}, 400)
		}
	}

	function onWebLoad(_e: UniWebViewLoadEvent): void {
		const mgr = getCallManager()
		console.log('[call] engine loaded', mgr.phase, mgr.callId)
		mgr.htmlLoaded = true
		kickEngine()
	}

	function onWebError(e: UniWebViewErrorEvent): void {
		console.warn('[call] web-view error', e.detail.errMsg)
		uni.showToast({ title: '通话页加载失败', icon: 'none' })
	}

	function takeWebStr(o: UTSJSONObject, key: string): string {
		const s = o.getString(key)
		if (s != null && s.length > 0) return s
		try {
			const v = o[key]
			if (v != null) {
				const t = '' + v
				if (t.length > 0 && t != 'null' && t != 'undefined') return t
			}
		} catch (e) {}
		return ''
	}

	function parseWebMsg(raw: any | null, mgr: CallManager, depth: number): void {
		if (raw == null) return
		if (depth > 6) return
		const asText = '' + raw
		if (asText.length > 2 && (asText.charAt(0) == '{' || asText.charAt(0) == '[')) {
			try {
				const parsed = JSON.parse(asText)
				parseWebMsg(parsed, mgr, depth + 1)
				return
			} catch (e0) {}
		}
		try {
			const arr = raw as Array<any>
			if (arr != null && arr.length > 0) {
				for (let i = 0; i < arr.length; i++) {
					parseWebMsg(arr[i], mgr, depth + 1)
				}
				return
			}
		} catch (e1) {}
		try {
			const o = raw as UTSJSONObject
			const kind = takeWebStr(o, 'type')
			if (kind.length == 0) {
				const inner = o.getJSON('data')
				if (inner != null) {
					parseWebMsg(inner, mgr, depth + 1)
					return
				}
				const ds = o.getString('data')
				if (ds != null && ds.length > 2) {
					parseWebMsg(ds, mgr, depth + 1)
				}
				return
			}
			let payload = ''
			const cand: UTSJSONObject = {}
			if (kind == 'offer' || kind == 'answer') {
				payload = takeWebStr(o, 'sdp')
			} else if (kind == 'error') {
				payload = takeWebStr(o, 'message')
			} else if (kind == 'ice') {
				payload = takeWebStr(o, 'candidate')
				cand['sdpMid'] = takeWebStr(o, 'sdpMid')
				cand['sdpMLineIndex'] = o.getNumber('sdpMLineIndex')
			} else if (kind == 'ui') {
				payload = takeWebStr(o, 'action')
			}
			console.log('[call] webmsg', kind, payload.length)
			mgr.onHtmlMessage(kind, payload, cand)
		} catch (e2) {}
	}

	function onWebMsg(e: UniWebViewMessageEvent): void {
		bindWeb()
		const mgr = getCallManager()
		console.log('[call] web event')
		parseWebMsg(e.detail.data, mgr, 0)
	}

	function goBack(): void {
		if (closing) return
		closing = true
		uni.navigateBack()
	}

	async function setupCall(): Promise<void> {
		let mgr = getCallManager()
		mgr.adoptIfIdle()
		mgr.bindMatrix()
		console.log('[call] setup', mgr.phase, mgr.callId, mgr.isIncoming, 'v4')
		try {
			const info = uni.getSystemInfoSync()
			console.log('[call] os', info.osName, info.uniPlatform, info.platform)
		} catch (eInfo) {}
		if (mgr.phase == 'idle') {
			console.log('[call] page waiting for ringing')
			await new Promise((resolve: (ok: boolean) => void) => {
				setTimeout(() => { resolve(true) }, 500)
			})
			mgr = getCallManager()
			mgr.adoptIfIdle()
		}
		ui.value = mgr.getSnapshot()
		off = mgr.onChange((s: CallSnapshot) => {
			ui.value = s
			refreshEngineSrc()
			if (s.phase == 'idle') {
				setTimeout(() => {
					if (getCallManager().phase == 'idle') goBack()
				}, 400)
				return
			}
			kickEngine()
		})
		if (mgr.phase == 'idle') {
			console.log('[call] still idle, stay and wait')
			return
		}
		await nextTick()
		refreshEngineSrc()
		console.log('[call] engine src', engineSrc.value)
		kickEngine()
		setTimeout(() => { kickEngine() }, 300)
		setTimeout(() => { kickEngine() }, 900)
		setTimeout(() => { kickEngine() }, 1800)
		setTimeout(() => { kickEngine() }, 3500)
		setTimeout(() => { kickEngine() }, 6000)
		mgr.attachDom()
		// #ifdef H5
		if (mgr.phase == 'outgoing') {
			await mgr.placeOutgoing()
		}
		// #endif
	}

	function onAccept() {
		getCallManager().accept()
		kickEngine()
	}
	function onReject() {
		getCallManager().reject()
		goBack()
	}
	function onHang() {
		getCallManager().hangup(true)
		goBack()
	}
	function onMute() {
		getCallManager().toggleMute()
	}
	function onCam() {
		getCallManager().toggleCamera()
	}

	onMounted(() => {
		const mgr = getCallManager()
		console.log('[call] 进入页面', mgr.phase, mgr.callId)
		setupCall()
	})
	onReady(() => {
		kickEngine()
	})

	onBackPress(() => {
		if (closing) return false
		getCallManager().hangup(true)
		goBack()
		return true
	})

	onUnmounted(() => {
		stopOff(off)
		off = null
		const mgr = getCallManager()
		if (mgr.phase == 'idle') {
			mgr.htmlEval = null
			mgr.htmlReady = false
			mgr.htmlLoaded = false
		}
		webCtx = null
		if (getCallManager().phase == 'idle') pageDestroyEngine()
	})
</script>

<style>
	.call-page {
		flex: 1;
		width: 750rpx;
		height: 100%;
		background-color: #111111;
		flex-direction: column;
	}
	.call-engine {
		flex: 1;
		width: 750rpx;
		height: 100%;
	}
	.call-web {
		width: 8px;
		height: 8px;
	}
	.call-web-audio {
		width: 8px;
		height: 8px;
	}
	.call-web-video {
		width: 8px;
		height: 8px;
	}
	.call-bar {
		width: 750rpx;
		flex: 1;
		padding-top: 80rpx;
		padding-bottom: 80rpx;
		padding-left: 24rpx;
		padding-right: 24rpx;
		align-items: center;
		justify-content: center;
		background-color: #111111;
	}
	.call-stage {
		position: absolute;
		left: 0;
		right: 0;
		top: 0;
		bottom: 0;
	}
	.call-mask {
		position: absolute;
		left: 0;
		right: 0;
		bottom: 0;
		padding: 48rpx 40rpx 80rpx;
		align-items: center;
		z-index: 3;
		background: linear-gradient(180deg, rgba(0,0,0,0) 0%, rgba(0,0,0,0.55) 100%);
	}
	.call-name {
		font-size: 44rpx;
		color: #ffffff;
		font-weight: 700;
		margin-bottom: 12rpx;
	}
	.call-sub {
		font-size: 28rpx;
		color: rgba(255,255,255,0.75);
		margin-bottom: 48rpx;
	}
	.call-actions {
		flex-direction: row;
		justify-content: center;
		flex-wrap: wrap;
	}
	.call-btn {
		padding: 20rpx 36rpx;
		border-radius: 48rpx;
		margin: 0 12rpx 16rpx;
		min-width: 140rpx;
		align-items: center;
	}
	.call-btn-accept { background-color: #07c160; }
	.call-btn-hang {
		background-color: #fa5151;
		min-width: 240rpx;
		padding: 28rpx 48rpx;
	}
	.call-btn-mute { background-color: #4a4a4a; }
	.call-btn-cam { background-color: #4a4a4a; }
	.call-btn-text {
		color: #ffffff;
		font-size: 28rpx;
		font-weight: 600;
	}
</style>
