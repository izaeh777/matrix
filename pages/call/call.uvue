<template>
	<view class="call-page">
		<!-- #ifdef H5 -->
		<view class="call-stage"></view>
		<!-- #endif -->
		<!-- #ifndef H5 -->
		<web-view
			id="callWeb"
			class="call-engine"
			:src="engineSrc"
			:style="'width:750rpx;height:' + engineH + 'px'"
			@message="onWebMsg"
			@on-post-message="onWebMsg"
			@load="onWebLoad"
			@error="onWebError"
		></web-view>
		<!-- #endif -->
		<view class="call-bar">
			<image class="call-avatar" :src="avatarSrc()"></image>
			<text class="call-name">{{ ui.peerName }}</text>
			<text v-if="ui.isGroupCall && ui.groupPeerCount > 0" class="call-sub">群成员 {{ ui.groupPeerCount }} 人</text>
			<text v-if="durText != ''" class="call-dur">{{ durText }}</text>
			<text v-else class="call-sub">{{ ui.sub }}</text>
			<view class="call-actions">
				<view v-if="ui.phase == 'ringing' && ui.isIncoming" class="call-btn call-btn-accept" @click="onAccept">
					<text class="call-btn-text">接听</text>
				</view>
				<view v-if="ui.phase == 'ringing' && ui.isIncoming" class="call-btn call-btn-hang" @click="onReject">
					<text class="call-btn-text">拒绝</text>
				</view>
				<view v-if="showHangBtn()" class="call-btn call-btn-mute" @click="onMute">
					<text class="call-btn-text">{{ ui.muted ? '取消静音' : '静音' }}</text>
				</view>
				<view v-if="showCamBtn()" class="call-btn call-btn-cam" @click="onCam">
					<text class="call-btn-text">{{ ui.cameraOff ? '开摄像头' : '关摄像头' }}</text>
				</view>
				<view v-if="showFlipBtn()" class="call-btn call-btn-cam" @click="onFlip">
					<text class="call-btn-text">翻转</text>
				</view>
				<view v-if="showHangBtn()" class="call-btn call-btn-hang" @click="onHang">
					<text class="call-btn-text">挂断</text>
				</view>
			</view>
		</view>
	</view>
</template>

<script setup lang="uts">
	import { ref, onMounted, onUnmounted, nextTick, getCurrentInstance } from 'vue'
	import { getCallManager, CallManager, CallSnapshot, h5TapRunAnswer, formatCallDur } from '@/common/call.uts'
	import { tuneCallWebView, makeNativeEval, pingCallEngine, destroyCallEngine, reloadEngineAsHttps, loadEngineHtmlInto } from '@/common/call-webview.uts'
	// #ifdef APP-ANDROID
	import WebView from 'android.webkit.WebView'
	import FrameLayout from 'android.widget.FrameLayout'
	import ViewGroup from 'android.view.ViewGroup'
	// #endif

	const ui = ref<CallSnapshot>({
		phase: 'idle', roomId: '', callId: '', peerName: '', peerAvatar: '', isVideo: false,
		isIncoming: false, sub: '', muted: false, cameraOff: false, isGroupCall: false, groupPeerCount: 0
	})
	const durText = ref<string>('')
	let durTimer: number | null = null
	let off: (() => void) | null = null
	let closing: boolean = false
	let httpsTried: boolean = false
	let httpsReady: boolean = false
	let httpsFallbackArmed: boolean = false
	let engineH = 520
	try {
		const info = uni.getSystemInfoSync()
		if (info.windowHeight > 360) engineH = info.windowHeight - 300
	} catch (e) {}

	function makeEngineSrc(): string {
		const mgr = getCallManager()
		const mode = mgr.isIncoming ? 'in' : 'out'
		const v = mgr.isVideo ? '1' : '0'
		return '/static/call-engine.html?p=' + mode + '&v=' + v
	}
	const engineSrc = ref<string>(makeEngineSrc())

	let h5MsgFn: ((ev: any) => void) | null = null
	let h5EngineFetch = false
	function noteH5Ready(): boolean {
		// #ifdef H5
		try {
			const win = window as any
			if (win == null || win.__callJson == null) return false
			const mgr = getCallManager()
			if (mgr.htmlLoaded == false) {
				console.log('[call] h5 engine ready', mgr.phase)
			}
			mgr.htmlLoaded = true
			mgr.htmlReady = true
			return true
		} catch (eNote) {}
		// #endif
		return false
	}
	function h5EngineUrls(): Array<string> {
		const out: Array<string> = []
		const push = (u: string): void => {
			if (u.length == 0) return
			if (out.indexOf(u) >= 0) return
			out.push(u)
		}
		push('/static/call-engine.js')
		push('./static/call-engine.js')
		push('static/call-engine.js')
		try {
			const loc = (window as any).location
			if (loc != null && loc.origin != null) {
				push('' + loc.origin + '/static/call-engine.js')
			}
		} catch (e0) {}
		return out
	}
	function injectScriptOnce(id: string, src: string, onDone: (ok: boolean) => void): void {
		// #ifdef H5
		try {
			const doc = (window as any).document
			const exist = doc.getElementById(id)
			if (exist != null) {
				onDone(true)
				return
			}
			const s = doc.createElement('script')
			s.id = id
			s.src = src
			s.onload = (): void => { onDone(true) }
			s.onerror = (): void => { onDone(false) }
			doc.head.appendChild(s)
		} catch (e) {
			onDone(false)
		}
		// #endif
	}
	function ensureLivekitScripts(done: () => void): void {
		// #ifdef H5
		// 必须在 call-engine 之后加载，以便包装 __callJson
		injectScriptOnce('livekitClientScript', '/static/livekit-client.umd.js', (_ok0: boolean): void => {
			// 允许重复注入 engine 以重新 wrap
			try {
				const doc = (window as any).document
				const old = doc.getElementById('livekitEngineScript')
				if (old != null) {
					try { old.parentNode.removeChild(old) } catch (eR) {}
				}
			} catch (e0) {}
			injectScriptOnce('livekitEngineScript', '/static/livekit-engine.js?t=' + Date.now(), (_ok1: boolean): void => {
				done()
			})
		})
		return
		// #endif
		done()
	}
	function injectH5EngineScript(src: string, onDone: (ok: boolean) => void): void {
		// #ifdef H5
		try {
			const doc = (window as any).document
			const old = doc.getElementById('callEngineScript')
			if (old != null) {
				try { old.parentNode.removeChild(old) } catch (eR) {}
			}
			const s = doc.createElement('script')
			s.id = 'callEngineScript'
			s.src = src
			s.onload = (): void => {
				// call-engine 覆盖 __callJson 后再挂 LiveKit
				ensureLivekitScripts((): void => { onDone(true) })
			}
			s.onerror = (): void => { onDone(false) }
			doc.head.appendChild(s)
		} catch (e) {
			onDone(false)
		}
		// #endif
	}
	function fetchH5Engine(): void {
		// #ifdef H5
		if (h5EngineFetch) return
		if (noteH5Ready()) return
		h5EngineFetch = true
		const urls = h5EngineUrls()
		let idx = 0
		const tryNext = (): void => {
			if (noteH5Ready()) return
			if (idx >= urls.length) {
				h5EngineFetch = false
				console.warn('[call] engine script all urls failed')
				return
			}
			const url = urls[idx]
			idx = idx + 1
			console.log('[call] load engine script', url)
			injectH5EngineScript(url, (ok: boolean): void => {
				if (ok && noteH5Ready()) {
					kickEngine()
					return
				}
				// request 文本兜底：必须是 JS，不能是 HTML（SPA 回退页）
				uni.request({
					url: url,
					method: 'GET',
					dataType: 'text',
					success: (res) => {
						try {
							const win = window as any
							if (win.__callJson != null) {
								noteH5Ready()
								kickEngine()
								return
							}
							const code = '' + res.data
							const trim = code.replace(/^\s+/, '')
							if (trim.length < 20 || trim.charAt(0) == '<') {
								console.warn('[call] engine url returned html, skip', url)
								tryNext()
								return
							}
							win.eval(code)
							console.log('[call] h5 engine eval', code.length)
							noteH5Ready()
							kickEngine()
						} catch (eEval) {
							console.warn('[call] engine eval fail', eEval)
							tryNext()
						}
					},
					fail: () => {
						tryNext()
					}
				})
			})
		}
		tryNext()
		// #endif
	}
	function bindH5IFrame(): boolean {
		// #ifdef H5
		try {
			const doc = (window as any).document
			const win = window as any
			if (doc == null) return false
			let root = doc.getElementById('callEngineRoot')
			if (root == null) {
				root = doc.createElement('div')
				root.id = 'callEngineRoot'
				const remote = doc.createElement('video')
				remote.id = 'remote'
				remote.setAttribute('autoplay', 'true')
				remote.setAttribute('playsinline', 'true')
				remote.setAttribute('webkit-playsinline', 'true')
				// muted 便于自动播放；画面仍可显示
				remote.muted = true
				remote.style.cssText = 'position:absolute;left:0;top:0;width:100%;height:100%;object-fit:cover;background:#111;pointer-events:none;z-index:1;opacity:1;visibility:visible;'
				const local = doc.createElement('video')
				local.id = 'local'
				local.setAttribute('autoplay', 'true')
				local.setAttribute('playsinline', 'true')
				local.setAttribute('webkit-playsinline', 'true')
				local.muted = true
				local.style.cssText = 'position:absolute;right:12px;top:12px;width:112px;height:152px;object-fit:cover;background:#000;border-radius:12px;pointer-events:none;'
				const audio = doc.createElement('audio')
				audio.id = 'remoteAudio'
				audio.setAttribute('autoplay', 'true')
				audio.setAttribute('playsinline', 'true')
				root.appendChild(remote)
				root.appendChild(local)
				root.appendChild(audio)
				doc.body.appendChild(root)
			}
			root.style.cssText = 'position:fixed;left:0;top:0;right:0;bottom:160px;z-index:9998;background:#111;overflow:hidden;pointer-events:none;'
			const mgr = getCallManager()
			mgr.htmlPost = (json: string): void => {
				try {
					const fn = win.__callJson
					if (fn != null) fn(json)
				} catch (ePost) {
					console.warn('[call] engine post fail', ePost)
				}
			}
			mgr.htmlEval = (js: string): void => {
				try {
					if (js.indexOf('runAnswer') >= 0 && win.runAnswer != null) {
						win.runAnswer()
						return
					}
					const fn = win.__callJson
					if (fn != null) fn(js)
				} catch (e0) {
					console.warn('[call] engine eval fail', e0)
				}
			}
			if (h5MsgFn == null) {
				h5MsgFn = (ev: any): void => {
					try {
						const d = ev.data
						if (d == null) return
						if (d['__callEngine'] != true) return
						const kind = (d.type != null) ? ('' + d.type) : ''
						let payload = ''
						if (d.sdp != null) payload = '' + d.sdp
						else if (d.message != null) payload = '' + d.message
						else if (d.reason != null) payload = '' + d.reason
						else if (d.action != null) payload = '' + d.action
						else if (d.candidate != null) payload = '' + d.candidate
						const cand: UTSJSONObject = {}
						if (d.candidate != null) cand['candidate'] = d.candidate
						if (d.sdpMid != null) cand['sdpMid'] = d.sdpMid
						if (d.sdpMLineIndex != null) cand['sdpMLineIndex'] = d.sdpMLineIndex
						if (d.peer != null) cand['peer'] = d.peer
						getCallManager().onHtmlMessage(kind, payload, cand)
					} catch (e1) {}
				}
				window.addEventListener('message', h5MsgFn)
			}
			httpsTried = true
			if (noteH5Ready()) return true
			fetchH5Engine()
			return true
		} catch (e) {
			console.warn('[call] bind h5 engine', e)
			return false
		}
		// #endif
		return false
	}

	function avatarSrc(): string {
		const a = ui.value.peerAvatar
		if (a.length > 0) return a
		return '/static/login/tiki.png'
	}

	function tickDur(): void {
		const mgr = getCallManager()
		if (mgr.connectedAt > 0 && (mgr.phase == 'connected' || mgr.phase == 'connecting')) {
			const sec = Math.floor((Date.now() - mgr.connectedAt) / 1000)
			durText.value = formatCallDur(sec)
		} else if (mgr.phase == 'connected') {
			durText.value = '00:00'
		} else {
			durText.value = ''
		}
	}

	function startDurTimer(): void {
		tickDur()
		if (durTimer != null) return
		durTimer = setInterval((): void => {
			tickDur()
		}, 1000) as number | null
	}

	function stopDurTimer(): void {
		const t = durTimer
		durTimer = null
		if (t != null) clearInterval(t)
		durText.value = ''
	}

	function refreshEngineSrc(): void {
		if (httpsTried) return
		const next = makeEngineSrc()
		if (engineSrc.value == next) return
		engineSrc.value = next
		getCallManager().htmlLoaded = false
	}

	function showInCall(): boolean {
		const p = ui.value.phase
		if (p == 'outgoing') return true
		if (p == 'connecting') return true
		if (p == 'connected') return true
		return false
	}
	function showCamBtn(): boolean {
		if (ui.value.isVideo == false) return false
		return showInCall()
	}
	function showFlipBtn(): boolean {
		if (showCamBtn() == false) return false
		if (ui.value.cameraOff) return false
		return true
	}
	function showHangBtn(): boolean {
		const p = ui.value.phase
		if (p == 'idle') return false
		if (p == 'ringing' && ui.value.isIncoming) return false
		return true
	}
	function showEngine(): boolean {
		return ui.value.phase != 'idle'
	}

	function stopOff(handler: (() => void) | null): void {
		if (handler == null) return
		try { handler() } catch (e) {}
	}

	function bindCallEval(evalFn: (js: string) => void, how: string): boolean {
		const mgr = getCallManager()
		mgr.htmlEval = evalFn
		mgr.htmlReady = true
		console.log('[call] bind', how)
		return true
	}

	function bindWeb(): boolean {
		const mgr = getCallManager()
		if (mgr.htmlEval != null) return true
		console.log('[call] bind webview')
		try {
			const inst = getCurrentInstance()
			if (inst != null && inst.proxy != null) {
				const page = inst.proxy.$page
				if (page != null) {
					const pageEl = page.getElementById('callWeb')
					if (pageEl != null) {
						const wv = pageEl as UniWebViewElement
						return bindCallEval((js: string): void => { wv.evalJS(js) }, 'page-element')
					}
				}
			}
		} catch (ePage) {}
		try {
			const el = uni.getElementById('callWeb')
			if (el != null) {
				const wv = el as UniWebViewElement
				return bindCallEval((js: string): void => { wv.evalJS(js) }, 'element')
			}
		} catch (e0) {}
		try {
			const nativeFn = makeNativeEval()
			if (nativeFn != null) {
				return bindCallEval(nativeFn, 'native')
			}
		} catch (e2) {}
		return false
	}

	// #ifdef APP-ANDROID
	let pageWv: WebView | null = null
	function bindPageWv(wv: WebView): void {
		const mgr = getCallManager()
		mgr.htmlEval = (js: string): void => {
			try {
				wv.evaluateJavascript(js, (_v: string) => {})
			} catch (e) {}
		}
		mgr.htmlReady = true
		console.log('[call] page eval bound')
	}
	function pingPageWv(wv: WebView): void {
		try {
			wv.evaluateJavascript('(function(){try{return window.__callJson?"1":"0";}catch(e){return "0";}})()', (value: string) => {
				const v = (value != null) ? value : ''
				console.log('[call] page ping', v)
				if (v.indexOf('1') < 0) return
				const m3 = getCallManager()
				m3.htmlLoaded = true
				if (m3.phase == 'outgoing') m3.placeOutgoing()
				else if (m3.phase == 'connecting') m3.appAnswer()
				else if (m3.phase == 'ringing') m3.armIncoming()
				else m3.pushUi()
			})
		} catch (e) {
			console.warn('[call] page ping fail', e)
		}
	}
	function pageEnsureEngine(): void {
		console.log('[call] pageEnsureEngine')
		const existed = pageWv
		if (existed != null) {
			bindPageWv(existed)
			pingPageWv(existed)
			return
		}
		try {
			const act = UTSAndroid.getUniActivity()
			if (act == null) {
				console.warn('[call] no activity')
				return
			}
			const wv = new WebView(act)
			const s = wv.getSettings()
			s.setJavaScriptEnabled(true)
			s.setDomStorageEnabled(true)
			s.setMediaPlaybackRequiresUserGesture(false)
			s.setAllowFileAccess(true)
			s.setAllowContentAccess(true)
			s.setAllowFileAccessFromFileURLs(true)
			s.setAllowUniversalAccessFromFileURLs(true)
			s.setMixedContentMode(0)
			const lp = new FrameLayout.LayoutParams(-1, -1)
			act.addContentView(wv, lp)
			pageWv = wv
			wv.bringToFront()
			bindPageWv(wv)
			console.log('[call] page injected webview')
			loadEngineHtmlInto(wv, (_ok: boolean) => {
				setTimeout(() => { pingPageWv(wv) }, 400)
				setTimeout(() => { pingPageWv(wv) }, 1200)
			})
		} catch (e) {
			console.warn('[call] page inject fail', e)
		}
	}
	function pageDestroyEngine(): void {
		const wv = pageWv
		pageWv = null
		if (wv == null) {
			destroyCallEngine()
			return
		}
		try {
			const parent = wv.getParent()
			if (parent != null && parent instanceof ViewGroup) {
				const g = parent as ViewGroup
				g.removeView(wv)
			}
		} catch (e) {}
		try { wv.destroy() } catch (e2) {}
		destroyCallEngine()
	}
	// #endif
	// #ifndef APP-ANDROID
	function pageEnsureEngine(): void {
		console.log('[call] pageEnsureEngine skip')
	}
	function pageDestroyEngine(): void {}
	// #endif

	function runEngineCmd(): void {
		const mgr = getCallManager()
		if (mgr.useLivekit) {
			if (mgr.phase == 'outgoing') mgr.placeOutgoing()
			else mgr.pushUi()
			return
		}
		if (mgr.phase == 'outgoing') {
			mgr.placeOutgoing()
		} else if (mgr.phase == 'connecting') {
			mgr.appAnswer()
		} else if (mgr.phase == 'ringing') {
			mgr.armIncoming()
		} else {
			mgr.pushUi()
		}
	}

	let lastKickKey = ''
	function armHttpsFallback(): void {
		// #ifndef H5
		if (httpsFallbackArmed) return
		httpsFallbackArmed = true
		setTimeout(() => {
			if (httpsTried && httpsReady && getCallManager().htmlLoaded) return
			console.warn('[call] https/engine fallback force')
			httpsTried = true
			httpsReady = true
			try { pageEnsureEngine() } catch (e0) {}
			kickEngine()
		}, 2500)
		// #endif
	}
	function kickEngine(): void {
		const mgr = getCallManager()
		if (mgr.phase == 'idle') return
		// #ifdef H5
		bindH5IFrame()
		if (mgr.htmlLoaded && mgr.htmlEval != null) {
			runEngineCmd()
			return
		}
		// #endif
		const ok = bindWeb()
		console.log('[call] kickEngine', mgr.phase, 'bind', ok, 'loaded', mgr.htmlLoaded, 'https', httpsTried, httpsReady)
		try { tuneCallWebView() } catch (e1) {}
		// #ifndef H5
		if (!httpsTried || !httpsReady) {
			armHttpsFallback()
			if (!httpsTried || !httpsReady) return
		}
		// #endif
		if (!ok) {
			// #ifndef H5
			try { pageEnsureEngine() } catch (ePe) {}
			// #endif
			return
		}
		const key = mgr.callId + '|' + mgr.phase + (mgr.htmlLoaded ? '|1' : '|0')
		if (mgr.htmlLoaded && lastKickKey == key) return
		if (mgr.htmlLoaded) lastKickKey = key
		if (mgr.htmlLoaded) {
			runEngineCmd()
			return
		}
		try {
			pingCallEngine((ready: boolean): void => {
				if (ready) {
					mgr.htmlLoaded = true
					lastKickKey = mgr.callId + '|' + mgr.phase + '|1'
					console.log('[call] engine ping ready', mgr.phase)
					runEngineCmd()
				} else {
					armHttpsFallback()
				}
			})
		} catch (e2) {
			runEngineCmd()
		}
	}

	function onWebLoad(_e: UniWebViewLoadEvent): void {
		const mgr = getCallManager()
		console.log('[call] engine loaded', mgr.phase, mgr.callId, 'httpsTried', httpsTried)
		bindWeb()
		try { tuneCallWebView() } catch (e0) {}
		if (!httpsTried) {
			httpsTried = true
			httpsReady = false
			try {
				pingCallEngine((already: boolean): void => {
					if (already) {
						console.log('[call] engine already live, skip https reload')
						mgr.htmlLoaded = true
						httpsReady = true
						lastKickKey = ''
						kickEngine()
						return
					}
					mgr.htmlLoaded = false
					lastKickKey = ''
					try {
						reloadEngineAsHttps((ok: boolean): void => {
							console.log('[call] https engine', ok)
							const after = (delay: number, last: boolean): void => {
								setTimeout(() => {
									const m2 = getCallManager()
									if (m2.htmlLoaded && httpsReady) return
									pingCallEngine((ready: boolean): void => {
										console.log('[call] after https ping', ready, 'last', last)
										if (ready) m2.htmlLoaded = true
										if (ready || last) {
											httpsReady = true
											lastKickKey = ''
											kickEngine()
										}
									})
								}, delay)
							}
							after(ok ? 350 : 80, false)
							after(ok ? 1200 : 400, true)
						})
					} catch (e1) {
						httpsReady = true
						kickEngine()
					}
				})
			} catch (ePing) {
				httpsReady = true
				kickEngine()
			}
			return
		}
		if (!httpsReady) return
		pingCallEngine((ready: boolean): void => {
			console.log('[call] web load ping', ready)
			if (ready) mgr.htmlLoaded = true
			lastKickKey = ''
			kickEngine()
		})
	}

	function onWebError(e: UniWebViewErrorEvent): void {
		const msg = e.detail.errMsg
		console.warn('[call] web-view error', msg)
		if (httpsTried) return
		if (msg.indexOf('page error') >= 0) return
		uni.showToast({ title: '通话页加载失败', icon: 'none' })
	}

	function takeWebStr(o: UTSJSONObject, key: string): string {
		try {
			const v = o[key]
			if (v != null) {
				const t = '' + v
				if (t.length > 0 && t != 'null' && t != 'undefined' && t != '[object Object]') return t
			}
		} catch (e0) {}
		try {
			const s = o.getString(key)
			if (s != null && s.length > 0) return s
		} catch (e1) {}
		return ''
	}

	function parseWebMsg(raw: any | null, mgr: CallManager, depth: number): void {
		if (raw == null) return
		if (depth > 6) return
		const asText = '' + raw
		if (asText.length > 2 && (asText.charAt(0) == '{' || asText.charAt(0) == '[')) {
			try {
				const parsed = JSON.parse(asText)
				parseWebMsg(parsed, mgr, depth + 1)
				return
			} catch (e0) {}
		}
		try {
			const arr = raw as Array<any>
			if (arr != null && arr.length > 0) {
				for (let i = 0; i < arr.length; i++) {
					parseWebMsg(arr[i], mgr, depth + 1)
				}
				return
			}
		} catch (e1) {}
		try {
			const o = raw as UTSJSONObject
			const kind = takeWebStr(o, 'type')
			if (kind.length == 0) {
				const inner = o.getJSON('data')
				if (inner != null) {
					parseWebMsg(inner, mgr, depth + 1)
					return
				}
				const ds = o.getString('data')
				if (ds != null && ds.length > 2) {
					parseWebMsg(ds, mgr, depth + 1)
				}
				return
			}
			let payload = ''
			const cand: UTSJSONObject = {}
			if (kind == 'offer' || kind == 'answer') {
				payload = takeWebStr(o, 'sdp')
			} else if (kind == 'error' || kind == 'failed') {
				payload = takeWebStr(o, 'message')
				if (payload.length == 0) payload = takeWebStr(o, 'reason')
			} else if (kind == 'ice') {
				payload = takeWebStr(o, 'candidate')
				cand['sdpMid'] = takeWebStr(o, 'sdpMid')
				cand['sdpMLineIndex'] = o.getNumber('sdpMLineIndex')
			} else if (kind == 'ui') {
				payload = takeWebStr(o, 'action')
			}
			const peer = takeWebStr(o, 'peer')
			if (peer.length > 0) cand['peer'] = peer
			console.log('[call] webmsg', kind, payload.length)
			mgr.onHtmlMessage(kind, payload, cand)
		} catch (e2) {}
	}

	function onWebMsg(e: UniWebViewMessageEvent): void {
		bindWeb()
		const mgr = getCallManager()
		console.log('[call] web event')
		parseWebMsg(e.detail.data, mgr, 0)
	}

	function goBack(): void {
		if (closing) return
		closing = true
		uni.navigateBack()
	}

	async function setupCall(): Promise<void> {
		let mgr = getCallManager()
		mgr.adoptIfIdle()
		mgr.bindMatrix()
		console.log('[call] setup', mgr.phase, mgr.callId, mgr.isIncoming, 'v4')
		try {
			const info = uni.getSystemInfoSync()
			console.log('[call] os', info.osName, info.uniPlatform, info.platform)
		} catch (eInfo) {}
		if (mgr.phase == 'idle') {
			console.log('[call] page waiting for ringing')
			await new Promise((resolve: (ok: boolean) => void) => {
				setTimeout(() => { resolve(true) }, 500)
			})
			mgr = getCallManager()
			mgr.adoptIfIdle()
		}
		ui.value = mgr.getSnapshot()
		startDurTimer()
		let watchPhase = mgr.phase
		off = mgr.onChange((s: CallSnapshot) => {
			ui.value = s
			refreshEngineSrc()
			if (s.phase == 'connected' || (s.phase == 'connecting' && getCallManager().connectedAt > 0)) {
				startDurTimer()
			}
			if (s.phase == 'idle') {
				stopDurTimer()
				setTimeout(() => {
					if (getCallManager().phase == 'idle') goBack()
				}, 400)
				return
			}
			if (s.phase != watchPhase) {
				watchPhase = s.phase
				kickEngine()
			}
		})
		if (mgr.phase == 'idle') {
			console.log('[call] still idle, stay and wait')
			return
		}
		await nextTick()
		refreshEngineSrc()
		console.log('[call] engine src', engineSrc.value)
		kickEngine()
		setTimeout(() => { kickEngine() }, 400)
		setTimeout(() => { kickEngine() }, 1600)
		mgr.attachDom()
		// #ifdef H5
		if (mgr.phase == 'outgoing') {
			await mgr.placeOutgoing()
		}
		// #endif
	}

	function onAccept() {
		const mgr = getCallManager()
		h5TapRunAnswer()
		bindH5IFrame()
		mgr.accept()
		kickEngine()
	}
	function onReject() {
		getCallManager().reject()
		goBack()
	}
	function onHang() {
		getCallManager().hangup(true)
		goBack()
	}
	function onMute() {
		getCallManager().toggleMute()
	}
	function onCam() {
		getCallManager().toggleCamera()
	}
	function onFlip() {
		getCallManager().flipCamera()
	}

	onMounted(() => {
		const mgr = getCallManager()
		console.log('[call] 进入页面', mgr.phase, mgr.callId)
		// #ifdef H5
		httpsTried = true
		httpsReady = true
		nextTick(() => { bindH5IFrame() })
		// #endif
		// #ifndef H5
		armHttpsFallback()
		// #endif
		setupCall()
	})
	onReady(() => {
		kickEngine()
		// #ifndef H5
		armHttpsFallback()
		// #endif
	})

	onBackPress(() => {
		if (closing) return false
		getCallManager().hangup(true)
		goBack()
		return true
	})

	onUnmounted(() => {
		stopDurTimer()
		stopOff(off)
		off = null
		const mgr = getCallManager()
		if (mgr.phase == 'idle') {
			mgr.htmlEval = null
			mgr.htmlPost = null
			mgr.htmlReady = false
			mgr.htmlLoaded = false
		}
		httpsTried = false
		httpsReady = false
		httpsFallbackArmed = false
		if (getCallManager().phase == 'idle') pageDestroyEngine()
		// #ifdef H5
		try {
			if (h5MsgFn != null) {
				window.removeEventListener('message', h5MsgFn)
				h5MsgFn = null
			}
			const doc = (window as any).document
			const win = window as any
			try {
				if (win.__callJson != null) win.__callJson('{"cmd":"hangup"}')
			} catch (e0) {}
			const root = doc.getElementById('callEngineRoot')
			if (root != null && root.parentNode != null) root.parentNode.removeChild(root)
		} catch (eH5) {}
		// #endif
	})
</script>

<style>
	.call-page {
		flex: 1;
		width: 750rpx;
		height: 100%;
		background-color: #111111;
		flex-direction: column;
	}
	.call-engine {
		width: 750rpx;
	}
	.call-stage {
		position: absolute;
		left: 0;
		right: 0;
		top: 0;
		bottom: 220rpx;
		z-index: 1;
	}
	.call-bar {
		width: 750rpx;
		padding-top: 24rpx;
		padding-bottom: 48rpx;
		padding-left: 24rpx;
		padding-right: 24rpx;
		align-items: center;
		background-color: #111111;
		z-index: 20;
		position: relative;
	}
	/* #ifdef H5 */
	.call-bar {
		position: fixed;
		left: 0;
		right: 0;
		bottom: 0;
		z-index: 10000;
	}
	/* #endif */
	.call-web {
		width: 8px;
		height: 8px;
	}
	.call-web-audio {
		width: 8px;
		height: 8px;
	}
	.call-web-video {
		width: 8px;
		height: 8px;
	}
	.call-mask {
		position: absolute;
		left: 0;
		right: 0;
		bottom: 0;
		padding: 48rpx 40rpx 80rpx;
		align-items: center;
		z-index: 3;
		background: linear-gradient(180deg, rgba(0,0,0,0) 0%, rgba(0,0,0,0.55) 100%);
	}
	.call-avatar {
		width: 160rpx;
		height: 160rpx;
		border-radius: 80rpx;
		margin-bottom: 20rpx;
		background-color: #333333;
	}
	.call-name {
		font-size: 44rpx;
		color: #ffffff;
		font-weight: 700;
		margin-bottom: 12rpx;
	}
	.call-dur {
		font-size: 32rpx;
		color: #07c160;
		margin-bottom: 40rpx;
		font-weight: 600;
	}
	.call-sub {
		font-size: 28rpx;
		color: rgba(255,255,255,0.75);
		margin-bottom: 48rpx;
	}
	.call-actions {
		flex-direction: row;
		justify-content: center;
		flex-wrap: wrap;
	}
	.call-btn {
		padding: 0 36rpx;
		height: 72rpx;
		border-radius: 48rpx;
		margin: 0 12rpx 16rpx;
		min-width: 140rpx;
		flex-direction: row;
		justify-content: center;
		align-items: center;
	}
	.call-btn-accept { background-color: #07c160; }
	.call-btn-hang {
		background-color: #fa5151;
		min-width: 240rpx;
		height: 88rpx;
		padding: 0 48rpx;
	}
	.call-btn-mute { background-color: #4a4a4a; }
	.call-btn-cam { background-color: #4a4a4a; }
	.call-btn-text {
		color: #ffffff;
		font-size: 28rpx;
		font-weight: 600;
		line-height: 28rpx;
		text-align: center;
	}
</style>
