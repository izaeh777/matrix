	}
	.btn-login {
		height: 112rpx;
		background-color: #1861c8;
		border-radius: 48rpx;
		margin-top: 12rpx;
		justify-content: center;
		align-items: center;
		border-width: 2rpx;
		border-style: solid;
		border-color: #1454b0;
	}
	.btn-sign {
		margin-top: 20rpx;
	}
	.btn-login-off {
		background-color: #8fb4ff;
		border-color: #7aa6f0;
	}
	.btn-login-text {
		color: #ffffff;
