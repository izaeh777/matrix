<template>
	<view class="page">
		<!-- #ifdef APP -->
		<view class="status-bar-holder"></view>
		<!-- #endif -->
		<view class="top-bar">
			<view class="back-btn" @click="onBack">
				<text class="back-icon">‹</text>
			</view>
			<text class="top-title">{{ t('login.wallet') }}</text>
			<view class="top-spacer"></view>
		</view>

		<scroll-view class="form-scroll" scroll-y="true">
			<text class="brand">i-tiklink</text>
			<text class="card-title">{{ t('login.walletAuth') }}</text>
			<text class="card-subtitle">{{ subTitle }}</text>

			<view class="status-card">
				<view class="status-dot" :class="(address.length > 0 || waiting) ? 'status-on' : ''"></view>
				<text class="status-text">{{ statusText }}</text>
			</view>

			<view class="invite-field">
				<text class="invite-label">{{ t('login.walletInvite') }}</text>
				<view class="invite-box">
					<input
						class="invite-input"
						type="text"
						v-model="inviteCode"
						:placeholder="t('login.invitePh')"
						placeholder-class="invite-ph"
					/>
				</view>
			</view>

			<view class="btn-login" :class="busy ? 'btn-login-off' : ''" @click="onOneTapLogin">
				<text class="btn-login-text">{{ mainBtnText }}</text>
			</view>

			<text class="hint">{{ hintText }}</text>
			<view class="form-scroll-pad"></view>
		</scroll-view>
	</view>
</template>

<script setup lang="uts">
	import { ref, computed } from 'vue'
	import { t } from '@/common/i18n.uts'
	import {
		walletChallenge,
		walletVerify,
		tpLoginInit,
		tpLoginSubmitSignature,
		tpLoginCheckOnce,
		saveTpLoginTicket,
		loadTpLoginTicket,
		clearTpLoginTicket,
		consumePendingInviteCode,
		savePendingInviteCode,
		loadPendingInviteCode,
		PlatformSession
	} from '@/common/platform.uts'
	import { startMatrixFromPlatform } from '@/common/app.uts'
	import {
		clearTpPending,
		tpSdkPersonalSign,
		tpSdkSignTicket,
		loadTpWalletAddress,
		saveTpWalletAddress
	} from '@/common/tp-wallet.uts'

	const LAST_WALLET_KEY = 'tp_last_wallet_v1'

	const address = ref<string>('')
	const inviteCode = ref<string>('')
	const loading = ref<boolean>(false)
	const checking = ref<boolean>(false)
	const waiting = ref<boolean>(false)
	const waitTip = ref<string>('')
	const appMode = ref<boolean>(false)
	// #ifdef APP
	appMode.value = true
	// #endif
	let loginDone = false
	let starting = false

	function resolveInviteForSubmit(): string {
		let inv = inviteCode.value.trim()
		if (inv.length == 0) {
			inv = consumePendingInviteCode()
		} else {
			savePendingInviteCode(inv)
			consumePendingInviteCode()
		}
		return inv
	}

	onLoad((opts: UTSJSONObject) => {
		try {
			let inv = ''
			const c1 = opts['invite']
			const c2 = opts['code']
			const c3 = opts['invite_code']
			if (c1 != null) inv = ('' + c1).trim()
			if (inv.length == 0 && c2 != null) inv = ('' + c2).trim()
			if (inv.length == 0 && c3 != null) inv = ('' + c3).trim()
			if (inv.length == 0) inv = loadPendingInviteCode()
			if (inv.length > 0) {
				savePendingInviteCode(inv)
				inviteCode.value = inv
			}
		} catch (e) {}
	})

	function loadLastWallet(): string {
		try {
			const raw = uni.getStorageSync(LAST_WALLET_KEY)
			if (raw != null) {
				const s = ('' + raw).trim()
				if (s.indexOf('0x') == 0 && s.length >= 42) return s
			}
		} catch (e) {}
		const cached = loadTpWalletAddress().trim()
		if (cached.indexOf('0x') == 0 && cached.length >= 42) return cached
		return ''
	}

	function saveLastWallet(addr: string): void {
		if (addr.length < 10) return
		try { uni.setStorageSync(LAST_WALLET_KEY, addr) } catch (e) {}
		saveTpWalletAddress(addr)
	}

	function sleepMs(ms: number): Promise<void> {
		return new Promise<void>((resolve, _reject) => {
			setTimeout(() => { resolve() }, ms)
		})
	}

	const busy = computed((): boolean => {
		return loading.value || starting
	})

	const shortAddr = computed((): string => {
		const a = address.value
		if (a.length < 12) return a
		return a.substring(0, 6) + '...' + a.substring(a.length - 4)
	})

	const subTitle = computed((): string => {
		if (appMode.value) return t('login.walletTpOnce')
		return t('login.walletSupport')
	})

	const statusText = computed((): string => {
		if (waitTip.value.length > 0) return waitTip.value
		if (address.value.length > 0) return shortAddr.value
		return t('login.walletNotConnected')
	})

	const mainBtnText = computed((): string => {
		if (loading.value) return t('login.wait')
		return appMode.value ? t('login.walletAuthBtn') : t('login.walletSignBtn')
	})

	const hintText = computed((): string => {
		if (appMode.value) {
			return t('login.walletTipApp')
		}
		return t('login.walletTipH5')
	})

	type WalletBridge = {
		connect: () => Promise<string>
		personalSign: (message: string, addr: string) => Promise<string>
	}

	function onBack(): void {
		uni.navigateBack({})
	}

	function errMsg(e: any): string {
		let msg = t('login.walletOpFail')
		try { msg = '' + e } catch (e2) {}
		if (msg.indexOf('Error:') == 0) msg = msg.substring(6).trim()
		if (msg.indexOf('HTTP_525') >= 0 || msg.indexOf('CDN') >= 0) {
			return t('login.walletNet')
		}
		return msg.length > 0 ? msg : t('login.walletOpFail')
	}

	function ensureWalletBridge(): WalletBridge | null {
		// #ifdef H5
		try {
			const w = window as any
			if (w == null) return null
			if (w.__itikWallet != null) return w.__itikWallet as WalletBridge
			const makeBridge = (): WalletBridge => {
				const provider = (): any | null => {
					try {
						if (w.tokenpocket != null && w.tokenpocket.ethereum != null) return w.tokenpocket.ethereum
					} catch (e0) {}
					try {
						if (w.deboxWallet != null) return w.deboxWallet
					} catch (e1) {}
					try {
						if (w.ethereum != null) return w.ethereum
					} catch (e2) {}
					return null
				}
				const bridge: WalletBridge = {
					connect: async (): Promise<string> => {
						const eth = provider()
						if (eth == null) throw new Error(t('login.noWallet'))
						const accounts = await eth.request({ method: 'eth_requestAccounts', params: [] }) as string[]
						if (accounts == null || accounts.length == 0) throw new Error(t('login.noAddr'))
						return accounts[0]
					},
					personalSign: async (message: string, addr: string): Promise<string> => {
						const eth = provider()
						if (eth == null) throw new Error(t('login.noWallet'))
						return await eth.request({ method: 'personal_sign', params: [message, addr] }) as string
					}
				}
				w.__itikWallet = bridge
				return bridge
			}
			return makeBridge()
		} catch (e0) {}
		// #endif
		return null
	}

	async function afterLoginOk(session: PlatformSession): Promise<void> {
		if (loginDone) return
		loginDone = true
		waiting.value = false
		const addr = session.email
		if (addr.length > 0) address.value = addr
		clearTpPending()
		clearTpLoginTicket()
		waitTip.value = ''
		uni.hideLoading()
		loading.value = false
		try {
			startMatrixFromPlatform()
		} catch (eMx) {
			console.warn('[wallet] matrix start fail', eMx)
		}
		uni.showToast({ title: t('login.ok'), icon: 'success' })
		setTimeout(() => {
			uni.reLaunch({ url: '/pages/home/home' })
		}, 500)
	}

	async function finishLoginSiwe(addr: string, signature: string): Promise<void> {
		const invite = resolveInviteForSubmit()
		console.log('[wallet] verify start', addr, 'sigLen=', signature.length, 'invite=', invite)
		const session = await walletVerify(addr, signature, invite)
		await afterLoginOk(session)
	}

	/** 有地址：challenge + 一次 personalSign + verify */
	async function loginWithCachedWallet(wallet: string): Promise<void> {
		address.value = wallet
		waitTip.value = t('login.walletSigning')
		uni.showLoading({ title: t('login.walletPreparing') })
		const challenge = await walletChallenge(wallet)
		console.log('[wallet] challenge msgLen=', challenge.message.length)
		waiting.value = true
		waitTip.value = t('login.walletConfirmTp')
		uni.showLoading({ title: t('login.walletOpenSign') })
		const signed = await tpSdkPersonalSign(challenge.message)
		console.log('[wallet] signed ok=', signed.ok, 'wallet=', signed.wallet, 'sigLen=', signed.signature.length)
		if (!signed.ok || signed.signature.length == 0) {
			throw new Error(t('login.signCancel'))
		}
		const useWallet = signed.wallet.length > 10 ? signed.wallet : wallet
		address.value = useWallet
		saveLastWallet(useWallet)
		waitTip.value = t('login.walletFinishing')
		uni.showLoading({ title: t('login.loggingIn') })
		const invite = resolveInviteForSubmit()
		console.log('[wallet] verify invite=', invite)
		const session = await walletVerify(useWallet, signed.signature, invite)
		await afterLoginOk(session)
	}

	/**
	 * 无缓存地址：tp-login 一次签名 → 按服务端字段回传完成 ticket
	 * 若 ticket 仍 pending：已有钱包地址，再走 challenge 签一次（不再 authorize）
	 */
	async function loginWithTpTicketOnce(): Promise<boolean> {
		const invite = resolveInviteForSubmit()
		waitTip.value = t('login.walletProtocol')
		uni.showLoading({ title: t('login.walletPreparing') })
		const init = await tpLoginInit(invite, '')
		if (init.message.length == 0 || init.ticket.length == 0) {
			console.warn('[wallet] tp-login message empty')
			return false
		}
		saveTpLoginTicket(init.ticket, init.expire)
		console.log('[wallet] tp-login once ticket=', init.ticket, 'msgLen=', init.message.length)
		waiting.value = true
		waitTip.value = t('login.walletConfirmTp')
		uni.showLoading({ title: t('login.walletOpenSign') })
		const signed = await tpSdkSignTicket(init.message, init.ticket)
		console.log('[wallet] tp-login signed ok=', signed.ok, 'wallet=', signed.wallet, 'sigLen=', signed.signature.length)
		if (!signed.ok || signed.signature.length == 0) {
			throw new Error(t('login.signCancel'))
		}
		const useWallet = signed.wallet
		if (useWallet.length < 10) {
			throw new Error(t('login.noAddr'))
		}
		address.value = useWallet
		saveLastWallet(useWallet)

		waitTip.value = t('login.walletFinishing')
		uni.showLoading({ title: t('login.loggingIn') })
		try {
			await tpLoginSubmitSignature(init.ticket, useWallet, signed.signature)
		} catch (eSub) {
			console.warn('[wallet] tp-login submit err', eSub)
		}
		for (let i = 0; i < 6; i++) {
			try {
				const session = await tpLoginCheckOnce(init.ticket)
				if (session != null) {
					await afterLoginOk(session)
					return true
				}
			} catch (eCheck) {
				const m = errMsg(eCheck)
				if (m.indexOf('过期') >= 0) break
				console.warn('[wallet] tp-login check', m)
			}
			await sleepMs(800)
		}
		// ticket 未完成：地址已缓存，改走 SIWE（再弹一次签名）
		console.log('[wallet] ticket still pending, SIWE with cached wallet')
		clearTpLoginTicket()
		await loginWithCachedWallet(useWallet)
		return true
	}

	/**
	 * App（Mobile-SDK）
	 * - 有缓存地址：只弹一次签名（challenge/verify）
	 * - 无缓存：优先 tp-login 一次签名完成；不成再 SIWE 补一次
	 */
	async function onOneTapApp(): Promise<void> {
		if (starting || loading.value) return
		starting = true
		loginDone = false
		loading.value = true
		waiting.value = false
		clearTpLoginTicket()
		try {
			const wallet = loadLastWallet()
			if (wallet.length >= 10) {
				console.log('[wallet] use cached wallet', wallet)
				await loginWithCachedWallet(wallet)
			} else {
				await loginWithTpTicketOnce()
			}
			starting = false
		} catch (e) {
			console.warn('[wallet] app login fail', e)
			starting = false
			waiting.value = false
			uni.hideLoading()
			loading.value = false
			waitTip.value = ''
			clearTpLoginTicket()
			uni.showToast({ title: errMsg(e), icon: 'none', duration: 3500 })
		}
	}

	/** H5：仍走 challenge + verify */
	async function onOneTapH5(): Promise<void> {
		const bridge = ensureWalletBridge()
		if (bridge == null) {
			uni.showToast({ title: t('login.openInWallet'), icon: 'none' })
			return
		}
		loading.value = true
		uni.showLoading({ title: t('login.signing') })
		try {
			const addr = await bridge.connect()
			const useAddr = addr != null ? ('' + addr) : ''
			if (useAddr.length == 0) throw new Error(t('login.noAddr'))
			address.value = useAddr
			const challenge = await walletChallenge(useAddr)
			const signature = await bridge.personalSign(challenge.message, useAddr)
			if (signature == null || ('' + signature).length == 0) {
				throw new Error(t('login.signFail'))
			}
			await finishLoginSiwe(useAddr, '' + signature)
		} catch (e) {
			uni.hideLoading()
			loading.value = false
			waitTip.value = ''
			uni.showToast({ title: errMsg(e), icon: 'none', duration: 3000 })
		}
	}

	async function onOneTapLogin(): Promise<void> {
		if (busy.value) return
		if (appMode.value) {
			await onOneTapApp()
			return
		}
		await onOneTapH5()
	}

	onShow(() => {
		if (!appMode.value) return
		if (loginDone || starting) return
		const ticket = loadTpLoginTicket()
		if (ticket.length == 0) return
		// 从 TP 回到前台：补查一次 ticket（定时器可能被系统挂起）
		console.log('[wallet] onShow check ticket', ticket)
		waiting.value = true
		waitTip.value = t('login.confirming')
		const run = async (): Promise<void> => {
			try {
				const session = await tpLoginCheckOnce(ticket)
				if (session == null || loginDone) return
				await afterLoginOk(session)
			} catch (e) {
				console.warn('[wallet] onShow ticket check', e)
			}
		}
		run()
	})
</script>

<style>
	.page {
		flex: 1;
		background: linear-gradient(180deg, #eaf6ff 0%, #ffffff 40%);
		padding: 24rpx 48rpx 0;
		flex-direction: column;
	}
	.form-scroll {
		flex: 1;
		height: 0;
		padding-bottom: 48rpx;
	}
	.form-scroll-pad {
		height: 40rpx;
	}
	.top-bar {
		flex-direction: row;
		align-items: center;
		justify-content: space-between;
		height: 88rpx;
		margin-bottom: 40rpx;
	}
	.back-btn {
		width: 72rpx;
		height: 72rpx;
		align-items: center;
		justify-content: center;
	}
	.back-icon {
		font-size: 56rpx;
		color: #1a1a1a;
		line-height: 56rpx;
	}
	.top-title {
		font-size: 34rpx;
		font-weight: 600;
		color: #1a1a1a;
	}
	.top-spacer {
		width: 72rpx;
	}
	.brand {
		font-size: 48rpx;
		font-weight: 700;
		color: #0b6bcb;
		margin-bottom: 12rpx;
	}
	.card-title {
		font-size: 36rpx;
		font-weight: 600;
		color: #1a1a1a;
		margin-top: 24rpx;
	}
	.card-subtitle {
		font-size: 26rpx;
		color: #6b7280;
		margin-top: 8rpx;
		margin-bottom: 36rpx;
		lines: 2;
	}
	.status-card {
		flex-direction: row;
		align-items: center;
		background-color: #f3f8fe;
		border-radius: 16rpx;
		padding: 24rpx 28rpx;
		margin-bottom: 32rpx;
	}
	.status-dot {
		width: 16rpx;
		height: 16rpx;
		border-radius: 8rpx;
		background-color: #9ca3af;
		margin-right: 16rpx;
	}
	.status-on {
		background-color: #07c160;
	}
	.status-text {
		flex: 1;
		font-size: 28rpx;
		color: #374151;
		lines: 2;
	}
	.invite-field {
		margin-bottom: 28rpx;
	}
	.invite-label {
		font-size: 24rpx;
		color: #475569;
		margin-bottom: 12rpx;
		font-weight: 600;
	}
	.invite-box {
		flex-direction: row;
		align-items: center;
		background-color: #f4f8fd;
		border-radius: 16rpx;
		padding: 0 24rpx;
		height: 96rpx;
		border-width: 2rpx;
		border-style: solid;
		border-color: #e2eef8;
	}
	.invite-input {
		flex: 1;
		font-size: 28rpx;
		color: #0f172a;
		height: 96rpx;
	}
	.invite-ph {
		color: #94a3b8;
	}
	.btn-login {
		height: 96rpx;
		border-radius: 48rpx;
		background-color: #0b6bcb;
		align-items: center;
		justify-content: center;
		margin-top: 12rpx;
	}
	.btn-check {
		background-color: #374151;
		margin-top: 20rpx;
	}
	.btn-login-off {
		opacity: 0.55;
	}
	.btn-login-text {
		font-size: 32rpx;
		font-weight: 600;
		color: #ffffff;
	}
	.hint {
		margin-top: 28rpx;
		font-size: 24rpx;
		color: #9ca3af;
		lines: 4;
	}
</style>
