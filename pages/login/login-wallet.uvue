<template>
	<view class="page">
		<view class="top-bar">
			<view class="back-btn" @click="onBack">
				<text class="back-icon">‹</text>
			</view>
			<text class="top-title">钱包登录</text>
			<view class="top-spacer"></view>
		</view>

		<text class="brand">i-tiklink</text>
		<text class="card-title">钱包授权登录</text>
		<text class="card-subtitle">支持 TokenPocket / DeBox / MetaMask 等（EIP-4361）</text>

		<view class="status-card">
			<view class="status-dot" :class="address.length > 0 ? 'status-on' : ''"></view>
			<text class="status-text">{{ address.length > 0 ? shortAddr : '未连接钱包' }}</text>
		</view>

		<view class="field">
			<text class="field-label">钱包地址</text>
			<view class="input-box">
				<input
					class="input"
					type="text"
					:value="address"
					disabled
					placeholder="点击下方连接钱包自动读取"
					placeholder-class="placeholder"
				/>
			</view>
		</view>

		<view class="field">
			<text class="field-label">推荐人邀请码（可选）</text>
			<view class="input-box">
				<input
					class="input"
					type="text"
					v-model="inviteCode"
					placeholder="新钱包注册时可填写"
					placeholder-class="placeholder"
				/>
			</view>
		</view>

		<view class="btn-login" :class="loading ? 'btn-login-off' : ''" @click="onConnect">
			<text class="btn-login-text">{{ address.length > 0 ? '重新连接钱包' : '连接钱包' }}</text>
		</view>

		<view
			class="btn-login btn-sign"
			:class="(loading || address.length == 0) ? 'btn-login-off' : ''"
			@click="onSignLogin"
		>
			<text class="btn-login-text">{{ loading ? '请稍候…' : '一键签名登录/注册' }}</text>
		</view>

		<text class="hint">流程：连接钱包 → 获取挑战 → personal_sign → 校验登录</text>
	</view>
</template>

<script setup lang="uts">
	import { ref, computed } from 'vue'
	import { walletChallenge, walletVerify } from '@/common/platform.uts'
	import { startMatrixFromPlatform } from '@/common/app.uts'

	const address = ref<string>('')
	const inviteCode = ref<string>('')
	const loading = ref<boolean>(false)

	const shortAddr = computed((): string => {
		const a = address.value
		if (a.length < 12) return a
		return a.substring(0, 6) + '...' + a.substring(a.length - 4)
	})

	function onBack(): void {
		uni.navigateBack({})
	}

	function errMsg(e: any): string {
		let msg = '操作失败'
		try { msg = '' + e } catch (e2) {}
		if (msg.indexOf('Error:') == 0) msg = msg.substring(6).trim()
		return msg.length > 0 ? msg : '操作失败'
	}

	function walletBridge(): any | null {
		// #ifdef H5
		try {
			const w = window as any
			if (w != null && w.__itikWallet != null) return w.__itikWallet
		} catch (e0) {}
		// #endif
		return null
	}

	async function onConnect(): Promise<void> {
		if (loading.value) return
		const bridge = walletBridge()
		if (bridge == null) {
			uni.showToast({ title: '请在 TP / DeBox 等钱包浏览器内打开', icon: 'none' })
			return
		}
		loading.value = true
		try {
			const addr = await bridge.connect() as string
			address.value = addr != null ? ('' + addr) : ''
			uni.showToast({ title: '钱包已连接', icon: 'none' })
		} catch (e) {
			uni.showToast({ title: errMsg(e), icon: 'none', duration: 3000 })
		}
		loading.value = false
	}

	async function onSignLogin(): Promise<void> {
		if (loading.value) return
		const addr = address.value.trim()
		if (addr.length == 0) {
			uni.showToast({ title: '请先连接钱包', icon: 'none' })
			return
		}
		const bridge = walletBridge()
		if (bridge == null) {
			uni.showToast({ title: '请在 TP / DeBox 等钱包浏览器内打开', icon: 'none' })
			return
		}
		loading.value = true
		uni.showLoading({ title: '签名登录中…' })
		try {
			const challenge = await walletChallenge(addr)
			const signature = await bridge.personalSign(challenge.message, addr) as string
			if (signature == null || ('' + signature).length == 0) {
				throw new Error('签名失败')
			}
			await walletVerify(addr, '' + signature, inviteCode.value)
			startMatrixFromPlatform()
			uni.hideLoading()
			uni.showToast({ title: '登录成功', icon: 'success' })
			setTimeout(() => {
				uni.reLaunch({ url: '/pages/home/home' })
			}, 500)
		} catch (e) {
			uni.hideLoading()
			loading.value = false
			uni.showToast({ title: errMsg(e), icon: 'none', duration: 3000 })
		}
	}
</script>

