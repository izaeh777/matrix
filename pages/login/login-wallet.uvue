		flex-direction: row;
		align-items: center;
		background-color: #f3f6fb;
		border-radius: 16rpx;
		padding: 20rpx 24rpx;
		margin-bottom: 28rpx;
	}
	.status-dot {
		width: 16rpx;
		height: 16rpx;
		border-radius: 8rpx;
		background-color: #f59e0b;
		margin-right: 12rpx;
	}
	.status-on {
		background-color: #10b981;
	}
	.status-text {
		font-size: 26rpx;
		color: #374151;
	}
	.field {
		margin-bottom: 24rpx;
	}
	.field-label {
		font-size: 26rpx;
		color: #4b5563;
		margin-bottom: 12rpx;
		font-weight: 600;
	}
	.input-box {
		background-color: #ffffff;
		border-radius: 16rpx;
		border-width: 1rpx;
		border-style: solid;
		border-color: #e5e7eb;
		padding: 0 24rpx;
		height: 96rpx;
		justify-content: center;
	}
	.input {
		font-size: 28rpx;
