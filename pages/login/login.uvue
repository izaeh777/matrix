<template>
	<view class="page">
		<!-- #ifdef APP -->
		<view class="status-bar-holder"></view>
		<!-- #endif -->
		<view class="hero">
			<view class="hero-fade"></view>
			<view class="header">
				<image class="brand-logo" src="/static/login/logo.png" mode="aspectFit"></image>
				<view class="lang" @click="onLang">
					<image class="lang-icon" src="/static/login/china.png" mode="aspectFit"></image>
					<text class="lang-text">简体中文</text>
					<text class="lang-caret">▾</text>
				</view>
			</view>

			<view class="mascot-wrap">
				<image class="mascot" src="/static/login/tiki.png" mode="aspectFit" />
			</view>

			<image class="slogan-img" src="/static/login/ls.png" mode="widthFix"></image>

			<view class="btn-primary" @click="goLogin">
				<text class="btn-primary-text">登录</text>
			</view>
		</view>

		<view class="btn-outline" @click="onRegister">
			<text class="btn-outline-text">注册账号</text>
		</view>

		<view class="other-row">
			<view class="other-line"></view>
			<text class="other-text">其他方式登录</text>
			<view class="other-line"></view>
		</view>

		<view class="methods">
			<view class="method" @click="onOther('tp')">
				<image class="method-icon" src="/static/login/apple.png" mode="aspectFit" />
			</view>
			<view class="method" @click="goEmailLogin">
				<image class="method-icon" src="/static/login/ball-big.png" mode="aspectFit" />
			</view>
		</view>
	</view>
</template>

<script setup lang="uts">
	import { savePendingInviteCode } from '@/common/platform.uts'

	onLoad((opts: UTSJSONObject) => {
		try {
			let inv = ''
			const c1 = opts['invite']
			const c2 = opts['code']
			const c3 = opts['invite_code']
			if (c1 != null) inv = ('' + c1).trim()
			if (inv.length == 0 && c2 != null) inv = ('' + c2).trim()
			if (inv.length == 0 && c3 != null) inv = ('' + c3).trim()
			if (inv.length > 0) savePendingInviteCode(inv)
		} catch (e) {}
	})

	function goLogin() {
		uni.navigateTo({ url: '/pages/login/login-mail' })
	}

	function goEmailLogin() {
		uni.navigateTo({ url: '/pages/login/login-mail' })
	}

	function onRegister() {
		uni.navigateTo({ url: '/pages/login/login-mail?mode=register' })
	}

	function onLang() {
		uni.showToast({ title: '当前仅支持简体中文', icon: 'none' })
	}

	function onOther(name: string) {
		if (name == 'tp') {
			uni.navigateTo({ url: '/pages/login/login-wallet' })
			return
		}
		uni.showToast({ title: '该登录方式暂未开放', icon: 'none' })
	}
</script>

