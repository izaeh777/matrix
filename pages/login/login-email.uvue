		color: #0f172a;
		margin-bottom: 10rpx;
	}
	.card-subtitle {
		font-size: 26rpx;
		color: #64748b;
		margin-bottom: 48rpx;
	}

	.field {
		margin-bottom: 28rpx;
	}
	.field-label {
		font-size: 24rpx;
		color: #475569;
		margin-bottom: 12rpx;
		font-weight: 600;
	}
	.input-box {
		flex-direction: row;
		align-items: center;
		background-color: #f4f8fd;
		border-radius: 16rpx;
		padding: 0 24rpx;
		height: 96rpx;
		border-width: 2rpx;
		border-style: solid;
		border-color: #e2eef8;
	}
	.input-eye {
		font-size: 24rpx;
		color: #1e6fff;
		padding: 8rpx;
	}
	.input {
		flex: 1;
