<template>
	<view class="page">
		<!-- #ifdef APP -->
		<view class="status-bar-holder"></view>
		<!-- #endif -->
		<view class="top-bar">
			<view class="back-btn" @click="onBack">
				<text class="back-icon">‹</text>
			</view>
			<text class="top-title">{{ t('login.signIn') }}</text>
			<view class="top-spacer"></view>
		</view>

		<image class="brand-logo" src="/static/login/logo.png" mode="aspectFit"></image>
		<text class="card-title">{{ t('login.welcome') }}</text>
		<text class="card-subtitle">{{ t('login.pwdLoginSub') }}</text>

		<view class="field">
			<text class="field-label">{{ t('login.username') }}</text>
			<view class="input-box">
				<input
					class="input"
					type="text"
					v-model="username"
					:placeholder="t('login.usernamePh')"
					placeholder-class="placeholder"
				/>
			</view>
		</view>

		<view class="field">
			<text class="field-label">{{ t('login.password') }}</text>
			<view class="input-box">
				<input
					class="input"
					:type="showPwd ? 'text' : 'password'"
					v-model="password"
					:placeholder="t('login.passwordPh')"
					placeholder-class="placeholder"
				/>
				<text class="input-eye" @click="togglePwd">{{ showPwd ? t('login.hide') : t('login.show') }}</text>
			</view>
		</view>

		<view class="btn-login" :class="loading ? 'btn-login-off' : ''" @click="onLogin">
			<text class="btn-login-text">{{ loading ? t('login.loggingIn') : t('login.signIn') }}</text>
		</view>

		<view class="signup-row">
			<text class="signup-text">{{ t('login.noAccount') }}</text>
			<text class="signup-link" @click="onSignup">{{ t('login.signUp') }}</text>
		</view>
	</view>
</template>

<script setup lang="uts">
	import { ref } from 'vue'
	import { t } from '@/common/i18n.uts'
	import { MatrixClient, errText } from '@/common/matrix.uts'
	import { startMatrixSession } from '@/common/app.uts'
	import { saveSession } from '@/common/storage.uts'

	const username = ref<string>('')
	const password = ref<string>('')
	const homeserver = ref<string>('https://matrix.itiklink.com')
	const showPwd = ref<boolean>(false)
	const loading = ref<boolean>(false)

	function onBack() {
		uni.navigateBack()
	}

	function togglePwd() {
		showPwd.value = !showPwd.value
	}

	function onSignup() {
		uni.showToast({ title: t('login.contactAdmin'), icon: 'none' })
	}

	async function onLogin() {
		if (loading.value) return
		const user = username.value.trim()
		const pwd = password.value
		if (user.length == 0) {
			uni.showToast({ title: t('login.needUsername'), icon: 'none' })
			return
		}
		if (pwd.length == 0) {
			uni.showToast({ title: t('login.needPwd'), icon: 'none' })
			return
		}

		loading.value = true
		uni.showLoading({ title: t('login.loggingIn') })
		try {
			const client = new MatrixClient()
			const session = await client.login(homeserver.value.trim(), user, pwd)
			const matrix = startMatrixSession(session)

			try {
				const profile = await matrix.getProfile(session.user_id)
				session.display_name = profile.display_name
				session.avatar_url = profile.avatar_url
				saveSession(session)
			} catch (e) {
				console.warn('拉取 profile 失败，不致命', e)
			}

			uni.hideLoading()
			uni.showToast({ title: t('login.ok'), icon: 'success' })

			setTimeout(() => {
				uni.reLaunch({ url: '/pages/home/home' })
			}, 600)
		} catch (e: any) {
			uni.hideLoading()
			loading.value = false
			const msg = errText(e, t('login.fail'))
			uni.showToast({ title: msg, icon: 'none', duration: 3000 })
		}
	}
</script>

