		margin-bottom: 12rpx;
		font-weight: 600;
	}
	.input-box {
		flex-direction: row;
		align-items: center;
		background-color: #f4f8fd;
		border-radius: 16rpx;
		padding: 0 24rpx;
		height: 96rpx;
		border-width: 2rpx;
