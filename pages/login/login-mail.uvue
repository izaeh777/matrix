<template>
	<view class="page">
		<!-- #ifdef APP -->
		<view class="status-bar-holder"></view>
		<!-- #endif -->
		<view class="top-bar">
			<view class="back-btn" @click="onBack">
				<text class="back-icon">‹</text>
			</view>
			<text class="top-title">{{ isRegister ? i18n.register : i18n.mail }}</text>
			<view class="top-spacer"></view>
		</view>

		<scroll-view class="form-scroll" scroll-y="true">
			<image class="brand-logo" src="/static/login/logo.png" mode="aspectFit"></image>
			<text class="card-title">{{ isRegister ? i18n.create : i18n.welcome }}</text>
			<text class="card-subtitle">{{ cardSub }}</text>

			<view v-if="!isRegister" class="mode-tabs">
				<view class="mode-tab" :class="loginByPwd ? 'mode-tab-on' : ''" @click="setLoginByPwd(true)">
					<text class="mode-tab-text" :class="loginByPwd ? 'mode-tab-text-on' : ''">{{ i18n.pwdTab }}</text>
				</view>
				<view class="mode-tab" :class="!loginByPwd ? 'mode-tab-on' : ''" @click="setLoginByPwd(false)">
					<text class="mode-tab-text" :class="!loginByPwd ? 'mode-tab-text-on' : ''">{{ i18n.codeTab }}</text>
				</view>
			</view>

			<view class="field">
				<text class="field-label">{{ i18n.email }}</text>
				<view class="input-box">
					<input
						class="input"
						type="text"
						v-model="email"
						:placeholder="i18n.emailPh"
						placeholder-class="placeholder"
					/>
				</view>
			</view>

			<view v-if="isRegister || !loginByPwd" class="field">
				<text class="field-label">{{ i18n.code }}</text>
				<view class="input-box">
					<input
						class="input"
						type="number"
						v-model="code"
						:placeholder="i18n.codePh"
						placeholder-class="placeholder"
					/>
					<text
						class="code-btn"
						:class="codeWait > 0 ? 'code-btn-off' : ''"
						@click="onSendCode"
					>{{ codeWait > 0 ? (codeWait + 's') : i18n.getCode }}</text>
				</view>
			</view>

			<view v-if="isRegister" class="field">
				<text class="field-label">{{ i18n.nickname }}</text>
				<view class="input-box">
					<input
						class="input"
						type="text"
						v-model="nickname"
						:placeholder="i18n.nicknamePh"
						placeholder-class="placeholder"
					/>
				</view>
			</view>

			<view v-if="isRegister || loginByPwd" class="field">
				<text class="field-label">{{ i18n.password }}</text>
				<view class="input-box">
					<input
						class="input"
						:type="showPwd ? 'text' : 'password'"
						v-model="password"
						:placeholder="isRegister ? i18n.passwordMin : i18n.passwordPh"
						placeholder-class="placeholder"
					/>
					<text class="input-eye" @click="togglePwd">{{ showPwd ? i18n.hide : i18n.show }}</text>
				</view>
			</view>

			<view v-if="isRegister" class="field">
				<text class="field-label">{{ i18n.invite }}</text>
				<view class="input-box">
					<input
						class="input"
						type="text"
						v-model="inviteCode"
						:placeholder="i18n.invitePh"
						placeholder-class="placeholder"
					/>
				</view>
			</view>

			<view class="btn-login" :class="loading ? 'btn-login-off' : ''" @click="onSubmit">
				<text class="btn-login-text">{{ loading ? i18n.wait : (isRegister ? i18n.registerLogin : i18n.signIn) }}</text>
			</view>

			<view class="signup-row">
				<text class="signup-text">{{ isRegister ? i18n.hasAccount : i18n.noAccount }}</text>
				<text class="signup-link" @click="toggleMode">{{ isRegister ? i18n.goLogin : i18n.signUp }}</text>
			</view>
			<view class="form-scroll-pad"></view>
		</scroll-view>
	</view>
</template>

<script setup lang="uts">
	import { ref, onUnmounted, computed } from 'vue'
	import {
		sendEmailCode,
		emailLogin,
		emailPasswordLogin,
		emailRegister,
		consumePendingInviteCode,
		savePendingInviteCode,
		loadPendingInviteCode
	} from '@/common/platform.uts'
	import { startMatrixFromPlatform } from '@/common/app.uts'
	import { t } from '@/common/i18n.uts'

	
	type MailI18n = {
		register: string
		mail: string
		create: string
		welcome: string
		pwdTab: string
		codeTab: string
		email: string
		emailPh: string
		code: string
		codePh: string
		getCode: string
		nickname: string
		nicknamePh: string
		password: string
		passwordPh: string
		passwordMin: string
		show: string
		hide: string
		invite: string
		invitePh: string
		wait: string
		registerLogin: string
		signIn: string
		hasAccount: string
		noAccount: string
		goLogin: string
		signUp: string
	}
	function buildMailI18n(): MailI18n {
		return {
			register: t('login.register'),
			mail: t('login.mail'),
			create: t('login.create'),
			welcome: t('login.welcome'),
			pwdTab: t('login.pwdTab'),
			codeTab: t('login.codeTab'),
			email: t('login.email'),
			emailPh: t('login.emailPh'),
			code: t('login.code'),
			codePh: t('login.codePh'),
			getCode: t('login.getCode'),
			nickname: t('login.nickname'),
			nicknamePh: t('login.nicknamePh'),
			password: t('login.password'),
			passwordPh: t('login.passwordPh'),
			passwordMin: t('login.passwordMin'),
			show: t('login.show'),
			hide: t('login.hide'),
			invite: t('login.invite'),
			invitePh: t('login.invitePh'),
			wait: t('login.wait'),
			registerLogin: t('login.registerLogin'),
			signIn: t('login.signIn'),
			hasAccount: t('login.hasAccount'),
			noAccount: t('login.noAccount'),
			goLogin: t('login.goLogin'),
			signUp: t('login.signUp')
		} as MailI18n
	}
	const i18n = ref<MailI18n>(buildMailI18n())
	const isRegister = ref<boolean>(false)
	/** 登录页：true=密码登录，false=验证码登录 */
	const loginByPwd = ref<boolean>(true)
	const email = ref<string>('')
	const code = ref<string>('')
	const nickname = ref<string>('')
	const password = ref<string>('')
	const inviteCode = ref<string>('')
	const showPwd = ref<boolean>(false)
	const loading = ref<boolean>(false)
	const codeWait = ref<number>(0)
	let codeTimer: number | null = null

	const cardSub = computed((): string => {
		if (isRegister.value) return t('login.subRegister')
		if (loginByPwd.value) return t('login.subPwd')
		return t('login.subCode')
	})

	function resolveInviteForSubmit(): string {
		let inv = inviteCode.value.trim()
		if (inv.length == 0) {
			inv = consumePendingInviteCode()
		} else {
			savePendingInviteCode(inv)
			consumePendingInviteCode()
		}
		return inv
	}

	onLoad((opts: UTSJSONObject) => {
		try {
			const m = opts['mode']
			if (m != null && ('' + m) == 'register') isRegister.value = true
		} catch (e) {}
		try {
			let inv = ''
			const c1 = opts['invite']
			const c2 = opts['code']
			const c3 = opts['invite_code']
			if (c1 != null) inv = ('' + c1).trim()
			if (inv.length == 0 && c2 != null) inv = ('' + c2).trim()
			if (inv.length == 0 && c3 != null) inv = ('' + c3).trim()
			if (inv.length == 0) inv = loadPendingInviteCode()
			if (inv.length > 0) {
				savePendingInviteCode(inv)
				inviteCode.value = inv
			}
		} catch (eInv) {}
	})

	onShow(() => {
		i18n.value = buildMailI18n()
	})

	onUnmounted(() => {
		const t = codeTimer
		codeTimer = null
		if (t != null) {
			clearInterval(t as number)
		}
	})

	function onBack() {
		uni.navigateBack()
	}

	function togglePwd() {
		showPwd.value = !showPwd.value
	}

	function setLoginByPwd(v: boolean): void {
		loginByPwd.value = v
	}

	function toggleMode() {
		isRegister.value = !isRegister.value
	}

	function validEmail(v: string): boolean {
		if (v.length < 5) return false
		if (v.indexOf('@') < 1) return false
		if (v.indexOf('.') < 0) return false
		return true
	}

	function startCodeCountdown(): void {
		codeWait.value = 60
		const old = codeTimer
		codeTimer = null
		if (old != null) {
			clearInterval(old as number)
		}
		codeTimer = setInterval(() => {
			if (codeWait.value <= 1) {
				codeWait.value = 0
				const t = codeTimer
				codeTimer = null
				if (t != null) {
					clearInterval(t as number)
				}
				return
			}
			codeWait.value = codeWait.value - 1
		}, 1000)
	}

	async function onSendCode(): Promise<void> {
		if (codeWait.value > 0 || loading.value) return
		const em = email.value.trim()
		if (!validEmail(em)) {
			uni.showToast({ title: t('login.needEmail'), icon: 'none' })
			return
		}
		const event = isRegister.value ? 'register' : 'login'
		uni.showLoading({ title: t('login.sending') })
		try {
			await sendEmailCode(em, event)
			uni.hideLoading()
			uni.showToast({ title: t('login.codeSent'), icon: 'none' })
			startCodeCountdown()
		} catch (e) {
			uni.hideLoading()
			let msg = t('login.sendFail')
			try { msg = '' + e } catch (e2) {}
			if (msg.indexOf('Error:') == 0) msg = msg.substring(6).trim()
			uni.showToast({ title: msg.length > 0 ? msg : t('login.sendFail'), icon: 'none', duration: 3000 })
		}
	}

	async function onSubmit(): Promise<void> {
		if (loading.value) return
		const em = email.value.trim()
		const cd = code.value.trim()
		const pwd = password.value
		if (!validEmail(em)) {
			uni.showToast({ title: t('login.needEmail'), icon: 'none' })
			return
		}
		if (isRegister.value) {
			if (cd.length == 0) {
				uni.showToast({ title: t('login.needCode'), icon: 'none' })
				return
			}
			if (pwd.length < 6) {
				uni.showToast({ title: t('login.passwordMin'), icon: 'none' })
				return
			}
		} else if (loginByPwd.value) {
			if (pwd.length == 0) {
				uni.showToast({ title: t('login.needPwd'), icon: 'none' })
				return
			}
		} else {
			if (cd.length == 0) {
				uni.showToast({ title: t('login.needCode'), icon: 'none' })
				return
			}
		}

		loading.value = true
		uni.showLoading({ title: isRegister.value ? t('login.wait') : t('login.loggingIn') })
		try {
			if (isRegister.value) {
				const invite = resolveInviteForSubmit()
				console.log('[mail] register invite=', invite)
				await emailRegister(em, cd, pwd, nickname.value.trim(), invite)
			} else if (loginByPwd.value) {
				console.log('[mail] password-login')
				await emailPasswordLogin(em, pwd)
			} else {
				await emailLogin(em, cd)
			}
			// 用登录返回的 matrix 凭证直接拉起聊天会话（无需再登 Matrix）
			startMatrixFromPlatform()
			uni.hideLoading()
			uni.showToast({ title: t('login.ok'), icon: 'success' })
			setTimeout(() => {
				uni.reLaunch({ url: '/pages/home/home' })
			}, 500)
		} catch (e) {
			uni.hideLoading()
			loading.value = false
			let msg = t('login.opFail')
			try { msg = '' + e } catch (e2) {}
			if (msg.indexOf('Error:') == 0) msg = msg.substring(6).trim()
			uni.showToast({ title: msg.length > 0 ? msg : t('login.opFail'), icon: 'none', duration: 3000 })
		}
	}
</script>

<style>
	.page {
		flex: 1;
		background: linear-gradient(180deg, #eaf6ff 0%, #ffffff 40%);
		padding: 24rpx 48rpx 0;
		flex-direction: column;
	}
	.form-scroll {
		flex: 1;
		height: 0;
		padding-bottom: 48rpx;
	}
	.form-scroll-pad {
		height: 40rpx;
	}

	.top-bar {
		flex-direction: row;
		align-items: center;
		margin-top: 40rpx;
		margin-bottom: 40rpx;
	}
	.back-btn {
		width: 72rpx;
		height: 72rpx;
		justify-content: center;
		align-items: center;
	}
	.back-icon {
		font-size: 64rpx;
		color: #1e6fff;
		font-weight: 400;
		line-height: 64rpx;
	}
	.top-title {
		flex: 1;
		text-align: center;
		font-size: 34rpx;
		font-weight: 700;
		color: #0f172a;
		margin-right: 72rpx;
	}
	.top-spacer {
		width: 72rpx;
		height: 72rpx;
	}

	.brand-logo {
		width: 280rpx;
		height: 64rpx;
		margin-bottom: 20rpx;
	}
	.card-title {
		font-size: 48rpx;
		font-weight: 700;
		color: #0f172a;
		margin-bottom: 10rpx;
	}
	.card-subtitle {
		font-size: 26rpx;
		color: #64748b;
		margin-bottom: 28rpx;
	}
	.mode-tabs {
		flex-direction: row;
		align-items: center;
		background-color: #eef4fb;
		border-radius: 16rpx;
		padding: 6rpx;
		margin-bottom: 32rpx;
	}
	.mode-tab {
		flex: 1;
		height: 72rpx;
		align-items: center;
		justify-content: center;
		border-radius: 12rpx;
	}
	.mode-tab-on {
		background-color: #ffffff;
	}
	.mode-tab-text {
		font-size: 26rpx;
		color: #64748b;
		font-weight: 600;
	}
	.mode-tab-text-on {
		color: #1e6fff;
	}

	.field {
		margin-bottom: 28rpx;
	}
	.field-label {
		font-size: 24rpx;
		color: #475569;
		margin-bottom: 12rpx;
		font-weight: 600;
	}
	.input-box {
		flex-direction: row;
		align-items: center;
		background-color: #f4f8fd;
		border-radius: 16rpx;
		padding: 0 24rpx;
		height: 96rpx;
		border-width: 2rpx;
		border-style: solid;
		border-color: #e2eef8;
	}
	.input-eye {
		font-size: 24rpx;
		color: #1e6fff;
		padding: 8rpx;
	}
	.code-btn {
		font-size: 24rpx;
		color: #1e6fff;
		font-weight: 600;
		padding: 8rpx 4rpx 8rpx 16rpx;
		flex-shrink: 0;
	}
	.code-btn-off {
		color: #94a3b8;
	}
	.input {
		flex: 1;
		font-size: 30rpx;
		color: #0f172a;
		background-color: transparent;
		height: 96rpx;
	}
	.placeholder {
		color: #b8c4d4;
	}

	.btn-login {
		height: 112rpx;
		background-color: #1861c8;
		border-radius: 48rpx;
		margin-top: 24rpx;
		justify-content: center;
		align-items: center;
		flex-direction: row;
		border-width: 2rpx;
		border-style: solid;
		border-color: #1454b0;
	}
	.btn-login-off {
		background-color: #8fb4ff;
		border-color: #7aa6f0;
	}
	.btn-login-text {
		color: #ffffff;
		font-size: 32rpx;
		font-weight: 600;
	}

	.signup-row {
		flex-direction: row;
		justify-content: center;
		margin-top: 36rpx;
	}
	.signup-text {
		font-size: 26rpx;
		color: #64748b;
	}
	.signup-link {
		font-size: 26rpx;
		color: #1e6fff;
		font-weight: 600;
	}
</style>
