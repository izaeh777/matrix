		flex-direction: row;
		align-items: center;
		margin-top: 40rpx;
		margin-bottom: 40rpx;
	}
	.back-btn {
		width: 72rpx;
		height: 72rpx;
		justify-content: center;
		align-items: center;
	}
	.back-icon {
		font-size: 64rpx;
		color: #1e6fff;
		font-weight: 400;
		line-height: 64rpx;
	}
	.top-title {
		flex: 1;
		text-align: center;
		font-size: 34rpx;
		font-weight: 700;
		color: #0f172a;
		margin-right: 72rpx;
	}
	.top-spacer {
		width: 72rpx;
		height: 72rpx;
	}

	.brand-logo {
		width: 280rpx;
		height: 64rpx;
		margin-bottom: 20rpx;
	}
	.card-title {
		font-size: 48rpx;
		font-weight: 700;
		color: #0f172a;
		margin-bottom: 10rpx;
	}
	.card-subtitle {
		font-size: 26rpx;
		color: #64748b;
		margin-bottom: 28rpx;
	}
	.mode-tabs {
		flex-direction: row;
		align-items: center;
		background-color: #eef4fb;
		border-radius: 16rpx;
		padding: 6rpx;
		margin-bottom: 32rpx;
	}
	.mode-tab {
		flex: 1;
		height: 72rpx;
		align-items: center;
		justify-content: center;
		border-radius: 12rpx;
	}
	.mode-tab-on {
		background-color: #ffffff;
	}
	.mode-tab-text {
		font-size: 26rpx;
		color: #64748b;
		font-weight: 600;
	}
	.mode-tab-text-on {
		color: #1e6fff;
	}

	.field {
		margin-bottom: 28rpx;
	}
	.field-label {
		font-size: 24rpx;
		color: #475569;
		margin-bottom: 12rpx;
		font-weight: 600;
	}
	.input-box {
		flex-direction: row;
		align-items: center;
		background-color: #f4f8fd;
		border-radius: 16rpx;
		padding: 0 24rpx;
		height: 96rpx;
		border-width: 2rpx;
		border-style: solid;
		border-color: #e2eef8;
	}
	.input-eye {
		font-size: 24rpx;
		color: #1e6fff;
		padding: 8rpx;
	}
	.code-btn {
		font-size: 24rpx;
		color: #1e6fff;
		font-weight: 600;
		padding: 8rpx 4rpx 8rpx 16rpx;
		flex-shrink: 0;
	}
	.code-btn-off {
		color: #94a3b8;
	}
	.input {
		flex: 1;
		font-size: 30rpx;
		color: #0f172a;
		background-color: transparent;
		height: 96rpx;
	}
	.placeholder {
		color: #b8c4d4;
	}

	.btn-login {
		height: 112rpx;
		background-color: #1861c8;
		border-radius: 48rpx;
		margin-top: 24rpx;
		justify-content: center;
		align-items: center;
		flex-direction: row;
		border-width: 2rpx;
		border-style: solid;
		border-color: #1454b0;
	}
	.btn-login-off {
		background-color: #8fb4ff;
		border-color: #7aa6f0;
	}
	.btn-login-text {
		color: #ffffff;
		font-size: 32rpx;
		font-weight: 600;
	}

	.signup-row {
		flex-direction: row;
		justify-content: center;
		margin-top: 36rpx;
	}
	.signup-text {
		font-size: 26rpx;
