	.action-list {
		background-color: #fff;
		border-radius: 20rpx;
		margin: 0 20rpx;
		overflow: hidden;
	}

	.action-item {
		flex-direction: row;
		align-items: center;
		padding: 28rpx 30rpx;
		border-bottom-width: 1rpx;
		border-bottom-color: #f0f0f4;
	}

	.action-item:last-child {
		border-bottom-width: 0;
	}

	.action-icon {
		width: 56rpx;
		font-size: 32rpx;
		color: #1a1a1a;
		font-weight: 600;
	}

	.action-label {
		font-size: 30rpx;
		color: #1a1a1a;
		flex: 1;
	}

	.action-item.danger .action-icon,
	.action-item.danger .action-label {
		color: #ff3b30;
	}

	.action-cancel {
		background-color: #fff;
		padding: 28rpx;
		text-align: center;
		margin: 12rpx 20rpx 0;
		border-radius: 20rpx;
		color: #1a1a1a;
		font-size: 30rpx;
		font-weight: 500;
	}
