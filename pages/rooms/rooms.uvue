<template>
	<view class="rooms-page">
		<!-- #ifdef APP -->
		<view class="status-bar-holder"></view>
		<!-- #endif -->
		<view class="msg-header">
			<view class="msg-header-row">
				<text class="msg-title">{{ i18n.title }}</text>
				<view class="header-actions">
					<text class="header-ico header-search" @click="onSearch">⌕</text>
					<text class="header-ico" @click="onJoin">＋</text>
					<view class="lang-pill" @click="onLang">
						<image class="lang-globe" src="/static/login/china.png" mode="aspectFit"></image>
						<text class="lang-text">{{ langLabel }}</text>
						<text class="lang-caret">▾</text>
					</view>
				</view>
			</view>
			<view class="filter-row">
				<view class="filter-pill" :class="{ 'filter-on': filterTab == 'all' }" @click="filterTab = 'all'">
					<text class="filter-text" :class="{ 'filter-text-on': filterTab == 'all' }">{{ i18n.filterAll }}</text>
				</view>
				<view class="filter-pill" :class="{ 'filter-on': filterTab == 'recent' }" @click="filterTab = 'recent'">
					<text class="filter-text" :class="{ 'filter-text-on': filterTab == 'recent' }">{{ i18n.filterRecent }}</text>
				</view>
				<view class="filter-pill" :class="{ 'filter-on': filterTab == 'unread' }" @click="filterTab = 'unread'">
					<text class="filter-text" :class="{ 'filter-text-on': filterTab == 'unread' }">{{ i18n.filterUnread }}</text>
				</view>
			</view>
		</view>

		<!-- #ifdef H5 -->
		<view v-if="stripRooms.length > 0" class="strip-h5">
			<view class="strip-row" :style="{ width: stripWidth }">
				<view
					v-for="room in stripRooms"
					:key="'s-' + room.room_id"
					class="strip-item"
					@click="onOpenRoom(room.room_id)"
				>
					<view class="strip-ava-wrap">
						<image class="strip-ava" :src="roomAvatarSrc(room)" mode="aspectFill"></image>
						<view v-if="roomHasUnread(room)" class="strip-badge">
							<text class="strip-badge-text">{{ roomUnreadText(room) }}</text>
						</view>
					</view>
					<text class="strip-name">{{ roomTitleShort(room) }}</text>
				</view>
			</view>
		</view>
		<!-- #endif -->
		<!-- #ifndef H5 -->
		<scroll-view v-if="stripRooms.length > 0" class="strip-scroll" direction="horizontal" :show-scrollbar="false" :rebound="false">
			<view class="strip-row" :style="{ width: stripWidth }">
				<view
					v-for="room in stripRooms"
					:key="'s-' + room.room_id"
					class="strip-item"
					@click="onOpenRoom(room.room_id)"
				>
					<view class="strip-ava-wrap">
						<image class="strip-ava" :src="roomAvatarSrc(room)" mode="aspectFill"></image>
						<view v-if="roomHasUnread(room)" class="strip-badge">
							<text class="strip-badge-text">{{ roomUnreadText(room) }}</text>
						</view>
					</view>
					<text class="strip-name">{{ roomTitleShort(room) }}</text>
				</view>
			</view>
		</scroll-view>
		<!-- #endif -->

		<view v-if="incomingCall" class="incoming-call-bar">
			<view class="incoming-call-info">
				<text class="incoming-call-title">{{ incomingCallTitle }}</text>
				<text class="incoming-call-sub">{{ incomingCallSub }}</text>
			</view>
			<view class="incoming-call-actions">
				<view class="incoming-call-reject" @click="rejectIncomingCall">
					<text class="incoming-call-btn-text">{{ i18n.reject }}</text>
				</view>
				<view class="incoming-call-accept" @click="acceptIncomingCall">
					<text class="incoming-call-btn-text">{{ i18n.answer }}</text>
				</view>
			</view>
		</view>

		<view v-if="invites.length > 0" class="invite-banner">
			<view class="invite-banner-head">
				<text class="invite-banner-title">{{ inviteBannerText }}</text>
			</view>
			<view v-for="inv in invites" :key="inv.room_id" class="invite-row">
				<view class="invite-row-body">
					<text class="invite-room-name">{{ inviteTitle(inv) }}</text>
					<text v-if="inviteHasFrom(inv)" class="invite-from">{{ i18n.from }}{{ inv.inviter }}</text>
				</view>
				<view class="invite-row-actions">
					<view class="invite-btn reject" @click="onRejectInvite(inv.room_id)">
						<text class="invite-btn-text">{{ i18n.reject }}</text>
					</view>
					<view class="invite-btn accept" @click="onAcceptInvite(inv.room_id)">
						<text class="invite-btn-text">{{ i18n.accept }}</text>
					</view>
				</view>
			</view>
		</view>

		<scroll-view class="rooms-scroll" direction="vertical" :show-scrollbar="false" :rebound="false">
			<view v-if="needMatrixLogin" class="empty">
				<text class="empty-title">{{ i18n.needLogin }}</text>
				<text class="empty-hint">{{ i18n.needLoginHint }}</text>
				<view class="matrix-login-btn" @click="goMatrixLogin">
					<text class="matrix-login-btn-text">{{ i18n.loginMatrix }}</text>
				</view>
			</view>

			<view v-else-if="loading && filteredRooms.length == 0" class="loading">
				<text class="empty-hint">{{ i18n.loading }}</text>
			</view>

			<view v-else-if="!loading && filteredRooms.length == 0" class="empty">
				<text class="empty-title">{{ i18n.empty }}</text>
				<text class="empty-hint">{{ i18n.emptyHint }}</text>
			</view>

			<view
				v-for="room in filteredRooms"
				:key="room.room_id"
				class="room-item"
				:class="{ 'room-pin': roomPinned(room) }"
				@click="onOpenRoom(room.room_id)"
				@longpress="onLongPressRoom(room)"
			>
				<view class="room-row">
					<view class="avatar-wrap">
						<image
							class="room-avatar"
							:src="roomAvatarSrc(room)"
							mode="aspectFill"
						></image>
						<view v-if="roomHasUnread(room) && roomMuted(room)" class="mute-dot"></view>
						<view v-else-if="roomHasUnread(room)" class="avatar-badge">
							<text class="avatar-badge-text">{{ roomUnreadText(room) }}</text>
						</view>
					</view>
					<view class="room-body">
						<view class="room-line1">
							<text class="room-name">{{ roomTitle(room) }}</text>
							<text class="room-time">{{ roomTimeText(room) }}</text>
						</view>
						<view class="room-line2">
							<text class="room-preview">{{ roomPreviewText(room) }}</text>
							<text v-if="roomMuted(room)" class="mute-mark">🔕</text>
						</view>
					</view>
				</view>
				<view class="room-divider"></view>
			</view>
		</scroll-view>

		<view class="wx-tabbar">
			<view class="wx-tab" @click="onHome">
				<image class="wx-tab-icon" src="/static/login/s11.png" mode="aspectFit"></image>
			</view>
			<view class="wx-tab wx-tab-on">
				<image class="wx-tab-icon" src="/static/login/s2.png" mode="aspectFit"></image>
			</view>
			<view class="wx-tab" @click="onDiscover">
				<image class="wx-tab-icon" src="/static/login/s33.png" mode="aspectFit"></image>
			</view>
			<view class="wx-tab" @click="onNotify">
				<image class="wx-tab-icon" src="/static/login/s44.png" mode="aspectFit"></image>
			</view>
			<view class="wx-tab" @click="onProfile">
				<image class="wx-tab-icon" src="/static/login/s55.png" mode="aspectFit"></image>
			</view>
		</view>

		<!-- 房间操作菜单（长按弹出） -->
		<view v-if="roomAction.show" class="action-sheet" @click="roomAction.show = false">
			<view class="action-panel" @click.stop="">
				<view class="action-handle"></view>
				<view class="action-header">
					<text class="action-title">{{ actionRoomName }}</text>
					<text class="action-subtitle">{{ actionRoomSub }}</text>
				</view>
				<view class="action-list">
					<view class="action-item" @click="doRoomAction('pin')">
						<text class="action-icon">📌</text>
						<text class="action-label">{{ pinActionLabel }}</text>
					</view>
					<view class="action-item" @click="doRoomAction('mute')">
						<text class="action-icon">🔕</text>
						<text class="action-label">{{ muteActionLabel }}</text>
					</view>
					<view class="action-item" @click="doRoomAction('invite')">
						<text class="action-icon">＋</text>
						<text class="action-label">{{ i18n.inviteMember }}</text>
					</view>
					<view class="action-item danger" @click="doRoomAction('leave')">
						<text class="action-icon">⎋</text>
						<text class="action-label">{{ i18n.deleteChat }}</text>
					</view>
				</view>
				<view class="action-cancel" @click="roomAction.show = false">
					<text>{{ i18n.cancel }}</text>
				</view>
			</view>
		</view>
	</view>
</template>

<script setup lang="uts">
	import { ref, onMounted, onUnmounted, computed } from 'vue'
	import { getMatrix, MatrixRoom, MatrixEvent, errText, InvitedRoomInfo, CreateRoomOpts, roomIsGroup, sortRoomList, localPartOf } from '@/common/matrix.uts'
	import { loadSession, SessionInfo, loadRoomList, saveRoomList, loadRoomChat } from '@/common/storage.uts'
	import { openChat, bootstrapMatrix, openGroupPick, hasPlatformLogin, openMatrixLogin } from '@/common/app.uts'
	import { getCallManager, CallSnapshot, h5TapRunAnswer, unlockH5CallMedia } from '@/common/call.uts'
	import { getLocaleLabel, openLanguagePage, t } from '@/common/i18n.uts'

	type RoomsI18n = {
		title: string
		filterAll: string
		filterRecent: string
		filterUnread: string
		reject: string
		accept: string
		answer: string
		from: string
		needLogin: string
		needLoginHint: string
		loginMatrix: string
		loading: string
		empty: string
		emptyHint: string
		inviteMember: string
		deleteChat: string
		cancel: string
		inviteBannerTpl: string
		noMessage: string
		yesterday: string
		pin: string
		unpin: string
		mute: string
		unmute: string
	}

	const rooms = ref<Array<MatrixRoom>>([])
	const invites = ref<Array<InvitedRoomInfo>>([])
	const langLabel = ref<string>(getLocaleLabel())
	const i18n = ref<RoomsI18n>({
		title: t('chat.title'),
		filterAll: t('chat.filterAll'),
		filterRecent: t('chat.filterRecent'),
		filterUnread: t('chat.filterUnread'),
		reject: t('chat.reject'),
		accept: t('chat.accept'),
		answer: t('chat.answer'),
		from: t('chat.from'),
		needLogin: t('chat.needLogin'),
		needLoginHint: t('chat.needLoginHint'),
		loginMatrix: t('chat.loginMatrix'),
		loading: t('common.loading'),
		empty: t('chat.empty'),
		emptyHint: t('chat.emptyHint'),
		inviteMember: t('chat.inviteMember'),
		deleteChat: t('chat.deleteChat'),
		cancel: t('common.cancel'),
		inviteBannerTpl: t('chat.inviteBanner'),
		noMessage: t('chat.noMessage'),
		yesterday: t('chat.yesterday'),
		pin: t('chat.pin'),
		unpin: t('chat.unpin'),
		mute: t('chat.mute'),
		unmute: t('chat.unmute')
	} as RoomsI18n)
	const loading = ref<boolean>(false)
	const needMatrixLogin = ref<boolean>(false)
	const incomingCall = ref<boolean>(false)
	const incomingCallTitle = ref<string>('')
	const incomingCallSub = ref<string>('')
	const syncState = ref<string>('INITIAL')
	const syncError = ref<string>('')
	const session = ref<SessionInfo | null>(null)
	const filterTab = ref<string>('all')
	type RoomActionState = {
		show: boolean
		room: MatrixRoom | null
	}
	const roomAction = ref<RoomActionState>({ show: false, room: null })

	function roomHasUnread(room: MatrixRoom): boolean {
		const c = room.unread_count
		if (c == null) return false
		return c > 0
	}
	function roomTitle(room: MatrixRoom): string {
		const n = room.name
		if (n != null && n.length > 0) return n
		return room.room_id
	}
	function roomTitleShort(room: MatrixRoom): string {
		const t = roomTitle(room)
		if (t.length <= 5) return t
		return t.substring(0, 4) + '…'
	}

	const filteredRooms = computed((): Array<MatrixRoom> => {
		const list = rooms.value
		const tab = filterTab.value
		if (tab == 'unread') {
			const out: Array<MatrixRoom> = []
			for (let i = 0; i < list.length; i++) {
				if (roomHasUnread(list[i])) out.push(list[i])
			}
			return out
		}
		if (tab == 'recent') {
			const out: Array<MatrixRoom> = []
			const now = Date.now()
			for (let i = 0; i < list.length; i++) {
				const ts = list[i].last_message_ts
				if (ts != null && ts > 0 && (now - ts) < 7 * 86400000) out.push(list[i])
			}
			if (out.length > 0) return out
			return list
		}
		return list
	})

	const stripRooms = computed((): Array<MatrixRoom> => {
		const list = rooms.value
		const out: Array<MatrixRoom> = []
		for (let i = 0; i < list.length; i++) {
			out.push(list[i])
			if (out.length >= 12) break
		}
		return out
	})

	const stripWidth = computed((): string => {
		const n = stripRooms.value.length
		if (n <= 0) return '100%'
		return (n * 148 + 48) + 'rpx'
	})

	function formatTime(ts: number = 0): string {
		if (ts == 0) return ''
		const d = new Date(ts)
		const now = new Date()
		const pad = (n: number): string => {
			if (n < 10) return '0' + n
			return '' + n
		}
		const startToday = new Date(now.getFullYear(), now.getMonth(), now.getDate()).getTime()
		const startMsg = new Date(d.getFullYear(), d.getMonth(), d.getDate()).getTime()
		const dayDiff = Math.floor((startToday - startMsg) / 86400000)
		if (dayDiff == 0) return pad(d.getHours()) + ':' + pad(d.getMinutes())
		if (dayDiff == 1) return i18n.value.yesterday
		if (dayDiff == 2) return i18n.value.yesterday
		if (dayDiff < 7) return pad(d.getMonth() + 1) + '-' + pad(d.getDate())
		return pad(d.getMonth() + 1) + '-' + pad(d.getDate())
	}

	const inviteBannerText = computed((): string => {
		return i18n.value.inviteBannerTpl.replace('{n}', '' + invites.value.length)
	})

	function onLang(): void {
		openLanguagePage()
	}

	function inviteTitle(inv: InvitedRoomInfo): string {
		if (inv.name.length > 0) return inv.name
		return inv.room_id
	}
	function inviteHasFrom(inv: InvitedRoomInfo): boolean {
		return inv.inviter.length > 0
	}
	function roomPinned(room: MatrixRoom): boolean {
		return room.favourite == true
	}
	function roomMuted(room: MatrixRoom): boolean {
		return room.muted == true
	}
	function roomUnreadText(room: MatrixRoom): string {
		const c = room.unread_count
		if (c == null) return ''
		if (c > 99) return '99+'
		return '' + c
	}
	function roomAvatarSrc(room: MatrixRoom): string {
		let a = room.avatar_url
		if (a == null || a.length == 0) {
			const other = room.other_avatar
			if (other != null && other.length > 0) a = other
		}
		if (a == null || a.length == 0) return '/static/login/tiki.png'
		if (a.indexOf('http://') == 0 || a.indexOf('https://') == 0) return a
		const matrix = getMatrix()
		if (matrix == null) return '/static/login/tiki.png'
		const http = matrix.mxcToHttp(a, 96, 96)
		if (http.length == 0) return '/static/login/tiki.png'
		return http
	}
	function roomPreviewText(room: MatrixRoom): string {
		const p = room.last_message_preview
		let preview = ''
		if (p != null && p.length > 0) preview = p
		if (preview.length == 0) {
			const t = room.topic
			if (t != null && t.length > 0) return t
			return i18n.value.noMessage
		}
		if (roomIsGroup(room)) {
			const sid = room.last_message_sender
			if (sid != null && sid.length > 0) {
				const matrix = getMatrix()
				const me = matrix != null ? matrix.userId : ''
				if (sid != me) {
					let name = ''
					if (matrix != null) name = matrix.getCachedUserName(sid)
					if (name.length == 0) name = localPartOf(sid)
					return name + ': ' + preview
				}
			}
		}
		return preview
	}
	function roomTimeText(room: MatrixRoom): string {
		const ts = room.last_message_ts
		if (ts == null) return ''
		return formatTime(ts)
	}

	const pinActionLabel = computed((): string => {
		const r = roomAction.value.room
		if (r != null && r.favourite == true) return i18n.value.unpin
		return i18n.value.pin
	})
	const muteActionLabel = computed((): string => {
		const r = roomAction.value.room
		if (r != null && r.muted == true) return i18n.value.unmute
		return i18n.value.mute
	})
	const actionRoomName = computed((): string => {
		const r = roomAction.value.room
		if (r == null) return ''
		const n = r.name
		if (n != null && n.length > 0) return n
		return r.room_id
	})
	const actionRoomSub = computed((): string => {
		const r = roomAction.value.room
		if (r == null) return ''
		const id = r.other_user_id
		if (id != null) return id
		return ''
	})
	const displayName = computed(() => {
		const s = session.value
		if (s == null) return ''
		if (s.display_name != null && s.display_name.length > 0) return s.display_name
		return s.user_id
	})
	const userId = computed(() => {
		const s = session.value
		if (s == null) return ''
		return s.user_id
	})
	const avatarUrl = computed(() => {
		const m = getMatrix()
		const s = session.value
		if (s == null || s.avatar_url == null || s.avatar_url.length == 0) return '/static/login/tiki.png'
		if (m == null) return '/static/login/tiki.png'
		const http = m.mxcToHttp(s.avatar_url, 96, 96)
		if (http.length == 0) return '/static/login/tiki.png'
		return http
	})
	const syncClass = computed(() => {
		const s = syncState.value
		if (s == 'PREPARED' || s == 'SYNCING') return 'sync-ok'
		if (s == 'ERROR') return 'sync-error'
		return 'sync-init'
	})
	const syncText = computed(() => {
		const s = syncState.value
		if (s == 'PREPARED') return t('rooms.synced')
		if (s == 'SYNCING') return t('rooms.syncing')
		if (s == 'ERROR') return t('rooms.syncError')
		return t('rooms.notSynced')
	})

	let timer: number | null = null
	let persistTimer: number | null = null
	let offSync: (() => void) | null = null
	let offInvite: (() => void) | null = null
	let offTimeline: (() => void) | null = null
	let offUnread: (() => void) | null = null
	let offCall: (() => void) | null = null

	function stopOff(handler: (() => void) | null): void {
		if (handler == null) return
		try { handler() } catch (e) {}
	}

	function pickStr(obj: UTSJSONObject, key: string): string {
		try {
			const v = obj[key]
			if (v != null) {
				const t = '' + v
				if (t.length > 0 && t != 'null' && t != 'undefined' && t != '[object Object]') return t
			}
		} catch (e0) {}
		try {
			const s = obj.getString(key)
			if (s != null && s.length > 0) return s
		} catch (e1) {}
		return ''
	}
	function pickNum(obj: UTSJSONObject, key: string): number {
		try {
			const raw = obj[key]
			if (raw != null) {
				const n = parseFloat('' + raw)
				if (n == n) return n
			}
		} catch (e0) {}
		try {
			const v = obj.getNumber(key)
			if (v != null) return v
		} catch (e1) {}
		return 0
	}

	function roomToRow(r: MatrixRoom): UTSJSONObject {
		const o: UTSJSONObject = {}
		o['room_id'] = r.room_id
		const name = r.name
		if (name != null && name.length > 0) o['name'] = name
		const topic = r.topic
		if (topic != null && topic.length > 0) o['topic'] = topic
		const av = r.avatar_url
		if (av != null && av.length > 0) o['avatar_url'] = av
		const alias = r.canonical_alias
		if (alias != null && alias.length > 0) o['canonical_alias'] = alias
		const preview = r.last_message_preview
		if (preview != null && preview.length > 0) o['last_message_preview'] = preview
		const ts = r.last_message_ts
		if (ts != null) o['last_message_ts'] = ts
		const sender = r.last_message_sender
		if (sender != null && sender.length > 0) o['last_message_sender'] = sender
		const unread = r.unread_count
		if (unread != null) o['unread_count'] = unread
		const otherId = r.other_user_id
		if (otherId != null && otherId.length > 0) o['other_user_id'] = otherId
		const otherName = r.other_displayname
		if (otherName != null && otherName.length > 0) o['other_displayname'] = otherName
		const otherAv = r.other_avatar
		if (otherAv != null && otherAv.length > 0) o['other_avatar'] = otherAv
		if (r.is_direct == true) o['is_direct'] = 'true'
		if (r.is_direct == false) o['is_direct'] = 'false'
		const mc = r.member_count
		if (mc != null) o['member_count'] = mc
		if (r.favourite == true) o['favourite'] = 'true'
		if (r.muted == true) o['muted'] = 'true'
		return o
	}

	function rowToRoom(o: UTSJSONObject): MatrixRoom {
		const room: MatrixRoom = { room_id: pickStr(o, 'room_id') }
		const name = pickStr(o, 'name')
		if (name.length > 0) room.name = name
		const topic = pickStr(o, 'topic')
		if (topic.length > 0) room.topic = topic
		const av = pickStr(o, 'avatar_url')
		if (av.length > 0) room.avatar_url = av
		const alias = pickStr(o, 'canonical_alias')
		if (alias.length > 0) room.canonical_alias = alias
		const preview = pickStr(o, 'last_message_preview')
		if (preview.length > 0) room.last_message_preview = preview
		const ts = pickNum(o, 'last_message_ts')
		if (ts > 0) room.last_message_ts = ts
		const sender = pickStr(o, 'last_message_sender')
		if (sender.length > 0) room.last_message_sender = sender
		const unread = pickNum(o, 'unread_count')
		if (unread > 0) room.unread_count = unread
		const otherId = pickStr(o, 'other_user_id')
		if (otherId.length > 0) room.other_user_id = otherId
		const otherName = pickStr(o, 'other_displayname')
		if (otherName.length > 0) room.other_displayname = otherName
		const otherAv = pickStr(o, 'other_avatar')
		if (otherAv.length > 0) room.other_avatar = otherAv
		const directStr = pickStr(o, 'is_direct')
		if (directStr == 'true') room.is_direct = true
		if (directStr == 'false') room.is_direct = false
		const mc = pickNum(o, 'member_count')
		if (mc > 0) room.member_count = mc
		if (pickStr(o, 'favourite') == 'true') room.favourite = true
		if (pickStr(o, 'muted') == 'true') room.muted = true
		return room
	}

	function persistRoomListNow(): void {
		const s = session.value
		if (s == null) return
		const list = rooms.value
		const rows: Array<UTSJSONObject> = []
		for (let i = 0; i < list.length; i++) {
			rows.push(roomToRow(list[i]))
		}
		saveRoomList(s.user_id, rows)
	}

	function schedulePersistRooms(): void {
		const old = persistTimer
		persistTimer = null
		if (old != null) {
			clearTimeout(old)
		}
		persistTimer = setTimeout(() => {
			persistTimer = null
			persistRoomListNow()
		}, 400) as number | null
	}

	function previewFromChatRow(o: UTSJSONObject): string {
		const mt = pickStr(o, 'msgtype')
		if (mt == 'm.audio') return t('rooms.previewVoice')
		if (mt == 'm.image') return t('rooms.previewImage')
		if (mt == 'm.file') return t('rooms.previewFile')
		if (mt == 'm.call') {
			const body = pickStr(o, 'body')
			if (body.length > 0) return body
			return t('rooms.previewCall')
		}
		const body = pickStr(o, 'body')
		if (body.length > 0) return body
		return ''
	}

	function fillPreviewFromChatCache(room: MatrixRoom): boolean {
		const s = session.value
		if (s == null) return false
		const preview = room.last_message_preview
		if (preview != null && preview.length > 0 && preview != i18n.value.noMessage) return false
		const cached = loadRoomChat(s.user_id, room.room_id)
		if (cached == null || cached.msgs.length == 0) return false
		const last = cached.msgs[cached.msgs.length - 1]
		const text = previewFromChatRow(last)
		if (text.length == 0) return false
		room.last_message_preview = text
		const ts = pickNum(last, 'ts')
		if (ts > 0) room.last_message_ts = ts
		const sender = pickStr(last, 'sender')
		if (sender.length > 0) room.last_message_sender = sender
		return true
	}

	function applyRoomListCache(): boolean {
		const s = session.value
		if (s == null) return false
		const rows = loadRoomList(s.user_id)
		if (rows.length == 0) return false
		const out: Array<MatrixRoom> = []
		for (let i = 0; i < rows.length; i++) {
			const room = rowToRoom(rows[i])
			if (room.room_id.length == 0) continue
			fillPreviewFromChatCache(room)
			out.push(room)
		}
		if (out.length == 0) return false
		sortRoomList(out)
		rooms.value = out
		return true
	}

	function applyLastFromSync(): void {
		const matrix = getMatrix()
		if (matrix == null) return
		const list = rooms.value
		if (list.length == 0) return
		let changed = false
		for (let i = 0; i < list.length; i++) {
			const room = list[i]
			const fav = matrix.isRoomFavourite(room.room_id)
			const mute = matrix.isRoomMuted(room.room_id)
			if (room.favourite != fav) {
				room.favourite = fav
				changed = true
			}
			if (room.muted != mute) {
				room.muted = mute
				changed = true
			}
			const last = matrix.roomLastMessage.get(room.room_id)
			if (last != null && last.body.length > 0) {
				const curTs = room.last_message_ts != null ? room.last_message_ts : 0
				const curPrev = room.last_message_preview != null ? room.last_message_preview : ''
				if (last.ts >= curTs && (last.ts != curTs || curPrev != last.body)) {
					room.last_message_preview = last.body
					room.last_message_ts = last.ts
					room.last_message_sender = last.sender
					changed = true
				}
			} else if (fillPreviewFromChatCache(room)) {
				changed = true
			}
		}
		if (!changed) return
		sortRoomList(list)
		rooms.value = list.slice()
		schedulePersistRooms()
	}

	onUnmounted(() => {
		const t = timer
		timer = null
		if (t != null) clearInterval(t)
		const pt = persistTimer
		persistTimer = null
		if (pt != null) clearTimeout(pt)
		persistRoomListNow()
		const mClient = getMatrix()
		if (mClient != null) {
			mClient.onRoomListEvent = null
			if (mClient.onUnread != null) {
				mClient.onUnread = null
			}
		}
		stopOff(offSync)
		stopOff(offInvite)
		stopOff(offTimeline)
		stopOff(offUnread)
		stopOff(offCall)
		offSync = null
		offInvite = null
		offTimeline = null
		offUnread = null
		offCall = null
	})

	function onMatrixAuthLost(): void {
		needMatrixLogin.value = true
		rooms.value = []
		if (hasPlatformLogin()) {
			uni.showToast({ title: t('rooms.sessionExpired'), icon: 'none' })
			return
		}
		uni.reLaunch({ url: '/pages/login/login' })
	}

	async function loadRooms(): Promise<void> {
		const matrix = getMatrix()
		if (matrix == null) return
		try {
			if (rooms.value.length == 0) loading.value = true
			rooms.value = await matrix.listRooms()
			loading.value = false
			applyLastFromSync()
			schedulePersistRooms()
		} catch (e: any) {
			loading.value = false
			console.error('loadRooms error', e)
			if (errText(e, '').indexOf('M_UNKNOWN_TOKEN') >= 0) {
				onMatrixAuthLost()
			}
		}
	}

	// 拉取自己处于 invited 状态的房间（不是 join）
	async function loadInvites() {
		const matrix = getMatrix()
		if (matrix == null) return
		try {
			const list = matrix.listInvitedRooms()
			invites.value = list
		} catch (e) {
			console.warn('loadInvites error', e)
		}
	}

	async function refreshOneRoom(roomId: string, event: MatrixEvent) {
		const matrix = getMatrix()
		if (matrix == null) return
		try {
			const idx = rooms.value.findIndex(r => r.room_id == roomId)
			if (idx < 0) {
				const summary = await matrix.getRoomSummary(roomId)
				const idx2 = rooms.value.findIndex(r => r.room_id == roomId)
				if (idx2 < 0) {
					rooms.value.unshift(summary)
					rooms.value = rooms.value.slice()
					schedulePersistRooms()
				}
				return
			}
			const c = event.content != null ? event.content : ({} as UTSJSONObject)
			const mt = pickStr(c, 'msgtype')
			let body = pickStr(c, 'body')
			if (mt == 'm.audio') body = t('rooms.previewVoice')
			else if (mt == 'm.image') body = t('rooms.previewImage')
			else if (mt == 'm.file') body = t('rooms.previewFile')
			else if (mt == 'm.call') {
				if (body.length == 0) body = t('rooms.previewCall')
			}
			else if (body.length == 0) body = t('rooms.previewMsg')
			const ts: number = event.origin_server_ts != null ? event.origin_server_ts : Date.now()
			const sender: string = event.sender != null ? event.sender : ''
			const cur = rooms.value[idx]
			// 仅当新消息时间更新时才覆盖预览并重新排序
			const lastTs = cur.last_message_ts != null ? cur.last_message_ts : 0
			if (lastTs < ts) {
				cur.last_message_preview = body
				cur.last_message_ts = ts
				cur.last_message_sender = sender
				// 把该房间移到列表顶部（unshift 之前先 splice）
				rooms.value.splice(idx, 1)
				rooms.value.unshift(cur)
			}
			rooms.value = rooms.value.slice() // 触发响应式
			schedulePersistRooms()
		} catch (e) {
			// 静默
		}
	}

	function goMatrixLogin(): void {
		openMatrixLogin()
	}

	async function setupRooms(): Promise<void> {
		session.value = loadSession()
		const hadCache = applyRoomListCache()
		let matrix = getMatrix()
		if (matrix == null) matrix = bootstrapMatrix()
		if (matrix == null) {
			if (hasPlatformLogin()) {
				needMatrixLogin.value = true
				loading.value = false
				return
			}
			uni.reLaunch({ url: '/pages/login/login' })
			return
		}
		needMatrixLogin.value = false
		if (offSync != null || offTimeline != null) {
			console.warn('rooms: 回调已挂载，跳过重复注册')
			return
		}
		offSync = matrix.onSync((state: string, error: string) => {
			syncState.value = state
			if (error.length > 0) syncError.value = error
			if (state == 'PREPARED') applyLastFromSync()
		})
		offInvite = matrix.onInvite((_roomId: string) => {
			loadInvites()
			loadRooms()
		})
		offTimeline = matrix.onTimeline((event: MatrixEvent, rid: string) => {
			if (event.type.indexOf('m.call.') == 0) {
				getCallManager().handleEvent(event, rid)
				return
			}
			if (event.type != 'm.room.message') return
			refreshOneRoom(rid, event)
		})
		matrix.onRoomListEvent = (event: MatrixEvent, rid: string) => {
			if (event.type != 'm.room.message') return
			refreshOneRoom(rid, event)
		}
		const callMgr = getCallManager()
		callMgr.bindMatrix()
		stopOff(offCall)
		offCall = callMgr.onChange((s: CallSnapshot) => {
			incomingCall.value = s.phase == 'ringing' && s.isIncoming
			incomingCallTitle.value = s.isVideo ? t('rooms.videoIncoming') : s.peerName
			incomingCallSub.value = s.isVideo ? (s.peerName + t('rooms.videoInvite')) : s.sub
		})
		const snap = callMgr.getSnapshot()
		incomingCall.value = snap.phase == 'ringing' && snap.isIncoming
		incomingCallTitle.value = snap.isVideo ? t('rooms.videoIncoming') : snap.peerName
		incomingCallSub.value = snap.isVideo ? (snap.peerName + t('rooms.videoInvite')) : snap.sub
		const unreadHandler = (rid: string, count: number) => {
			const idx = rooms.value.findIndex((r: MatrixRoom) => r.room_id == rid)
			if (idx >= 0) {
				rooms.value[idx].unread_count = count
				rooms.value = rooms.value.slice()
				schedulePersistRooms()
			}
		}
		matrix.unreadHandlers.push(unreadHandler)
		matrix.onUnread = unreadHandler
		offUnread = () => {
			const i = matrix.unreadHandlers.indexOf(unreadHandler)
			if (i >= 0) matrix.unreadHandlers.splice(i, 1)
			if (matrix.onUnread == unreadHandler) {
				matrix.onUnread = null
			}
		}
		matrix.startSync()
		await loadInvites()
		if (hadCache) {
			loadRooms()
			applyLastFromSync()
		} else {
			await loadRooms()
			applyLastFromSync()
		}
		let liveTick = 0
		timer = setInterval(() => {
			applyLastFromSync()
			liveTick = liveTick + 1
			if (liveTick % 30 == 0 && syncState.value == 'PREPARED') {
				loadInvites()
				loadRooms()
			}
		}, 2000) as number | null
	}


	onMounted(() => {
		setupRooms()
	})

	onShow(() => {
		langLabel.value = getLocaleLabel()
		i18n.value = {
			title: t('chat.title'),
			filterAll: t('chat.filterAll'),
			filterRecent: t('chat.filterRecent'),
			filterUnread: t('chat.filterUnread'),
			reject: t('chat.reject'),
			accept: t('chat.accept'),
			answer: t('chat.answer'),
			from: t('chat.from'),
			needLogin: t('chat.needLogin'),
			needLoginHint: t('chat.needLoginHint'),
			loginMatrix: t('chat.loginMatrix'),
			loading: t('common.loading'),
			empty: t('chat.empty'),
			emptyHint: t('chat.emptyHint'),
			inviteMember: t('chat.inviteMember'),
			deleteChat: t('chat.deleteChat'),
			cancel: t('common.cancel'),
			inviteBannerTpl: t('chat.inviteBanner'),
			noMessage: t('chat.noMessage'),
			yesterday: t('chat.yesterday'),
			pin: t('chat.pin'),
			unpin: t('chat.unpin'),
			mute: t('chat.mute'),
			unmute: t('chat.unmute')
		} as RoomsI18n
	})

	async function onAcceptInvite(roomId: string) {
		const matrix = getMatrix()
		if (matrix == null) return
		uni.showLoading({ title: t('rooms.joining') })
		try {
			await matrix.joinRoom(roomId)
			uni.hideLoading()
			uni.showToast({ title: t('rooms.joined'), icon: 'success' })
			await loadInvites()
			await loadRooms()
		} catch (e: any) {
			uni.hideLoading()
			uni.showToast({ title: t('rooms.joinFail') + ': ' + errText(e, ''), icon: 'none' })
		}
	}

	async function rejectInvite(roomId: string): Promise<void> {
		const matrix = getMatrix()
		if (matrix == null) return
		try {
			await matrix.leaveRoom(roomId)
			await loadInvites()
		} catch (e) {
			uni.showToast({ title: t('rooms.opFail'), icon: 'none' })
		}
	}

	function onRejectInvite(roomId: string) {
		const matrix = getMatrix()
		if (matrix == null) return
		uni.showModal({
			title: t('rooms.rejectTitle'),
			content: t('rooms.rejectContent'),
			success: (res) => {
				if (res.confirm) {
					rejectInvite(roomId)
				}
			}
		})
	}

	function onOpenRoom(roomId: string) {
		openChat(roomId)
	}

	function onContacts() {
		uni.redirectTo({ url: '/pages/contacts/contacts' })
	}

	async function createRoomNow(name: string, inviteUsers: Array<string>): Promise<void> {
		const matrix = getMatrix()
		if (matrix == null) return
		uni.showLoading({ title: t('rooms.creating') })
		try {
			const opts: CreateRoomOpts = {
				name: name,
				topic: t('rooms.topicCreated'),
				preset: 'private_chat',
				invite: inviteUsers,
				is_direct: false
			}
			const roomId = await matrix.createRoom(opts)
			uni.hideLoading()
			uni.showToast({ title: t('rooms.createOk'), icon: 'success' })
			setTimeout(() => {
				openChat(roomId)
			}, 500)
		} catch (e) {
			uni.hideLoading()
			uni.showToast({ title: errText(e, t('rooms.createFail')), icon: 'none' })
		}
	}

	function askInviteThenCreate(name: string) {
		uni.showModal({
			title: t('rooms.inviteTitle'),
			editable: true,
			placeholderText: t('rooms.invitePh'),
			success: (r) => {
				const inviteUsers: Array<string> = []
				const raw = r.content
				const input = (raw != null) ? raw.trim() : ''
				if (input.length > 0) {
					inviteUsers.push(input.startsWith('@') ? input : '@' + input)
				}
				createRoomNow(name, inviteUsers)
			}
		})
	}

	function createNewRoom() {
		uni.showModal({
			title: t('rooms.createTitle'),
			editable: true,
			placeholderText: t('rooms.namePh'),
			success: (res) => {
				if (!res.confirm) return
				let name = ''
				if (res.content != null) {
					name = res.content.trim()
				}
				if (name.length == 0) {
					name = t('rooms.defaultName')
				}
				askInviteThenCreate(name)
			}
		})
	}

	async function joinRoomByInput(input: string): Promise<void> {
		const matrix = getMatrix()
		if (matrix == null) return
		uni.showLoading({ title: t('rooms.joiningShort') })
		try {
			const hash = input.startsWith('#')
			const bang = input.startsWith('!')
			const target = (hash || bang) ? input : '#' + input
			const joined = await matrix.joinRoom(target)
			uni.hideLoading()
			uni.showToast({ title: t('rooms.joinOk'), icon: 'success' })
			setTimeout(() => {
				openChat(joined.room_id)
			}, 500)
		} catch (e) {
			uni.hideLoading()
			uni.showToast({ title: errText(e, t('rooms.joinFail')), icon: 'none' })
		}
	}

	function joinExistingRoom() {
		uni.showModal({
			title: t('rooms.joinRoomTitle'),
			editable: true,
			placeholderText: t('rooms.joinPh'),
			success: (res) => {
				if (!res.confirm) return
				const raw = res.content
				const input = (raw != null) ? raw.trim() : ''
				if (input.length == 0) return
				joinRoomByInput(input)
			}
		})
	}

	function onJoin() {
		uni.showActionSheet({
			itemList: [t('rooms.actionCreate'), t('rooms.actionAddFriend'), t('rooms.actionJoin')],
			success: (res) => {
				if (res.tapIndex == 0) {
					openGroupPick('create')
				} else if (res.tapIndex == 1) {
					uni.navigateTo({ url: '/pages/contacts/add' })
				} else if (res.tapIndex == 2) {
					joinExistingRoom()
				}
			}
		})
	}

	function onHome() {
		uni.redirectTo({ url: '/pages/home/home' })
	}

	function onNotify() {
		uni.redirectTo({ url: '/pages/notify/notify' })
	}

	function onProfile() {
		uni.redirectTo({ url: '/pages/profile/profile' })
	}

	function acceptIncomingCall() {
		h5TapRunAnswer()
		getCallManager().accept()
		incomingCall.value = false
	}
	function rejectIncomingCall() {
		getCallManager().reject()
		incomingCall.value = false
	}

	function onSearch() {
		uni.navigateTo({ url: '/pages/search/search' })
	}

	function onDiscover() {
		uni.redirectTo({ url: '/pages/discover/discover' })
	}

	function onLongPressRoom(room: MatrixRoom) {
		roomAction.value.room = room
		roomAction.value.show = true
	}

	async function inviteMemberByInput(roomId: string, raw: string | null): Promise<void> {
		const matrix = getMatrix()
		if (matrix == null) return
		const trimmed = (raw != null) ? raw.trim() : ''
		if (trimmed.length == 0) return
		const userId = trimmed.startsWith('@') ? trimmed : '@' + trimmed
		try {
			await matrix.inviteUser(roomId, userId)
			uni.showToast({ title: t('rooms.invited'), icon: 'success' })
		} catch (e) {
			uni.showToast({ title: errText(e, t('rooms.opFail')), icon: 'none' })
		}
	}

	async function renameRoomByInput(roomId: string, content: string | null): Promise<void> {
		if (content == null || content.length == 0) return
		const matrix = getMatrix()
		if (matrix == null) return
		try {
			await matrix.setRoomName(roomId, content)
			uni.showToast({ title: t('rooms.updated'), icon: 'success' })
			loadRooms()
		} catch (e) {
			uni.showToast({ title: errText(e, t('rooms.opFail')), icon: 'none' })
		}
	}

	async function setTopicByInput(roomId: string, content: string | null): Promise<void> {
		if (content == null || content.length == 0) return
		const matrix = getMatrix()
		if (matrix == null) return
		try {
			await matrix.setRoomTopic(roomId, content)
			uni.showToast({ title: t('rooms.updated'), icon: 'success' })
			loadRooms()
		} catch (e) {
			uni.showToast({ title: errText(e, t('rooms.opFail')), icon: 'none' })
		}
	}

	async function leaveRoomConfirmed(roomId: string): Promise<void> {
		const matrix = getMatrix()
		if (matrix == null) return
		try {
			await matrix.leaveRoom(roomId)
			uni.showToast({ title: t('rooms.left'), icon: 'success' })
			loadRooms()
		} catch (e) {
			uni.showToast({ title: errText(e, t('rooms.opFail')), icon: 'none' })
		}
	}

	async function doRoomAction(action: string) {
		const sheet = roomAction.value
		const room = sheet.room
		sheet.show = false
		if (room == null) return
		const matrix = getMatrix()
		if (matrix == null) return
		try {
			if (action == 'invite') {
				openGroupPick('invite', room.room_id)
			} else if (action == 'pin') {
				const next = room.favourite != true
				await matrix.favouriteRoom(room.room_id, next)
				room.favourite = next
				sortRoomList(rooms.value)
				rooms.value = rooms.value.slice()
				schedulePersistRooms()
				uni.showToast({ title: next ? t('rooms.pinned') : t('rooms.unpinned'), icon: 'success' })
			} else if (action == 'mute') {
				const next = room.muted != true
				await matrix.setRoomMuted(room.room_id, next)
				room.muted = next
				rooms.value = rooms.value.slice()
				schedulePersistRooms()
				uni.showToast({ title: next ? t('rooms.mutedOn') : t('rooms.mutedOff'), icon: 'success' })
			} else if (action == 'leave') {
				const leaveName = (room.name != null) ? room.name : t('rooms.thisRoom')
				uni.showModal({
					title: t('rooms.leaveTitle'),
					content: (() => { let s=t('rooms.leaveConfirm'); const i=s.indexOf('{name}'); return i>=0?s.substring(0,i)+leaveName+s.substring(i+6):leaveName })(),
					success: (res) => {
						if (res.confirm) {
							leaveRoomConfirmed(room.room_id)
						}
					}
				})
			}
		} catch (e) {
			uni.showToast({ title: errText(e, t('rooms.opFail')), icon: 'none' })
		}
	}
</script>

<style>
	.rooms-page {
		flex: 1;
		background-color: #ffffff;
		background-image: linear-gradient(180deg, #F3F8FE 0%, #FFFFFF 100%);
		display: flex;
		flex-direction: column;
	}
	/* #ifdef H5 */
	.rooms-page ::-webkit-scrollbar {
		width: 0;
		height: 0;
		display: none;
	}
	.strip-h5,
	.rooms-scroll,
	.strip-scroll {
		scrollbar-width: none;
		-ms-overflow-style: none;
	}
	/* #endif */
	.msg-header {
		padding: 52rpx 28rpx 12rpx;
		background-color: transparent;
	}
	.msg-header-row {
		flex-direction: row;
		align-items: center;
		justify-content: space-between;
		margin-bottom: 20rpx;
