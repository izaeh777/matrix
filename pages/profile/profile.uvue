						<text class="vip-text">VIP1会员</text>
					</view>
				</view>
			</view>
			<text class="user-arrow">›</text>
		</view>

		<view class="balance-row">
			<text class="balance-label">USDT 余额</text>
			<text class="balance-value">{{ usdtBalance }}</text>
		</view>

		<view class="member-card">
			<view class="vip-bar">
				<text class="vip-bar-text">有效期：2026-09-11 至 2026-10-11</text>
				<view class="renew-btn" @click="onSoon">
					<text class="renew-text">续费</text>
				</view>
			</view>
			<view class="stat-row">
				<view class="stat-cell" @click="onSearchMessages">
					<view class="stat-head">
						<text class="stat-title">收藏夹</text>
						<text class="stat-mini">›</text>
					</view>
					<text class="stat-empty">暂无记录</text>
				</view>
				<view class="stat-split"></view>
				<view class="stat-cell" @click="onSearchMessages">
					<view class="stat-head">
						<text class="stat-title">浏览历史</text>
						<text class="stat-mini">›</text>
					</view>
					<text class="stat-empty">暂无记录</text>
				</view>
			</view>
			<view class="quick-row">
				<view class="quick-item" @click="goStats">
					<image class="quick-ico" src="/static/login/q4.png" mode="aspectFit"></image>
					<text class="quick-label">项目分析</text>
				</view>
				<view class="quick-item" @click="goRooms">
					<image class="quick-ico" src="/static/login/q3.png" mode="aspectFit"></image>
					<text class="quick-label">沟通交流</text>
				</view>
				<view class="quick-item" @click="onSoon">
					<image class="quick-ico" src="/static/login/q2.png" mode="aspectFit"></image>
					<text class="quick-label">项目分成</text>
				</view>
				<view class="quick-item" @click="onSoon">
					<image class="quick-ico" src="/static/login/q1.png" mode="aspectFit"></image>
					<text class="quick-label">专属服务</text>
				</view>
			</view>
		</view>

		<view class="func-card">
			<text class="func-title">功能中心</text>
			<view class="func-cell" @click="onDiscover">
				<image class="func-ico" src="/static/login/f1.png" mode="aspectFit"></image>
				<text class="func-label">我的发布</text>
				<text class="func-arrow">›</text>
			</view>
			<view class="func-line"></view>
			<view class="func-cell" @click="goContacts">
				<image class="func-ico" src="/static/login/f2.png" mode="aspectFit"></image>
				<text class="func-label">我的关注</text>
				<text class="func-arrow">›</text>
			</view>
			<view class="func-line"></view>
			<view class="func-cell" @click="onInvite">
				<image class="func-ico" src="/static/login/f3.png" mode="aspectFit"></image>
				<text class="func-label">邀请好友</text>
				<text class="func-arrow">›</text>
			</view>
		</view>

		<view class="wx-tabbar">
			<view class="wx-tab" @click="goHome">
				<image class="wx-tab-icon" src="/static/login/s11.png" mode="aspectFit"></image>
			</view>
			<view class="wx-tab" @click="goRooms">
				<image class="wx-tab-icon" src="/static/login/s22.png" mode="aspectFit"></image>
			</view>
			<view class="wx-tab" @click="onDiscover">
				<image class="wx-tab-icon" src="/static/login/s33.png" mode="aspectFit"></image>
			</view>
			<view class="wx-tab" @click="goNotify">
				<image class="wx-tab-icon" src="/static/login/s44.png" mode="aspectFit"></image>
			</view>
			<view class="wx-tab wx-tab-on">
				<image class="wx-tab-icon" src="/static/login/s5.png" mode="aspectFit"></image>
			</view>
		</view>

		<view v-if="showInvite" class="invite-mask" @click="closeInvite">
			<view class="invite-sheet" @click.stop="">
				<text class="invite-title">邀请好友</text>
				<text class="invite-desc">邀请新用户提前获得新项目信息以及平台会员其他特权时刻关注平台信息</text>
				<image class="invite-qr" :src="inviteQr" mode="aspectFit"></image>
				<view class="or-row">
					<view class="or-line"></view>
					<text class="or-text">或</text>
					<view class="or-line"></view>
				</view>
				<view class="code-pill" @click="copyFriendCode">
					<text class="code-text">我的好友码 {{ friendCode }}</text>
					<text class="code-copy">⧉</text>
				</view>
				<view v-if="showCodeInput" class="code-input-wrap">
					<input class="code-input" v-model="enterCode" placeholder="请输入好友码" />
					<view class="code-go" @click="applyFriendCode">
						<text class="code-go-text">添加</text>
					</view>
				</view>
				<view class="invite-btn" @click="onEnterCode">
					<text class="invite-btn-text">{{ showCodeInput ? '收起' : '输入好友码' }}</text>
				</view>
			</view>
		</view>
	</view>
</template>

<script setup lang="uts">
	import { ref, computed, onMounted, onUnmounted } from 'vue'
	import { getMatrix } from '@/common/matrix.uts'
	import { loadSession, saveSession, SessionInfo } from '@/common/storage.uts'
	import { loadPlatformSession, PlatformSession, fetchPlatformMe, savePlatformSession } from '@/common/platform.uts'
	import { friendCodeOf, inviteQrUrl, matrixIdFromFriendCode } from '@/common/cms.uts'
	import { openChat } from '@/common/app.uts'

	const session = ref<SessionInfo | null>(loadSession())
	const platform = ref<PlatformSession | null>(loadPlatformSession())
	const usdtBalance = ref<string>('--')
	const displayName = computed(() => {
		const s = session.value
		if (s != null) {
			if (s.display_name != null && s.display_name.length > 0) return s.display_name
			return s.user_id
		}
		const p = platform.value
		if (p != null) {
			if (p.nickname.length > 0) return p.nickname
			return p.email
		}
		return ''
	})
	const userId = computed(() => {
		const s = session.value
		if (s != null) return s.user_id
		const p = platform.value
		if (p != null) {
			if (p.user_id.length > 0) return p.user_id
			return p.email
		}
		return ''
	})
	const accountName = computed(() => {
		const s = session.value
		if (s != null) {
			const id = s.user_id
			if (id.length == 0) return ''
			return id.split(':')[0].replace('@', '')
		}
		const p = platform.value
		if (p != null) {
			if (p.email.length > 0) return p.email
			return p.user_id
		}
		return ''
	})
	const avatarUrl = ref<string>('/static/login/tiki.png')
	const showInvite = ref<boolean>(false)
	const showCodeInput = ref<boolean>(false)
	const enterCode = ref<string>('')
	const friendCode = computed((): string => friendCodeOf(userId.value as string))
	const inviteQr = computed((): string => inviteQrUrl(userId.value as string))
	let offSync: (() => void) | null = null

	function stopOff(handler: (() => void) | null): void {
		if (handler == null) return
		try { handler() } catch (e) {}
	}

	async function loadUsdtBalance(): Promise<void> {
		if (platformTokenEmpty()) {
			usdtBalance.value = '--'
			return
		}
		try {
			const me = await fetchPlatformMe()
			usdtBalance.value = me.money.length > 0 ? me.money : '0'
			// 同步昵称到本地 session，资料页立刻刷新
			const p = loadPlatformSession()
			if (p != null && me.nickname.length > 0) {
				p.nickname = me.nickname
				savePlatformSession(p)
				platform.value = p
			}
			if (me.avatar.length > 0 && me.avatar.indexOf('http') == 0) {
				avatarUrl.value = me.avatar
			}
		} catch (e) {
			console.warn('拉取余额失败', e)
			usdtBalance.value = '--'
		}
	}

	function platformTokenEmpty(): boolean {
		const p = loadPlatformSession()
		return p == null || p.token.length == 0
	}

	async function setupProfile(): Promise<void> {
		platform.value = loadPlatformSession()
		const matrix = getMatrix()
		if (matrix == null && platform.value == null && session.value == null) {
			uni.reLaunch({ url: '/pages/login/login' })
			return
		}
		loadUsdtBalance()
		if (matrix == null) return
		try {
			const p = await matrix.getProfile(userId.value)
			const s = session.value
			if (s != null) {
				s.display_name = p.display_name
				s.avatar_url = p.avatar_url
				saveSession(s)
				session.value = s
			}
			if (p.avatar_url != null && p.avatar_url.length > 0) {
				let url = matrix.mxcToHttp(p.avatar_url, 256, 256)
				const token = matrix.accessToken
				if (token.length > 0 && url.indexOf('access_token=') < 0) {
					url = url + (url.indexOf('?') >= 0 ? '&' : '?') + 'access_token=' + encodeURIComponent(token)
				}
				if (url.length > 0) avatarUrl.value = url
			}
		} catch (e) {
			console.warn('拉取 profile 失败', e)
		}
		offSync = matrix.onSync((_state: string, error: string) => {
			if (error.length > 0) console.warn('sync error', error)
		})
	}

	onMounted(() => {
		setupProfile()
	})

	onShow(() => {
		session.value = loadSession()
		platform.value = loadPlatformSession()
		loadUsdtBalance()
	})

	onUnmounted(() => {
		stopOff(offSync)
		offSync = null
	})

	function onSoon() {
		uni.showToast({ title: '即将开放', icon: 'none' })
	}
	function goStats() {
		uni.navigateTo({ url: '/pages/stats/stats' })
	}

	function goHome() {
		uni.redirectTo({ url: '/pages/home/home' })
	}
	function goRooms() {
		uni.redirectTo({ url: '/pages/rooms/rooms' })
	}
	function goContacts() {
		uni.redirectTo({ url: '/pages/contacts/contacts' })
	}
	function onSearchMessages() {
		uni.navigateTo({ url: '/pages/search/search' })
	}
	function onDiscover() {
		uni.redirectTo({ url: '/pages/discover/discover' })
	}
	function goNotify() {
		uni.redirectTo({ url: '/pages/notify/notify' })
	}
	function onSettings() {
		uni.navigateTo({ url: '/pages/settings/settings' })
	}
	function onInvite() {
		const id = userId.value as string
		if (id.length == 0) {
			uni.showToast({ title: '暂无账号', icon: 'none' })
			return
		}
		showCodeInput.value = false
		enterCode.value = ''
		showInvite.value = true
	}

	function closeInvite(): void {
		showInvite.value = false
	}

	function copyFriendCode(): void {
		uni.setClipboardData({
			data: friendCode.value,
			success: () => {
				uni.showToast({ title: '好友码已复制', icon: 'none' })
			}
		})
	}

	function onEnterCode(): void {
		showCodeInput.value = !showCodeInput.value
	}

	async function applyFriendCode(): Promise<void> {
		const code = enterCode.value.trim()
		if (code.length == 0) {
			uni.showToast({ title: '请输入好友码', icon: 'none' })
			return
		}
		const target = matrixIdFromFriendCode(code)
		const matrix = getMatrix()
		if (matrix == null) return
		try {
			const rid = await matrix.startDM(target)
			showInvite.value = false
			openChat(rid)
		} catch (e) {
			uni.showToast({ title: '未找到该好友码', icon: 'none' })
		}
	}
</script>

