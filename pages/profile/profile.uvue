<template>
	<view class="profile-page">
		<!-- #ifdef APP -->
		<view class="status-bar-holder"></view>
		<!-- #endif -->
		<scroll-view class="profile-scroll" scroll-y="true">
			<view class="top-row">
				<view class="lang-pill" @click="onLang">
					<image class="lang-globe" src="/static/login/china.png" mode="aspectFit"></image>
					<text class="lang-text">{{ langLabel }}</text>
					<text class="lang-caret">▾</text>
				</view>
				<view class="top-right">
					<image class="top-icon" src="/static/login/e1.png" mode="aspectFit" @click="goNotify"></image>
					<image class="top-icon" src="/static/login/e2.png" mode="aspectFit" @click="onSettings"></image>
				</view>
			</view>

			<view class="user-row" @click="onSettings">
				<image class="user-avatar" :src="avatarUrl" mode="aspectFill"></image>
				<view class="user-meta">
					<text class="user-name">{{ displayName }}</text>
					<view class="user-sub">
						<text class="user-id">ID: {{ accountName }}</text>
						<view class="vip-badge">
							<text class="vip-text">{{ vipLabelText }}</text>
						</view>
						<view v-if="teamName.length > 0" class="team-badge">
							<text class="team-text">{{ teamName }}</text>
						</view>
					</view>
				</view>
				<text class="user-arrow">›</text>
			</view>

			<view class="balance-row">
				<view class="balance-left">
					<text class="balance-label">{{ i18n.balance }}</text>
					<text class="balance-value">{{ usdtBalance }}</text>
				</view>
				<view class="withdraw-btn" @click="openWithdraw">
					<text class="withdraw-btn-text">{{ i18n.withdraw }}</text>
				</view>
			</view>

			<view class="member-card">
				<view class="vip-bar">
					<text class="vip-bar-text">{{ vipPeriodText }}</text>
					<view class="renew-btn" @click="onSubscribe">
						<text class="renew-text">{{ renewBtnText }}</text>
					</view>
				</view>
				<view class="stat-row">
					<view class="stat-cell" @click="onSearchMessages">
						<view class="stat-head">
						<text class="stat-title">{{ i18n.fav }}</text>
						<text class="stat-mini">›</text>
					</view>
					<text class="stat-empty">{{ i18n.emptyRec }}</text>
				</view>
				<view class="stat-split"></view>
				<view class="stat-cell" @click="onSearchMessages">
					<view class="stat-head">
						<text class="stat-title">{{ i18n.history }}</text>
						<text class="stat-mini">›</text>
					</view>
					<text class="stat-empty">{{ i18n.emptyRec }}</text>
				</view>
			</view>
			<view class="quick-row">
				<view class="quick-item" @click="goStats">
					<image class="quick-ico" src="/static/login/q4.png" mode="aspectFit"></image>
					<text class="quick-label">{{ i18n.analytics }}</text>
				</view>
				<view class="quick-item" @click="goRooms">
					<image class="quick-ico" src="/static/login/q3.png" mode="aspectFit"></image>
					<text class="quick-label">{{ i18n.chat }}</text>
				</view>
				<view class="quick-item" @click="onSoon">
					<image class="quick-ico" src="/static/login/q2.png" mode="aspectFit"></image>
					<text class="quick-label">{{ i18n.share }}</text>
				</view>
				<view class="quick-item" @click="onSoon">
					<image class="quick-ico" src="/static/login/q1.png" mode="aspectFit"></image>
					<text class="quick-label">{{ i18n.service }}</text>
				</view>
			</view>
		</view>

			<view class="func-card">
				<text class="func-title">{{ i18n.center }}</text>
				<view class="func-cell" @click="onDiscover">
					<image class="func-ico" src="/static/login/f1.png" mode="aspectFit"></image>
					<text class="func-label">{{ i18n.myPublish }}</text>
					<text class="func-arrow">›</text>
				</view>
				<view class="func-line"></view>
				<view class="func-cell" @click="goContacts">
					<image class="func-ico" src="/static/login/f2.png" mode="aspectFit"></image>
					<text class="func-label">{{ i18n.follow }}</text>
					<text class="func-arrow">›</text>
				</view>
				<view class="func-line"></view>
				<view class="func-cell" @click="onInvite">
					<image class="func-ico" src="/static/login/f3.png" mode="aspectFit"></image>
					<text class="func-label">{{ i18n.invite }}</text>
					<text class="func-arrow">›</text>
				</view>
			</view>
			<view class="profile-scroll-pad"></view>
		</scroll-view>

		<view class="wx-tabbar">
			<view class="wx-tab" @click="goHome">
				<image class="wx-tab-icon" src="/static/login/s11.png" mode="aspectFit"></image>
			</view>
			<view class="wx-tab" @click="goRooms">
				<image class="wx-tab-icon" src="/static/login/s22.png" mode="aspectFit"></image>
			</view>
			<view class="wx-tab" @click="onDiscover">
				<image class="wx-tab-icon" src="/static/login/s33.png" mode="aspectFit"></image>
			</view>
			<view class="wx-tab" @click="goNotify">
				<image class="wx-tab-icon" src="/static/login/s44.png" mode="aspectFit"></image>
			</view>
			<view class="wx-tab wx-tab-on">
				<image class="wx-tab-icon" src="/static/login/s5.png" mode="aspectFit"></image>
			</view>
		</view>

		<view v-if="showInvite" class="invite-mask" @click="closeInvite">
			<view class="invite-sheet" @click.stop="">
				<text class="invite-title">邀请好友注册</text>
				<text class="invite-desc">分享邀请码，新用户注册时绑定推荐关系，可提前获得新项目信息与会员特权</text>
				<image class="invite-qr" :src="inviteQr" mode="aspectFit"></image>
				<view class="code-pill" @click="copyInviteCode">
					<text class="code-text">我的邀请码 {{ inviteCodeDisplay }}</text>
					<text class="code-copy">⧉</text>
				</view>
				<view class="or-row">
					<view class="or-line"></view>
					<text class="or-text">加好友</text>
					<view class="or-line"></view>
				</view>
				<view class="invite-actions">
					<view class="invite-action" @click="onScanFriend">
						<text class="invite-action-text">扫码加好友</text>
					</view>
					<view class="invite-action" @click="onGoAddFriend">
						<text class="invite-action-text">搜用户名</text>
					</view>
				</view>
				<view v-if="showCodeInput" class="code-input-wrap">
					<input class="code-input" v-model="enterCode" placeholder="输入用户名或 Matrix ID" />
					<view class="code-go" @click="applyFriendCode">
						<text class="code-go-text">添加</text>
					</view>
				</view>
				<view class="invite-btn" @click="onEnterCode">
					<text class="invite-btn-text">{{ showCodeInput ? '收起' : '输入用户名加好友' }}</text>
				</view>
			</view>
		</view>

		<view v-if="showWithdraw" class="invite-mask" @click="closeWithdraw">
			<view class="plan-sheet" @click.stop="">
				<text class="invite-title">{{ i18n.withdrawTitle }}</text>
				<text class="invite-desc">{{ i18n.withdrawDesc }}</text>
				<view class="wd-field">
					<text class="wd-label">{{ i18n.withdrawAmount }}</text>
					<input class="wd-input" type="digit" v-model="wdAmount" :placeholder="i18n.withdrawAmountPh" />
				</view>
				<view class="wd-field">
					<text class="wd-label">{{ i18n.withdrawAddr }}</text>
					<input class="wd-input" type="text" v-model="wdAddress" :placeholder="i18n.withdrawAddrPh" />
				</view>
				<view class="wd-field">
					<text class="wd-label">{{ i18n.withdrawCode }}</text>
					<view class="wd-code-row">
						<input class="wd-input wd-input-code" type="number" v-model="wdCode" :placeholder="i18n.withdrawCodePh" />
						<text class="wd-code-btn" :class="wdCodeWait > 0 ? 'wd-code-btn-off' : ''" @click="onSendWithdrawCode">{{ wdCodeWait > 0 ? (wdCodeWait + 's') : i18n.withdrawGetCode }}</text>
					</view>
				</view>
				<view class="invite-btn" :class="{ 'invite-btn-disabled': wdSubmitting }" @click="onSubmitWithdraw">
					<text class="invite-btn-text">{{ wdSubmitting ? i18n.withdrawSubmitting : i18n.withdrawSubmit }}</text>
				</view>
			</view>
		</view>

		<view v-if="showPlans" class="invite-mask" @click="closePlans">
			<view class="plan-sheet" @click.stop="">
				<text class="invite-title">{{ i18n.planTitle }}</text>
				<text class="invite-desc">{{ i18n.planDesc }}</text>
				<view v-if="plansLoading" class="plan-state">
					<text class="plan-state-text">{{ i18n.loading }}</text>
				</view>
				<view v-else-if="planList.length == 0" class="plan-state">
					<text class="plan-state-text">{{ i18n.planEmpty }}</text>
				</view>
				<scroll-view v-else class="plan-scroll" scroll-y="true">
					<view
						v-for="item in planList"
						:key="item.plan_code"
						class="plan-card"
						:class="{ 'plan-card-on': selectedPlanCode == item.plan_code }"
						@click="selectPlan(item.plan_code)"
					>
						<view class="plan-card-top">
							<text class="plan-name">{{ planNameText(item.name) }}</text>
							<view class="plan-price-col">
								<text class="plan-price">{{ formatPlanPayPrice(item) }}</text>
								<text v-if="hasPlanDiscount(item)" class="plan-price-origin">{{ formatPlanOriginPrice(item) }}</text>
							</view>
						</view>
						<text v-if="hasPlanDiscount(item)" class="plan-dis">{{ formatPlanDiscount(item) }}</text>
						<text class="plan-meta">{{ formatPlanMeta(item) }}</text>
					</view>
				</scroll-view>
				<view class="invite-btn" :class="{ 'invite-btn-disabled': paying || selectedPlanCode.length == 0 }" @click="onPayPlan">
					<text class="invite-btn-text">{{ paying ? i18n.planPaying : payBtnLabel }}</text>
				</view>
			</view>
		</view>
	</view>
</template>

<script setup lang="uts">
	import { ref, computed, onMounted, onUnmounted } from 'vue'
	import { getMatrix } from '@/common/matrix.uts'
	import { loadSession, saveSession, SessionInfo } from '@/common/storage.uts'
	import {
		loadPlatformSession,
		PlatformSession,
		fetchPlatformMe,
		savePlatformSession,
		fetchRolePlans,
		createBillingOrder,
		renewBillingSubscription,
		billingPayNotify,
		fetchOrderDetail,
		fetchBillingWallet,
		planPayPrice,
		planPayPriceText,
		isPlanDiscountActive,
		findFriendByUsername,
		sendWithdrawEmailCode,
		billingWithdraw,
		RolePlan
	} from '@/common/platform.uts'
	import { loadTpWalletAddress } from '@/common/tp-wallet.uts'
	import { tpTransferUsdt, waitBscTxConfirmed, isTpAppInstalled } from '@/common/tp-wallet.uts'
	import { inviteRegisterQrUrl, matrixIdFromFriendCode } from '@/common/cms.uts'
	import { openChat } from '@/common/app.uts'
	import { scanAddFriendOrInvite } from '@/common/deeplink.uts'
	import { getLocaleLabel, openLanguagePage, t, tx } from '@/common/i18n.uts'

	type ProfileI18n = {
		balance: string
		fav: string
		history: string
		emptyRec: string
		analytics: string
		chat: string
		share: string
		service: string
		center: string
		myPublish: string
		follow: string
		invite: string
		withdraw: string
		withdrawTitle: string
		withdrawDesc: string
		withdrawAmount: string
		withdrawAmountPh: string
		withdrawAddr: string
		withdrawAddrPh: string
		withdrawCode: string
		withdrawCodePh: string
		withdrawGetCode: string
		withdrawSubmit: string
		withdrawSubmitting: string
		planTitle: string
		planDesc: string
		planEmpty: string
		planPaying: string
		loading: string
	}

	function buildProfileI18n(): ProfileI18n {
		return {
			balance: t('profile.balance'),
			fav: t('profile.fav'),
			history: t('profile.history'),
			emptyRec: t('profile.emptyRec'),
			analytics: t('profile.analytics'),
			chat: t('profile.chat'),
			share: t('profile.share'),
			service: t('profile.service'),
			center: t('profile.center'),
			myPublish: t('profile.myPublish'),
			follow: t('profile.follow'),
			invite: t('profile.invite'),
			withdraw: t('profile.withdraw'),
			withdrawTitle: t('profile.withdrawTitle'),
			withdrawDesc: t('profile.withdrawDesc'),
			withdrawAmount: t('profile.withdrawAmount'),
			withdrawAmountPh: t('profile.withdrawAmountPh'),
			withdrawAddr: t('profile.withdrawAddr'),
			withdrawAddrPh: t('profile.withdrawAddrPh'),
			withdrawCode: t('profile.withdrawCode'),
			withdrawCodePh: t('profile.withdrawCodePh'),
			withdrawGetCode: t('profile.withdrawGetCode'),
			withdrawSubmit: t('profile.withdrawSubmit'),
			withdrawSubmitting: t('profile.withdrawSubmitting'),
			planTitle: t('profile.planTitle'),
			planDesc: t('profile.planDesc'),
			planEmpty: t('profile.planEmpty'),
			planPaying: t('profile.planPaying'),
			loading: t('common.loading')
		} as ProfileI18n
	}

	function fillTpl(tpl: string, token: string, value: string): string {
		let out = tpl
		while (out.indexOf(token) >= 0) {
			const i = out.indexOf(token)
			out = out.substring(0, i) + value + out.substring(i + token.length)
		}
		return out
	}

	const session = ref<SessionInfo | null>(loadSession())
	const platform = ref<PlatformSession | null>(loadPlatformSession())
	const usdtBalance = ref<string>('--')
	const vipLabel = ref<string>('普通用户')
	const vipPeriod = ref<string>('暂无有效订阅')
	const teamName = ref<string>('')
	const langLabel = ref<string>(getLocaleLabel())
	const showWithdraw = ref<boolean>(false)
	const wdAmount = ref<string>('')
	const wdAddress = ref<string>('')
	const wdCode = ref<string>('')
	const wdSubmitting = ref<boolean>(false)
	const wdCodeWait = ref<number>(0)
	let wdCodeTimer: number | null = null
	const i18n = ref<ProfileI18n>(buildProfileI18n())
	const vipLabelText = computed((): string => tx(vipLabel.value))
	const vipPeriodText = computed((): string => tx(vipPeriod.value))
	const renewBtnText = computed((): string => {
		const label = vipLabel.value
		const period = vipPeriod.value
		if (label == '游客' || label == '普通用户' || label.toUpperCase() == 'VISITOR') {
			return t('api.goSubscribe')
		}
		if (period.indexOf('待支付') >= 0 || period.indexOf('暂无') >= 0 || period.indexOf('过期') >= 0) {
			return t('api.goSubscribe')
		}
		return t('api.renew')
	})
	const displayName = computed(() => {
		const s = session.value
		if (s != null) {
			if (s.display_name != null && s.display_name.length > 0) return s.display_name
			return s.user_id
		}
		const p = platform.value
		if (p != null) {
			if (p.nickname.length > 0) return p.nickname
			return p.email
		}
		return ''
	})
	const userId = computed(() => {
		const s = session.value
		if (s != null) return s.user_id
		const p = platform.value
		if (p != null) {
			if (p.user_id.length > 0) return p.user_id
			return p.email
		}
		return ''
	})
	const accountName = computed(() => {
		const s = session.value
		if (s != null) {
			const id = s.user_id
			if (id.length == 0) return ''
			return id.split(':')[0].replace('@', '')
		}
		const p = platform.value
		if (p != null) {
			if (p.email.length > 0) return p.email
			return p.user_id
		}
		return ''
	})
	const avatarUrl = ref<string>('/static/login/tiki.png')
	const showInvite = ref<boolean>(false)
	const showCodeInput = ref<boolean>(false)
	const enterCode = ref<string>('')
	const showPlans = ref<boolean>(false)
	const plansLoading = ref<boolean>(false)
	const paying = ref<boolean>(false)
	const planList = ref<Array<RolePlan>>([])
	const selectedPlanCode = ref<string>('')
	const myInviteCode = ref<string>('')
	const inviteCodeDisplay = computed((): string => {
		if (myInviteCode.value.length > 0) return myInviteCode.value
		return accountName.value as string
	})
	const inviteQr = computed((): string => inviteRegisterQrUrl(inviteCodeDisplay.value as string))
	let offSync: (() => void) | null = null

	function stopOff(handler: (() => void) | null): void {
		if (handler == null) return
		try { handler() } catch (e) {}
	}

	function platformTokenEmpty(): boolean {
		const p = loadPlatformSession()
		return p == null || p.token.length == 0
	}

	async function loadUsdtBalance(): Promise<void> {
		if (platformTokenEmpty()) {
			usdtBalance.value = '--'
			return
		}
		try {
			const me = await fetchPlatformMe()
			usdtBalance.value = me.money.length > 0 ? me.money : '0'
			if (me.vip_label.length > 0) vipLabel.value = me.vip_label
			if (me.vip_period.length > 0) vipPeriod.value = me.vip_period
			teamName.value = me.team_name
			if (me.invite_code.length > 0) myInviteCode.value = me.invite_code
			else if (me.username.length > 0) myInviteCode.value = me.username
			// vip_label 已在 fetchPlatformMe 内缓存，供首页/发现页判断发布入口
			console.log('[profile] vip=', me.vip_label, me.vip_period, 'team=', me.team_name, 'invite=', me.invite_code)
			// 同步昵称到本地 session，资料页立刻刷新
			const p = loadPlatformSession()
			if (p != null && me.nickname.length > 0) {
				p.nickname = me.nickname
				savePlatformSession(p)
				platform.value = p
			}
			if (me.avatar.length > 0 && me.avatar.indexOf('http') == 0) {
				avatarUrl.value = me.avatar
			}
		} catch (e) {
			console.warn('拉取余额失败', e)
			usdtBalance.value = '--'
		}
	}

	async function setupProfile(): Promise<void> {
		platform.value = loadPlatformSession()
		const matrix = getMatrix()
		if (matrix == null && platform.value == null && session.value == null) {
			uni.reLaunch({ url: '/pages/login/login' })
			return
		}
		loadUsdtBalance()
		if (matrix == null) return
		try {
			const p = await matrix.getProfile(userId.value)
			const s = session.value
			if (s != null) {
				s.display_name = p.display_name
				s.avatar_url = p.avatar_url
				saveSession(s)
				session.value = s
			}
			if (p.avatar_url != null && p.avatar_url.length > 0) {
				let url = matrix.mxcToHttp(p.avatar_url, 256, 256)
				const token = matrix.accessToken
				if (token.length > 0 && url.indexOf('access_token=') < 0) {
					url = url + (url.indexOf('?') >= 0 ? '&' : '?') + 'access_token=' + encodeURIComponent(token)
				}
				if (url.length > 0) avatarUrl.value = url
			}
		} catch (e) {
			console.warn('拉取 profile 失败', e)
		}
		offSync = matrix.onSync((_state: string, error: string) => {
			if (error.length > 0) console.warn('sync error', error)
		})
	}

	onMounted(() => {
		setupProfile()
	})

	onShow(() => {
		session.value = loadSession()
		platform.value = loadPlatformSession()
		langLabel.value = getLocaleLabel()
		i18n.value = buildProfileI18n()
		loadUsdtBalance()
	})

	onUnmounted(() => {
		stopOff(offSync)
		offSync = null
		const t = wdCodeTimer
		wdCodeTimer = null
		if (t != null) {
			clearInterval(t as number)
		}
	})

	function onSoon() {
		uni.showToast({ title: '即将开放', icon: 'none' })
	}

	function onLang(): void {
		openLanguagePage()
	}

	function hasPlanDiscount(item: RolePlan): boolean {
		return isPlanDiscountActive(item)
	}

	function selectedPlan(): RolePlan | null {
		const code = selectedPlanCode.value
		if (code.length == 0) return null
		const list = planList.value
		for (let i = 0; i < list.length; i++) {
			if (list[i].plan_code == code) return list[i]
		}
		return null
	}

	function formatPlanPayPrice(item: RolePlan): string {
		return 'USDT ' + planPayPriceText(item)
	}

	function formatPlanOriginPrice(item: RolePlan): string {
		return t('profile.planOrigin') + ('' + item.price)
	}

	function formatPlanDiscount(item: RolePlan): string {
		return t('profile.planDiscountPrefix') + ('' + item.dis) + ' USDT'
	}

	function formatPayConfirm(item: RolePlan): string {
		const pay = planPayPriceText(item)
		if (isPlanDiscountActive(item)) {
			let s = t('profile.planConfirmBodyDis')
			s = fillTpl(s, '{pay}', pay)
			s = fillTpl(s, '{price}', '' + item.price)
			s = fillTpl(s, '{dis}', '' + item.dis)
			return s
		}
		return fillTpl(t('profile.planConfirmBody'), '{pay}', pay)
	}

	const payBtnLabel = computed((): string => {
		const code = selectedPlanCode.value
		if (code.length == 0) return t('profile.planPayConfirm')
		const list = planList.value
		for (let i = 0; i < list.length; i++) {
			if (list[i].plan_code == code) {
				return t('profile.planPayUsdt') + planPayPriceText(list[i])
			}
		}
		return t('profile.planPayConfirm')
	})

	function planNameText(name: string): string {
		return tx(name)
	}

	function formatPlanMeta(item: RolePlan): string {
		let days = item.duration_days
		if (days <= 0) days = 365
		let tip = '' + days + 'd'
		if (days >= 365 && days % 365 == 0) {
			tip = '' + (days / 365) + 'y'
		}
		return tip + ' · ' + item.plan_code
	}

	function selectPlan(code: string): void {
		selectedPlanCode.value = code
	}

	function closePlans(): void {
		if (paying.value) return
		showPlans.value = false
	}

	function openWithdraw(): void {
		if (platformTokenEmpty()) {
			uni.showToast({ title: t('profile.loginFirst'), icon: 'none' })
			return
		}
		wdAmount.value = ''
		wdCode.value = ''
		let addr = loadTpWalletAddress().trim()
		if (addr.length < 10) {
			try {
				const raw = uni.getStorageSync('tp_wallet_address_v1')
				if (raw != null) addr = ('' + raw).trim()
			} catch (e0) {}
		}
		wdAddress.value = addr
		showWithdraw.value = true
	}

	function closeWithdraw(): void {
		if (wdSubmitting.value) return
		showWithdraw.value = false
	}

	function startWdCodeCountdown(): void {
		wdCodeWait.value = 60
		const old = wdCodeTimer
		wdCodeTimer = null
		if (old != null) clearInterval(old as number)
		wdCodeTimer = setInterval(() => {
			if (wdCodeWait.value <= 1) {
				wdCodeWait.value = 0
				const t = wdCodeTimer
				wdCodeTimer = null
				if (t != null) clearInterval(t as number)
				return
			}
			wdCodeWait.value = wdCodeWait.value - 1
		}, 1000)
	}

	async function onSendWithdrawCode(): Promise<void> {
		if (wdCodeWait.value > 0 || wdSubmitting.value) return
		const p = loadPlatformSession()
		const em = p != null ? p.email.trim() : ''
		if (em.length == 0 || em.indexOf('@') < 1) {
			uni.showToast({ title: t('profile.withdrawNoEmail'), icon: 'none' })
			return
		}
		uni.showLoading({ title: t('profile.withdrawSending') })
		try {
			await sendWithdrawEmailCode(em)
			uni.hideLoading()
			uni.showToast({ title: t('profile.withdrawCodeSent'), icon: 'none' })
			startWdCodeCountdown()
		} catch (e) {
			uni.hideLoading()
			let msg = t('profile.withdrawSendFail')
			try { msg = '' + e } catch (e2) {}
			if (msg.indexOf('Error:') == 0) msg = msg.substring(6).trim()
			uni.showToast({ title: msg.length > 0 ? msg : t('profile.withdrawSendFail'), icon: 'none' })
		}
	}

	async function onSubmitWithdraw(): Promise<void> {
		if (wdSubmitting.value) return
		const amt = wdAmount.value.trim()
		const addr = wdAddress.value.trim()
		const cd = wdCode.value.trim()
		if (amt.length == 0) {
			uni.showToast({ title: t('profile.withdrawNeedAmount'), icon: 'none' })
			return
		}
		if (addr.length < 10) {
			uni.showToast({ title: t('profile.withdrawNeedAddr'), icon: 'none' })
			return
		}
		if (cd.length == 0) {
			uni.showToast({ title: t('profile.withdrawNeedCode'), icon: 'none' })
			return
		}
		wdSubmitting.value = true
		uni.showLoading({ title: t('profile.withdrawSubmitting') })
		try {
			const r = await billingWithdraw(amt, addr, cd)
			uni.hideLoading()
			uni.showToast({ title: r.msg.length > 0 ? tx(r.msg) : t('profile.withdrawOk'), icon: 'none' })
			showWithdraw.value = false
			await loadUsdtBalance()
		} catch (e) {
			uni.hideLoading()
			let msg = t('profile.withdrawFail')
			try { msg = '' + e } catch (e2) {}
			if (msg.indexOf('Error:') == 0) msg = msg.substring(6).trim()
			uni.showToast({ title: msg.length > 0 ? tx(msg) : t('profile.withdrawFail'), icon: 'none', duration: 3000 })
		}
		wdSubmitting.value = false
	}

	async function onSubscribe(): Promise<void> {
		if (platformTokenEmpty()) {
			uni.showToast({ title: t('profile.loginFirst'), icon: 'none' })
			return
		}
		showPlans.value = true
		plansLoading.value = true
		planList.value = []
		selectedPlanCode.value = ''
		try {
			const list = await fetchRolePlans()
			planList.value = list
			if (list.length > 0) {
				selectedPlanCode.value = list[0].plan_code
			}
		} catch (e) {
			console.warn('[profile] plans fail', e)
			uni.showToast({ title: '' + e, icon: 'none' })
			showPlans.value = false
		}
		plansLoading.value = false
	}

	async function onPayPlan(): Promise<void> {
		if (paying.value) return
		const code = selectedPlanCode.value
		if (code.length == 0) {
			uni.showToast({ title: t('profile.planPick'), icon: 'none' })
			return
		}
		const picked = selectedPlan()
		const amtTip = picked != null ? planPayPriceText(picked!) : ''
		const confirmText = picked != null ? formatPayConfirm(picked!) : (t('profile.planConfirmFallback') + code)
		const ok = await new Promise((resolve: (v: boolean) => void) => {
			uni.showModal({
				title: t('profile.planPayConfirm'),
				content: confirmText,
				confirmText: t('common.confirm'),
				cancelText: t('common.cancel'),
				success: (res) => {
					resolve(res.confirm == true)
				},
				fail: () => {
					resolve(false)
				}
			})
		})
		if (ok != true) return
		if (!isTpAppInstalled()) {
			uni.showToast({ title: t('profile.planNeedTp'), icon: 'none' })
			return
		}
		paying.value = true
		uni.showLoading({ title: t('profile.planOrdering'), mask: true })
		try {
			const isRenew = renewBtnText.value == t('api.renew')
			const order = isRenew ? await renewBillingSubscription(code) : await createBillingOrder(code)
			let orderNo = order.order_no
			let payTo = ''
			try {
				payTo = await fetchBillingWallet()
			} catch (eWal) {
				console.warn('[profile] billing/wallet fail', eWal)
			}
			let amount = amtTip
			if (amount.length == 0) amount = order.amount
			if (orderNo.length > 0) {
				try {
					const detail = await fetchOrderDetail(orderNo)
					if (detail.order_no.length > 0) orderNo = detail.order_no
					if (amount.length == 0 && detail.amount.length > 0) amount = detail.amount
					if (payTo.length == 0 && detail.pay_address.length > 0) payTo = detail.pay_address
				} catch (eDet) {
					console.warn('[profile] order detail skip', eDet)
				}
			}
			if (payTo.length == 0 && order.pay_address.length > 0) payTo = order.pay_address
			if (payTo.length == 0) {
				throw new Error(t('profile.planNoAddr'))
			}
			if (amount.length == 0) throw new Error(t('profile.planNoAmount'))
			if (orderNo.length == 0) throw new Error(t('profile.planNoOrder'))

			uni.showLoading({ title: t('profile.planOpenWallet'), mask: true })
			console.log('[profile] pay order=', orderNo, 'to=', payTo, 'amt=', amount, 'orderAmt=', order.amount, 'planPay=', amtTip)
			const tx = await tpTransferUsdt(payTo, amount, 'plan:' + code)
			console.log('[profile] txHash=', tx.txHash)

			uni.showLoading({ title: t('profile.planConfirming'), mask: true })
			const conf = await waitBscTxConfirmed(tx.txHash, 40000)
			console.log('[profile] confirm', conf.status, conf.message)
			uni.hideLoading()

			if (conf.status == 'failed') {
				const failBase = conf.message.length > 0 ? conf.message : t('profile.planTxFail')
				throw new Error(failBase + t('profile.planTxFailTip'))
			}
			if (conf.status == 'confirmed') {
				uni.showLoading({ title: t('profile.planSyncing'), mask: true })
				await billingPayNotify(orderNo, tx.txHash, 'USDT')
				uni.hideLoading()
				uni.showToast({ title: t('profile.planPayOk'), icon: 'success' })
				showPlans.value = false
				await loadUsdtBalance()
				paying.value = false
				return
			}
			const tip = conf.message.length > 0 ? conf.message : t('profile.planConfirmFail')
			let manualBody = t('profile.planManualBody')
			manualBody = fillTpl(manualBody, '{tip}', tip)
			manualBody = fillTpl(manualBody, '{hash}', tx.txHash)
			const manualOk = await new Promise((resolve: (v: boolean) => void) => {
				uni.showModal({
					title: t('profile.planChainBlocked'),
					content: manualBody,
					confirmText: t('profile.planContinueSync'),
					cancelText: t('common.cancel'),
					success: (res) => {
						resolve(res.confirm == true)
					},
					fail: () => {
						resolve(false)
					}
				})
			})
			if (manualOk != true) {
				throw new Error(t('profile.planUnconfirmed') + tx.txHash.substring(0, 18) + '…')
			}
			uni.showLoading({ title: t('profile.planSyncing'), mask: true })
			await billingPayNotify(orderNo, tx.txHash, 'USDT')
			uni.hideLoading()
			uni.showToast({ title: t('profile.planSynced'), icon: 'success' })
			showPlans.value = false
			await loadUsdtBalance()
		} catch (e) {
			uni.hideLoading()
			console.warn('[profile] pay fail', e)
			uni.showToast({ title: '' + e, icon: 'none' })
		}
		paying.value = false
	}

	function goStats() {
		uni.navigateTo({ url: '/pages/stats/stats' })
	}

	function goHome() {
		uni.redirectTo({ url: '/pages/home/home' })
	}
	function goRooms() {
		uni.redirectTo({ url: '/pages/rooms/rooms' })
	}
	function goContacts() {
		uni.redirectTo({ url: '/pages/contacts/contacts' })
	}
	function onSearchMessages() {
		uni.navigateTo({ url: '/pages/search/search' })
	}
	function onDiscover() {
		uni.redirectTo({ url: '/pages/discover/discover' })
	}
	function goNotify() {
		uni.redirectTo({ url: '/pages/notify/notify' })
	}
	function onSettings() {
		uni.navigateTo({ url: '/pages/settings/settings' })
	}
	function onInvite() {
		const id = userId.value as string
		if (id.length == 0) {
			uni.showToast({ title: '暂无账号', icon: 'none' })
			return
		}
		showCodeInput.value = false
		enterCode.value = ''
		showInvite.value = true
	}

	function closeInvite(): void {
		showInvite.value = false
	}

	function copyInviteCode(): void {
		const code = inviteCodeDisplay.value as string
		if (code.length == 0) {
			uni.showToast({ title: '暂无邀请码', icon: 'none' })
			return
		}
		uni.setClipboardData({
			data: code,
			success: () => {
				uni.showToast({ title: '邀请码已复制', icon: 'none' })
			}
		})
	}

	function onEnterCode(): void {
		showCodeInput.value = !showCodeInput.value
	}

	function onScanFriend(): void {
		showInvite.value = false
		scanAddFriendOrInvite()
	}

	function onGoAddFriend(): void {
		showInvite.value = false
		uni.navigateTo({ url: '/pages/contacts/add' })
	}

	async function applyFriendCode(): Promise<void> {
		const code = enterCode.value.trim()
		if (code.length == 0) {
			uni.showToast({ title: '请输入用户名', icon: 'none' })
			return
		}
		const matrix = getMatrix()
		if (matrix == null) return
		uni.showLoading({ title: '查找中…', mask: true })
		try {
			let target = ''
			if (code.indexOf('@') == 0) {
				target = code
			} else {
				const found = await findFriendByUsername(code)
				if (found.length > 0 && found[0].imUser.length > 0) {
					target = found[0].imUser
				} else {
					target = matrixIdFromFriendCode(code)
				}
			}
			const rid = await matrix.startDM(target)
			uni.hideLoading()
			showInvite.value = false
			openChat(rid)
		} catch (e) {
			uni.hideLoading()
			uni.showToast({ title: '未找到该用户', icon: 'none' })
		}
	}
</script>

