			</view>
			<view class="wx-tab wx-tab-on">
				<text class="wx-tab-icon">◎</text>
				<text class="wx-tab-label">我</text>
			</view>
		</view>
	</view>
</template>

<script setup lang="uts">
	import { ref, computed, onMounted, onUnmounted } from 'vue'
	import { getMatrix } from '@/common/matrix.uts'
	import { loadSession, saveSession, SessionInfo } from '@/common/storage.uts'

	const session = ref<SessionInfo | null>(loadSession())
	const displayName = computed(() => {
		const s = session.value
		if (s == null) return ''
		if (s.display_name != null && s.display_name.length > 0) return s.display_name
		return s.user_id
	})
	const userId = computed(() => {
		const s = session.value
		if (s == null) return ''
		return s.user_id
	})
	const accountName = computed(() => {
		const s = session.value
		if (s == null) return ''
		const id = s.user_id
		if (id.length == 0) return ''
		return id.split(':')[0].replace('@', '')
	})
	const avatarUrl = ref<string>('/static/login/tiki.png')
	let offSync: (() => void) | null = null

	function stopOff(handler: (() => void) | null): void {
		if (handler == null) return
		try { handler() } catch (e) {}
	}

	async function setupProfile(): Promise<void> {
		const matrix = getMatrix()
		if (matrix == null) {
			uni.reLaunch({ url: '/pages/login/login' })
			return
		}
		try {
			const p = await matrix.getProfile(userId.value)
			const s = session.value
			if (s != null) {
				s.display_name = p.display_name
				s.avatar_url = p.avatar_url
				saveSession(s)
				session.value = s
			}
			if (p.avatar_url != null && p.avatar_url.length > 0) {
				let url = matrix.mxcToHttp(p.avatar_url, 256, 256)
				const token = matrix.accessToken
				if (token.length > 0 && url.indexOf('access_token=') < 0) {
					url = url + (url.indexOf('?') >= 0 ? '&' : '?') + 'access_token=' + encodeURIComponent(token)
				}
				if (url.length > 0) avatarUrl.value = url
			}
		} catch (e) {
			console.warn('拉取 profile 失败', e)
		}
		offSync = matrix.onSync((_state: string, error: string) => {
			if (error.length > 0) console.warn('sync error', error)
		})
	}

	onMounted(() => {
		setupProfile()
	})

	onUnmounted(() => {
		stopOff(offSync)
		offSync = null
	})

	function onSoon() {
		uni.showToast({ title: '即将开放', icon: 'none' })
	}

	function goRooms() {
		uni.redirectTo({ url: '/pages/rooms/rooms' })
	}
	function goContacts() {
		uni.redirectTo({ url: '/pages/contacts/contacts' })
	}
	function onSearchMessages() {
		uni.navigateTo({ url: '/pages/search/search' })
	}
	function onDiscover() {
		uni.redirectTo({ url: '/pages/discover/discover' })
	}
	function onSettings() {
		uni.navigateTo({ url: '/pages/settings/settings' })
	}
	function onInvite() {
		const id = userId.value as string
		if (id.length == 0) {
			uni.showToast({ title: '暂无账号', icon: 'none' })
			return
		}
		uni.setClipboardData({
			data: id,
			success: () => {
				uni.showToast({ title: '已复制你的账号', icon: 'none' })
			}
		})
	}
</script>

