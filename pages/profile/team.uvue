		flex: 1;
		background-color: #f5f6f8;
		flex-direction: column;
	}
	.status-bar-holder {
		height: var(--status-bar-height);
		background-color: #ffffff;
	}
	.topbar {
		flex-direction: row;
		align-items: center;
		justify-content: space-between;
		height: 88rpx;
		padding: 0 16rpx;
		background-color: #ffffff;
		border-bottom-width: 1rpx;
		border-bottom-style: solid;
		border-bottom-color: #f0f0f0;
	}
	.back-btn {
		width: 72rpx;
		height: 72rpx;
		align-items: center;
		justify-content: center;
	}
	.back-text {
		font-size: 48rpx;
		color: #222222;
		line-height: 48rpx;
	}
	.topbar-title {
		flex: 1;
		text-align: center;
		font-size: 34rpx;
		font-weight: 600;
		color: #111111;
	}
	.topbar-right {
		width: 72rpx;
	}
	.body {
		flex: 1;
		padding: 24rpx;
	}
	.state-row {
		padding: 80rpx 24rpx;
		align-items: center;
		justify-content: center;
	}
	.state-text {
		font-size: 28rpx;
		color: #9ca3af;
	}
	.list-card {
		background-color: #ffffff;
		border-radius: 24rpx;
		overflow: hidden;
	}
	.head-row {
		flex-direction: row;
		align-items: center;
		padding: 24rpx 28rpx;
		background-color: #f8fafc;
		border-bottom-width: 1rpx;
		border-bottom-style: solid;
		border-bottom-color: #eef2f7;
	}
	.head-nick {
		flex: 1;
		font-size: 26rpx;
		color: #6b7280;
		font-weight: 600;
	}
	.head-level {
		width: 220rpx;
		text-align: right;
		font-size: 26rpx;
		color: #6b7280;
		font-weight: 600;
	}
	.item-row {
		flex-direction: row;
		align-items: center;
		padding: 28rpx;
		border-bottom-width: 1rpx;
		border-bottom-style: solid;
		border-bottom-color: #f3f4f6;
	}
	.item-nick {
		flex: 1;
		font-size: 30rpx;
		color: #111111;
		font-weight: 500;
	}
	.item-level {
		width: 220rpx;
