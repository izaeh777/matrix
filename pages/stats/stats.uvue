		padding: 28rpx 20rpx 24rpx;
	}
	.chart-area {
		flex-direction: row;
		height: 360rpx;
	}
	.y-axis {
		width: 64rpx;
		justify-content: space-between;
		padding-bottom: 8rpx;
	}
	.y-label {
		font-size: 18rpx;
		color: #9aa3af;
		text-align: right;
	}
	.plot {
		flex: 1;
		position: relative;
		margin-left: 8rpx;
		margin-right: 8rpx;
	}
	.grid-h {
		position: absolute;
		left: 0;
		right: 0;
		height: 1rpx;
		background-color: #eef0f3;
	}
	.grid-h0 { top: 0%; }
	.grid-h1 { top: 25%; }
	.grid-h2 { top: 50%; }
	.grid-h3 { top: 75%; }
	.grid-h4 { top: 100%; }
	.grid-v {
		position: absolute;
		top: 0;
		bottom: 0;
		width: 1rpx;
		background-color: #eef0f3;
	}
	.grid-v0 { left: 0%; }
	.grid-v1 { left: 33.33%; }
	.grid-v2 { left: 66.66%; }
	.grid-v3 { left: 100%; }
	.line-seg {
		position: absolute;
		height: 3rpx;
		background-color: #3b82f6;
		transform-origin: 0 50%;
	}
	.chart-dot {
		position: absolute;
		width: 10rpx;
		height: 10rpx;
		border-radius: 5rpx;
		background-color: #3b82f6;
