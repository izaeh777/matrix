<template>
	<view class="stats-page">
		<!-- #ifdef APP -->
		<view class="status-bar-holder"></view>
		<!-- #endif -->
		<view class="topbar">
			<view class="back-btn" @click="goBack">
				<text class="back-text">‹</text>
			</view>
			<text class="topbar-title">{{ t('stats.title') }}</text>
			<text class="topbar-link" @click="onEarnings">{{ t('stats.earnings') }}</text>
		</view>

		<scroll-view class="body" direction="vertical" :show-scrollbar="false" :rebound="false">
			<view class="overview-head">
				<view class="overview-left">
					<text class="overview-title">{{ t('stats.overview') }}</text>
					<text class="overview-time">{{ t('stats.updated') }}{{ updateTime }}</text>
				</view>
				<view class="range-row">
					<view
						class="range-chip"
						:class="rangeKey == '1d' ? 'range-on' : ''"
						@click="setRange('1d')"
					>
						<text class="range-text" :class="rangeKey == '1d' ? 'range-text-on' : ''">{{ t('stats.d1') }}</text>
					</view>
					<view
						class="range-chip"
						:class="rangeKey == '7d' ? 'range-on' : ''"
						@click="setRange('7d')"
					>
						<text class="range-text" :class="rangeKey == '7d' ? 'range-text-on' : ''">{{ t('stats.d7') }}</text>
					</view>
					<view class="range-chip" @click="onMoreRange">
						<text class="range-text">{{ moreLabel }}</text>
						<text class="range-caret">▾</text>
					</view>
				</view>
			</view>

			<view v-if="loading" class="state-row">
				<text class="state-text">{{ t('common.loading') }}</text>
			</view>

			<view class="card-grid">
				<view
					v-for="item in metricList"
					:key="item.key"
					class="metric-card"
					:class="selectedKey == item.key ? 'metric-on' : ''"
					@click="selectMetric(item.key)"
				>
					<text class="metric-label">{{ item.label }}</text>
					<text class="metric-value">{{ item.value }}</text>
					<view class="metric-diff">
						<text class="diff-prefix">{{ t('stats.diffPrev') }}</text>
						<text
							v-if="item.trend == 'up'"
							class="diff-up"
						>↑ {{ item.diff }}</text>
						<text
							v-else-if="item.trend == 'down'"
							class="diff-down"
						>↓ {{ item.diff }}</text>
						<text v-else class="diff-flat">-</text>
					</view>
				</view>
			</view>

			<view class="chart-card">
				<view class="chart-area">
					<view class="y-axis">
						<text class="y-label">{{ yMaxLabel }}</text>
						<text class="y-label">{{ yMidLabel }}</text>
						<text class="y-label">0</text>
					</view>
					<view class="plot">
						<view class="grid-h grid-h0"></view>
						<view class="grid-h grid-h1"></view>
						<view class="grid-h grid-h2"></view>
						<view class="grid-h grid-h3"></view>
						<view class="grid-h grid-h4"></view>
						<view class="grid-v grid-v0"></view>
						<view class="grid-v grid-v1"></view>
						<view class="grid-v grid-v2"></view>
						<view class="grid-v grid-v3"></view>

						<view
							v-for="(seg, si) in lineSegs"
							:key="'seg-' + si"
							class="line-seg"
							:style="'left:' + seg.left + '%;top:' + seg.top + '%;width:' + seg.width + '%;transform:rotate(' + seg.deg + 'deg);'"
						></view>
						<view
							v-for="(pt, pi) in chartPoints"
							:key="'pt-' + pi"
							class="chart-dot"
							:style="'left:' + pt.x + '%;top:' + pt.y + '%;'"
						></view>
					</view>
				</view>
				<view class="x-axis">
					<text
						v-for="(lab, li) in xLabels"
						:key="'x-' + li"
						class="x-label"
					>{{ lab }}</text>
				</view>
			</view>

			<view class="scroll-pad"></view>
		</scroll-view>
	</view>
</template>

<script setup lang="uts">
	import { ref } from 'vue'
	import { t as __i18nT } from '@/common/i18n.uts'
	import {
		fetchMoneyStat,
		MoneyStatMetric,
		MoneyStatPoint
	} from '@/common/platform.uts'

	function t(key: string): string {
		return __i18nT(key)
	}

	type MetricItem = {
		key: string
		label: string
		value: string
		diff: string
		trend: string
	}

	type ChartPt = {
		x: number
		y: number
	}

	type LineSeg = {
		left: number
		top: number
		width: number
		deg: number
	}

	const rangeKey = ref('1d')
	const selectedKey = ref('total')
	const updateTime = ref('--')
	const loading = ref<boolean>(false)
	const moreLabel = ref<string>(t('stats.more'))
	const yMaxLabel = ref<string>('1')
	const yMidLabel = ref<string>('0.5')

	const metricList = ref([
		{ key: 'total', label: t('stats.total'), value: '--', diff: '', trend: 'flat' } as MetricItem,
		{ key: 'direct', label: t('stats.direct'), value: '--', diff: '', trend: 'flat' } as MetricItem,
		{ key: 'team', label: t('stats.team'), value: '--', diff: '', trend: 'flat' } as MetricItem,
		{ key: 'reward', label: t('stats.reward'), value: '--', diff: '', trend: 'flat' } as MetricItem
	] as MetricItem[])

	const xLabels = ref([] as string[])
	const chartPoints = ref([] as ChartPt[])
	const lineSegs = ref([] as LineSeg[])

	function pad2(n: number): string {
		return n < 10 ? '0' + n : '' + n
	}

	function formatYmd(d: Date): string {
		return '' + d.getFullYear() + '-' + pad2(d.getMonth() + 1) + '-' + pad2(d.getDate())
	}

	function rangeDays(key: string): number {
		if (key == '7d') return 6
		if (key == '30d') return 29
		if (key == '90d') return 89
		return 0
	}

	function dateRangeForKey(key: string): Array<string> {
		const end = new Date()
		const start = new Date()
		start.setDate(end.getDate() - rangeDays(key))
		return [formatYmd(start), formatYmd(end)] as Array<string>
	}

	function labelOfMetric(key: string): string {
		if (key == 'direct') return t('stats.direct')
		if (key == 'team') return t('stats.team')
		if (key == 'reward') return t('stats.reward')
		return t('stats.total')
	}

	function applyMetrics(list: Array<MoneyStatMetric>): void {
		const next: Array<MetricItem> = [] as Array<MetricItem>
		const keys = ['total', 'direct', 'team', 'reward'] as Array<string>
		for (let i = 0; i < keys.length; i++) {
			const k = keys[i]
			let hit: MoneyStatMetric | null = null
			for (let j = 0; j < list.length; j++) {
				if (list[j].key == k) {
					hit = list[j]
					break
				}
			}
			const value = hit != null ? hit!.amount : '0.00'
			const diff = hit != null ? hit!.diff : ''
			const trend = hit != null ? hit!.trend : 'flat'
			next.push({
				key: k,
				label: labelOfMetric(k),
				value: value,
				diff: diff,
				trend: trend
			} as MetricItem)
		}
		metricList.value = next
	}

	function shortDateLabel(raw: string): string {
		let s = raw.trim()
		if (s.length >= 10 && s.indexOf('-') > 0) {
			return s.substring(5, 10).split('-').join('')
		}
		if (s.length >= 8) return s.substring(s.length - 4)
		return s
	}

	function buildChart(series: Array<MoneyStatPoint>): void {
		if (series.length == 0) {
			chartPoints.value = [] as ChartPt[]
			lineSegs.value = [] as LineSeg[]
			xLabels.value = [] as string[]
			yMaxLabel.value = '1'
			yMidLabel.value = '0.5'
			return
		}
		let maxV = 0
		for (let i = 0; i < series.length; i++) {
			if (series[i].amount > maxV) maxV = series[i].amount
		}
		if (maxV <= 0) maxV = 1
		yMaxLabel.value = '' + (Math.round(maxV * 100) / 100)
		yMidLabel.value = '' + (Math.round(maxV * 50) / 100)

		const pts: Array<ChartPt> = [] as ChartPt[]
		const n = series.length
		for (let i = 0; i < n; i++) {
			const x = n == 1 ? 50 : (i * 100) / (n - 1)
			const ratio = series[i].amount / maxV
			const y = 100 - ratio * 100
			pts.push({ x: x, y: y } as ChartPt)
		}
		chartPoints.value = pts

		const segs: Array<LineSeg> = [] as LineSeg[]
		for (let i = 0; i < pts.length - 1; i++) {
			const a = pts[i]
			const b = pts[i + 1]
			const dx = b.x - a.x
			const dy = b.y - a.y
			const width = Math.sqrt(dx * dx + dy * dy)
			const deg = Math.atan2(dy, dx) * 180 / Math.PI
			segs.push({
				left: a.x,
				top: a.y,
				width: width,
				deg: deg
			} as LineSeg)
		}
		lineSegs.value = segs

		const labels: Array<string> = [] as string[]
		if (n <= 4) {
			for (let i = 0; i < n; i++) labels.push(shortDateLabel(series[i].date))
		} else {
			labels.push(shortDateLabel(series[0].date))
			labels.push(shortDateLabel(series[Math.floor((n - 1) / 3)].date))
			labels.push(shortDateLabel(series[Math.floor(((n - 1) * 2) / 3)].date))
			labels.push(shortDateLabel(series[n - 1].date))
		}
		xLabels.value = labels
	}

	async function loadStat(): Promise<void> {
		loading.value = true
		try {
			const range = dateRangeForKey(rangeKey.value)
			const res = await fetchMoneyStat(range[0], range[1], 'all')
			applyMetrics(res.metrics)
			buildChart(res.series)
			updateTime.value = res.updated_at
		} catch (e) {
			applyMetrics([] as Array<MoneyStatMetric>)
			buildChart([] as Array<MoneyStatPoint>)
			let msg = ''
			try { msg = ('' + e).trim() } catch (e0) { msg = '' }
			if (msg.indexOf('Error:') == 0) msg = msg.substring(6).trim()
			uni.showToast({ title: msg.length > 0 ? msg : t('stats.loadFail'), icon: 'none' })
		}
		loading.value = false
	}

	function goBack() {
		uni.navigateBack({})
	}

	function onEarnings() {
		uni.navigateTo({ url: '/pages/stats/earnings' })
	}

	function setRange(key: string) {
		rangeKey.value = key
		if (key == '1d' || key == '7d') moreLabel.value = t('stats.more')
		loadStat()
	}

	function onMoreRange() {
		uni.showActionSheet({
			itemList: [t('stats.d30'), t('stats.d90')],
			success: (res) => {
				const idx = res.tapIndex
				if (idx == 0) {
					rangeKey.value = '30d'
					moreLabel.value = t('stats.d30')
					loadStat()
				} else if (idx == 1) {
					rangeKey.value = '90d'
					moreLabel.value = t('stats.d90')
					loadStat()
				}
			}
		})
	}

	function selectMetric(key: string) {
		selectedKey.value = key
	}

	onShow(() => {
		moreLabel.value = (rangeKey.value == '30d') ? t('stats.d30') : ((rangeKey.value == '90d') ? t('stats.d90') : t('stats.more'))
		metricList.value = [
			{ key: 'total', label: t('stats.total'), value: metricList.value[0].value, diff: metricList.value[0].diff, trend: metricList.value[0].trend } as MetricItem,
			{ key: 'direct', label: t('stats.direct'), value: metricList.value[1].value, diff: metricList.value[1].diff, trend: metricList.value[1].trend } as MetricItem,
			{ key: 'team', label: t('stats.team'), value: metricList.value[2].value, diff: metricList.value[2].diff, trend: metricList.value[2].trend } as MetricItem,
			{ key: 'reward', label: t('stats.reward'), value: metricList.value[3].value, diff: metricList.value[3].diff, trend: metricList.value[3].trend } as MetricItem
		] as MetricItem[]
		loadStat()
	})
</script>

<style>
	.stats-page {
		flex: 1;
		background-color: #f5f6f8;
		flex-direction: column;
	}
	/* #ifdef H5 */
	.stats-page ::-webkit-scrollbar {
		width: 0;
		height: 0;
		display: none;
	}
	.body {
		scrollbar-width: none;
		-ms-overflow-style: none;
	}
	/* #endif */
	.topbar {
		flex-direction: row;
		align-items: center;
		justify-content: space-between;
		padding: 48rpx 24rpx 20rpx;
		background-color: #ffffff;
	}
	.back-btn {
		width: 72rpx;
		height: 72rpx;
		align-items: center;
		justify-content: center;
	}
	.back-text {
		font-size: 56rpx;
		color: #181818;
		line-height: 56rpx;
	}
	.topbar-title {
		font-size: 34rpx;
		font-weight: 700;
		color: #1a1a1a;
	}
	.topbar-link {
		font-size: 28rpx;
		color: #3b82f6;
		width: 120rpx;
		text-align: right;
	}
	.body {
		flex: 1;
		height: 0;
	}
	.overview-head {
		flex-direction: row;
		align-items: flex-start;
		justify-content: space-between;
		padding: 28rpx 28rpx 8rpx;
	}
	.overview-left {
		flex-direction: column;
	}
	.overview-title {
		font-size: 36rpx;
		font-weight: 800;
		color: #111111;
		margin-bottom: 10rpx;
	}
	.overview-time {
		font-size: 22rpx;
		color: #9aa3af;
	}
	.range-row {
		flex-direction: row;
		align-items: center;
		margin-top: 4rpx;
	}
	.range-chip {
		flex-direction: row;
		align-items: center;
		padding: 8rpx 16rpx;
		background-color: #eef0f3;
		border-radius: 8rpx;
		margin-left: 10rpx;
	}
	.range-on {
		background-color: #e8f0fe;
	}
	.range-text {
		font-size: 22rpx;
		color: #6b7280;
	}
	.range-text-on {
		color: #3b82f6;
	}
	.range-caret {
		font-size: 18rpx;
		color: #6b7280;
		margin-left: 2rpx;
	}
	.state-row {
		padding: 12rpx 28rpx;
	}
	.state-text {
		font-size: 24rpx;
		color: #9aa3af;
	}
	.card-grid {
		flex-direction: row;
		flex-wrap: wrap;
		padding: 16rpx 20rpx 8rpx;
		justify-content: space-between;
	}
	.metric-card {
		width: 48.5%;
		background-color: #ffffff;
		border-radius: 16rpx;
		padding: 24rpx 20rpx;
		margin-bottom: 16rpx;
		border-width: 2rpx;
		border-style: solid;
		border-color: transparent;
	}
	.metric-on {
		border-color: #3b82f6;
		background-color: #f5f9ff;
	}
	.metric-label {
		font-size: 24rpx;
		color: #6b7280;
		margin-bottom: 12rpx;
	}
	.metric-value {
		font-size: 40rpx;
		font-weight: 700;
		color: #111827;
		margin-bottom: 10rpx;
	}
	.metric-diff {
		flex-direction: row;
		align-items: center;
	}
	.diff-prefix {
		font-size: 20rpx;
		color: #9ca3af;
	}
	.diff-up {
		font-size: 20rpx;
		color: #ef4444;
	}
	.diff-down {
		font-size: 20rpx;
		color: #22c55e;
	}
	.diff-flat {
		font-size: 20rpx;
		color: #9ca3af;
	}
	.chart-card {
		margin: 8rpx 20rpx 0;
		background-color: #ffffff;
		border-radius: 16rpx;
		padding: 24rpx 16rpx 20rpx;
	}
	.chart-area {
		flex-direction: row;
		height: 320rpx;
	}
	.y-axis {
		width: 72rpx;
		justify-content: space-between;
		padding-bottom: 8rpx;
	}
	.y-label {
		font-size: 18rpx;
		color: #9ca3af;
		text-align: right;
	}
	.plot {
		flex: 1;
		position: relative;
		margin-left: 8rpx;
	}
	.grid-h {
		position: absolute;
		left: 0;
		right: 0;
		height: 1rpx;
		background-color: #eef0f3;
	}
	.grid-h0 { top: 0; }
	.grid-h1 { top: 25%; }
	.grid-h2 { top: 50%; }
	.grid-h3 { top: 75%; }
	.grid-h4 { bottom: 0; }
	.grid-v {
		position: absolute;
		top: 0;
		bottom: 0;
		width: 1rpx;
		background-color: #eef0f3;
	}
	.grid-v0 { left: 0; }
	.grid-v1 { left: 33%; }
	.grid-v2 { left: 66%; }
	.grid-v3 { right: 0; }
	.line-seg {
		position: absolute;
		height: 3rpx;
		background-color: #3b82f6;
		transform-origin: 0 50%;
	}
	.chart-dot {
		position: absolute;
		width: 12rpx;
		height: 12rpx;
		margin-left: -6rpx;
		margin-top: -6rpx;
		border-radius: 6rpx;
		background-color: #3b82f6;
	}
	.x-axis {
		flex-direction: row;
		justify-content: space-between;
		padding-left: 80rpx;
		margin-top: 12rpx;
	}
	.x-label {
		font-size: 18rpx;
		color: #9ca3af;
	}
	.scroll-pad {
		height: 40rpx;
	}
	.status-bar-holder {
		height: var(--status-bar-height);
		background-color: #ffffff;
	}
</style>
