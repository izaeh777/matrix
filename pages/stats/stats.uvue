<template>
	<view class="stats-page">
		<!-- #ifdef APP -->
		<view class="status-bar-holder"></view>
		<!-- #endif -->
		<view class="topbar">
			<view class="back-btn" @click="goBack">
				<text class="back-text">‹</text>
			</view>
			<text class="topbar-title">{{ t('stats.title') }}</text>
			<text class="topbar-link" @click="onEarnings">{{ t('stats.earnings') }}</text>
		</view>

		<scroll-view class="body" direction="vertical" :show-scrollbar="false" :rebound="false">
			<view class="overview-head">
				<view class="overview-left">
					<text class="overview-title">{{ t('stats.overview') }}</text>
					<text class="overview-time">{{ t('stats.updated') }}{{ updateTime }}</text>
				</view>
				<view class="range-row">
					<view
						class="range-chip"
						:class="rangeKey == '1d' ? 'range-on' : ''"
						@click="setRange('1d')"
					>
						<text class="range-text" :class="rangeKey == '1d' ? 'range-text-on' : ''">{{ t('stats.d1') }}</text>
					</view>
					<view
						class="range-chip"
						:class="rangeKey == '7d' ? 'range-on' : ''"
						@click="setRange('7d')"
					>
						<text class="range-text" :class="rangeKey == '7d' ? 'range-text-on' : ''">{{ t('stats.d7') }}</text>
					</view>
					<view class="range-chip" @click="onMoreRange">
						<text class="range-text">{{ t('stats.more') }}</text>
						<text class="range-caret">▾</text>
					</view>
				</view>
			</view>

			<view class="card-grid">
				<view
					v-for="item in metricList"
					:key="item.key"
					class="metric-card"
					:class="selectedKey == item.key ? 'metric-on' : ''"
					@click="selectMetric(item.key)"
				>
					<text class="metric-label">{{ item.label }}</text>
					<text class="metric-value">{{ item.value }}</text>
					<view class="metric-diff">
						<text class="diff-prefix">{{ t('stats.diffPrev') }}</text>
						<text
							v-if="item.trend == 'up'"
							class="diff-up"
						>↑ {{ item.diff }}</text>
						<text
							v-else-if="item.trend == 'down'"
							class="diff-down"
						>↓ {{ item.diff }}</text>
						<text v-else class="diff-flat">-</text>
					</view>
				</view>
			</view>

			<view class="chart-card">
				<view class="chart-area">
					<view class="y-axis">
						<text class="y-label">1</text>
						<text class="y-label">0.75</text>
						<text class="y-label">0.5</text>
						<text class="y-label">0.25</text>
						<text class="y-label">0</text>
					</view>
					<view class="plot">
						<view class="grid-h grid-h0"></view>
						<view class="grid-h grid-h1"></view>
						<view class="grid-h grid-h2"></view>
						<view class="grid-h grid-h3"></view>
						<view class="grid-h grid-h4"></view>
						<view class="grid-v grid-v0"></view>
						<view class="grid-v grid-v1"></view>
						<view class="grid-v grid-v2"></view>
						<view class="grid-v grid-v3"></view>

						<view
							v-for="(seg, si) in lineSegs"
							:key="'seg-' + si"
							class="line-seg"
							:style="'left:' + seg.left + '%;top:' + seg.top + '%;width:' + seg.width + '%;transform:rotate(' + seg.deg + 'deg);'"
						></view>
						<view
							v-for="(pt, pi) in chartPoints"
							:key="'pt-' + pi"
							class="chart-dot"
							:style="'left:' + pt.x + '%;top:' + pt.y + '%;'"
						></view>
					</view>
				</view>
				<view class="x-axis">
					<text
						v-for="(lab, li) in xLabels"
						:key="'x-' + li"
						class="x-label"
					>{{ lab }}</text>
				</view>
			</view>

			<view class="scroll-pad"></view>
		</scroll-view>
	</view>
</template>

<script setup lang="uts">
	import { ref } from 'vue'
	import { t as __i18nT } from '@/common/i18n.uts'
	function t(key: string): string {
		return __i18nT(key)
	}




	type MetricItem = {
		key: string
		label: string
		value: string
		diff: string
		trend: string
	}

	type ChartPt = {
		x: number
		y: number
	}

	type LineSeg = {
		left: number
		top: number
		width: number
		deg: number
	}

	const rangeKey = ref('1d')
	const selectedKey = ref('total')
	const updateTime = ref('2026.05.26 12:00')

	const metricList = ref([
		{ key: 'total', label: t('stats.total'), value: '2,569.40', diff: '100.00%', trend: 'down' } as MetricItem,
		{ key: 'direct', label: t('stats.direct'), value: '8600.00', diff: '100.00%', trend: 'up' } as MetricItem,
		{ key: 'team', label: t('stats.team'), value: '0', diff: '', trend: 'flat' } as MetricItem,
		{ key: 'reward', label: t('stats.reward'), value: '0', diff: '', trend: 'flat' } as MetricItem,
		{ key: 'refund_n', label: t('stats.refundN'), value: '0', diff: '', trend: 'flat' } as MetricItem,
		{ key: 'refund_m', label: t('stats.refundM'), value: '0', diff: '', trend: 'flat' } as MetricItem
	] as MetricItem[])

	const xLabels = ref(['20260519', '20260521', '20260523', '20260526'] as string[])

	// 与效果图一致：前期为 0，末期冲高后回落（坐标已预计算线段）
	const chartPoints = ref([
		{ x: 0, y: 100 } as ChartPt,
		{ x: 14, y: 100 } as ChartPt,
		{ x: 28, y: 100 } as ChartPt,
		{ x: 42, y: 100 } as ChartPt,
		{ x: 56, y: 100 } as ChartPt,
		{ x: 68, y: 88 } as ChartPt,
		{ x: 78, y: 8 } as ChartPt,
		{ x: 88, y: 42 } as ChartPt,
		{ x: 100, y: 78 } as ChartPt
	] as ChartPt[])

	const lineSegs = ref([
		{ left: 0, top: 100, width: 14, deg: 0 } as LineSeg,
		{ left: 14, top: 100, width: 14, deg: 0 } as LineSeg,
		{ left: 28, top: 100, width: 14, deg: 0 } as LineSeg,
		{ left: 42, top: 100, width: 14, deg: 0 } as LineSeg,
		{ left: 56, top: 100, width: 16.97, deg: -45 } as LineSeg,
		{ left: 68, top: 88, width: 85.4, deg: -82.9 } as LineSeg,
		{ left: 78, top: 8, width: 35.4, deg: 73.6 } as LineSeg,
		{ left: 88, top: 42, width: 37.9, deg: 71.6 } as LineSeg
	] as LineSeg[])

	function goBack() {
		uni.navigateBack({})
	}

	function onEarnings() {
		uni.showToast({ title: t('stats.earnSoon'), icon: 'none' })
	}

	function setRange(key: string) {
		rangeKey.value = key
	}

	function onMoreRange() {
		uni.showActionSheet({
			itemList: ['近30天', '近90天', '自定义'],
			success: (_res) => {
				uni.showToast({ title: t('stats.filterSoon'), icon: 'none' })
			}
		})
	}

	function selectMetric(key: string) {
		selectedKey.value = key
	}
</script>

<style>
	.stats-page {
		flex: 1;
		background-color: #f5f6f8;
		flex-direction: column;
	}
	/* #ifdef H5 */
	.stats-page ::-webkit-scrollbar {
		width: 0;
		height: 0;
		display: none;
	}
	.body {
		scrollbar-width: none;
		-ms-overflow-style: none;
	}
	/* #endif */
	.topbar {
		flex-direction: row;
		align-items: center;
		justify-content: space-between;
		padding: 48rpx 24rpx 20rpx;
		background-color: #ffffff;
	}
	.back-btn {
		width: 72rpx;
		height: 72rpx;
