<template>
	<view class="chat-page">
		<!-- 顶部标题栏 -->
		<view class="topbar">
			<view class="back-btn" @click="goBack">
				<text class="back-text">‹</text>
			</view>
			<view class="topbar-center">
				<text class="topbar-title">{{ roomTitleBar }}</text>
			</view>
			<view class="topbar-right" @click="showRoomInfo">
				<text class="topbar-more">···</text>
			</view>
		</view>

			<view v-if="roomEncrypted" class="encrypt-banner">
				<text class="encrypt-banner-text">此对话已加密，对方消息需解密后才能完整显示</text>
			</view>
		<scroll-view
			class="messages"
			scroll-y
			:scroll-into-view="scrollInto"
			:scroll-top="scrollTop"
			:scroll-with-animation="false"
			@scrolltoupper="onScrollToUpper"
		>
			<view v-if="loadingHistory" class="loading-history">
				<text>加载历史消息…</text>
			</view>

			<view v-if="!loadingHistory && messages.length == 0" class="empty-chat">
				<text class="empty-chat-text">还没有消息，发个招呼吧 👋</text>
			</view>

			<view
				v-for="msg in messages"
				:key="msg.event_id"
				class="msg-row"
				:class="[msg.sender == currentUserId ? 'msg-row-me' : 'msg-row-other', msg._highlight ? 'msg-highlight' : '']"
				@longpress="onLongPress(msg)"
			>
				<view v-if="msg.sender != currentUserId" class="msg-avatar">
					<text class="avatar-letter">{{ senderInitial(msg.sender) }}</text>
				</view>
				<view class="msg-main">
				<view class="msg-bubble" :class="{ 'msg-bubble-img': msg.msgtype == 'm.image' }">
					<text v-if="msg.sender != currentUserId && msg.msgtype != 'm.image'" class="msg-sender">{{ senderName(msg.sender) }}</text>

					<view v-if="msg.msgtype == 'm.encrypted'" class="msg-content">
						<text class="msg-text msg-encrypted">{{ msg.body }}</text>
					</view>
					<view v-else-if="isTextMsg(msg)" class="msg-content">
						<text class="msg-text">{{ msg.body }}</text>
						<text v-if="msg.edited" class="msg-edited">已编辑</text>
					</view>

					<!-- 图片 -->
					<view v-else-if="msg.msgtype == 'm.image'" class="msg-image msg-image-uniform" @click="previewImage(msg)">
						<image
							class="msg-img"
							:src="msg._src"
							mode="widthFix"
						></image>
					</view>

					<!-- 文件 -->
					<view v-else-if="msg.msgtype == 'm.file'" class="msg-file" @click="downloadFile(msg)">
						<text class="file-icon">📎</text>
						<view class="file-info">
							<text class="file-name">{{ msg.body }}</text>
							<text class="file-size">{{ fileSizeText(msg) }}</text>
						</view>
					</view>

					<!-- 音频 -->
					<view v-else-if="msg.msgtype == 'm.audio'" class="msg-audio" :style="{ width: audioBubbleWidth(msg) }" @click="playAudio(msg)">
						<text class="audio-icon">{{ playingAudioId == msg.event_id ? '⏸' : '▶' }}</text>
						<text class="audio-label">语音</text>
						<text class="audio-dur">{{ audioSeconds(msg) }}″</text>
					</view>

					<!-- 位置 -->
					<view v-else-if="msg.msgtype == 'm.location'" class="msg-location">
						<text class="loc-icon">📍</text>
						<text class="loc-text">{{ msg.body }}</text>
					</view>

					<!-- 已撤回 -->
					<view v-else-if="msg.redacted" class="msg-content">
						<text class="msg-redacted">消息已撤回</text>
					</view>

					<view v-if="msg.msgtype != 'm.text' && msg.msgtype != 'm.notice' && msg.msgtype != 'm.emote' && msg.msgtype != 'm.image' && msg.msgtype != 'm.audio' && msg.msgtype != 'm.location' && msg.msgtype != 'm.file' && msg.msgtype != 'm.encrypted' && msg.type != 'm.room.calling'" class="msg-content">
						<text class="msg-text">{{ msg.body }}</text>
					</view>
					<view v-else-if="msg.type == 'm.room.calling'" class="msg-call">
						<text class="msg-call-icon">📹</text>
						<text class="msg-call-text">视频通话邀请</text>
					</view>

					<!-- 已读/未读标记 -->
					<text v-if="msg.sender == currentUserId" class="msg-read">{{ msg.read_by_other ? '已读' : '已发送' }}</text>
					<text v-if="msg._failed" class="msg-read msg-failed">发送失败</text>
				</view>
				<view v-if="hasReactions(msg)" class="msg-reactions">
					<text v-for="pill in reactionPills(msg)" :key="pill" class="reaction-pill">{{ pill }}</text>
				</view>
				</view>
				<view v-if="msg.sender == currentUserId" class="msg-avatar msg-avatar-me">
					<image v-if="myAvatarSrc.length > 0" class="msg-avatar-img" :src="myAvatarSrc" mode="aspectFill"></image>
					<text v-else class="avatar-letter">{{ myInitial }}</text>
				</view>
			</view>
			<view id="chat-bottom" class="chat-bottom-anchor"></view>
		</scroll-view>

		<!-- 输入栏 -->
		<view class="input-bar">
			<view class="input-tool" @click="toggleVoiceMode">
				<text class="input-tool-text">{{ voiceMode ? '⌨' : '🎙' }}</text>
			</view>
			<view
				v-if="voiceMode && inputText.trim().length == 0"
				class="voice-hold"
				@touchstart="onVoiceTouchStart"
				@touchmove="onVoiceTouchMove"
				@touchend="onVoiceTouchEnd"
				@touchcancel="onVoiceTouchCancel"
			>
				<text class="voice-hold-text">{{ isRecording ? voiceStatusText : '按住 说话' }}</text>
			</view>
			<view v-else class="input-field-wrap">
				<input
					class="msg-input"
					v-model="inputText"
					placeholder=""
					placeholder-class="input-placeholder"
					confirm-type="send"
					@input="onInputChange"
					@focus="onInputFocus"
					@blur="onInputBlur"
					@confirm="onSend"
				/>
			</view>
			<text class="input-tool-text" @click="toggleEmojiPanel">😊</text>
			<text v-if="inputText.trim().length == 0" class="input-tool-text plus-btn" @click="toggleMorePanel">＋</text>
			<view v-else class="btn-send" @click="onSend">
				<text class="btn-send-text">发送</text>
			</view>
		</view>

		<!-- 底部更多功能面板 -->
		<view v-if="showMorePanel" class="more-panel">
			<view class="more-grid">
				<view class="more-item" @click="onPickImage">
					<view class="more-icon-bg">
						<text class="more-icon-text">📷</text>
					</view>
					<text class="more-label">图片</text>
				</view>
				<view class="more-item" @click="onPickFile">
					<view class="more-icon-bg">
						<text class="more-icon-text">📎</text>
					</view>
					<text class="more-label">文件</text>
				</view>
				<view class="more-item" @click.stop="startCallVoice">
					<view class="more-icon-bg">
						<text class="more-icon-text">☎</text>
					</view>
					<text class="more-label">语音通话</text>
				</view>
				<view class="more-item" @click.stop="startCallVideo">
					<view class="more-icon-bg">
						<text class="more-icon-text">📹</text>
					</view>
					<text class="more-label">视频通话</text>
				</view>
			</view>
		</view>

		<!-- 表情包面板 -->
		<view v-if="showEmojiPanel" class="emoji-panel">
			<view class="emoji-panel-tabs">
				<view
					v-for="(icon, idx) in emojiCatIcons"
					:key="idx"
					class="emoji-tab"
					:class="idx == activeEmojiCat ? 'emoji-tab-active' : ''"
					@click="setEmojiCat(idx)"
				>
					<text class="emoji-tab-text">{{ icon }}</text>
				</view>
			</view>
			<scroll-view class="emoji-grid-scroll" scroll-y>
				<view class="emoji-grid">
					<view
						v-for="(e, i) in activeEmojiList"
						:key="i"
						class="emoji-cell"
						@click="insertEmoji(e)"
					>
						<view class="emoji-cell-bg">
							<text class="emoji-cell-text">{{ e }}</text>
						</view>
					</view>
				</view>
			</scroll-view>
		</view>

		<!-- 语音录制面板 -->
		<!-- 按住说话时的浮层 -->
		<view v-if="isRecording || voiceCancelHint" class="voice-floating">
			<view class="voice-floating-bg" @click.stop="noop"></view>
			<view class="voice-floating-content">
				<view class="voice-floating-tip">
					<text class="voice-floating-tip-text">{{ voiceFloatingTip }}</text>
				</view>
				<view class="voice-floating-mic">
					<text class="voice-floating-mic-icon">🎙</text>
				</view>
				<view class="voice-floating-time">
					<text class="voice-floating-time-text">{{ recordDuration }}s</text>
				</view>
				<view class="voice-floating-sub">
					<text class="voice-floating-sub-text">
						{{ voiceCancelHint ? '松开手指，取消发送' : '上滑取消，松开发送' }}
					</text>
				</view>
			</view>
		</view>

		<view v-if="showAudioRecorder" class="audio-panel">
			<view class="audio-panel-bg" @click="closeAudioRecorder"></view>
			<view class="audio-panel-content">
				<view class="audio-record-tip">
					<text v-if="recordingState == 'idle'" class="audio-tip-text">点击开始录音</text>
					<text v-else-if="recordingState == 'recording'" class="audio-tip-text recording">录音中… {{ recordDuration }}s</text>
					<text v-else-if="recordingState == 'recorded'" class="audio-tip-text">录音完成 ({{ recordDuration }}s)</text>
				</view>
				<view class="audio-record-actions">
					<view v-if="recordingState == 'idle'" class="audio-btn audio-btn-start" @click="startRecord">
						<text class="audio-btn-text">🎙 开始</text>
					</view>
					<view v-else-if="recordingState == 'recording'" class="audio-btn audio-btn-stop" @click="stopRecord">
						<text class="audio-btn-text">⏹ 停止</text>
					</view>
					<view v-if="recordingState == 'recorded'" class="audio-btn audio-btn-cancel" @click="cancelRecord">
						<text class="audio-btn-text">✕ 取消</text>
					</view>
					<view v-if="recordingState == 'recorded'" class="audio-btn audio-btn-send" @click="sendAudioMsg">
						<text class="audio-btn-text">✓ 发送</text>
					</view>
				</view>
			</view>
		</view>

		<!-- 操作面板（长按弹出） -->
		<view v-if="actionSheet.show" class="action-sheet" @click="hideActionSheet">
			<view class="action-panel" @click.stop="noop">
				<text v-if="actionSheet.replyTo == null" class="action-title">对消息操作</text>
				<text v-if="actionSheet.replyTo != null" class="action-title">回复: {{ actionSheet.replyTo.body }}</text>
				<view v-if="!actionSheet.mine" class="action-item" @click="doAction('react', '👍')">
					<text>👍 表情回应</text>
				</view>
				<view v-if="!actionSheet.mine" class="action-item" @click="doAction('react', '❤️')">
					<text>❤️ 表情回应</text>
				</view>
				<view class="action-item" @click="doAction('reply', '')">
					<text>↩ 回复</text>
				</view>
				<view v-if="actionSheet.mine" class="action-item" @click="doAction('edit', '')">
					<text>✏ 编辑</text>
				</view>
				<view v-if="actionSheet.mine" class="action-item" @click="doAction('redact', '')">
					<text>🗑 撤回</text>
				</view>
				<view class="action-cancel" @click="hideActionSheet">
					<text>取消</text>
				</view>
			</view>
		</view>
	</view>
</template>

<script setup lang="uts">
	import { ref, onUnmounted, onMounted, computed, nextTick } from 'vue'
	import { getMatrix, MatrixClient, MatrixMessage, MatrixEvent, errText } from '@/common/matrix.uts'
	import { getCallManager } from '@/common/call.uts'

	type ChatMsg = {
		event_id: string
		sender: string
		type: string
		body: string
		msgtype: string
		ts: number
		url: string
		mxc: string
		edited: boolean
		redacted: boolean
		read_by_other: boolean
		_highlight: boolean
		_failed: boolean
		_pending: boolean
		_src: string
		_blobUrl: string
		info: UTSJSONObject
		reactions: UTSJSONObject
	}
	type EmojiCat = {
		icon: string
		list: Array<string>
	}

	type ReplyTarget = {
		event_id: string
		sender: string
		body: string
	}
	function emptyChatMsg(): ChatMsg {
		return {
			event_id: '',
			sender: '',
			type: 'm.room.message',
			body: '',
			msgtype: 'm.text',
			ts: 0,
			url: '',
			mxc: '',
			edited: false,
			redacted: false,
			read_by_other: false,
			_highlight: false,
			_failed: false,
			_pending: false,
			_src: '',
			_blobUrl: '',
			info: {} as UTSJSONObject,
			reactions: {} as UTSJSONObject
		}
	}
	function fromMatrixMessage(m: MatrixMessage): ChatMsg {
		const msg = emptyChatMsg()
		msg.event_id = m.event_id
		msg.sender = m.sender
		msg.type = m.type
		msg.body = m.body
		msg.ts = m.ts
		if (m.msgtype != null) msg.msgtype = m.msgtype
		if (m.url != null) msg.url = m.url
		if (m.mxc != null) msg.mxc = m.mxc
		if (m.info != null) msg.info = m.info
		return msg
	}
	type ActionSheetState = {
		show: boolean
		mine: boolean
		target: ChatMsg | null
		replyTo: ReplyTarget | null
	}

	const roomId = ref<string>('')
	const highlightEventId = ref<string>('')
	const roomName = ref<string>('房间')
	const roomTitleBar = computed((): string => {
		const n = roomName.value
		if (n.length > 0) return n
		return '聊天'
	})
	const roomTopic = ref<string>('')
	const roomEncrypted = ref<boolean>(false)
	const messages = ref<Array<ChatMsg>>([])
	const inputText = ref<string>('')
	const sending = ref<boolean>(false)
	const loadingHistory = ref<boolean>(false)
	const scrollTop = ref<number>(999999)
	const scrollInto = ref<string>('')
	const currentUserId = ref<string>('')
	const myInitial = ref<string>('我')
	const myAvatarSrc = ref<string>('')
	const senderMap = ref<UTSJSONObject>({})
	const typingUsers = ref<Array<string>>([])
	const replyTo = ref<ReplyTarget | null>(null)
	const actionSheet = ref<ActionSheetState>({
		show: false,
		target: null,
		mine: false,
		replyTo: null
	})
	let prevBatch: string = ''
	let typingTimer: number | null = null
	let unloadHandler: (() => void) | null = null
	let offTyping: (() => void) | null = null
	let offReaction: (() => void) | null = null
	let offRedaction: (() => void) | null = null
	let offUnread: (() => void) | null = null
	let offTimeline: (() => void) | null = null
	function stopOff(handler: (() => void) | null): void {
		if (handler == null) return
		try { handler() } catch (e) {}
	}
	// 缓存 matrix 引用，避免每次 import
	let matrixRef: MatrixClient | null = null
	async function getMatrix2(): Promise<MatrixClient | null> {
		if (matrixRef != null) return matrixRef
		matrixRef = getMatrix()
		return matrixRef
	}

	// ===== 表情包 =====
	const showEmojiPanel = ref<boolean>(false)
	const showMorePanel = ref<boolean>(false)
	const inputFocused = ref<boolean>(false)
	const voiceMode = ref<boolean>(false)
	const activeEmojiCat = ref<number>(0)
	const emojiCategories = ref<Array<EmojiCat>>([
		{ icon: '😀', list: ['😀','😁','😂','🤣','😃','😄','😅','😆','😉','😊','😋','😎','😍','😘','🥰','😗','😙','😚','🙂','🤗','🤩','🤔','🤨','😐','😑','😶','🙄','😏','😣','😥','😮','🤐','😯','😪','😫','🥱','😴','😌','😛','😜','😝','🤤','😒','😓','😔','😕','🙃','🤑','😲','☹️','🙁','😖','😞','😟','😤','😢','😭','😦','😧','😨','😩','🤯','😬','😰','😱','🥵','🥶','😳','🤪','😵','🥴','😠','😡','🤬','😷','🤒','🤕','🤢','🤮','🥳','🥺','🤠','🤥'] },
		{ icon: '❤️', list: ['❤️','🧡','💛','💚','💙','💜','🖤','🤍','🤎','💔','❣️','💕','💞','💓','💗','💖','💘','💝','💟','♥️','💌','💋','👄','🫀','🫁'] },
		{ icon: '👍', list: ['👍','👎','👌','✌️','🤞','🤟','🤘','🤙','👈','👉','👆','🖕','👇','☝️','👋','🤚','🖐','✋','🖖','👏','🙌','🤝','🙏','✍️','💅','🤳','💪','🦾','🦿','🦵','🦶','👂','🦻','👃','🧠','🦷','🦴','👀','👁','👅'] },
		{ icon: '🐶', list: ['🐶','🐱','🐭','🐹','🐰','🦊','🐻','🐼','🐨','🐯','🦁','🐮','🐷','🐽','🐸','🐵','🙈','🙉','🙊','🐒','🐔','🐧','🐦','🐤','🐣','🐥','🦆','🦅','🦉','🦇','🐺','🐗','🐴','🦄','🐝','🐛','🦋','🐌','🐞','🐜','🪰','🪲','🐢','🐍','🦎','🦖','🦕','🐙','🦑','🦐','🦞','🦀','🐡','🐠','🐟','🐬','🐳','🐋','🦈'] },
		{ icon: '🍎', list: ['🍎','🍐','🍊','🍋','🍌','🍉','🍇','🍓','🫐','🍈','🍒','🍑','🥭','🍍','🥥','🥝','🍅','🍆','🥑','🥦','🥬','🥒','🌶','🫑','🌽','🥕','🫒','🧄','🧅','🥔','🍠','🥐','🥯','🍞','🥖','🥨','🧀','🥚','🍳','🧈','🥞','🧇','🥓','🥩','🍗','🍖','🦴','🌭','🍔','🍟','🍕','🥪','🥙','🧆','🌮','🌯','🫔','🥗','🥘','🫕','🥫','🍝','🍜','🍲','🍛','🍣','🍱','🥟','🦪','🍤','🍙','🍚','🍘','🍥','🥠','🥮','🍢','🥡','🍦','🍧','🍨','🍩','🍪'] }
	])

	// ===== 语音录制 =====
	const showAudioRecorder = ref<boolean>(false)
	const recordingState = ref<string>('idle')
	const recordDuration = ref<number>(0)
	// 按住说话相关状态
	const isRecording = ref<boolean>(false)
	const voiceCancelHint = ref<boolean>(false) // 上滑超过阈值时为 true，松手取消
	let recordTimer: number | null = null
	let recordStartTs: number = 0
	let recordStartX: number = 0
	let recordStartY: number = 0
	const VOICE_CANCEL_THRESHOLD: number = 80 // 上滑超过 80px 视为取消
	let recordTempPath: string = ''
	let recordMediaRecorder: any | null = null
	let recordChunks: Array<UTSJSONObject> = []
	let recordStream: any | null = null
	let recordLastMime: string = 'audio/webm'
	let wavCtx: any | null = null
	let wavProcessor: any | null = null
	let wavBuffers: Array<any> = []
	let wavSampleRate: number = 0

	function clearRecordTimer(): void {
		const t = recordTimer
		recordTimer = null
		if (t != null) {
			clearInterval(t)
		}
	}
	function clearTypingTimer(): void {
		const t = typingTimer
		typingTimer = null
		if (t != null) {
			clearTimeout(t)
		}
	}
	function bindTimeout(fn: () => void, ms: number): number | null {
		return setTimeout(fn, ms) as number | null
	}
	function bindInterval(fn: () => void, ms: number): number | null {
		return setInterval(fn, ms) as number | null
	}

	const voiceFloatingTip = computed<string>(() => {
		if (voiceCancelHint.value) return '松开取消'
		if (isRecording.value) return '正在录音…'
		return ''
	})
	const voiceStatusText = computed<string>(() => {
		if (voiceCancelHint.value) return '松开 取消'
		return `${recordDuration.value}s`
	})

	function noop(): void {}
	function toggleMorePanel(): void {
		showMorePanel.value = !showMorePanel.value
		if (showMorePanel.value) showEmojiPanel.value = false
	}
	const activeEmojiList = computed<Array<string>>(() => {
		const cats = emojiCategories.value
		const idx = activeEmojiCat.value
		if (idx < 0 || idx >= cats.length) {
			return [] as Array<string>
		}
		const cat = cats[idx]
		if (cat == null) {
			return [] as Array<string>
		}
		return cat.list
	})
	const emojiCatIcons = computed<Array<string>>(() => {
		const out: Array<string> = []
		const cats = emojiCategories.value
		let i = 0
		while (i < cats.length) {
			const c = cats[i]
			if (c != null) {
				out.push(c.icon)
			}
			i++
		}
		return out
	})
	function setEmojiCat(idx: number): void {
		activeEmojiCat.value = idx
	}
	function closeAudioRecorder(): void {
		showAudioRecorder.value = false
	}
	function hideActionSheet(): void {
		actionSheet.value.show = false
	}
	function formatSize(bytes: number): string {
		if (bytes == 0) return ''
		if (bytes < 1024) return bytes + ' B'
		if (bytes < 1024 * 1024) return (bytes / 1024).toFixed(1) + ' KB'
		return (bytes / 1024 / 1024).toFixed(1) + ' MB'
	}
	function senderInitial(sender: string): string {
		const local = sender.split(':')[0].replace('@', '')
		return local.length > 0 ? local.substring(0, 1).toUpperCase() : '?'
	}
	function formatTime(ts: number): string {
		if (ts == 0) return ''
		const d = new Date(ts)
		const pad = (n: number): string => n < 10 ? '0' + n : '' + n
		return `${pad(d.getHours())}:${pad(d.getMinutes())}`
	}
	function safeDecode(raw: string): string {
		const d = decodeURIComponent(raw)
		if (d == null || d.length == 0) return raw
		return d
	}

	function storageStr(key: string): string {
		const raw = uni.getStorageSync(key)
		if (raw == null) return ''
		const s = '' + raw
		if (s.length == 0) return ''
		if (s == 'null') return ''
		if (s == 'undefined') return ''
		return s
	}
	function getMxcUrl(mxc: string, w: number, h: number): string {
		const matrix = matrixRef
		if (matrix == null || mxc.length == 0) return ''
		let url = matrix.mxcToHttp(mxc, w, h)
		if (url.length == 0) return ''
		const token = matrix.accessToken
		if (token.length > 0 && url.indexOf('access_token=') < 0) {
			url = url + (url.indexOf('?') >= 0 ? '&' : '?') + 'access_token=' + encodeURIComponent(token)
		}
		return url
	}
	function scrollToBottom() {
		scrollInto.value = ''
		nextTick(() => {
			scrollInto.value = 'chat-bottom'
			scrollTop.value = Date.now() % 100000 + 999000
			// #ifdef H5
			try {
				const doc = (window as any).document
				if (doc != null) {
					const roots = doc.querySelectorAll('.messages')
					for (let i = 0; i < roots.length; i++) {
						const root = roots[i]
						const inner = root.querySelector('.uni-scroll-view')
						const target = inner != null ? inner : root
						target.scrollTop = target.scrollHeight
					}
					const anchor = doc.getElementById('chat-bottom')
					if (anchor != null && typeof anchor.scrollIntoView == 'function') {
						anchor.scrollIntoView({ block: 'end' })
					}
				}
			} catch (e) {}
			// #endif
		})
	}
	function buildMessage(eventId: string, sender: string, type: string, content: UTSJSONObject, ts: number): ChatMsg {
		const mxc = content.getString('url')
		const mxc2 = (mxc != null) ? mxc : ''
		let msgtypeRaw = content.getString('msgtype')
		let msgtype = (msgtypeRaw != null && msgtypeRaw.length > 0) ? msgtypeRaw : 'm.text'
		let bodyRaw = content.getString('body')
		let body = (bodyRaw != null) ? bodyRaw : ''
		if (type == 'm.room.encrypted') {
			msgtype = 'm.encrypted'
			body = '加密消息，当前版本无法解密'
		}
		const msg = emptyChatMsg()
		msg.event_id = eventId
		msg.sender = sender
		msg.type = type
		msg.body = body
		msg.msgtype = msgtype
		msg.mxc = mxc2
		msg.url = mxc2
		msg.ts = ts
		const info = content.getJSON('info')
		if (info != null) msg.info = info
		if (msgtype == 'm.image' && mxc2.length > 0) {
			msg._src = getMxcUrl(mxc2, 800, 800)
		}
		return msg
	}
	function msgDomId(msg: ChatMsg): string {
		return 'msg-' + msg.event_id
	}
	function isTextMsg(msg: ChatMsg): boolean {
		const t = msg.msgtype
		if (t == 'm.text') return true
		if (t == 'm.notice') return true
		if (t == 'm.emote') return true
		if (t.length == 0) return true
		return false
	}
	function isOtherMsg(msg: ChatMsg): boolean {
		const t = msg.msgtype
		if (t == 'm.text' || t.length == 0 || t == 'm.image' || t == 'm.audio' || t == 'm.location' || t == 'm.file') return false
		if (msg.type == 'm.room.calling') return false
		return true
	}
	function fileSizeText(msg: ChatMsg): string {
		const info = msg.info
		const size = info['size'] as number
		if (size == 0) return ''
		return formatSize(size)
	}
	function reactionPills(msg: ChatMsg): Array<string> {
		const out: Array<string> = []
		try {
			const r = msg.reactions
			const m = r.toMap()
			m.forEach((v: any | null, k: string) => {
				let n = 0
				if (v != null) {
					const users = v as Array<string>
					n = users.length
				}
				out.push(k + ' ' + n.toString())
			})
		} catch (e) {}
		return out
	}
	function hasReactions(msg: ChatMsg): boolean {
		return reactionPills(msg).length > 0
	}
	async function cancelVoiceRecord() {
		clearRecordTimer()
		// #ifdef H5
		try {
			if (recordMediaRecorder != null && recordMediaRecorder.state != 'inactive') {
				recordMediaRecorder.stop()
			}
		} catch (err) {}
		try {
			if (recordStream != null) {
				const tracks = recordStream.getTracks()
				for (let i = 0; i < tracks.length; i++) {
					try { tracks[i].stop() } catch (e) {}
				}
			}
		} catch (err) {}
		try {
			if (wavProcessor != null) {
				try { wavProcessor.disconnect() } catch (e) {}
				wavProcessor.onaudioprocess = null
				wavProcessor = null
			}
			if (wavCtx != null) {
				try { wavCtx.close() } catch (e) {}
				wavCtx = null
			}
		} catch (err) {}
		// #endif
		recordMediaRecorder = null
		recordStream = null
		recordingState.value = 'idle'
		recordDuration.value = 0
		recordTempPath = ''
	}
	function beginAppRecorder(): void {
		// #ifndef H5
		const rec = uni.getRecorderManager()
		rec.onStop((res) => {
			try {
				const p = res.tempFilePath
				if (p != null && p.length > 0) recordTempPath = p
			} catch (e) {}
		})
		rec.onError((_err) => {
			uni.showToast({ title: '录音失败', icon: 'none' })
		})
		const opt: RecorderManagerStartOptions = {
			duration: 60000,
			sampleRate: 16000,
			numberOfChannels: 1,
			encodeBitRate: 48000,
			format: 'mp3'
		}
		rec.start(opt)
		// #endif
	}
	function startRecordApp(): void {
		// #ifndef H5
		recordTempPath = ''
		recordLastMime = 'audio/mpeg'
		// #ifdef APP-ANDROID
		try {
			const act = UTSAndroid.getUniActivity()
			if (act != null) {
				const permissionNeed: Array<string> = ['android.permission.RECORD_AUDIO']
				UTSAndroid.requestSystemPermission(act, permissionNeed, (_ok: boolean, _list: Array<string>) => {
					beginAppRecorder()
				}, (_again: boolean, _denied: Array<string>) => {
					beginAppRecorder()
				})
				return
			}
		} catch (e) {}
		// #endif
		beginAppRecorder()
		// #endif
	}
	function stopRecordApp(): Promise<string> {
		return new Promise((resolve: (path: string) => void) => {
			// #ifdef H5
			resolve('')
			// #endif
			// #ifndef H5
			let done = false
			const rec = uni.getRecorderManager()
			rec.onStop((res) => {
				if (done) return
				done = true
				let p = ''
				try {
					const fp = res.tempFilePath
					if (fp != null) p = fp
				} catch (e) {}
				if (p.length > 0) recordTempPath = p
				resolve(p)
			})
			try {
				rec.stop()
			} catch (e2) {
				done = true
				resolve(recordTempPath)
				return
			}
			setTimeout(() => {
				if (done) return
				done = true
				resolve(recordTempPath)
			}, 2500)
			// #endif
		})
	}
	async function sendAudioMsg(tempPathArg: string, durArg: number) {
		const tempPath = tempPathArg
		const dur = durArg
		showAudioRecorder.value = false
		recordingState.value = 'idle'
		isRecording.value = false
		voiceCancelHint.value = false
		if (dur <= 0) return
		const mime = recordLastMime.length > 0 ? recordLastMime : 'audio/webm'
		const ext = (mime.indexOf('wav') >= 0) ? 'wav'
			: (mime.indexOf('ogg') >= 0) ? 'ogg'
			: (mime.indexOf('mpeg') >= 0 || mime.indexOf('mp3') >= 0) ? 'mp3'
			: (mime.indexOf('mp4') >= 0 || mime.indexOf('aac') >= 0) ? 'm4a'
			: 'webm'
		const filename = 'voice.' + ext
		sending.value = true
		try {
			const matrix = await getMatrix2()
			if (matrix == null) {
				sending.value = false
				return
			}
			const tempId = matrix.genTxnId()
			const audioInfo: UTSJSONObject = {}
			audioInfo['duration'] = dur
			const msgObj = emptyChatMsg()
			msgObj.event_id = tempId
			msgObj.sender = matrix.userId
			msgObj.type = 'm.room.message'
			msgObj.body = '语音'
			msgObj.msgtype = 'm.audio'
			msgObj.mxc = ''
			msgObj.info = audioInfo
			msgObj.ts = Date.now()
			msgObj._pending = true
			messages.value.push(msgObj)
			messages.value = messages.value.slice()
			scrollToBottom()
			let mxc = ''
			if (tempPath.length > 0) {
				uni.showLoading({ title: '发送中…' })
				try {
					mxc = await matrix.uploadMedia(tempPath, mime, filename)
				} catch (upErr) {
					console.warn('音频上传失败', upErr)
				}
				uni.hideLoading()
			}
			const idx0 = messages.value.findIndex(m => m.event_id == tempId)
			if (mxc.length == 0) {
				if (idx0 >= 0) {
					messages.value[idx0]._pending = false
					messages.value[idx0]._failed = true
					messages.value = messages.value.slice()
				}
				uni.showToast({ title: '语音发送失败', icon: 'none' })
				sending.value = false
				return
			}
			if (idx0 >= 0) {
				messages.value[idx0].mxc = mxc
			}
			const ev = await matrix.sendAudio(roomId.value, mxc, mime, dur)
			const idx = messages.value.findIndex(m => m.event_id == tempId)
			if (idx >= 0 && ev.event_id.length > 0) {
				messages.value[idx].event_id = ev.event_id
				messages.value[idx]._pending = false
				messages.value = messages.value.slice()
			}
		} catch (e) {
			uni.showToast({ title: errText(e, '语音发送失败'), icon: 'none' })
		}
		sending.value = false
	}
	async function stopRecordH5(): Promise<void> {
		// #ifdef H5
		if (recordMediaRecorder != null && recordMediaRecorder.state != 'inactive') {
			await new Promise<void>(function(resolve) {
				var mr = recordMediaRecorder
				var prevOnStop = mr.onstop
				mr.onstop = function(ev) {
					try {
						var realMime = (mr.mimeType != null) ? mr.mimeType : 'audio/webm'
						var blob = new Blob(recordChunks, { type: realMime })
						if (recordTempPath.indexOf('blob:') == 0) {
							try { URL.revokeObjectURL(recordTempPath) } catch (x) {}
						}
						recordTempPath = URL.createObjectURL(blob)
					} catch (e) {
						console.warn('组装 blob 失败', e)
					}
					recordingState.value = 'recorded'
					if (prevOnStop != null) { try { prevOnStop(ev) } catch (x) {} }
					resolve()
				}
				try { mr.stop() } catch (e) { resolve() }
			})
		} else if (wavProcessor != null || wavCtx != null) {
			await stopWavFallback()
		}
		try {
			if (recordStream != null) {
				var tracks = (recordStream.getTracks != null) ? recordStream.getTracks() : []
				for (var ti = 0; ti < tracks.length; ti++) {
					try { tracks[ti].stop() } catch (x) {}
				}
			}
		} catch (e) {}
		recordMediaRecorder = null
		recordStream = null
		// #endif
	}
	async function stopRecordAndSend() {
		const dur = recordDuration.value
		// #ifdef H5
		await stopRecordH5()
		// #endif
		// #ifndef H5
		const appPath = await stopRecordApp()
		if (appPath.length > 0) recordTempPath = appPath
		recordLastMime = 'audio/mpeg'
		// #endif
		const tempPath = recordTempPath
		isRecording.value = false
		recordingState.value = 'idle'
		if (dur <= 0 || tempPath.length == 0) {
			uni.showToast({ title: '录音太短', icon: 'none' })
			return
		}
		await sendAudioMsg(tempPath, dur)
	}

	function startRecord() {
		recordDuration.value = 0
		recordTempPath = ''
		// #ifdef H5
		// 微信内置浏览器：除非接入了 wx JSSDK 并配了 JSSDKConfig，否则无解。
		if (isWeixinBrowser()) {
			isRecording.value = false
			voiceCancelHint.value = false
			uni.showModal({
				title: '请用浏览器打开',
				content: '微信内置浏览器不支持 H5 录音。点击右上角 ··· 选择「在浏览器打开」即可使用语音功能。',
				showCancel: false,
				confirmText: '我知道了'
			})
			return
		}
		var hasMd = (typeof navigator != 'undefined') && (navigator.mediaDevices != null)
		if (!hasMd) {
			uni.showToast({ title: '当前环境不支持录音', icon: 'none' })
			isRecording.value = false
			return
		}
		navigator.mediaDevices.getUserMedia({ audio: true }).then(function(stream) {
			recordStream = stream
			// 1) 先尝试 MediaRecorder，挑选浏览器实际支持的 mime
			var mime = pickRecorderMime()
			var mr = null
			try {
				if (mime.length > 0) {
					mr = new MediaRecorder(stream, { mimeType: mime })
				} else {
					mr = new MediaRecorder(stream)
				}
			} catch (e) {
				console.warn('MediaRecorder 构造失败，改用 wav 降级', e && e.message ? e.message : e)
			}
			if (mr != null) {
				recordMediaRecorder = mr
				recordLastMime = (mr.mimeType != null) ? mr.mimeType : (mime.length > 0 ? mime : 'audio/webm')
				recordChunks = []
				mr.ondataavailable = function(e) { if (e.data.size > 0) recordChunks.push(e.data) }
				mr.onstop = function() {
					try {
						var realMime = (mr.mimeType != null) ? mr.mimeType : (mime.length > 0 ? mime : 'audio/webm')
						var blob = new Blob(recordChunks, { type: realMime })
						if (recordTempPath.indexOf('blob:') == 0) {
							try { URL.revokeObjectURL(recordTempPath) } catch (x) {}
						}
						recordTempPath = URL.createObjectURL(blob)
					} catch (e2) {
						console.warn('组装 blob 失败', e2)
					}
					recordingState.value = 'recorded'
				}
				try { mr.start() } catch (e3) {
					console.warn('MediaRecorder.start 失败，改用 wav 降级', e3)
					mr = null
				}
			}
			if (mr != null) {
				recordingState.value = 'recording'
				recordStartTs = Date.now()
				clearRecordTimer()
				recordTimer = bindInterval(() => {
					try {
						if (!isRecording.value) return
						recordDuration.value = Math.floor((Date.now() - recordStartTs) / 1000)
						if (recordDuration.value >= 60) {
							isRecording.value = false
							voiceCancelHint.value = false
							stopRecordAndSend()
						}
					} catch (e) {
						console.warn('recordTimer tick 异常', e)
					}
				}, 200)
				return
			}
			// 2) 降级：AudioContext 直采 pcm 拼 wav
			startWavFallback(stream)
		}).catch(function(err) {
			uni.showToast({ title: '麦克风权限被拒', icon: 'none' })
			console.warn('录音权限错误', err)
			isRecording.value = false
		})
		// #endif
		// #ifndef H5
		startRecordApp()
		recordingState.value = 'recording'
		recordStartTs = Date.now()
		recordDuration.value = 0
		clearRecordTimer()
		recordTimer = bindInterval(() => {
			try {
				if (!isRecording.value) return
				recordDuration.value = Math.floor((Date.now() - recordStartTs) / 1000)
			} catch (e) {
				console.warn('recordTimer tick 异常', e)
			}
		}, 200)
		// #endif
	}

	function onVoiceTouchStart(e: UniTouchEvent) {
		if (sending.value) return
		isRecording.value = true
		voiceCancelHint.value = false
		recordDuration.value = 0
		recordTempPath = ''
		try {
			if (e.touches.length > 0) {
				recordStartX = e.touches[0].clientX
				recordStartY = e.touches[0].clientY
			}
		} catch (err) {}
		startRecord()
	}
	function onVoiceTouchMove(e: UniTouchEvent) {
		if (!isRecording.value) return
		try {
			if (e.touches.length == 0) return
			const dy = e.touches[0].clientY - recordStartY
			const dx = Math.abs(e.touches[0].clientX - recordStartX)
			if (-dy >= VOICE_CANCEL_THRESHOLD && dx < 120) {
				if (!voiceCancelHint.value) voiceCancelHint.value = true
			} else {
				if (voiceCancelHint.value) voiceCancelHint.value = false
			}
		} catch (err) {}
	}
	async function onVoiceTouchEnd(_e: UniTouchEvent) {
		if (!isRecording.value) return
		const willCancel = voiceCancelHint.value
		isRecording.value = false
		voiceCancelHint.value = false
		if (willCancel) {
			cancelVoiceRecord()
		} else {
			await stopRecordAndSend()
		}
	}
	function onVoiceTouchCancel(_e: UniTouchEvent) {
		if (!isRecording.value) return
		isRecording.value = false
		voiceCancelHint.value = false
		cancelVoiceRecord()
	}

	// #ifdef H5
	function isWeixinBrowser(): boolean {
		try {
			const ua: string = (typeof navigator != 'undefined') ? (navigator.userAgent ?? '') : ''
			// microMessenger 是微信内置浏览器标识
			return /MicroMessenger/i.test(ua)
		} catch (e) {
			return false
		}
	}

	// 探测浏览器实际支持的 MediaRecorder mime（按优先级依次尝试）
	function pickRecorderMime(): string {
		const w: any = (typeof window != 'undefined') ? window : null
		if (w == null || typeof w.MediaRecorder == 'undefined' || typeof w.MediaRecorder.isTypeSupported != 'function') {
			return ''
		}
		const candidates: Array<string> = [
			'audio/webm;codecs=opus',
			'audio/webm',
			'audio/ogg;codecs=opus',
			'audio/ogg',
			'audio/mp4;codecs=mp4a.40.2',
			'audio/mp4',
			'audio/aac',
			'audio/wav'
		]
		for (const m of candidates) {
			try {
				if (w.MediaRecorder.isTypeSupported(m)) return m
			} catch (e) {}
		}
		return ''
	}

	function startWavFallback(stream: any) {
		try {
			var W = (typeof window != 'undefined') ? window : null
			var Ctx: any = (W != null && W.AudioContext != null) ? W.AudioContext : (W != null ? W.webkitAudioContext : null)
			if (Ctx == null) {
				uni.showToast({ title: '当前环境不支持录音', icon: 'none' })
				isRecording.value = false
				return
			}
			recordLastMime = 'audio/wav'
			wavCtx = new Ctx()
			wavSampleRate = (wavCtx.sampleRate != null) ? wavCtx.sampleRate : 44100
			var source = wavCtx.createMediaStreamSource(stream)
			wavProcessor = wavCtx.createScriptProcessor(4096, 1, 1)
			wavBuffers = []
			wavProcessor.onaudioprocess = function(e) {
				var ch = e.inputBuffer.getChannelData(0)
				var copy = new Float32Array(ch.length)
				copy.set(ch)
				wavBuffers.push(copy)
			}
			source.connect(wavProcessor)
			wavProcessor.connect(wavCtx.destination)
			recordingState.value = 'recording'
			recordStartTs = Date.now()
			clearRecordTimer()
			recordTimer = bindInterval(() => {
				try {
					if (!isRecording.value) return
					recordDuration.value = Math.floor((Date.now() - recordStartTs) / 1000)
					if (recordDuration.value >= 60) {
						isRecording.value = false
						voiceCancelHint.value = false
						stopRecordAndSend()
					}
				} catch (e) {
					console.warn('wav recordTimer tick 异常', e)
				}
			}, 200)
		} catch (e) {
			console.warn('wav 降级失败', e)
			uni.showToast({ title: '当前环境不支持录音', icon: 'none' })
			isRecording.value = false
		}
	}

	function stopWavFallback() {
		return new Promise<void>(function(resolve) {
			try {
				if (wavProcessor != null) {
					try { wavProcessor.disconnect() } catch (x) {}
					wavProcessor.onaudioprocess = null
					wavProcessor = null
				}
				if (wavCtx != null) {
					try { wavCtx.close() } catch (x) {}
					wavCtx = null
				}
				if (wavBuffers.length == 0) { resolve(); return }
				var totalLen = 0
				for (var bi = 0; bi < wavBuffers.length; bi++) totalLen += wavBuffers[bi].length
				var merged = new Float32Array(totalLen)
				var off = 0
				for (var bj = 0; bj < wavBuffers.length; bj++) { merged.set(wavBuffers[bj], off); off += wavBuffers[bj].length }
				var pcm = new Int16Array(totalLen)
				for (var i = 0; i < totalLen; i++) {
					var s = Math.max(-1, Math.min(1, merged[i]))
					pcm[i] = s < 0 ? s * 0x8000 : s * 0x7fff
				}
				var headerBytes = 44
				var dataBytes = pcm.byteLength
				var buf = new ArrayBuffer(headerBytes + dataBytes)
				var view = new DataView(buf)
				view.setUint8(0, 'R'.charCodeAt(0))
				view.setUint8(1, 'I'.charCodeAt(0))
				view.setUint8(2, 'F'.charCodeAt(0))
				view.setUint8(3, 'F'.charCodeAt(0))
				view.setUint32(4, 36 + dataBytes, true)
				view.setUint8(8, 'W'.charCodeAt(0))
				view.setUint8(9, 'A'.charCodeAt(0))
				view.setUint8(10, 'V'.charCodeAt(0))
				view.setUint8(11, 'E'.charCodeAt(0))
				view.setUint8(12, 'f'.charCodeAt(0))
				view.setUint8(13, 'm'.charCodeAt(0))
				view.setUint8(14, 't'.charCodeAt(0))
				view.setUint8(15, ' '.charCodeAt(0))
				view.setUint32(16, 16, true)
				view.setUint16(20, 1, true)
				view.setUint16(22, 1, true)
				view.setUint32(24, wavSampleRate, true)
				view.setUint32(28, wavSampleRate * 2, true)
				view.setUint16(32, 2, true)
				view.setUint16(34, 16, true)
				view.setUint8(36, 'd'.charCodeAt(0))
				view.setUint8(37, 'a'.charCodeAt(0))
				view.setUint8(38, 't'.charCodeAt(0))
				view.setUint8(39, 'a'.charCodeAt(0))
				view.setUint32(40, dataBytes, true)
				var u8 = new Uint8Array(buf, headerBytes)
				u8.set(new Uint8Array(pcm.buffer, pcm.byteOffset, pcm.byteLength))
				var blob = new Blob([buf], { type: 'audio/wav' })
				if (recordTempPath.indexOf('blob:') == 0) {
					try { URL.revokeObjectURL(recordTempPath) } catch (x) {}
				}
				recordTempPath = URL.createObjectURL(blob)
				recordingState.value = 'recorded'
			} catch (e) {
				console.warn('wav 拼装失败', e)
			}
			resolve()
		})
	}
	// #endif
	function stopRecord() {
		clearRecordTimer()
		// #ifdef H5
		if (recordMediaRecorder != null && recordMediaRecorder.state != 'inactive') {
			recordMediaRecorder.stop()
			// 停止音轨
			try {
				const tracks = recordMediaRecorder.stream?.getTracks?.() ?? []
				tracks.forEach((t: any) => t.stop())
			} catch (e: any) {}
			recordMediaRecorder = null
		} else {
			recordingState.value = 'recorded'
		}
		// #endif
		// #ifndef H5
		recordingState.value = 'recorded'
		// #endif
	}

	function audioSeconds(msg: ChatMsg): number {
		const d = msg.info['duration'] as number
		if (d == null) return 1
		if (d > 1000) return Math.max(1, Math.round(d / 1000))
		return d > 0 ? d : 1
	}

	function audioBubbleWidth(msg: ChatMsg): string {
		const s = audioSeconds(msg)
		const w = 160 + s * 12
		return (w > 420 ? 420 : w) + 'rpx'
	}

	const playingAudioId = ref<string>('')
	let playingCtx: InnerAudioContext | null = null

	let _mounted = false

	let startingCall = false
	async function startCall(isVideo: boolean) {
		if (startingCall) return
		startingCall = true
		showMorePanel.value = false
		showEmojiPanel.value = false
		const mgr = getCallManager()
		mgr.bindMatrix()
		const ok = await mgr.startOutgoing(roomId.value, isVideo)
		startingCall = false
		if (!ok) return
	}
	function startCallVoice() {
		startCall(false)
	}
	function startCallVideo() {
		startCall(true)
	}


	// ============================================================
	// 表情包
	// ============================================================
	function toggleEmojiPanel() {
		showEmojiPanel.value = !showEmojiPanel.value
	}
	async function sendEmojiAsMessage(text: string) {
		if (sending.value) return
		sending.value = true
		try {
			const matrix = await getMatrix2()
			if (matrix == null) {
				sending.value = false
				return
			}
			// 乐观更新
			const tempId = matrix.genTxnId()
			const msgObj = emptyChatMsg()
			msgObj.event_id = tempId
			msgObj.sender = matrix.userId
			msgObj.type = 'm.room.message'
			msgObj.body = text
			msgObj.msgtype = 'm.text'
			msgObj.ts = Date.now()
			msgObj._pending = true
			messages.value.push(msgObj)
			messages.value = messages.value.slice()
			scrollToBottom()
			// 发送
			const ev = await matrix.sendText(roomId.value, text)
			const idx = messages.value.findIndex(m => m.event_id == tempId)
			const newId = ev.event_id != null ? ev.event_id : ''
			if (idx >= 0 && newId.length > 0) {
				messages.value[idx].event_id = newId
				messages.value[idx]._pending = false
				messages.value = messages.value.slice()
			}
		} catch (e) {
			uni.showToast({ title: errText(e, '表情发送失败'), icon: 'none' })
		}
		sending.value = false
	}
	function insertEmoji(e: string) {
		const text = e
		if (text.length == 0) return
		inputText.value = ''
		showEmojiPanel.value = false
		sendEmojiAsMessage(text)
	}

	// ============================================================
	// 语音录制
	// ============================================================
	function toggleAudioRecorder() {
		showAudioRecorder.value = !showAudioRecorder.value
		// 进入面板时清空上一次录制状态
		if (showAudioRecorder.value) {
			recordingState.value = 'idle'
			recordDuration.value = 0
			recordTempPath = ''
		}
	}
	function cancelRecord() {
		recordingState.value = 'idle'
		recordDuration.value = 0
		recordTempPath = ''
	}

	const typingLabel = computed((): string => {
		const users = typingUsers.value
		if (users.length == 0) return ''
		const parts: Array<string> = []
		let i = 0
		while (i < users.length) {
			const u = users[i]
			if (u != null) parts.push(senderInitial(u))
			i++
		}
		return parts.join('、')
	})

	async function checkRoomEncrypted(matrix: MatrixClient): Promise<void> {
		try {
			await matrix.request(
				'GET',
				'/_matrix/client/v3/rooms/' + encodeURIComponent(roomId.value) + '/state/m.room.encryption/',
				null,
				null
			)
			roomEncrypted.value = true
		} catch (e) {
			roomEncrypted.value = false
		}
	}

	async function loadRoomTitle(matrix: MatrixClient) {
		try {
			const n = await matrix.getRoomTitle(roomId.value)
			if (n.length > 0) roomName.value = n
		} catch (e) {
			console.warn('拉取房间标题失败', e)
		}
	}

	function attachImageSrc(msg: ChatMsg): void {
		if (msg.msgtype != 'm.image') return
		const blob = msg._blobUrl
		if (blob.length > 0) {
			msg._src = blob
			return
		}
		const mxc = msg.mxc.length > 0 ? msg.mxc : msg.url
		if (mxc.length == 0) {
			msg._src = ''
			return
		}
		msg._src = getMxcUrl(mxc, 800, 800)
	}

	function applyBlobUrl(eventId: string, url: string): void {
		if (eventId.length == 0 || url.length == 0) return
		const idx = messages.value.findIndex(m => m.event_id == eventId)
		if (idx < 0) return
		messages.value[idx]._blobUrl = url
		messages.value[idx]._src = url
		messages.value = messages.value.slice()
	}

	async function ensureImageBlob(msg: ChatMsg): Promise<string> {
		if (msg._blobUrl.length > 0) return msg._blobUrl
		const matrix = matrixRef as MatrixClient | null
		const rawMxc = msg.mxc.length > 0 ? msg.mxc : msg.url
		if (matrix == null || rawMxc.length == 0 || !rawMxc.startsWith('mxc://')) return ''
		const downloadUrl = matrix.mxcToHttp(rawMxc, 800, 800)
		if (downloadUrl.length == 0) return ''
		try {
			// #ifdef H5
			const resp = await fetch(downloadUrl, {
				headers: { 'Authorization': 'Bearer ' + (matrix.accessToken ?? '') }
			} as any)
			if (!resp.ok) return ''
			const blob = await resp.blob()
			const url = URL.createObjectURL(blob)
			msg._blobUrl = url
			applyBlobUrl(msg.event_id, url)
			return url
			// #endif
		} catch (e) {
			console.error('fetch image blob failed', e)
			return ''
		}
	}

	function hydrateImages(): void {
		const list = messages.value
		for (let i = 0; i < list.length; i++) {
			attachImageSrc(list[i])
		}
		messages.value = messages.value.slice()
		for (let i = 0; i < list.length; i++) {
			const m = list[i]
			if (m.msgtype == 'm.image') {
				ensureImageBlob(m)
			}
		}
	}

	function scrollToHighlight() {
		if (highlightEventId.value.length == 0) return
		const idx = messages.value.findIndex(m => m.event_id == highlightEventId.value)
		if (idx < 0) {
			uni.showToast({ title: '目标消息较旧，上滑加载更多', icon: 'none' })
			return
		}
		const msg = messages.value[idx]
		msg._highlight = true
		messages.value = messages.value.slice()
		setTimeout(() => {
			try {
				if (msg._highlight) {
					msg._highlight = false
					messages.value = messages.value.slice()
				}
			} catch (e) {
				console.warn('clear highlight 异常', e)
			}
		}, 3000)
	}

	async function loadHistory() {
		const matrix = await getMatrix2()
		if (matrix == null) return
		loadingHistory.value = messages.value.length == 0
		try {
			const page = await matrix.getMessagesPage(roomId.value, 30, prevBatch)
			const history = page.messages
			prevBatch = page.end
			const merged: Array<ChatMsg> = messages.value.slice()
			for (const m of history) {
				if (merged.findIndex(x => x.event_id == m.event_id) >= 0) continue
				merged.push(fromMatrixMessage(m))
			}
			merged.sort((a, b) => a.ts - b.ts)
			messages.value = merged
			hydrateImages()
		} catch (e: any) {
			uni.showToast({ title: errText(e, '加载历史失败'), icon: 'none' })
		}
		loadingHistory.value = false
		setTimeout(() => {
			try {
				scrollToHighlight()
				scrollToBottom()
			} catch (e) {
				console.warn('scroll init 异常', e)
			}
		}, 100)
	}

	async function onScrollToUpper() {
		if (loadingHistory.value) return
		if (prevBatch.length == 0) return
		const matrix = await getMatrix2()
		if (matrix == null) return
		loadingHistory.value = true
		const oldFirst = messages.value.length > 0 ? messages.value[0].event_id : ''
		try {
			const page = await matrix.getMessagesPage(roomId.value, 30, prevBatch)
			const history = page.messages
			if (page.end == prevBatch || history.length == 0) {
				prevBatch = ''
			} else {
				prevBatch = page.end
			}
			const merged: Array<ChatMsg> = []
			for (const m of history) {
				if (messages.value.findIndex(x => x.event_id == m.event_id) >= 0) continue
				merged.push(fromMatrixMessage(m))
			}
			if (merged.length > 0) {
				messages.value = merged.concat(messages.value)
				messages.value = messages.value.slice()
				hydrateImages()
			}
			if (oldFirst.length > 0) {
				scrollInto.value = `msg-${oldFirst}`
			}
		} catch (e: any) {
			console.warn('加载更多失败', e)
		}
		loadingHistory.value = false
	}

	async function finishSend(tempId: string, text: string, replyRef: ReplyTarget | null, matrix: MatrixClient): Promise<void> {
		try {
			let newId = ''
			if (replyRef != null) {
				const sent = await matrix.sendReply(roomId.value, replyRef.event_id, text)
				const rid = sent.event_id
				if (rid != null) newId = rid
			} else {
				const sent = await matrix.sendText(roomId.value, text)
				const eid = sent.event_id
				if (eid != null) newId = eid
			}
			const list = messages.value
			for (let i = 0; i < list.length; i++) {
				if (list[i].event_id == tempId) {
					if (newId.length > 0) list[i].event_id = newId
					list[i]._pending = false
					break
				}
			}
		} catch (e) {
			uni.showToast({ title: errText(e, '发送失败'), icon: 'none' })
			const list = messages.value
			for (let i = 0; i < list.length; i++) {
				if (list[i].event_id == tempId) {
					list[i]._pending = false
					list[i]._failed = true
					break
				}
			}
		}
	}

	function onSend() {
		try {
			sending.value = false
			const text = inputText.value.trim()
			if (text.length == 0) {
				uni.showToast({ title: '请输入内容', icon: 'none' })
				return
			}
			let matrix = matrixRef
			if (matrix == null) {
				matrix = getMatrix()
				matrixRef = matrix
			}
			if (matrix == null) {
				uni.showToast({ title: '尚未登录', icon: 'none' })
				return
			}
			if (roomId.value.length == 0) {
				uni.showToast({ title: '房间号为空', icon: 'none' })
				return
			}
			const tempId = matrix.genTxnId()
			const replyRef = replyTo.value
			const msgObj = emptyChatMsg()
			msgObj.event_id = tempId
			msgObj.sender = matrix.userId
			msgObj.type = 'm.room.message'
			msgObj.body = text
			msgObj.msgtype = 'm.text'
			msgObj.ts = Date.now()
			msgObj._pending = true
			messages.value.push(msgObj)
			messages.value = messages.value.slice()
			inputText.value = ''
			replyTo.value = null
			showEmojiPanel.value = false
			showMorePanel.value = false
			scrollToBottom()
			finishSend(tempId, text, replyRef, matrix)
		} catch (e) {
			uni.showToast({ title: errText(e, '发送失败'), icon: 'none' })
		}
	}

	function onInputChange() {
		try {
			if (sending.value) return
			const matrix = matrixRef
			if (matrix == null) return
			matrix.typing(roomId.value, true)
			clearTypingTimer()
			typingTimer = bindTimeout(() => {
				try {
					const m = matrixRef
					if (m != null) m.typing(roomId.value, false)
				} catch (e) {
					console.warn('typing reset 异常', e)
				}
			}, 4000)
		} catch (e) {
			console.warn('onInputChange 异常', e)
		}
	}
	function onInputFocus() {
		inputFocused.value = true
		voiceMode.value = false
		showMorePanel.value = false
	}
	function toggleVoiceMode() {
		voiceMode.value = !voiceMode.value
		showEmojiPanel.value = false
		showMorePanel.value = false
	}
	function onInputBlur() {
		inputFocused.value = false
	}
	function onVoiceBtn() {
		// 保留兼容：老的弹出式录音面板入口已废弃。
		// 现在按住说话按钮通过 onVoiceTouchStart/End/Move 直接控制录音。
	}

	function onLongPress(msg: ChatMsg) {
		actionSheet.value.target = msg
		actionSheet.value.mine = msg.sender == currentUserId.value
		actionSheet.value.show = true
	}

	async function applyEditMessage(eventId: string, content: string): Promise<void> {
		const matrix = await getMatrix2()
		if (matrix == null) return
		try {
			const newContent: UTSJSONObject = {
				msgtype: 'm.text',
				body: content
			}
			await matrix.editMessage(roomId.value, eventId, newContent)
			const idx = messages.value.findIndex(m => m.event_id == eventId)
			if (idx >= 0) {
				messages.value[idx].body = content
				messages.value[idx].edited = true
				messages.value = messages.value.slice()
			}
		} catch (e) {
			uni.showToast({ title: errText(e, '操作失败'), icon: 'none' })
		}
	}

	async function applyRedactMessage(eventId: string): Promise<void> {
		const matrix = await getMatrix2()
		if (matrix == null) return
		try {
			await matrix.redactEvent(roomId.value, eventId, '')
			const idx = messages.value.findIndex(m => m.event_id == eventId)
			if (idx >= 0) {
				messages.value[idx].redacted = true
				messages.value[idx].body = '（消息已撤回）'
				messages.value = messages.value.slice()
			}
		} catch (e) {
			uni.showToast({ title: errText(e, '操作失败'), icon: 'none' })
		}
	}

	async function doAction(action: string, payload: string) {
		const sheet = actionSheet.value
		const target = sheet.target
		sheet.show = false
		if (target == null) return
		const matrix = await getMatrix2()
		if (matrix == null) return
		try {
			if (action == 'react') {
				await matrix.sendReaction(roomId.value, target.event_id, payload)
			} else if (action == 'reply') {
				const rt: ReplyTarget = {
					event_id: target.event_id,
					sender: target.sender,
					body: target.body
				}
				replyTo.value = rt
				uni.showToast({ title: '回复模式已开启', icon: 'none' })
			} else if (action == 'edit') {
				uni.showModal({
					title: '编辑消息',
					editable: true,
					content: target.body,
					success: (res) => {
						if (res.confirm && res.content != null && res.content.length > 0) {
							applyEditMessage(target.event_id, res.content)
						}
					}
				})
			} else if (action == 'redact') {
				uni.showModal({
					title: '撤回消息',
					content: '确定要撤回这条消息吗？',
					success: (res) => {
						if (res.confirm) {
							applyRedactMessage(target.event_id)
						}
					}
				})
			}
		} catch (e: any) {
			uni.showToast({ title: errText(e, '操作失败'), icon: 'none' })
		}
	}

	function previewImage(msg: ChatMsg) {
		const mxc = msg.mxc.length > 0 ? msg.mxc : msg.url
		const url = getMxcUrl(mxc, 1200, 1200)
		if (url.length > 0) {
			uni.previewImage({ urls: [url], current: url })
		}
	}

	function downloadFile(msg: ChatMsg) {
		const mxc = msg.mxc.length > 0 ? msg.mxc : msg.url
		const url = getMxcUrl(mxc, 9999, 9999)
		if (url.length > 0) {
			uni.showToast({ title: '下载中…', icon: 'none' })
			uni.downloadFile({ url: url, success: (res) => {
				if (res.tempFilePath != null) {
					uni.openDocument({ filePath: res.tempFilePath })
				}
			} })
		}
	}

	function playAudio(msg: ChatMsg) {
		try {
			const old = playingCtx
			if (old != null) {
				old.stop()
				old.destroy()
				playingCtx = null
			}
		} catch (e) {}
		if (playingAudioId.value == msg.event_id) {
			playingAudioId.value = ''
			return
		}
		playingAudioId.value = msg.event_id
		const go = (url: string) => {
			if (url.length == 0) {
				uni.showToast({ title: '语音无法播放', icon: 'none' })
				playingAudioId.value = ''
				return
			}
			const ctx = uni.createInnerAudioContext()
			playingCtx = ctx
			ctx.src = url
			ctx.onEnded(() => { playingAudioId.value = ''; playingCtx = null })
			ctx.onError(() => {
				uni.showToast({ title: '语音播放失败', icon: 'none' })
				playingAudioId.value = ''
				playingCtx = null
			})
			ctx.play()
		}
		const raw = msg.mxc.length > 0 ? msg.mxc : msg.url
		ensureImageBlob(msg).then((blobUrl: string) => {
			if (blobUrl.length > 0) go(blobUrl)
			else go(getMxcUrl(raw, 9999, 9999))
		})
	}

	async function sendPickedImage(path: string): Promise<void> {
		try {
			const matrix = await getMatrix2()
			if (matrix == null) return
			uni.showLoading({ title: '上传中…' })
			const segs = path.split('/')
			const fileName = segs.length > 0 ? segs[segs.length - 1] : 'image.jpg'
			const mxc = await matrix.uploadMedia(path, 'image/jpeg', fileName)
			const sys = uni.getSystemInfoSync()
			const w = sys.windowWidth as number - 80
			await matrix.sendImage(roomId.value, mxc, 'image/jpeg', w, w, 0)
			uni.hideLoading()
		} catch (e) {
			uni.hideLoading()
			uni.showToast({ title: errText(e, '发送失败'), icon: 'none' })
		}
	}

	function onPickImage() {
		uni.chooseImage({
			count: 1,
			sourceType: ['album', 'camera'],
			success: (res) => {
				const files = res.tempFiles
				if (files.length == 0) return
				const path = files[0].path
				if (path.length == 0) return
				sendPickedImage(path)
			}
		})
	}

	async function onPickFile() {
		try {
			// #ifdef APP-PLUS
			plus.io.requestFileSystem(plus.io.PRIVATE_DOC, (fsObj) => {
				// 简化：APP 端用原生文件选择插件（此处提示用户用相册）
				uni.showToast({ title: '请使用相册选图片', icon: 'none' })
			})
			// #endif
			// 简化处理：复用选图（很多 App 不支持任意文件选择）
			onPickImage()
		} catch (e) {
			uni.showToast({ title: '请选择图片', icon: 'none' })
		}
	}

	function senderName(sender: string): string {
		const cached = senderMap.value.getString(sender)
		if (cached != null && cached.length > 0) return cached
		// 异步拉取
		;(async () => {
			try {
				const matrix = await getMatrix2()
				if (matrix == null) return
				const p = await matrix.getProfile(sender)
				senderMap.value[sender] = p.display_name
				senderMap.value = senderMap.value
			} catch (e) {
				// 失败就用 local part
				senderMap.value[sender] = sender.split(':')[0].replace('@', '')
			}
		})()
		return sender.split(':')[0].replace('@', '')
	}

	function goBack() {
		uni.navigateBack()
	}

	function showRoomInfo() {
		uni.showModal({
			title: roomName.value,
			content: `房间ID: ${roomId.value}\n${roomTopic.value.length > 0 ? '简介: ' + roomTopic.value : ''}`,
			showCancel: false
		})
	}

	async function sendChatInvite(userId: string): Promise<void> {
		const matrix = await getMatrix2()
		if (matrix == null) return
		uni.showLoading({ title: '邀请中…' })
		try {
			await matrix.inviteUser(roomId.value, userId)
			uni.hideLoading()
			uni.showToast({ title: '邀请已发送', icon: 'success' })
		} catch (e) {
			uni.hideLoading()
			const msg = errText(e, '')
			if (msg.indexOf('M_FORBIDDEN') >= 0) {
				uni.showToast({ title: '无权邀请（需管理员）', icon: 'none' })
			} else if (msg.indexOf('M_NOT_FOUND') >= 0) {
				uni.showToast({ title: '用户不存在', icon: 'none' })
			} else {
				uni.showToast({ title: '邀请失败: ' + msg, icon: 'none' })
			}
		}
	}

	async function leaveCurrentRoom(): Promise<void> {
		try {
			const matrix = await getMatrix2()
			if (matrix == null) return
			uni.showLoading({ title: '退出中…' })
			await matrix.leaveRoom(roomId.value)
			uni.hideLoading()
			uni.showToast({ title: '已退出', icon: 'success' })
			setTimeout(() => { uni.navigateBack() }, 500)
		} catch (e) {
			uni.hideLoading()
			uni.showToast({ title: errText(e, '退出失败'), icon: 'none' })
		}
	}

	function promptInviteMember() {
		uni.showModal({
			title: '邀请成员',
			editable: true,
			placeholderText: '输入对方用户ID，如 @zhang:matrix.itiklink.com',
			success: (res) => {
				if (!res.confirm) return
				const raw = res.content
				const input = (raw != null) ? raw.trim() : ''
				if (input.length == 0) return
				const userId = input.startsWith('@') ? input : '@' + input
				sendChatInvite(userId)
			}
		})
	}

	function showMore() {
		uni.showActionSheet({
			itemList: ['复制房间ID', '查看资料', '邀请成员', '退出房间'],
			success: (res) => {
				if (res.tapIndex == 0) {
					uni.setClipboardData({ data: roomId.value })
				} else if (res.tapIndex == 1) {
					uni.navigateTo({ url: '/pages/profile/profile' })
				} else if (res.tapIndex == 2) {
					promptInviteMember()
				} else if (res.tapIndex == 3) {
					uni.showModal({
						title: '退出房间',
						content: '确定要退出该房间吗？',
						success: (r) => {
							if (r.confirm) {
								leaveCurrentRoom()
							}
						}
					})
				}
			}
		})
	}

	// lifecycle: after helpers so Android UTS can resolve names
	onLoad((options: UTSJSONObject) => {
		const rid = options.getString('roomId')
		if (rid != null && rid.length > 0) {
			roomId.value = safeDecode(rid)
		}
		const hiOpt = options.getString('highlight')
		if (hiOpt != null && hiOpt.length > 0) {
			highlightEventId.value = safeDecode(hiOpt)
		}
		if (roomId.value.length == 0) {
			const pending = storageStr('pending_chat_room')
			if (pending.length > 0) {
				roomId.value = pending
				uni.removeStorageSync('pending_chat_room')
			}
			if (roomId.value.length == 0) {
				const last = storageStr('last_chat_room')
				if (last.length > 0) {
					roomId.value = last
				}
			}
			const hi = storageStr('pending_chat_highlight')
			if (hi.length > 0) {
				highlightEventId.value = hi
				uni.removeStorageSync('pending_chat_highlight')
			}
		}
	})


	async function initChat() {
		const matrix = await getMatrix2()
		if (matrix == null) {
			uni.reLaunch({ url: '/pages/login/login' })
			return
		}
		currentUserId.value = matrix.userId
		myInitial.value = senderInitial(matrix.userId)
		myAvatarSrc.value = ''
		try {
			const p = await matrix.getProfile(matrix.userId)
			const mxc = p.avatar_url
			if (mxc.length > 0) {
				myAvatarSrc.value = getMxcUrl(mxc, 96, 96)
			}
		} catch (e) {}

		const cachedName = matrix.getCachedRoomName(roomId.value)
		if (cachedName.length > 0) {
			roomName.value = cachedName
		}

		const bufferedNow = matrix.getBufferedEvents(roomId.value)
		if (bufferedNow.length > 0 && messages.value.length == 0) {
			for (const ev of bufferedNow) {
				if (ev.type != 'm.room.message' && ev.type != 'm.room.encrypted') continue
				const eid = ev.event_id != null ? ev.event_id : ''
				if (eid.length > 0 && messages.value.findIndex(m => m.event_id == eid) >= 0) continue
				const c = ev.content != null ? ev.content : ({} as UTSJSONObject)
				const sender = ev.sender != null ? ev.sender : ''
				const ts = ev.origin_server_ts != null ? ev.origin_server_ts : Date.now()
				messages.value.push(buildMessage(eid, sender, ev.type, c, ts))
			}
			messages.value = messages.value.slice()
			scrollToBottom()
			hydrateImages()
		}

		loadRoomTitle(matrix)
		checkRoomEncrypted(matrix)
		await loadHistory()

		// 订阅房间消息事件（多订阅者模型，进出页面互不影响）
		offTimeline = matrix.onTimeline((event: MatrixEvent, rid: string) => {
			if (rid != roomId.value) return
			const evType = event.type
			if (evType.indexOf('m.call.') == 0) return
			if (evType != 'm.room.message' && evType != 'm.room.encrypted') return
			const eid = event.event_id != null ? event.event_id : ''
			const list = messages.value
			if (eid.length > 0) {
				for (let di = 0; di < list.length; di++) {
					if (list[di].event_id == eid) return
				}
			}
			const emptyC: UTSJSONObject = {}
			const c = event.content != null ? event.content : emptyC
			const sender = event.sender != null ? event.sender : ''
			const bodyRaw = c.getString('body')
			const bodyText = (bodyRaw != null) ? bodyRaw : ''
			if (sender.length > 0 && sender == currentUserId.value) {
				let pendingIdx = -1
				for (let pi = 0; pi < list.length; pi++) {
					if (list[pi]._pending && list[pi].sender == sender && list[pi].body == bodyText) {
						pendingIdx = pi
						break
					}
				}
				if (pendingIdx >= 0) {
					if (eid.length > 0) list[pendingIdx].event_id = eid
					list[pendingIdx]._pending = false
					return
				}
			}
			const ts = event.origin_server_ts != null ? event.origin_server_ts : Date.now()
			const m = buildMessage(eid.length > 0 ? eid : matrix.genTxnId(), sender, event.type, c, ts)
			messages.value.push(m)
			messages.value = messages.value.slice()
			if (m.msgtype == 'm.image') {
				ensureImageBlob(m).then(() => {
					messages.value = messages.value.slice()
				})
			}
			scrollToBottom()
			if (sender != currentUserId.value) {
				matrix.readReceipt(rid, m.event_id)
			}
		})

		const redHandler = (red: UTSJSONObject, rid: string) => {
			if (rid != roomId.value) return
			const evId = (red['redacts'] as string) ?? ''
			if (evId.length == 0) return
			const idx = messages.value.findIndex(m => m.event_id == evId)
			if (idx >= 0) {
				messages.value[idx].redacted = true
				messages.value[idx].body = '（消息已撤回）'
				messages.value = messages.value.slice()
			}
		}
		matrix.redactionHandlers.push(redHandler)
		offRedaction = () => {
			const i = matrix.redactionHandlers.indexOf(redHandler)
			if (i >= 0) matrix.redactionHandlers.splice(i, 1)
		}

		const reactionHandler = (event: MatrixEvent, rid: string) => {
			if (rid != roomId.value) return
			const content = event.content
			if (content == null) return
			const rel = content['m.relates_to'] as UTSJSONObject
			if (rel == null) return
			const target = (rel['event_id'] as string) ?? ''
			const key = (rel['key'] as string) ?? ''
			if (target.length == 0 || key.length == 0) return
			const idx = messages.value.findIndex(m => m.event_id == target)
			if (idx < 0) return
			const msg = messages.value[idx]
			let users = msg.reactions[key] as Array<string>
			if (users == null) {
				users = []
				msg.reactions[key] = users
			}
			const sender = event.sender != null ? event.sender : ''
			if (users.indexOf(sender) < 0) users.push(sender)
			messages.value = messages.value.slice()
		}
		matrix.reactionHandlers.push(reactionHandler)
		offReaction = () => {
			const i = matrix.reactionHandlers.indexOf(reactionHandler)
			if (i >= 0) matrix.reactionHandlers.splice(i, 1)
		}

		const typingHandler = (userIds: Array<string>, rid: string) => {
			if (rid != roomId.value) return
			const mine = currentUserId.value
			const others: Array<string> = []
			let i = 0
			while (i < userIds.length) {
				const u = userIds[i]
				if (u != null && u != mine) others.push(u)
				i++
			}
			typingUsers.value = others
		}
		matrix.typingHandlers.push(typingHandler)
		offTyping = () => {
			const i = matrix.typingHandlers.indexOf(typingHandler)
			if (i >= 0) matrix.typingHandlers.splice(i, 1)
		}

		const unreadHandler = (rid: string, count: number) => {
			if (rid != roomId.value) return
			if (count > 0 && messages.value.length > 0) {
				const last = messages.value[messages.value.length - 1]
				matrix.readReceipt(rid, last.event_id)
			}
		}
		matrix.unreadHandlers.push(unreadHandler)
		offUnread = () => {
			const i = matrix.unreadHandlers.indexOf(unreadHandler)
			if (i >= 0) matrix.unreadHandlers.splice(i, 1)
		}

		const extraBuf = matrix.getBufferedEvents(roomId.value)
		for (const ev of extraBuf) {
			if (ev.type != 'm.room.message') continue
			const eid = ev.event_id != null ? ev.event_id : ''
			if (eid.length > 0 && messages.value.findIndex(m => m.event_id == eid) >= 0) continue
			const c = ev.content != null ? ev.content : ({} as UTSJSONObject)
			const sender = ev.sender != null ? ev.sender : ''
			const ts = ev.origin_server_ts != null ? ev.origin_server_ts : Date.now()
			messages.value.push(buildMessage(eid.length > 0 ? eid : matrix.genTxnId(), sender, ev.type, c, ts))
		}
		messages.value = messages.value.slice()

		unloadHandler = () => {
			stopOff(offTimeline)
			offTimeline = null
			stopOff(offTyping)
			offTyping = null
			stopOff(offReaction)
			offReaction = null
			stopOff(offRedaction)
			offRedaction = null
			stopOff(offUnread)
			offUnread = null
		}

		// 已读回执
		if (messages.value.length > 0) {
			const last = messages.value[messages.value.length - 1]
			matrix.readReceipt(roomId.value, last.event_id)
		}
	}

	async function setupChat(): Promise<void> {
		if (_mounted) return
		_mounted = true
		await nextTick()
		if (roomId.value.length == 0) {
			const pending = storageStr('pending_chat_room')
			if (pending.length > 0) {
				roomId.value = pending
				uni.removeStorageSync('pending_chat_room')
			}
			if (roomId.value.length == 0) {
				const last = storageStr('last_chat_room')
				if (last.length > 0) {
					roomId.value = last
				}
			}
		}
		if (roomId.value.length == 0) {
			uni.showToast({ title: '房间号为空', icon: 'none' })
			setTimeout(() => { uni.navigateBack() }, 800)
			return
		}
		initChat()
	}

	onMounted(() => {
		setupChat()
	})


	onUnmounted(() => {
		stopOff(unloadHandler)
		unloadHandler = null
		clearRecordTimer()
		clearTypingTimer()
		// #ifdef H5
		try {
			if (recordStream != null) {
				const tracks = recordStream.getTracks()
				for (let i = 0; i < tracks.length; i++) {
					try { tracks[i].stop() } catch (e) {}
				}
			}
		} catch (e) {}
		if (recordTempPath.startsWith('blob:')) {
			try { URL.revokeObjectURL(recordTempPath) } catch (e) {}
		}
		try {
			if (wavProcessor != null) {
				try { wavProcessor.disconnect() } catch (e) {}
				wavProcessor.onaudioprocess = null
				wavProcessor = null
			}
			if (wavCtx != null) {
				try { wavCtx.close() } catch (e) {}
				wavCtx = null
			}
		} catch (e) {}
		try {
			if (recordMediaRecorder != null && recordMediaRecorder.state != 'inactive') {
				recordMediaRecorder.stop()
			}
		} catch (e) {}
		// #endif
		recordMediaRecorder = null
		recordStream = null
	})

</script>

