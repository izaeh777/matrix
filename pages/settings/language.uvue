<template>
	<view class="lang-page">
		<!-- #ifdef APP -->
		<view class="status-bar-holder"></view>
		<!-- #endif -->
		<view class="nav">
			<view class="nav-back" @click="onBack">
				<text class="nav-back-text">‹</text>
			</view>
			<text class="nav-title">{{ pageTitle }}</text>
			<view class="nav-spacer"></view>
		</view>

		<scroll-view class="list" scroll-y="true">
			<view
				v-for="(item, idx) in options"
				:key="item.code"
				class="row"
				@click="onPick(idx)"
			>
				<text class="row-label">{{ item.label }}</text>
				<text v-if="item.code == current" class="row-check">✓</text>
			</view>
		</scroll-view>
	</view>
</template>

<script setup lang="uts">
	import { ref } from 'vue'
	import {
		LOCALE_OPTIONS,
		LocaleOption,
		getLocale,
		getLocaleLabel,
		t,
		applyLocaleAndReload
	} from '@/common/i18n.uts'

	const options = ref<Array<LocaleOption>>(LOCALE_OPTIONS)
	const current = ref<string>(getLocale())
	const pageTitle = ref<string>(t('lang.title'))

	function onBack(): void {
		uni.navigateBack({})
	}

	function onPick(idx: number): void {
		if (idx < 0 || idx >= options.value.length) return
		const item = options.value[idx]
		current.value = item.code
		pageTitle.value = t('lang.title')
		uni.showToast({ title: getLocaleLabel(item.code), icon: 'none' })
		setTimeout(() => {
			// 重建首页，让各页文案按新语言加载
			applyLocaleAndReload(item.code)
		}, 250)
	}

	onShow(() => {
		current.value = getLocale()
		pageTitle.value = t('lang.title')
	})
</script>

<style>
	.lang-page {
		flex: 1;
		background-color: #ffffff;
		flex-direction: column;
	}
	.nav {
		flex-direction: row;
		align-items: center;
		justify-content: space-between;
		height: 88rpx;
		padding: 0 16rpx;
		border-bottom-width: 1rpx;
		border-bottom-style: solid;
		border-bottom-color: #f0f0f0;
	}
	.nav-back {
		width: 72rpx;
		height: 72rpx;
		align-items: center;
		justify-content: center;
	}
	.nav-back-text {
		font-size: 56rpx;
		color: #1a1a1a;
		line-height: 56rpx;
	}
	.nav-title {
		font-size: 34rpx;
		font-weight: 600;
		color: #1a1a1a;
	}
	.nav-spacer {
		width: 72rpx;
	}
	.list {
		flex: 1;
		height: 0;
	}
	.row {
		flex-direction: row;
		align-items: center;
		justify-content: space-between;
		padding: 36rpx 40rpx;
		border-bottom-width: 1rpx;
		border-bottom-style: solid;
		border-bottom-color: #f5f5f5;
	}
	.row-label {
		font-size: 32rpx;
		color: #1a1a1a;
	}
	.row-check {
		font-size: 36rpx;
		color: #1a1a1a;
		font-weight: 700;
	}
</style>
