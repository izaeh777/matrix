<template>
	<view class="lang-page">
		<!-- #ifdef APP -->
		<view class="status-bar-holder"></view>
		<!-- #endif -->
		<view class="nav">
			<view class="nav-back" @click="onBack">
				<text class="nav-back-text">‹</text>
			</view>
			<text class="nav-title">{{ pageTitle }}</text>
			<view class="nav-spacer"></view>
		</view>

		<scroll-view class="list" scroll-y="true">
			<view
				v-for="(item, idx) in options"
				:key="item.code"
				class="row"
				@click="onPick(idx)"
			>
				<text class="row-label">{{ item.label }}</text>
				<text v-if="item.code == current" class="row-check">✓</text>
			</view>
		</scroll-view>

		<!-- 切语言遮罩：挡住返回动画里露出来的旧文案 -->
		<view v-if="switching" class="lang-mask">
			<text class="lang-mask-text">{{ switchingTip }}</text>
		</view>
	</view>
</template>

<script setup lang="uts">
	import { ref } from 'vue'
	import {
		LOCALE_OPTIONS,
		LocaleOption,
		getLocale,
		getLocaleLabel,
		t,
		setLocale,
		applyLocaleAndReload
	} from '@/common/i18n.uts'

	const options = ref<Array<LocaleOption>>(LOCALE_OPTIONS)
	const current = ref<string>(getLocale())
	const pageTitle = ref<string>(t('lang.title'))
	const switching = ref<boolean>(false)
	const switchingTip = ref<string>('')
	let picking = false

	function onBack(): void {
		if (switching.value) return
		uni.navigateBack({})
	}

	function onPick(idx: number): void {
		if (picking) return
		if (idx < 0 || idx >= options.value.length) return
		const item = options.value[idx]
		if (item.code == getLocale()) {
			uni.navigateBack({})
			return
		}
		picking = true
		// 先落盘 + 本页切到新语言，再盖白屏，避免「先旧后新」
		setLocale(item.code)
		current.value = item.code
		pageTitle.value = t('lang.title')
		switchingTip.value = getLocaleLabel(item.code)
		switching.value = true
		// 等遮罩先画出来再跳转
		setTimeout(() => {
			applyLocaleAndReload(item.code)
			picking = false
		}, 40)
	}

	onShow(() => {
		if (switching.value) return
		current.value = getLocale()
		pageTitle.value = t('lang.title')
	})
</script>

<style>
	.lang-page {
		flex: 1;
		background-color: #ffffff;
		flex-direction: column;
	}
	.nav {
		flex-direction: row;
		align-items: center;
		justify-content: space-between;
		height: 88rpx;
		padding: 0 16rpx;
		border-bottom-width: 1rpx;
		border-bottom-style: solid;
		border-bottom-color: #f0f0f0;
	}
	.nav-back {
		width: 72rpx;
		height: 72rpx;
		align-items: center;
		justify-content: center;
	}
	.nav-back-text {
		font-size: 56rpx;
		color: #1a1a1a;
		line-height: 56rpx;
	}
	.nav-title {
		font-size: 34rpx;
		font-weight: 600;
		color: #1a1a1a;
	}
	.nav-spacer {
		width: 72rpx;
	}
	.list {
		flex: 1;
		height: 0;
	}
	.row {
		flex-direction: row;
		align-items: center;
		justify-content: space-between;
		padding: 36rpx 40rpx;
		border-bottom-width: 1rpx;
		border-bottom-style: solid;
		border-bottom-color: #f5f5f5;
	}
	.row-label {
		font-size: 32rpx;
		color: #1a1a1a;
	}
	.row-check {
		font-size: 36rpx;
		color: #1a1a1a;
		font-weight: 700;
	}
	.lang-mask {
		position: fixed;
		left: 0;
		right: 0;
		top: 0;
		bottom: 0;
		background-color: #ffffff;
		align-items: center;
		justify-content: center;
		z-index: 9999;
	}
	.lang-mask-text {
		font-size: 32rpx;
		color: #666666;
	}
</style>
