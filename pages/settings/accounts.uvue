<template>
	<view class="acc-page">
		<!-- #ifdef APP -->
		<view class="status-bar-holder"></view>
		<!-- #endif -->
		<view class="nav">
			<view class="nav-back" @click="onBack">
				<text class="nav-back-text">‹</text>
			</view>
			<text class="nav-title">{{ pageTitle }}</text>
			<view class="nav-spacer"></view>
		</view>

		<scroll-view class="list" scroll-y="true">
			<view
				v-for="(item, idx) in rows"
				:key="item.id"
				class="row"
				@click="onTapAccount(idx)"
				@longpress="onLongRemove(idx)"
			>
				<image
					class="row-avatar"
					:src="avatarSrc(item)"
					mode="aspectFill"
					@error="onAvatarError(item)"
				></image>
				<view class="row-main">
					<text class="row-title">{{ titleOf(item) }}</text>
					<text v-if="subOf(item).length > 0" class="row-sub">{{ subOf(item) }}</text>
				</view>
				<text v-if="item.id == currentId" class="row-current">{{ currentLabel }}</text>
				<text v-else class="row-go">›</text>
			</view>

			<view class="row row-add" @click="onAddAccount">
				<view class="add-icon">
					<text class="add-icon-text">＋</text>
				</view>
				<text class="row-title">{{ addLabel }}</text>
			</view>

			<text class="hint">{{ hintText }}</text>
		</scroll-view>

		<view v-if="busy" class="busy-mask">
			<text class="busy-text">{{ busyText }}</text>
		</view>
	</view>
</template>

<script setup lang="uts">
	import { ref } from 'vue'
	import { t } from '@/common/i18n.uts'
	import {
		AccountSlot,
		loadAccountSlots,
		currentAccountId,
		accountTitle,
		accountSub,
		accountAvatarSrc,
		switchToAccount,
		prepareAddAccount,
		removeAccountById,
		rememberActiveAccount
	} from '@/common/accounts.uts'
	import { defaultAvatar } from '@/common/avatar.uts'

	const pageTitle = ref<string>(t('accounts.title'))
	const addLabel = ref<string>(t('accounts.add'))
	const currentLabel = ref<string>(t('accounts.current'))
	const hintText = ref<string>(t('accounts.hint'))
	const busyText = ref<string>(t('accounts.switching'))
	const rows = ref<Array<AccountSlot>>([] as Array<AccountSlot>)
	const currentId = ref<string>('')
	const busy = ref<boolean>(false)
	const avaFailed = ref<Map<string, boolean>>(new Map<string, boolean>())
	let switching = false

	function refreshLabels(): void {
		pageTitle.value = t('accounts.title')
		addLabel.value = t('accounts.add')
		currentLabel.value = t('accounts.current')
		hintText.value = t('accounts.hint')
		busyText.value = t('accounts.switching')
	}

	function reload(): void {
		rememberActiveAccount()
		avaFailed.value = new Map<string, boolean>()
		rows.value = loadAccountSlots()
		currentId.value = currentAccountId()
	}

	function titleOf(item: AccountSlot): string {
		return accountTitle(item)
	}

	function subOf(item: AccountSlot): string {
		return accountSub(item)
	}

	function avatarSrc(item: AccountSlot): string {
		if (avaFailed.value.get(item.id) == true) return defaultAvatar(item.id)
		return accountAvatarSrc(item)
	}

	function onAvatarError(item: AccountSlot): void {
		if (item.id.length == 0) return
		if (avaFailed.value.get(item.id) == true) return
		const next = new Map<string, boolean>()
		avaFailed.value.forEach((v, k) => {
			next.set(k, v)
		})
		next.set(item.id, true)
		avaFailed.value = next
	}

	function onBack(): void {
		if (busy.value) return
		uni.navigateBack({})
	}

	function onTapAccount(idx: number): void {
		if (switching || busy.value) return
		if (idx < 0 || idx >= rows.value.length) return
		const item = rows.value[idx]
		if (item.id == currentAccountId()) {
			uni.navigateBack({})
			return
		}
		switching = true
		busy.value = true
		busyText.value = t('accounts.switching')
		const ok = switchToAccount(item.id)
		if (!ok) {
			busy.value = false
			switching = false
			uni.showToast({ title: t('accounts.switchFail'), icon: 'none' })
			reload()
			return
		}
		setTimeout(() => {
			uni.reLaunch({ url: '/pages/home/home' })
			switching = false
		}, 80)
	}

	function onAddAccount(): void {
		if (switching || busy.value) return
		uni.showModal({
			title: t('accounts.add'),
			content: t('accounts.addConfirm'),
			confirmText: t('common.confirm'),
			cancelText: t('common.cancel'),
			success: (r) => {
				if (!r.confirm) return
				switching = true
				busy.value = true
				prepareAddAccount()
				uni.reLaunch({ url: '/pages/login/login' })
			}
		})
	}

	function onLongRemove(idx: number): void {
		if (switching || busy.value) return
		if (idx < 0 || idx >= rows.value.length) return
		const item = rows.value[idx]
		if (item.id == currentAccountId()) {
			uni.showToast({ title: t('accounts.cannotRemoveCurrent'), icon: 'none' })
			return
		}
		uni.showModal({
			title: t('accounts.removeTitle'),
			content: t('accounts.removeConfirm'),
			confirmText: t('common.confirm'),
			cancelText: t('common.cancel'),
			success: (r) => {
				if (!r.confirm) return
				removeAccountById(item.id)
				reload()
			}
		})
	}

	onShow(() => {
		refreshLabels()
		reload()
	})
</script>

<style>
	.acc-page {
		flex: 1;
		background-color: #ffffff;
		flex-direction: column;
	}
	.status-bar-holder {
		height: var(--status-bar-height);
	}
	.nav {
		flex-direction: row;
		align-items: center;
		justify-content: space-between;
		height: 88rpx;
		padding: 0 16rpx;
		border-bottom-width: 1rpx;
		border-bottom-style: solid;
		border-bottom-color: #f0f0f0;
	}
	.nav-back {
		width: 72rpx;
		height: 72rpx;
		align-items: center;
		justify-content: center;
	}
	.nav-back-text {
		font-size: 48rpx;
		color: #222222;
		line-height: 48rpx;
	}
	.nav-title {
		flex: 1;
		text-align: center;
		font-size: 34rpx;
		font-weight: 600;
		color: #111111;
	}
	.nav-spacer {
		width: 72rpx;
	}
	.list {
		flex: 1;
		padding: 24rpx 0 48rpx;
	}
	.row {
		flex-direction: row;
		align-items: center;
		padding: 28rpx 32rpx;
		border-bottom-width: 1rpx;
		border-bottom-style: solid;
		border-bottom-color: #f5f5f5;
	}
	.row-avatar {
		width: 80rpx;
		height: 80rpx;
		border-radius: 40rpx;
		background-color: #f0f0f0;
		margin-right: 24rpx;
	}
	.row-main {
		flex: 1;
		flex-direction: column;
	}
	.row-title {
		font-size: 30rpx;
		color: #111111;
		font-weight: 500;
	}
	.row-sub {
		margin-top: 6rpx;
		font-size: 24rpx;
		color: #888888;
	}
	.row-current {
		font-size: 24rpx;
		color: #1f6feb;
		margin-left: 12rpx;
	}
	.row-go {
		font-size: 36rpx;
		color: #cccccc;
		margin-left: 12rpx;
	}
	.row-add {
		margin-top: 12rpx;
		border-bottom-width: 0;
	}
	.add-icon {
		width: 80rpx;
		height: 80rpx;
		border-radius: 40rpx;
		background-color: #f3f8fe;
		align-items: center;
		justify-content: center;
		margin-right: 24rpx;
	}
	.add-icon-text {
		font-size: 40rpx;
		color: #1f6feb;
	}
	.hint {
		margin-top: 32rpx;
		padding: 0 40rpx;
		font-size: 22rpx;
		color: #aaaaaa;
		line-height: 34rpx;
	}
	.busy-mask {
		position: absolute;
		left: 0;
		right: 0;
		top: 0;
		bottom: 0;
		background-color: rgba(255, 255, 255, 0.92);
		align-items: center;
		justify-content: center;
	}
	.busy-text {
		font-size: 28rpx;
		color: #666666;
	}
</style>
