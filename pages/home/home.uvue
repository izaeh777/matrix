<template>
	<view class="home-page">
		<view class="home-top">
			<text class="brand">i-tiklink</text>
			<view class="user-pill">
				<view class="pill-user" @click="goProfile">
					<image class="pill-avatar" :src="avatarUrl" mode="aspectFill"></image>
					<text class="pill-name">{{ shortName }}</text>
					<text class="pill-caret">▾</text>
				</view>
				<view class="pill-bell" @click="goNotify">
					<image class="bell-img" src="/static/login/k1.png" mode="aspectFit"></image>
				</view>
			</view>
		</view>

		<scroll-view class="home-scroll" scroll-y>
			<view class="banner">
				<view class="banner-left">
					<text class="banner-title">发现优质项目</text>
					<text class="banner-title">链接无限商机</text>
					<text class="banner-sub">Web3 项目提示·交流·合作·共赢平台</text>
					<view class="banner-actions">
						<view class="btn-solid" @click="goPublish">
							<text class="btn-solid-text">发布项目</text>
						</view>
						<view class="btn-outline" @click="goSearch">
							<text class="btn-outline-text">搜索项目</text>
						</view>
					</view>
				</view>
				<image class="banner-mascot" src="/static/login/tiki.png" mode="aspectFit"></image>
			</view>

			<view class="section">
				<view class="section-head">
					<text class="section-title">最新动态</text>
					<text class="section-more" @click="goDiscover">更多 ›</text>
				</view>
				<view class="timeline-card">
					<view v-if="latest.length == 0" class="empty-tip">
						<text class="empty-tip-text">暂无动态</text>
					</view>
					<view
						v-for="(item, idx) in latest"
						:key="item.id"
						class="timeline-row"
						@click="onArchive(item)"
					>
						<view class="timeline-rail">
							<view class="timeline-dot"></view>
							<view v-if="idx < latest.length - 1" class="timeline-line"></view>
						</view>
						<view class="timeline-body">
							<text class="timeline-title">{{ item.title }}</text>
							<text class="timeline-sub">{{ archiveSub(item) }}</text>
						</view>
						<text class="timeline-arrow">›</text>
					</view>
				</view>
			</view>

			<view class="section">
				<view class="section-head">
					<text class="section-title">热门项目</text>
					<text class="section-more" @click="goDiscover">查看更多 ›</text>
				</view>
				<view v-if="hot.length == 0" class="empty-tip">
					<text class="empty-tip-text">暂无项目</text>
				</view>
				<view
					v-for="item in hot"
					:key="item.id"
					class="project-card"
					@click="onArchive(item)"
				>
					<view class="project-cover-wrap">
						<image
							v-if="coverOf(item).length > 0"
							class="project-cover"
							:src="coverOf(item)"
							mode="aspectFill"
						></image>
						<view v-else class="project-cover project-cover-fallback"></view>
						<view class="project-cover-mask">
							<text class="project-name">{{ item.title }}</text>
							<text class="project-desc-short">{{ shortDesc(item) }}</text>
							<view class="tag-row">
								<view class="tag"><text class="tag-text">Web</text></view>
								<view class="tag"><text class="tag-text">热门</text></view>
							</view>
						</view>
					</view>
					<text class="project-desc">{{ item.description }}</text>
				</view>
			</view>

			<view v-if="friendLinks.length > 0" class="section">
				<view class="section-head">
					<text class="section-title">友情链接</text>
				</view>
				<view class="friend-card">
					<view class="friend-grid">
						<view
							v-for="link in friendLinks"
							:key="link.id"
							class="friend-item"
							@click="onFriendLink(link)"
						>
							<image
								v-if="friendImage(link).length > 0"
								class="friend-logo"
								:src="friendImage(link)"
								mode="aspectFit"
							></image>
							<view v-else class="friend-logo-fallback">
								<text class="friend-logo-text">{{ friendInitial(link) }}</text>
							</view>
							<text class="friend-name">{{ link.title }}</text>
						</view>
					</view>
				</view>
			</view>

			<view class="scroll-pad"></view>
		</scroll-view>

		<view class="wx-tabbar">
			<view class="wx-tab wx-tab-on">
				<image class="wx-tab-icon" src="/static/login/s1.png" mode="aspectFit"></image>
				<text class="wx-tab-label">首页</text>
			</view>
			<view class="wx-tab" @click="goRooms">
				<image class="wx-tab-icon" src="/static/login/s22.png" mode="aspectFit"></image>
				<text class="wx-tab-label">消息</text>
			</view>
			<view class="wx-tab" @click="goDiscover">
				<image class="wx-tab-icon" src="/static/login/s33.png" mode="aspectFit"></image>
				<text class="wx-tab-label">发现</text>
			</view>
			<view class="wx-tab" @click="goNotify">
				<image class="wx-tab-icon" src="/static/login/s44.png" mode="aspectFit"></image>
				<text class="wx-tab-label">通知</text>
			</view>
			<view class="wx-tab" @click="goProfile">
				<image class="wx-tab-icon" src="/static/login/s55.png" mode="aspectFit"></image>
				<text class="wx-tab-label">我的</text>
			</view>
		</view>
	</view>
</template>

<script setup lang="uts">
	import { ref, computed, onMounted } from 'vue'
	import { loadSession, saveSession } from '@/common/storage.uts'
	import { loadPlatformSession } from '@/common/platform.uts'
	import { getMatrix } from '@/common/matrix.uts'
	import {
		fetchCmsHome,
		fetchFriendLinks,
		cmsAssetUrl,
		openCmsLink,
		openArchiveDetail,
		CmsArchiveItem,
		CmsFriendLink
	} from '@/common/cms.uts'

	const session = loadSession()
	const platform = loadPlatformSession()
	const avatarUrl = ref<string>('/static/login/tiki.png')
	const latest = ref<Array<CmsArchiveItem>>([])
	const hot = ref<Array<CmsArchiveItem>>([])
	const friendLinks = ref<Array<CmsFriendLink>>([])

	const shortName = computed((): string => {
		let name = ''
		if (session != null) {
			if (session.display_name != null && session.display_name.length > 0) {
				name = session.display_name
			} else {
				name = session.user_id.split(':')[0].replace('@', '')
			}
		} else if (platform != null) {
			if (platform.nickname.length > 0) name = platform.nickname
			else name = platform.email
		}
		if (name.length == 0) return '游客'
		if (name.length <= 10) return name
		return name.substring(0, 6) + '…' + name.substring(name.length - 4)
	})

	async function loadAvatar(): Promise<void> {
		if (session == null) return
		if (session.avatar_url != null && session.avatar_url.length > 0) {
			const matrix0 = getMatrix()
			if (matrix0 != null) {
				let url = matrix0.mxcToHttp(session.avatar_url, 96, 96)
				const token = matrix0.accessToken
				if (token.length > 0 && url.indexOf('access_token=') < 0) {
					url = url + (url.indexOf('?') >= 0 ? '&' : '?') + 'access_token=' + encodeURIComponent(token)
				}
				if (url.length > 0) {
					avatarUrl.value = url
					return
				}
			}
		}
		const matrix = getMatrix()
		if (matrix == null) return
		try {
			const p = await matrix.getProfile(session.user_id)
			if (p.avatar_url != null && p.avatar_url.length > 0) {
				session.avatar_url = p.avatar_url
				saveSession(session)
				let url = matrix.mxcToHttp(p.avatar_url, 96, 96)
				const token = matrix.accessToken
				if (token.length > 0 && url.indexOf('access_token=') < 0) {
					url = url + (url.indexOf('?') >= 0 ? '&' : '?') + 'access_token=' + encodeURIComponent(token)
				}
				if (url.length > 0) avatarUrl.value = url
			}
		} catch (e) {
			console.warn('首页头像拉取失败', e)
		}
	}

	function coverOf(item: CmsArchiveItem): string {
		return cmsAssetUrl(item.image)
	}

	function shortDesc(item: CmsArchiveItem): string {
		const d = item.description
		if (d.length == 0) return '精选内容'
		if (d.length <= 16) return d
		return d.substring(0, 16) + '…'
	}

	function archiveSub(item: CmsArchiveItem): string {
		if (item.views > 0) return '浏览 ' + item.views
		return '已上线'
	}

	function friendImage(link: CmsFriendLink): string {
		return cmsAssetUrl(link.image)
	}

	function friendInitial(link: CmsFriendLink): string {
		const t = link.title
		if (t.length == 0) return '链'
		return t.substring(0, 1)
	}

	function onFriendLink(link: CmsFriendLink): void {
		openCmsLink(link.website)
	}

	function onArchive(item: CmsArchiveItem): void {
		openArchiveDetail(item.id)
	}

	function onSoon(): void {
		uni.showToast({ title: '即将开放', icon: 'none' })
	}

	function goRooms(): void {
		uni.redirectTo({ url: '/pages/rooms/rooms' })
	}
	function goDiscover(): void {
		uni.redirectTo({ url: '/pages/discover/discover' })
	}
	function goNotify(): void {
		uni.redirectTo({ url: '/pages/notify/notify' })
	}
	function goProfile(): void {
		uni.redirectTo({ url: '/pages/profile/profile' })
	}
	function goSearch(): void {
		uni.navigateTo({ url: '/pages/search/search' })
	}
	function goPublish(): void {
		uni.navigateTo({ url: '/pages/project/publish' })
	}

	async function loadHome(): Promise<void> {
		try {
			const home = await fetchCmsHome()
			latest.value = home.latest.slice(0, 5)
			hot.value = home.hot.slice(0, 6)
		} catch (e) {
			console.warn('加载首页失败', e)
		}
		try {
			friendLinks.value = await fetchFriendLinks()
		} catch (e2) {
			console.warn('加载友链失败', e2)
		}
	}

	onMounted(() => {
		loadAvatar()
		loadHome()
	})
</script>

