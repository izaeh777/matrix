<template>
	<view class="pub-page">
		<!-- #ifdef APP -->
		<view class="status-bar-holder"></view>
		<!-- #endif -->
		<view class="nav">
			<text class="nav-back" @click="onBack">‹</text>
			<text class="nav-title">{{ editId > 0 ? i18n.editTitle : i18n.title }}</text>
			<text v-if="editId <= 0" class="nav-draft" @click="saveDraft">{{ i18n.draft }}</text>
			<text v-else class="nav-draft"></text>
		</view>

		<view class="steps">
			<view class="step" :class="{ 'step-on': step >= 1 }">
				<view class="step-num" :class="{ 'step-num-on': step >= 1 }">
					<text class="step-num-text">1</text>
				</view>
				<text class="step-label" :class="{ 'step-label-on': step >= 1 }">{{ i18n.step1 }}</text>
			</view>
			<view class="step-line" :class="{ 'step-line-on': step >= 2 }"></view>
			<view class="step" :class="{ 'step-on': step >= 2 }">
				<view class="step-num" :class="{ 'step-num-on': step >= 2 }">
					<text class="step-num-text">2</text>
				</view>
				<text class="step-label" :class="{ 'step-label-on': step >= 2 }">{{ i18n.step2 }}</text>
			</view>
			<view class="step-line" :class="{ 'step-line-on': step >= 3 }"></view>
			<view class="step" :class="{ 'step-on': step >= 3 }">
				<view class="step-num" :class="{ 'step-num-on': step >= 3 }">
					<text class="step-num-text">3</text>
				</view>
				<text class="step-label" :class="{ 'step-label-on': step >= 3 }">{{ i18n.step3 }}</text>
			</view>
			<view class="step-line" :class="{ 'step-line-on': step >= 4 }"></view>
			<view class="step" :class="{ 'step-on': step >= 4 }">
				<view class="step-num" :class="{ 'step-num-on': step >= 4 }">
					<text class="step-num-text">4</text>
				</view>
				<text class="step-label" :class="{ 'step-label-on': step >= 4 }">{{ i18n.step4 }}</text>
			</view>
		</view>

		<scroll-view class="form-scroll" direction="vertical" :show-scrollbar="false">
			<view class="form-scroll-inner">
				<view v-if="step == 1" class="form">
					<text class="label"><text class="req">*</text>{{ i18n.name }}</text>
					<input class="input" v-model="name" :placeholder="i18n.namePh" />

					<text class="label"><text class="req">*</text>{{ i18n.category }}</text>
					<view class="select" @click="pickCategory">
						<text class="select-text" :class="{ 'ph': category.length == 0 }">{{ category.length > 0 ? catText(category) : i18n.categoryPh }}</text>
						<text class="select-caret">▾</text>
					</view>

					<text class="label"><text class="req">*</text>{{ i18n.intro }}</text>
					<view class="area-wrap">
						<textarea class="area" v-model="summary" maxlength="300" :placeholder="i18n.introPh"></textarea>
						<text class="counter">{{ summary.length }}/300</text>
					</view>

					<text class="label"><text class="req">*</text>{{ i18n.startTime }}</text>
					<picker mode="date" :value="startDateStr" @change="onStartDateChange">
						<view class="select">
							<text class="select-text" :class="{ 'ph': startDateStr.length == 0 }">{{ startDateStr.length > 0 ? startDateStr : i18n.startTimePh }}</text>
							<text class="select-caret">▾</text>
						</view>
					</picker>

					<text class="label"><text class="req">*</text>{{ i18n.logo }}</text>
					<view class="upload-row">
						<view class="upload-box" @click="pickImage('logo')">
							<image v-if="logoFullurl.length > 0" class="upload-img" :src="logoFullurl" mode="aspectFill"></image>
							<view v-else class="upload-empty">
								<image class="upload-ico-img" src="/static/login/sf.png" mode="aspectFit"></image>
								<text class="upload-txt">{{ i18n.uploadLogo }}</text>
							</view>
						</view>
						<text class="upload-hint">{{ i18n.uploadHint }}</text>
					</view>

					<text class="label"><text class="req">*</text>{{ i18n.cover }}</text>
					<view class="upload-row">
						<view class="upload-box" @click="pickImage('cover')">
							<image v-if="coverFullurl.length > 0" class="upload-img" :src="coverFullurl" mode="aspectFill"></image>
							<view v-else class="upload-empty">
								<image class="upload-ico-img" src="/static/login/sf.png" mode="aspectFit"></image>
								<text class="upload-txt">{{ i18n.uploadCover }}</text>
							</view>
						</view>
						<text class="upload-hint">{{ i18n.coverHint }}</text>
					</view>
				</view>

				<view v-if="step == 2" class="form">
					<text class="label"><text class="req">*</text>{{ i18n.highlight }}</text>
					<input class="input" v-model="subtitle" :placeholder="i18n.highlightPh" />

					<text class="label"><text class="req">*</text>{{ i18n.audience }}</text>
					<input class="input" v-model="audience" :placeholder="i18n.audiencePh" />

					<text class="label"><text class="req">*</text>{{ i18n.detail }}</text>
					<view class="area-wrap">
						<textarea class="area" v-model="content" maxlength="300" :placeholder="i18n.detailPh"></textarea>
						<text class="counter">{{ content.length }}/300</text>
					</view>
				</view>

				<view v-if="step == 3" class="form">
					<text class="label">{{ i18n.material }}</text>
					<view class="upload-row">
						<view class="upload-box" @click="pickFile('material')">
							<image v-if="materialFullurl.length > 0" class="upload-img" :src="materialFullurl" mode="aspectFill"></image>
							<view v-else class="upload-empty">
								<image class="upload-ico-img" src="/static/login/sf.png" mode="aspectFit"></image>
								<text class="upload-txt">{{ i18n.uploadMaterial }}</text>
							</view>
						</view>
						<text class="upload-hint">{{ i18n.uploadHint }}</text>
					</view>
					<text class="label">{{ i18n.video }}</text>
					<view class="upload-row">
						<view class="upload-box" @click="pickVideo">
							<image v-if="videoFullurl.length > 0" class="upload-img" :src="videoFullurl" mode="aspectFill"></image>
							<view v-else class="upload-empty">
								<image class="upload-ico-img" src="/static/login/sf.png" mode="aspectFit"></image>
								<text class="upload-txt">{{ i18n.uploadVideo }}</text>
							</view>
						</view>
						<text class="upload-hint">{{ i18n.videoHint }}</text>
					</view>
					<text class="label">{{ i18n.coverPreview }}</text>
					<view class="upload-row">
						<view class="upload-box" @click="pickImage('cover')">
							<image v-if="coverFullurl.length > 0" class="upload-img" :src="coverFullurl" mode="aspectFill"></image>
							<view v-else class="upload-empty">
								<image class="upload-ico-img" src="/static/login/sf.png" mode="aspectFit"></image>
								<text class="upload-txt">{{ i18n.uploadCover }}</text>
							</view>
						</view>
						<text class="upload-hint">{{ i18n.coverHint }}</text>
					</view>
				</view>

				<view v-if="step == 4" class="form">
					<text class="review-title">{{ i18n.reviewTitle }}</text>
					<view class="review-card">
						<text class="review-line">{{ i18n.reviewName }}{{ name }}</text>
						<text class="review-line">{{ i18n.reviewCat }}{{ catText(category) }}</text>
						<text class="review-line">{{ i18n.reviewIntro }}{{ summary }}</text>
						<text class="review-line">{{ i18n.reviewHighlight }}{{ subtitle }}</text>
						<text v-if="startDateStr.length > 0" class="review-line">{{ i18n.startTime }}：{{ startDateStr }}</text>
						<text v-if="video.length > 0" class="review-line">{{ i18n.video }}：{{ i18n.videoReady }}</text>
					</view>
				</view>
				<view class="scroll-pad"></view>
			</view>
		</scroll-view>

		<view class="footer">
			<view v-if="step == 1" class="btn-primary" @click="nextStep">
				<text class="btn-primary-text">{{ i18n.next }}</text>
			</view>
			<view v-else-if="step < 4" class="footer-row">
				<view class="btn-ghost" @click="prevStep">
					<text class="btn-ghost-text">{{ i18n.prev }}</text>
				</view>
				<view class="btn-primary btn-primary-half" @click="nextStep">
					<text class="btn-primary-text">{{ i18n.next }}</text>
				</view>
			</view>
			<view v-else class="btn-primary" @click="submit">
				<text class="btn-primary-text">{{ submitting ? i18n.submitting : (editId > 0 ? i18n.saveUpdate : i18n.submit) }}</text>
			</view>
		</view>
	</view>
</template>

<script setup lang="uts">
	import { ref } from 'vue'
	import {
		createCmsProject,
		submitCmsProject,
		fetchProjectEditDraft,
		fetchProjectCategories,
		updateCmsProjectContent,
		CmsProjectDraft,
		CmsProjectCategory
	} from '@/common/cms.uts'
	import {
		fetchPlatformMe,
		canPublishProject,
		loadCachedVipLabel,
		uploadPlatformImage
	} from '@/common/platform.uts'
	import { t } from '@/common/i18n.uts'

	const DRAFT_KEY = 'cms_project_draft_v3'

	type PubI18n = {
		title: string
		editTitle: string
		saveUpdate: string
		draft: string
		step1: string
		step2: string
		step3: string
		step4: string
		name: string
		namePh: string
		category: string
		categoryPh: string
		intro: string
		introPh: string
		startTime: string
		startTimePh: string
		logo: string
		uploadLogo: string
		uploadHint: string
		cover: string
		uploadCover: string
		coverHint: string
		highlight: string
		highlightPh: string
		audience: string
		audiencePh: string
		detail: string
		detailPh: string
		material: string
		uploadMaterial: string
		video: string
		uploadVideo: string
		videoHint: string
		videoReady: string
		coverPreview: string
		reviewTitle: string
		reviewName: string
		reviewCat: string
		reviewIntro: string
		reviewHighlight: string
		next: string
		prev: string
		submit: string
		submitting: string
		visitorBlock: string
	}

	function buildPubI18n(): PubI18n {
		return {
			title: t('pub.title'),
			editTitle: t('pub.editTitle'),
			saveUpdate: t('pub.saveUpdate'),
			draft: t('pub.draft'),
			step1: t('pub.step1'),
			step2: t('pub.step2'),
			step3: t('pub.step3'),
			step4: t('pub.step4'),
			name: t('pub.name'),
			namePh: t('pub.namePh'),
			category: t('pub.category'),
			categoryPh: t('pub.categoryPh'),
			intro: t('pub.intro'),
			introPh: t('pub.introPh'),
			startTime: t('pub.startTime'),
			startTimePh: t('pub.startTimePh'),
			logo: t('pub.logo'),
			uploadLogo: t('pub.uploadLogo'),
			uploadHint: t('pub.uploadHint'),
			cover: t('pub.cover'),
			uploadCover: t('pub.uploadCover'),
			coverHint: t('pub.coverHint'),
			highlight: t('pub.highlight'),
			highlightPh: t('pub.highlightPh'),
			audience: t('pub.audience'),
			audiencePh: t('pub.audiencePh'),
			detail: t('pub.detail'),
			detailPh: t('pub.detailPh'),
			material: t('pub.material'),
			uploadMaterial: t('pub.uploadMaterial'),
			video: t('pub.video'),
			uploadVideo: t('pub.uploadVideo'),
			videoHint: t('pub.videoHint'),
			videoReady: t('pub.videoReady'),
			coverPreview: t('pub.coverPreview'),
			reviewTitle: t('pub.reviewTitle'),
			reviewName: t('pub.reviewName'),
			reviewCat: t('pub.reviewCat'),
			reviewIntro: t('pub.reviewIntro'),
			reviewHighlight: t('pub.reviewHighlight'),
			next: t('pub.next'),
			prev: t('pub.prev'),
			submit: t('pub.submit'),
			submitting: t('pub.submitting'),
			visitorBlock: t('pub.visitorBlock')
		} as PubI18n
	}

	const step = ref<number>(1)
	const name = ref<string>('')
	const category = ref<string>('')
	const categoryId = ref<number>(0)
	const catList = ref<Array<CmsProjectCategory>>([] as Array<CmsProjectCategory>)
	const summary = ref<string>('')
	const startDateStr = ref<string>('')
	const startTime = ref<number>(0)
	const logo = ref<string>('')
	const logoFullurl = ref<string>('')
	const cover = ref<string>('')
	const coverFullurl = ref<string>('')
	const subtitle = ref<string>('')
	const audience = ref<string>('')
	const content = ref<string>('')
	const material = ref<string>('')
	const materialFullurl = ref<string>('')
	const video = ref<string>('')
	const videoFullurl = ref<string>('')
	const submitting = ref<boolean>(false)
	const editId = ref<number>(0)
	const i18n = ref<PubI18n>(buildPubI18n())

	function resolveCategoryId(nameOrId: string, idHint: number): number {
		if (idHint > 0) {
			for (let i = 0; i < catList.value.length; i++) {
				if (catList.value[i].id == idHint) return idHint
			}
			return idHint
		}
		const n = nameOrId.trim()
		if (n.length == 0) return 0
		for (let i = 0; i < catList.value.length; i++) {
			if (catList.value[i].name == n) return catList.value[i].id
		}
		return 0
	}

	function unixToDateStr(ts: number): string {
		if (ts <= 0) return ''
		const d = new Date(ts * 1000)
		const y = d.getFullYear()
		const m = d.getMonth() + 1
		const day = d.getDate()
		const ms = m < 10 ? ('0' + m) : ('' + m)
		const ds = day < 10 ? ('0' + day) : ('' + day)
		return '' + y + '-' + ms + '-' + ds
	}

	function applyDraft(d: CmsProjectDraft): void {
		name.value = d.name
		category.value = d.category
		categoryId.value = resolveCategoryId(d.category, d.category_id)
		if (category.value.length == 0 && categoryId.value > 0) {
			for (let i = 0; i < catList.value.length; i++) {
				if (catList.value[i].id == categoryId.value) {
					category.value = catList.value[i].name
					break
				}
			}
		}
		summary.value = d.summary
		logo.value = d.logo
		logoFullurl.value = d.logoFullurl
		cover.value = d.cover
		coverFullurl.value = d.coverFullurl
		subtitle.value = d.subtitle
		audience.value = d.audience
		content.value = d.content
		material.value = d.material
		materialFullurl.value = d.materialFullurl
		video.value = d.video
		videoFullurl.value = d.videoFullurl
		startTime.value = d.start_time
		startDateStr.value = unixToDateStr(d.start_time)
	}

	async function loadCategories(): Promise<void> {
		try {
			const rows = await fetchProjectCategories()
			catList.value = rows
			if (categoryId.value <= 0 && category.value.length > 0) {
				categoryId.value = resolveCategoryId(category.value, 0)
			}
		} catch (e) {
			let msg = t('cms.categoriesFail')
			try {
				if (e instanceof Error && e.message.length > 0) msg = e.message
			} catch (e1) {}
			uni.showToast({ title: msg, icon: 'none' })
		}
	}

	async function loadForEdit(id: number): Promise<void> {
		uni.showLoading({ title: t('common.loading'), mask: true })
		try {
			const d = await fetchProjectEditDraft(id)
			applyDraft(d)
			editId.value = id
		} catch (e) {
			let msg = t('cms.detailFail')
			try {
				if (e instanceof Error && e.message.length > 0) msg = e.message
			} catch (e1) {}
			uni.showToast({ title: msg, icon: 'none' })
			setTimeout(() => {
				uni.navigateBack({})
			}, 800)
		} finally {
			uni.hideLoading()
		}
	}

	function pickStrObj(obj: UTSJSONObject, key: string): string {
		try {
			const v = obj[key]
			if (v != null) return '' + v
		} catch (e0) {}
		return ''
	}

	function dateToUnix(dateStr: string): number {
		const parts = dateStr.split('-')
		if (parts.length < 3) return 0
		const y = parseInt(parts[0])
		const m = parseInt(parts[1])
		const d = parseInt(parts[2])
		if (y != y || m != m || d != d) return 0
		const ts = new Date(y, m - 1, d).getTime()
		if (ts != ts || ts <= 0) return 0
		return Math.floor(ts / 1000)
	}

	type StartDateDetail = {
		value: string
	}
	type StartDateChangeEvent = {
		detail: StartDateDetail
	}
	function onStartDateChange(e: StartDateChangeEvent): void {
		let v = ''
		try { v = ('' + e.detail.value).trim() } catch (e0) { v = '' }
		startDateStr.value = v
		startTime.value = dateToUnix(v)
	}

	function loadDraft(): void {
		try {
			const raw = uni.getStorageSync(DRAFT_KEY)
			if (raw == null) return
			const text = ('' + raw).trim()
			if (text.length == 0 || text.charAt(0) != '{') return
			const obj = JSON.parse(text) as UTSJSONObject
			name.value = pickStrObj(obj, 'name')
			category.value = pickStrObj(obj, 'category')
			let cid = 0
			try {
				const n = parseInt(pickStrObj(obj, 'category_id'))
				if (n == n && n > 0) cid = n
			} catch (eCid) {}
			categoryId.value = cid
			summary.value = pickStrObj(obj, 'summary')
			if (summary.value.length == 0) summary.value = pickStrObj(obj, 'intro')
			logo.value = pickStrObj(obj, 'logo')
			logoFullurl.value = pickStrObj(obj, 'logoFullurl')
			cover.value = pickStrObj(obj, 'cover')
			coverFullurl.value = pickStrObj(obj, 'coverFullurl')
			subtitle.value = pickStrObj(obj, 'subtitle')
			if (subtitle.value.length == 0) subtitle.value = pickStrObj(obj, 'highlight')
			audience.value = pickStrObj(obj, 'audience')
			content.value = pickStrObj(obj, 'content')
			if (content.value.length == 0) content.value = pickStrObj(obj, 'detail')
			material.value = pickStrObj(obj, 'material')
			materialFullurl.value = pickStrObj(obj, 'materialFullurl')
			video.value = pickStrObj(obj, 'video')
			videoFullurl.value = pickStrObj(obj, 'videoFullurl')
			let st = 0
			try {
				const n = parseInt(pickStrObj(obj, 'start_time'))
				if (n == n && n > 0) st = n
			} catch (e1) {}
			startTime.value = st
			startDateStr.value = unixToDateStr(st)
		} catch (e) {}
	}

	function buildDraft(): CmsProjectDraft {
		return {
			name: name.value,
			category: category.value,
			category_id: categoryId.value,
			summary: summary.value,
			logo: logo.value,
			logoFullurl: logoFullurl.value,
			cover: cover.value,
			coverFullurl: coverFullurl.value,
			subtitle: subtitle.value,
			audience: audience.value,
			content: content.value,
			material: material.value,
			materialFullurl: materialFullurl.value,
			video: video.value,
			videoFullurl: videoFullurl.value,
			start_time: startTime.value
		} as CmsProjectDraft
	}

	function saveDraft(): void {
		try {
			uni.setStorageSync(DRAFT_KEY, JSON.stringify(buildDraft()))
			uni.showToast({ title: i18n.value.draft, icon: 'none' })
		} catch (e) {
			uni.showToast({ title: t('cms.saveFail'), icon: 'none' })
		}
	}

	function catText(raw: string): string {
		return raw
	}

	async function pickCategory(): Promise<void> {
		if (catList.value.length == 0) {
			await loadCategories()
		}
		if (catList.value.length == 0) {
			uni.showToast({ title: t('cms.categoriesFail'), icon: 'none' })
			return
		}
		const labels: Array<string> = []
		for (let i = 0; i < catList.value.length; i++) {
			labels.push(catList.value[i].name)
		}
		uni.showActionSheet({
			itemList: labels,
			success: (res) => {
				if (res.tapIndex >= 0 && res.tapIndex < catList.value.length) {
					const picked = catList.value[res.tapIndex]
					category.value = picked.name
					categoryId.value = picked.id
				}
			}
		})
	}

	async function uploadPickedFile(path: string, kind: string): Promise<void> {
		uni.showLoading({
			title: kind == 'video' ? t('pub.uploadingVideo') : t('pub.uploadingImage'),
			mask: true
		})
		try {
			const data = await uploadPlatformImage(path)
			const fileUrl = '' + data['url']
			const fileFull = '' + data['fullurl']
			if (fileUrl.length == 0) {
				throw new Error(t('pub.uploadNoUrl'))
			}
			if (kind == 'logo') {
				logo.value = fileUrl
				logoFullurl.value = fileFull
			} else if (kind == 'cover') {
				cover.value = fileUrl
				coverFullurl.value = fileFull
			} else if (kind == 'material') {
				material.value = fileUrl
				materialFullurl.value = fileFull
			} else if (kind == 'video') {
				video.value = fileUrl
				videoFullurl.value = fileFull.length > 0 ? fileFull : fileUrl
			}
			uni.showToast({ title: t('pub.uploadOk'), icon: 'success' })
		} catch (e) {
			let msg = t('pub.uploadFail')
			try {
				if (e instanceof Error && e.message.length > 0) msg = e.message
			} catch (e1) {}
			uni.showToast({ title: msg, icon: 'none' })
		} finally {
			uni.hideLoading()
		}
	}

	function pickImage(kind: string): void {
		uni.chooseImage({
			count: 1,
			sizeType: ['compressed'],
			sourceType: ['album', 'camera'],
			success: (res) => {
				const paths = res.tempFilePaths
				if (paths == null || paths.length == 0) return
				uploadPickedFile('' + paths[0], kind)
			}
		})
	}

	function pickFile(kind: string): void {
		uni.chooseFile({
			count: 1,
			extension: ['pdf', 'ppt', 'pptx'],
			success: (res) => {
				const paths = res.tempFilePaths
				if (paths == null || paths.length == 0) return
				uploadPickedFile('' + paths[0], kind)
			},
			fail: (err) => {
				console.warn('chooseFile fail', err)
			}
		})
	}

	function pickVideo(): void {
		uni.chooseVideo({
			sourceType: ['album', 'camera'],
			compressed: true,
			success: (res) => {
				let path = ''
				try { path = ('' + res.tempFilePath).trim() } catch (e0) { path = '' }
				if (path.length == 0) return
				uploadPickedFile(path, 'video')
			}
		})
	}

	onLoad((options: UTSJSONObject) => {
		if (!canPublishProject(loadCachedVipLabel())) {
			uni.showToast({ title: t('pub.visitorBlock'), icon: 'none' })
			setTimeout(() => {
				uni.navigateBack({})
			}, 800)
			return
		}
		let id = 0
		try {
			const raw = options['id']
			if (raw != null) {
				const n = parseInt('' + raw)
				if (n == n && n > 0) id = n
			}
		} catch (e0) {}
		loadCategories()
		if (id > 0) {
			loadForEdit(id)
		} else {
			loadDraft()
		}
	})

	onShow(() => {
		i18n.value = buildPubI18n()
	})

	function onBack(): void {
		if (step.value > 1) {
			step.value = step.value - 1
			return
		}
		uni.navigateBack()
	}

	function prevStep(): void {
		if (step.value > 1) step.value = step.value - 1
	}

	function nextStep(): void {
		if (step.value == 1) {
			if (name.value.trim().length < 5) {
				uni.showToast({ title: i18n.value.namePh, icon: 'none' })
				return
			}
			if (categoryId.value <= 0 || category.value.length == 0) {
				uni.showToast({ title: i18n.value.categoryPh, icon: 'none' })
				return
			}
			if (summary.value.trim().length < 20) {
				uni.showToast({ title: i18n.value.introPh, icon: 'none' })
				return
			}
			if (startTime.value <= 0) {
				uni.showToast({ title: i18n.value.startTimePh, icon: 'none' })
				return
			}
			if (logo.value.length == 0 || cover.value.length == 0) {
				uni.showToast({ title: i18n.value.uploadLogo, icon: 'none' })
				return
			}
		}
		if (step.value == 2) {
			if (subtitle.value.trim().length < 5) {
				uni.showToast({ title: i18n.value.highlightPh, icon: 'none' })
				return
			}
			if (audience.value.trim().length == 0) {
				uni.showToast({ title: i18n.value.audiencePh, icon: 'none' })
				return
			}
			if (content.value.trim().length < 20) {
				uni.showToast({ title: i18n.value.detailPh, icon: 'none' })
				return
			}
		}
		if (step.value < 4) step.value = step.value + 1
	}

	async function submit(): Promise<void> {
		if (submitting.value) return
		try {
			const me = await fetchPlatformMe()
			if (!canPublishProject(me.vip_label)) {
				uni.showToast({ title: i18n.value.visitorBlock, icon: 'none' })
				return
			}
		} catch (eGate) {
			if (!canPublishProject(loadCachedVipLabel())) {
				uni.showToast({ title: i18n.value.visitorBlock, icon: 'none' })
				return
			}
		}
		submitting.value = true
		const draft = buildDraft()
		draft.name = name.value.trim()
		draft.summary = summary.value.trim()
		draft.subtitle = subtitle.value.trim()
		draft.audience = audience.value.trim()
		draft.content = content.value.trim()
		try {
			if (editId.value > 0) {
				await updateCmsProjectContent(editId.value, draft)
				uni.showToast({ title: i18n.value.saveUpdate, icon: 'none' })
			} else {
				const created = await createCmsProject(draft)
				const newId = created.id
				const newStatus = created.status
				if (newStatus == 'pending') {
					try {
						await submitCmsProject(newId, false)
					} catch (e1) {}
					uni.showToast({ title: i18n.value.submit, icon: 'none' })
				} else {
					uni.showToast({ title: i18n.value.draft, icon: 'none' })
				}
				try { uni.removeStorageSync(DRAFT_KEY) } catch (e2) {}
			}
			setTimeout(() => {
				uni.navigateBack()
			}, 600)
		} catch (e) {
			let msg = t('cms.submitFail')
			try { msg = '' + e } catch (e3) {}
			if (msg.indexOf('Error:') == 0) msg = msg.substring(6).trim()
			uni.showToast({ title: msg.length > 0 ? msg : t('cms.submitFail'), icon: 'none' })
		}
		submitting.value = false
	}
</script>

