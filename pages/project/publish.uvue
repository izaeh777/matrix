<template>
	<view class="pub-page">
		<!-- #ifdef APP -->
		<view class="status-bar-holder"></view>
		<!-- #endif -->
		<view class="nav">
			<text class="nav-back" @click="onBack">‹</text>
			<text class="nav-title">{{ i18n.title }}</text>
			<text class="nav-draft" @click="saveDraft">{{ i18n.draft }}</text>
		</view>

		<view class="steps">
			<view class="step" :class="{ 'step-on': step >= 1 }">
				<view class="step-num" :class="{ 'step-num-on': step >= 1 }">
					<text class="step-num-text">1</text>
				</view>
				<text class="step-label" :class="{ 'step-label-on': step >= 1 }">{{ i18n.step1 }}</text>
			</view>
			<view class="step-line" :class="{ 'step-line-on': step >= 2 }"></view>
			<view class="step" :class="{ 'step-on': step >= 2 }">
				<view class="step-num" :class="{ 'step-num-on': step >= 2 }">
					<text class="step-num-text">2</text>
				</view>
				<text class="step-label" :class="{ 'step-label-on': step >= 2 }">{{ i18n.step2 }}</text>
			</view>
			<view class="step-line" :class="{ 'step-line-on': step >= 3 }"></view>
			<view class="step" :class="{ 'step-on': step >= 3 }">
				<view class="step-num" :class="{ 'step-num-on': step >= 3 }">
					<text class="step-num-text">3</text>
				</view>
				<text class="step-label" :class="{ 'step-label-on': step >= 3 }">{{ i18n.step3 }}</text>
			</view>
			<view class="step-line" :class="{ 'step-line-on': step >= 4 }"></view>
			<view class="step" :class="{ 'step-on': step >= 4 }">
				<view class="step-num" :class="{ 'step-num-on': step >= 4 }">
					<text class="step-num-text">4</text>
				</view>
				<text class="step-label" :class="{ 'step-label-on': step >= 4 }">{{ i18n.step4 }}</text>
			</view>
		</view>

		<scroll-view class="form-scroll" direction="vertical" :show-scrollbar="false">
			<view class="form-scroll-inner">
				<view v-if="step == 1" class="form">
					<text class="label"><text class="req">*</text>{{ i18n.name }}</text>
					<input class="input" v-model="name" :placeholder="i18n.namePh" />

					<text class="label"><text class="req">*</text>{{ i18n.category }}</text>
					<view class="select" @click="pickCategory">
						<text class="select-text" :class="{ 'ph': category.length == 0 }">{{ category.length > 0 ? catText(category) : i18n.categoryPh }}</text>
						<text class="select-caret">▾</text>
					</view>

					<text class="label"><text class="req">*</text>{{ i18n.intro }}</text>
					<view class="area-wrap">
						<textarea class="area" v-model="intro" maxlength="300" :placeholder="i18n.introPh"></textarea>
						<text class="counter">{{ intro.length }}/300</text>
					</view>

					<text class="label"><text class="req">*</text>{{ i18n.logo }}</text>
					<view class="upload-row">
						<view class="upload-box" @click="pickImage('logo')">
							<image v-if="logo.length > 0" class="upload-img" :src="logo" mode="aspectFill"></image>
							<view v-else class="upload-empty">
								<image class="upload-ico-img" src="/static/login/sf.png" mode="aspectFit"></image>
								<text class="upload-txt">{{ i18n.uploadLogo }}</text>
							</view>
						</view>
						<text class="upload-hint">{{ i18n.uploadHint }}</text>
					</view>

					<text class="label"><text class="req">*</text>{{ i18n.cover }}</text>
					<view class="upload-row">
						<view class="upload-box" @click="pickImage('cover')">
							<image v-if="cover.length > 0" class="upload-img" :src="cover" mode="aspectFill"></image>
							<view v-else class="upload-empty">
								<image class="upload-ico-img" src="/static/login/sf.png" mode="aspectFit"></image>
								<text class="upload-txt">{{ i18n.uploadCover }}</text>
							</view>
						</view>
						<text class="upload-hint">{{ i18n.coverHint }}</text>
					</view>
				</view>

				<view v-if="step == 2" class="form">
					<text class="label"><text class="req">*</text>{{ i18n.highlight }}</text>
					<input class="input" v-model="highlight" :placeholder="i18n.highlightPh" />

					<text class="label"><text class="req">*</text>{{ i18n.audience }}</text>
					<input class="input" v-model="audience" :placeholder="i18n.audiencePh" />

					<text class="label"><text class="req">*</text>{{ i18n.detail }}</text>
					<view class="area-wrap">
						<textarea class="area" v-model="detail" maxlength="300" :placeholder="i18n.detailPh"></textarea>
						<text class="counter">{{ detail.length }}/300</text>
					</view>
				</view>

				<view v-if="step == 3" class="form">
					<text class="label">{{ i18n.material }}</text>
					<view class="upload-row">
						<view class="upload-box" @click="pickImage('material')">
							<image v-if="material.length > 0" class="upload-img" :src="material" mode="aspectFill"></image>
							<view v-else class="upload-empty">
								<image class="upload-ico-img" src="/static/login/sf.png" mode="aspectFit"></image>
								<text class="upload-txt">{{ i18n.uploadMaterial }}</text>
							</view>
						</view>
						<text class="upload-hint">{{ i18n.uploadHint }}</text>
					</view>
					<text class="label">{{ i18n.coverPreview }}</text>
					<view class="upload-row">
						<view class="upload-box" @click="pickImage('cover')">
							<image v-if="cover.length > 0" class="upload-img" :src="cover" mode="aspectFill"></image>
							<view v-else class="upload-empty">
								<image class="upload-ico-img" src="/static/login/sf.png" mode="aspectFit"></image>
								<text class="upload-txt">{{ i18n.uploadCover }}</text>
							</view>
						</view>
						<text class="upload-hint">{{ i18n.coverHint }}</text>
					</view>
				</view>

				<view v-if="step == 4" class="form">
					<text class="review-title">{{ i18n.reviewTitle }}</text>
					<view class="review-card">
						<text class="review-line">{{ i18n.reviewName }}{{ name }}</text>
						<text class="review-line">{{ i18n.reviewCat }}{{ catText(category) }}</text>
						<text class="review-line">{{ i18n.reviewIntro }}{{ intro }}</text>
						<text class="review-line">{{ i18n.reviewHighlight }}{{ highlight }}</text>
					</view>
				</view>
				<view class="scroll-pad"></view>
			</view>
		</scroll-view>

		<view class="footer">
			<view v-if="step == 1" class="btn-primary" @click="nextStep">
				<text class="btn-primary-text">{{ i18n.next }}</text>
			</view>
			<view v-else-if="step < 4" class="footer-row">
				<view class="btn-ghost" @click="prevStep">
					<text class="btn-ghost-text">{{ i18n.prev }}</text>
				</view>
				<view class="btn-primary btn-primary-half" @click="nextStep">
					<text class="btn-primary-text">{{ i18n.next }}</text>
				</view>
			</view>
			<view v-else class="btn-primary" @click="submit">
				<text class="btn-primary-text">{{ submitting ? i18n.submitting : i18n.submit }}</text>
			</view>
		</view>
	</view>
</template>

<script setup lang="uts">
	import { ref } from 'vue'
	import { createCmsProject, submitCmsProject, CmsProjectDraft } from '@/common/cms.uts'
	import {
		fetchPlatformMe,
		canPublishProject,
		loadCachedVipLabel
	} from '@/common/platform.uts'
	import { t, tx } from '@/common/i18n.uts'

	const DRAFT_KEY = 'cms_project_draft_v1'
	const CATS: Array<string> = ['Web3', '金融', '直播', 'DeFi', '项目', '其他']

	type PubI18n = {
		title: string
		draft: string
		step1: string
		step2: string
		step3: string
		step4: string
		name: string
		namePh: string
		category: string
		categoryPh: string
		intro: string
		introPh: string
		logo: string
		uploadLogo: string
		uploadHint: string
		cover: string
		uploadCover: string
		coverHint: string
		highlight: string
		highlightPh: string
		audience: string
		audiencePh: string
		detail: string
		detailPh: string
		material: string
		uploadMaterial: string
		coverPreview: string
		reviewTitle: string
		reviewName: string
		reviewCat: string
		reviewIntro: string
		reviewHighlight: string
		next: string
		prev: string
		submit: string
		submitting: string
		visitorBlock: string
	}

	const step = ref<number>(1)
	const name = ref<string>('')
	const category = ref<string>('')
	const intro = ref<string>('')
	const logo = ref<string>('')
	const cover = ref<string>('')
	const highlight = ref<string>('')
	const audience = ref<string>('')
	const detail = ref<string>('')
	const material = ref<string>('')
	const submitting = ref<boolean>(false)
	const i18n = ref<PubI18n>({
		title: t('pub.title'),
		draft: t('pub.draft'),
		step1: t('pub.step1'),
		step2: t('pub.step2'),
		step3: t('pub.step3'),
		step4: t('pub.step4'),
		name: t('pub.name'),
		namePh: t('pub.namePh'),
		category: t('pub.category'),
		categoryPh: t('pub.categoryPh'),
		intro: t('pub.intro'),
		introPh: t('pub.introPh'),
		logo: t('pub.logo'),
		uploadLogo: t('pub.uploadLogo'),
		uploadHint: t('pub.uploadHint'),
		cover: t('pub.cover'),
		uploadCover: t('pub.uploadCover'),
		coverHint: t('pub.coverHint'),
		highlight: t('pub.highlight'),
		highlightPh: t('pub.highlightPh'),
		audience: t('pub.audience'),
		audiencePh: t('pub.audiencePh'),
		detail: t('pub.detail'),
		detailPh: t('pub.detailPh'),
		material: t('pub.material'),
		uploadMaterial: t('pub.uploadMaterial'),
		coverPreview: t('pub.coverPreview'),
		reviewTitle: t('pub.reviewTitle'),
		reviewName: t('pub.reviewName'),
		reviewCat: t('pub.reviewCat'),
		reviewIntro: t('pub.reviewIntro'),
		reviewHighlight: t('pub.reviewHighlight'),
		next: t('pub.next'),
		prev: t('pub.prev'),
		submit: t('pub.submit'),
		submitting: t('pub.submitting'),
		visitorBlock: t('pub.visitorBlock')
	} as PubI18n)

	function loadDraft(): void {
		try {
			const raw = uni.getStorageSync(DRAFT_KEY)
			if (raw == null) return
			const text = ('' + raw).trim()
			if (text.length == 0 || text.charAt(0) != '{') return
			const obj = JSON.parse(text) as UTSJSONObject
			name.value = obj['name'] != null ? '' + obj['name'] : ''
			category.value = obj['category'] != null ? '' + obj['category'] : ''
			intro.value = obj['intro'] != null ? '' + obj['intro'] : ''
			logo.value = obj['logo'] != null ? '' + obj['logo'] : ''
			cover.value = obj['cover'] != null ? '' + obj['cover'] : ''
			highlight.value = obj['highlight'] != null ? '' + obj['highlight'] : ''
			audience.value = obj['audience'] != null ? '' + obj['audience'] : ''
			detail.value = obj['detail'] != null ? '' + obj['detail'] : ''
			material.value = obj['material'] != null ? '' + obj['material'] : ''
		} catch (e) {}
	}

	function saveDraft(): void {
		const draft: CmsProjectDraft = {
			name: name.value,
			category: category.value,
			intro: intro.value,
			logo: logo.value,
			cover: cover.value,
			highlight: highlight.value,
			audience: audience.value,
			detail: detail.value,
			material: material.value
		}
		try {
			uni.setStorageSync(DRAFT_KEY, JSON.stringify(draft))
			uni.showToast({ title: i18n.value.draft, icon: 'none' })
		} catch (e) {
			uni.showToast({ title: 'save failed', icon: 'none' })
		}
	}

	function catText(raw: string): string {
		return tx(raw)
	}

	function pickCategory(): void {
		const labels: Array<string> = []
		for (let i = 0; i < CATS.length; i++) {
			labels.push(tx(CATS[i]))
		}
		uni.showActionSheet({
			itemList: labels,
			success: (res) => {
				if (res.tapIndex >= 0 && res.tapIndex < CATS.length) {
					category.value = CATS[res.tapIndex]
				}
			}
		})
	}

	function pickImage(kind: string): void {
		uni.chooseImage({
			count: 1,
			sizeType: ['compressed'],
			sourceType: ['album', 'camera'],
			success: (res) => {
				const paths = res.tempFilePaths
				if (paths == null || paths.length == 0) return
				const path = '' + paths[0]
				if (kind == 'logo') logo.value = path
				else if (kind == 'cover') cover.value = path
				else if (kind == 'material') material.value = path
			}
		})
	}

	onLoad(() => {
		if (!canPublishProject(loadCachedVipLabel())) {
			uni.showToast({ title: t('pub.visitorBlock'), icon: 'none' })
			setTimeout(() => {
				uni.navigateBack({})
			}, 800)
		}
	})

	onShow(() => {
		i18n.value = {
			title: t('pub.title'),
			draft: t('pub.draft'),
			step1: t('pub.step1'),
			step2: t('pub.step2'),
			step3: t('pub.step3'),
			step4: t('pub.step4'),
			name: t('pub.name'),
			namePh: t('pub.namePh'),
			category: t('pub.category'),
			categoryPh: t('pub.categoryPh'),
			intro: t('pub.intro'),
			introPh: t('pub.introPh'),
			logo: t('pub.logo'),
			uploadLogo: t('pub.uploadLogo'),
			uploadHint: t('pub.uploadHint'),
			cover: t('pub.cover'),
			uploadCover: t('pub.uploadCover'),
			coverHint: t('pub.coverHint'),
			highlight: t('pub.highlight'),
			highlightPh: t('pub.highlightPh'),
			audience: t('pub.audience'),
			audiencePh: t('pub.audiencePh'),
			detail: t('pub.detail'),
			detailPh: t('pub.detailPh'),
			material: t('pub.material'),
			uploadMaterial: t('pub.uploadMaterial'),
			coverPreview: t('pub.coverPreview'),
			reviewTitle: t('pub.reviewTitle'),
			reviewName: t('pub.reviewName'),
			reviewCat: t('pub.reviewCat'),
			reviewIntro: t('pub.reviewIntro'),
			reviewHighlight: t('pub.reviewHighlight'),
			next: t('pub.next'),
			prev: t('pub.prev'),
			submit: t('pub.submit'),
			submitting: t('pub.submitting'),
			visitorBlock: t('pub.visitorBlock')
		} as PubI18n
	})

	function onBack(): void {
		if (step.value > 1) {
			step.value = step.value - 1
			return
		}
		uni.navigateBack()
	}

	function prevStep(): void {
		if (step.value > 1) step.value = step.value - 1
	}

	function nextStep(): void {
		if (step.value == 1) {
			if (name.value.trim().length < 5) {
				uni.showToast({ title: i18n.value.namePh, icon: 'none' })
				return
			}
			if (category.value.length == 0) {
				uni.showToast({ title: i18n.value.categoryPh, icon: 'none' })
				return
			}
			if (intro.value.trim().length < 20) {
				uni.showToast({ title: i18n.value.introPh, icon: 'none' })
				return
			}
			if (logo.value.length == 0 || cover.value.length == 0) {
				uni.showToast({ title: i18n.value.uploadCover, icon: 'none' })
				return
			}
		}
		if (step.value == 2) {
			if (highlight.value.trim().length < 5) {
				uni.showToast({ title: i18n.value.highlightPh, icon: 'none' })
				return
			}
			if (audience.value.trim().length == 0) {
				uni.showToast({ title: i18n.value.audiencePh, icon: 'none' })
				return
			}
			if (detail.value.trim().length < 20) {
				uni.showToast({ title: i18n.value.detailPh, icon: 'none' })
				return
			}
		}
		if (step.value < 4) step.value = step.value + 1
	}

	async function submit(): Promise<void> {
		if (submitting.value) return
		try {
			const me = await fetchPlatformMe()
			if (!canPublishProject(me.vip_label)) {
				uni.showToast({ title: i18n.value.visitorBlock, icon: 'none' })
				return
			}
		} catch (eGate) {
			if (!canPublishProject(loadCachedVipLabel())) {
				uni.showToast({ title: i18n.value.visitorBlock, icon: 'none' })
				return
			}
		}
		submitting.value = true
		const draft: CmsProjectDraft = {
			name: name.value.trim(),
			category: category.value,
			intro: intro.value.trim(),
			logo: logo.value,
			cover: cover.value,
			highlight: highlight.value.trim(),
			audience: audience.value.trim(),
			detail: detail.value.trim(),
			material: material.value
		}
		try {
			const id = await createCmsProject(draft)
			try {
				await submitCmsProject(id)
			} catch (e1) {}
			try { uni.removeStorageSync(DRAFT_KEY) } catch (e2) {}
			uni.showToast({ title: i18n.value.submit, icon: 'none' })
			setTimeout(() => {
				uni.navigateBack()
			}, 600)
		} catch (e) {
			let msg = 'submit failed'
			try { msg = '' + e } catch (e3) {}
			if (msg.indexOf('Error:') == 0) msg = msg.substring(6).trim()
			uni.showToast({ title: msg.length > 0 ? msg : 'submit failed', icon: 'none' })
		}
		submitting.value = false
	}

	loadDraft()
</script>

<style>
	.pub-page {
		flex: 1;
		height: 100%;
		background-color: #f5f7fb;
		flex-direction: column;
		overflow: hidden;
	}
	.nav {
		flex-direction: row;
		align-items: center;
		padding: 56rpx 24rpx 16rpx;
		flex-shrink: 0;
	}
	.nav-back {
		width: 64rpx;
		font-size: 56rpx;
		color: #222;
	}
	.nav-title {
		flex: 1;
		text-align: center;
		font-size: 34rpx;
		font-weight: 700;
		color: #1a1a1a;
	}
	.nav-draft {
		width: 140rpx;
		text-align: right;
		font-size: 28rpx;
		color: #2f6ff2;
	}
	.steps {
		flex-direction: row;
		align-items: flex-start;
		padding: 12rpx 28rpx 24rpx;
		flex-shrink: 0;
	}
	.step {
		align-items: center;
		width: 120rpx;
	}
	.step-num {
		width: 48rpx;
		height: 48rpx;
		border-radius: 24rpx;
		background-color: #e5e7eb;
		align-items: center;
		justify-content: center;
		margin-bottom: 8rpx;
	}
	.step-num-on {
		background-color: #2f6ff2;
	}
	.step-num-text {
		font-size: 24rpx;
		color: #ffffff;
		font-weight: 700;
	}
	.step-label {
		font-size: 20rpx;
		color: #9aa3af;
	}
	.step-label-on {
		color: #2f6ff2;
	}
	.step-line {
		flex: 1;
		height: 2rpx;
		background-color: #e5e7eb;
		margin-top: 24rpx;
	}
	.step-line-on {
		background-color: #2f6ff2;
	}
	.form-scroll {
		flex: 1;
		height: 0;
		width: 100%;
	}
	.form-scroll-inner {
		flex-direction: column;
		width: 100%;
		padding-bottom: 24rpx;
	}
	.form {
		padding: 8rpx 32rpx 24rpx;
	}
	.label {
		font-size: 28rpx;
		color: #1a1a1a;
		font-weight: 600;
		margin-bottom: 12rpx;
		margin-top: 18rpx;
	}
	.req {
		color: #ef4444;
		margin-right: 6rpx;
	}
	.input {
		background-color: #ffffff;
		border-radius: 16rpx;
		padding: 22rpx 24rpx;
		font-size: 28rpx;
		color: #1a1a1a;
	}
	.select {
		background-color: #ffffff;
		border-radius: 16rpx;
		padding: 22rpx 24rpx;
		flex-direction: row;
		align-items: center;
	}
	.select-text {
		flex: 1;
		font-size: 28rpx;
		color: #1a1a1a;
	}
	.ph {
		color: #9aa3af;
	}
	.select-caret {
		font-size: 24rpx;
		color: #9aa3af;
	}
	.area-wrap {
		background-color: #ffffff;
		border-radius: 16rpx;
		padding: 16rpx 20rpx 12rpx;
		position: relative;
	}
	.area {
		width: 100%;
		min-height: 180rpx;
		font-size: 28rpx;
		color: #1a1a1a;
	}
	.counter {
		font-size: 22rpx;
		color: #9aa3af;
		text-align: right;
		margin-top: 8rpx;
	}
	.upload-row {
		flex-direction: row;
		align-items: center;
	}
	.upload-box {
		width: 160rpx;
		height: 160rpx;
		border-radius: 16rpx;
		background-color: #ffffff;
		border-width: 2rpx;
		border-style: dashed;
		border-color: #d1d5db;
		overflow: hidden;
		align-items: center;
		justify-content: center;
	}
	.upload-img {
		width: 160rpx;
		height: 160rpx;
	}
	.upload-empty {
		align-items: center;
		justify-content: center;
	}
	.upload-ico-img {
		width: 48rpx;
		height: 48rpx;
		margin-bottom: 8rpx;
	}
	.upload-txt {
		font-size: 22rpx;
		color: #6b7280;
	}
	.upload-hint {
		flex: 1;
		margin-left: 20rpx;
		font-size: 24rpx;
		color: #9aa3af;
		lines: 2;
	}
	.review-title {
		font-size: 30rpx;
		font-weight: 700;
		color: #1a1a1a;
		margin-bottom: 20rpx;
	}
	.review-card {
		background-color: #ffffff;
		border-radius: 16rpx;
		padding: 24rpx;
