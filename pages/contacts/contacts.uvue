		color: #1a1a1a;
		font-weight: 500;
	}

	.user-id {
		font-size: 24rpx;
		color: #999;
		margin-top: 6rpx;
	}

	.user-presence {
		font-size: 22rpx;
		margin-top: 4rpx;
	}

	.user-presence.presence-online {
		color: #34c759;
	}

	.user-presence.presence-offline {
		color: #999;
	}

	.user-presence.presence-busy {
		color: #ff9500;
	}

	.chat-icon {
		font-size: 40rpx;
	}

	.empty-page {
		flex: 1;
		align-items: center;
		justify-content: center;
		padding-bottom: 100rpx;
	}

	.empty-icon {
		font-size: 120rpx;
	}

	.empty-title {
		font-size: 36rpx;
		color: #333;
		font-weight: 600;
		margin-top: 24rpx;
	}

	.empty-desc {
		font-size: 26rpx;
		color: #999;
		margin-top: 16rpx;
		text-align: center;
		line-height: 1.6;
	}

	.entry-buttons {
		flex-direction: row;
		margin-top: 60rpx;
		flex-wrap: wrap;
		justify-content: center;
	}

	.entry-btn {
		flex-direction: column;
		align-items: center;
		background-color: #fff;
		border-radius: 16rpx;
		padding: 32rpx 48rpx;
		margin: 12rpx 16rpx;
	}

	.entry-btn-icon {
		font-size: 48rpx;
		margin-bottom: 12rpx;
	}

	.entry-btn-text {
		font-size: 24rpx;
		color: #333;
	}
</style>