		justify-content: space-between;
		padding: 24rpx 28rpx 16rpx;
		padding-top: 60rpx;
		background-color: #ededed;
	}
	.wx-nav-title {
		font-size: 34rpx;
		font-weight: 600;
		color: #181818;
	}
	.wx-nav-btn {
		font-size: 40rpx;
		color: #181818;
	}
	.wx-tabbar {
		flex-direction: row;
		background-color: #f7f7f7;
		border-top-width: 1rpx;
		border-top-color: #d9d9d9;
		padding-bottom: 24rpx;
	}
	.wx-tab {
		flex: 1;
		align-items: center;
		padding: 10rpx 0 12rpx;
	}
	.wx-tab-icon { font-size: 40rpx; margin-bottom: 4rpx; }
	.wx-tab-label { font-size: 20rpx; color: #181818; }
	.wx-tab-on .wx-tab-label { color: #07c160; }

	.search-bar {
		background-color: #fff;
		flex-direction: row;
		align-items: center;
		padding: 16rpx 24rpx;
		padding-top: 104rpx;
		border-bottom-width: 1rpx;
		border-bottom-color: #e8e8ec;
	}

	.search-input-wrap {
		flex: 1;
		flex-direction: row;
		align-items: center;
		background-color: #f0f0f5;
		border-radius: 16rpx;
		padding: 12rpx 16rpx;
	}

	.search-icon {
		font-size: 28rpx;
		margin-right: 8rpx;
	}

	.search-input {
		flex: 1;
		font-size: 28rpx;
		color: #333;
	}

	.search-placeholder {
		color: #aaa;
		font-size: 28rpx;
	}

	.clear-btn {
		font-size: 28rpx;
		color: #999;
		padding-left: 8rpx;
	}

	.cancel-btn {
		font-size: 28rpx;
		color: #1f6feb;
		margin-left: 20rpx;
	}

	.result-list {
		flex: 1;
	}

	.loading-row, .empty-row {
		padding: 60rpx;
		align-items: center;
	}

	.loading-text, .empty-text {
		font-size: 28rpx;
		color: #999;
	}

	.user-row {
		background-color: #fff;
		flex-direction: row;
		align-items: center;
		padding: 24rpx 32rpx;
		border-bottom-width: 1rpx;
		border-bottom-color: #f0f0f5;
	}

	.manual-row {
		border-top-width: 2rpx;
		border-top-color: #e0e0e6;
		margin-top: 0;
	}

	.manual-avatar {
		background-color: #e8f0ff;
		align-items: center;
		justify-content: center;
	}

	.manual-avatar-text {
		font-size: 40rpx;
	}

	.avatar-wrap {
		position: relative;
	}

	.avatar {
		width: 88rpx;
		height: 88rpx;
		border-radius: 50%;
		background-color: #e0e0e6;
	}

	.presence-dot {
		position: absolute;
		right: 0;
		bottom: 0;
		width: 24rpx;
		height: 24rpx;
		border-radius: 50%;
		border-width: 4rpx;
		border-color: #fff;
	}

	.presence-online {
		background-color: #34c759;
	}

	.presence-offline {
		background-color: #c8c8cd;
	}

	.presence-busy {
		background-color: #ff9500;
	}

	.presence-unknown {
		background-color: #e0e0e6;
	}

	.user-info {
		flex: 1;
