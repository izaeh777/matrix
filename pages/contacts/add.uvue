	.add-page {
		flex: 1;
		background-color: #f5f6f8;
		flex-direction: column;
	}
	.topbar {
		flex-direction: row;
		align-items: center;
		justify-content: space-between;
		padding: 48rpx 20rpx 16rpx;
		background-color: #ffffff;
	}
	.back-btn {
		width: 72rpx;
		height: 72rpx;
		align-items: center;
		justify-content: center;
	}
	.back-text {
		font-size: 56rpx;
		color: #181818;
		line-height: 56rpx;
	}
	.topbar-title {
		font-size: 34rpx;
		font-weight: 700;
		color: #1a1a1a;
	}
	.topbar-right {
		min-width: 72rpx;
		padding-right: 8rpx;
		align-items: center;
		justify-content: center;
	}
	.scan-btn {
		font-size: 26rpx;
		color: #2f6ff2;
		font-weight: 600;
	}
	.search-bar {
		background-color: #ffffff;
		padding: 8rpx 24rpx 20rpx;
		border-bottom-width: 1rpx;
		border-bottom-color: #eef0f3;
		border-bottom-style: solid;
	}
	.search-input-wrap {
		flex-direction: row;
		align-items: center;
		background-color: #f0f2f5;
		border-radius: 16rpx;
		padding: 16rpx 20rpx;
	}
	.search-icon {
		font-size: 30rpx;
		color: #9aa3af;
		margin-right: 10rpx;
		transform: scaleX(-1);
	}
	.search-input {
		flex: 1;
		font-size: 28rpx;
		color: #1a1a1a;
	}
	.search-placeholder {
		color: #9aa3af;
		font-size: 28rpx;
	}
	.clear-btn {
		font-size: 26rpx;
		color: #9aa3af;
		padding-left: 12rpx;
	}
	.body {
		flex: 1;
		height: 0;
	}
	.hint-wrap {
		padding: 80rpx 48rpx;
		align-items: center;
	}
	.hint-text {
		font-size: 26rpx;
		color: #9aa3af;
		text-align: center;
		line-height: 40rpx;
	}
	.result-list {
		flex-direction: column;
	}
	.loading-row, .empty-row {
		padding: 60rpx;
		align-items: center;
	}
	.loading-text, .empty-text {
		font-size: 28rpx;
		color: #9aa3af;
