		padding: 16rpx 20rpx;
	}
	.search-icon {
		font-size: 30rpx;
		color: #9aa3af;
		margin-right: 10rpx;
		transform: scaleX(-1);
	}
	.search-input {
		flex: 1;
		font-size: 28rpx;
		color: #1a1a1a;
	}
	.search-placeholder {
		color: #9aa3af;
		font-size: 28rpx;
	}
	.clear-btn {
		font-size: 26rpx;
		color: #9aa3af;
		padding-left: 12rpx;
	}
	.body {
		flex: 1;
		height: 0;
	}
	.hint-wrap {
		padding: 80rpx 48rpx;
		align-items: center;
	}
	.hint-text {
		font-size: 26rpx;
		color: #9aa3af;
		text-align: center;
		line-height: 40rpx;
	}
	.result-list {
		flex-direction: column;
	}
	.loading-row, .empty-row {
		padding: 60rpx;
		align-items: center;
	}
	.loading-text, .empty-text {
		font-size: 28rpx;
		color: #9aa3af;
		text-align: center;
	}
	.user-row {
		background-color: #ffffff;
		flex-direction: row;
		align-items: center;
		padding: 24rpx 32rpx;
