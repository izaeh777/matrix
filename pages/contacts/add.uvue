	}
	.user-row {
		background-color: #ffffff;
		flex-direction: row;
		align-items: center;
		padding: 24rpx 32rpx;
		border-bottom-width: 1rpx;
		border-bottom-color: #f0f2f5;
		border-bottom-style: solid;
	}
	.manual-row {
		margin-top: 16rpx;
		border-top-width: 1rpx;
		border-top-color: #eef0f3;
		border-top-style: solid;
	}
	.avatar {
		width: 88rpx;
		height: 88rpx;
		border-radius: 44rpx;
		background-color: #e5e7eb;
	}
	.manual-avatar {
		width: 88rpx;
		height: 88rpx;
		border-radius: 44rpx;
		background-color: #e8f0ff;
		align-items: center;
		justify-content: center;
	}
	.manual-avatar-text {
		font-size: 40rpx;
		color: #1861c8;
	}
	.user-info {
		flex: 1;
		margin-left: 24rpx;
		flex-direction: column;
	}
	.user-name {
		font-size: 30rpx;
		color: #1a1a1a;
		font-weight: 600;
	}
	.user-id {
		font-size: 24rpx;
		color: #9aa3af;
		margin-top: 6rpx;
	}
	.add-tag {
		font-size: 26rpx;
		color: #1861c8;
		font-weight: 600;
	}
</style>
