<template>
	<view class="add-page">
		<!-- #ifdef APP -->
		<view class="status-bar-holder"></view>
		<!-- #endif -->
		<view class="topbar">
			<view class="back-btn" @click="goBack">
				<text class="back-text">‹</text>
			</view>
			<text class="topbar-title">{{ t('contact.addTitle') }}</text>
			<view class="topbar-right" @click="onScan">
				<text class="scan-btn">{{ t('contact.scan') }}</text>
			</view>
		</view>

		<view class="search-bar">
			<view class="search-input-wrap">
				<text class="search-icon">⌕</text>
				<input
					class="search-input"
					v-model="searchText"
					:placeholder="t('contact.searchPh')"
					placeholder-class="search-placeholder"
					focus
					@confirm="onSearch"
					@input="onSearchInput"
				/>
				<text v-if="searchText.length > 0" class="clear-btn" @click="clearSearch">✕</text>
			</view>
		</view>

		<scroll-view class="body" direction="vertical" :show-scrollbar="false" :rebound="false">
			<view v-if="searchText.length == 0" class="hint-wrap">
				<text class="hint-text">{{ t('contact.hint') }}</text>
			</view>
			<view v-else class="result-list">
				<view v-if="searching" class="loading-row">
					<text class="loading-text">{{ t('contact.searching') }}</text>
				</view>
				<view
					v-for="user in results"
					:key="user.imUser"
					class="user-row"
					@click="onStartChat(user)"
				>
					<image class="avatar" :src="getAvatar(user)" mode="aspectFill"></image>
					<view class="user-info">
						<text class="user-name">{{ user.nickname.length > 0 ? user.nickname : user.username }}</text>
						<text class="user-id">{{ user.username }}</text>
					</view>
					<text class="add-tag">{{ t('contact.add') }}</text>
				</view>
				<view v-if="!searching && results.length == 0" class="empty-row">
					<text class="empty-text">{{ t('contact.notFound') }}</text>
				</view>
			</view>
		</scroll-view>
	</view>
</template>

<script setup lang="uts">
	import { ref, onUnmounted } from 'vue'
	import { t } from '@/common/i18n.uts'
	import { getMatrix, errText } from '@/common/matrix.uts'
	import { openChat } from '@/common/app.uts'
	import { findFriendByUsername, FindFriendItem } from '@/common/platform.uts'
	import { scanAddFriendOrInvite } from '@/common/deeplink.uts'

	type FriendRow = {
		nickname: string
		username: string
		imUser: string
		avatar_url: string
	}

	const searchText = ref<string>('')
	const searching = ref<boolean>(false)
	const results = ref<Array<FriendRow>>([])
	let searchTimer: number | null = null
	let searchSeq: number = 0

	function goBack(): void {
		uni.navigateBack({})
	}

	function onScan(): void {
		scanAddFriendOrInvite()
	}

	function clearSearch(): void {
		searchText.value = ''
		results.value = []
	}

	function getAvatar(user: FriendRow): string {
		const matrix = getMatrix()
		if (matrix == null) return '/static/login/tiki.png'
		if (user.avatar_url.length > 0) {
			const http = matrix.mxcToHttp(user.avatar_url, 80, 80)
			if (http.length > 0) return http
		}
		return '/static/login/tiki.png'
	}

	async function loadAvatar(imUser: string): Promise<string> {
		const matrix = getMatrix()
		if (matrix == null || imUser.length == 0) return ''
		try {
			const found = await matrix.searchUsers(imUser)
			if (found.length > 0 && found[0].avatar_url.length > 0) return found[0].avatar_url
		} catch (e0) {}
		try {
			const profile = await matrix.getProfile(imUser)
			return profile.avatar_url
		} catch (e1) {}
		return ''
	}

	async function onSearch(): Promise<void> {
		const term = searchText.value.trim()
		if (term.length == 0) {
			results.value = []
			return
		}
		searchSeq++
		const seq = searchSeq
		searching.value = true
		try {
			const friends = await findFriendByUsername(term)
			if (seq != searchSeq) return
			const list: Array<FriendRow> = [] as FriendRow[]
			for (let i = 0; i < friends.length; i++) {
				const f = friends[i] as FindFriendItem
				if (f.imUser.length == 0) continue
				const avatar = await loadAvatar(f.imUser)
				if (seq != searchSeq) return
				list.push({
					nickname: f.nickname,
					username: f.username,
					imUser: f.imUser,
					avatar_url: avatar
				} as FriendRow)
			}
			results.value = list
		} catch (e) {
			if (seq == searchSeq) results.value = []
		}
		if (seq == searchSeq) searching.value = false
	}

	function onSearchInput(): void {
		const t = searchTimer
		searchTimer = null
		if (t != null) {
			clearTimeout(t)
		}
		searchTimer = setTimeout(() => {
			onSearch()
		}, 400) as number | null
	}

	async function onStartChat(user: FriendRow): Promise<void> {
		const matrix = getMatrix()
		if (matrix == null) return
		if (user.imUser == matrix.userId) {
			uni.showToast({ title: t('contact.selfChat'), icon: 'none' })
			return
		}
		uni.showLoading({ title: t('contact.opening') })
		try {
			const roomId = await matrix.startDM(user.imUser)
			uni.hideLoading()
			openChat(roomId)
		} catch (e) {
			uni.hideLoading()
			uni.showToast({ title: t('contact.startFail') + ': ' + errText(e, ''), icon: 'none' })
		}
	}

	onUnmounted(() => {
		const t = searchTimer
		searchTimer = null
		if (t != null) clearTimeout(t)
	})
</script>

