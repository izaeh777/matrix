<template>
	<view class="splash">
		<image class="logo" src="/static/logo.png"></image>
		<text class="title">{{ title }}</text>
	</view>
</template>

<script setup lang="uts">
	import { ref } from 'vue'
	import { loadSession } from '@/common/storage.uts'
	import { loadPlatformSession } from '@/common/platform.uts'
	import { bootstrapMatrix } from '@/common/app.uts'

	const title = ref('i-tiklink')

	onLoad(() => {
		const matrix = loadSession()
		const platform = loadPlatformSession()
		if (matrix != null) {
			bootstrapMatrix()
			setTimeout(() => {
				uni.reLaunch({ url: '/pages/home/home' })
			}, 200)
		} else if (platform != null) {
			setTimeout(() => {
				uni.reLaunch({ url: '/pages/home/home' })
			}, 200)
		} else {
			setTimeout(() => {
				uni.reLaunch({ url: '/pages/login/login' })
			}, 200)
		}
	})
</script>

<style>
	.splash {
		flex: 1;
		background-color: #fff;
		justify-content: center;
		align-items: center;
	}

	.logo {
		height: 120px;
		width: 120px;
	}

	.title {
		font-size: 22px;
		color: #555;
		margin-top: 24px;
	}
</style>
