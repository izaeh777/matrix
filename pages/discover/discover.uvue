<template>
	<view class="discover-page">
		<!-- #ifdef APP -->
		<view class="status-bar-holder"></view>
		<!-- #endif -->
		<view class="search-wrap">
			<view class="search-box" @click="onSearchBoxTap">
				<view v-if="keyword.length == 0 && !searchFocused" class="search-placeholder">
					<text class="search-ico">⌕</text>
					<text class="search-ph-text">{{ t('discover.searchPh') }}</text>
				</view>
				<view v-else class="search-inner">
					<text class="search-ico">⌕</text>
					<input
						class="search-input"
						v-model="keyword"
						:placeholder="t('discover.searchPh')"
						placeholder-class="search-ph"
						confirm-type="search"
						:focus="searchFocused"
						@confirm="onSearch"
						@blur="onSearchBlur"
					/>
				</view>
			</view>
		</view>

		<!-- #ifdef H5 -->
		<view class="tabs-h5">
			<view class="tabs-row">
				<view
					v-for="tab in tabs"
					:key="'c' + tab.id"
					class="tab"
					:class="{ 'tab-on': tab.id == activeTabId }"
					@click="onTab(tab)"
				>
					<text class="tab-text" :class="{ 'tab-text-on': tab.id == activeTabId }">{{ tabLabel(tab) }}</text>
					<view v-if="tab.id == activeTabId" class="tab-line"></view>
				</view>
			</view>
		</view>
		<!-- #endif -->
		<!-- #ifndef H5 -->
		<scroll-view class="tabs" direction="horizontal" :show-scrollbar="false">
			<view class="tabs-row">
				<view
					v-for="tab in tabs"
					:key="'c' + tab.id"
					class="tab"
					:class="{ 'tab-on': tab.id == activeTabId }"
					@click="onTab(tab)"
				>
					<text class="tab-text" :class="{ 'tab-text-on': tab.id == activeTabId }">{{ tabLabel(tab) }}</text>
					<view v-if="tab.id == activeTabId" class="tab-line"></view>
				</view>
			</view>
		</scroll-view>
		<!-- #endif -->

		<scroll-view
			class="body"
			direction="vertical"
			:show-scrollbar="false"
			:lower-threshold="120"
			@scrolltolower="onScrollToLower"
		>
			<view class="banner">
				<view class="banner-text">
					<text class="banner-title">{{ t('discover.bannerTitle') }}</text>
					<text class="banner-sub">{{ t('discover.bannerSub') }}</text>
					<view v-if="canPublish" class="banner-btn" @click="goPublish">
						<text class="banner-btn-text">{{ t('home.publish') }}</text>
					</view>
				</view>
			</view>

			<view v-if="loading && leftCol.length == 0 && rightCol.length == 0" class="empty">
				<text class="empty-text">{{ t('common.loading') }}</text>
			</view>
			<view v-else-if="!loading && leftCol.length == 0 && rightCol.length == 0" class="empty">
				<text class="empty-text">{{ t('common.empty') }}</text>
			</view>
			<view v-else class="waterfall">
				<view class="waterfall-col">
					<view
						v-for="(cell, idx) in leftCol"
						:key="'l' + cell.item.id + '-' + idx"
						class="wf-card"
						@click="onOpen(cell.item)"
					>
						<view class="wf-cover-wrap" :style="{ height: cell.coverH + 'rpx' }">
							<image
								v-if="coverOf(cell.item).length > 0"
								class="wf-cover"
								:src="coverOf(cell.item)"
								mode="aspectFill"
							></image>
							<view v-else class="wf-cover wf-cover-fallback"></view>
							<view v-if="cell.isHot || cell.isNew" class="badge-row">
								<view v-if="cell.isHot" class="badge badge-hot">
									<text class="badge-text">{{ t('discover.hot') }}</text>
								</view>
								<view v-if="cell.isNew" class="badge badge-new">
									<text class="badge-text">{{ t('discover.latest') }}</text>
								</view>
							</view>
						</view>
						<text class="wf-title">{{ cell.item.title }}</text>
						<text v-if="descOf(cell.item).length > 0" class="wf-desc">{{ descOf(cell.item) }}</text>
						<view class="stat-row">
							<text class="stat">★ {{ cell.item.likes }}</text>
							<text class="stat">◎ {{ cell.item.views }}</text>
						</view>
					</view>
				</view>
				<view class="waterfall-col">
					<view
						v-for="(cell, idx) in rightCol"
						:key="'r' + cell.item.id + '-' + idx"
						class="wf-card"
						@click="onOpen(cell.item)"
					>
						<view class="wf-cover-wrap" :style="{ height: cell.coverH + 'rpx' }">
							<image
								v-if="coverOf(cell.item).length > 0"
								class="wf-cover"
								:src="coverOf(cell.item)"
								mode="aspectFill"
							></image>
							<view v-else class="wf-cover wf-cover-fallback"></view>
							<view v-if="cell.isHot || cell.isNew" class="badge-row">
								<view v-if="cell.isHot" class="badge badge-hot">
									<text class="badge-text">{{ t('discover.hot') }}</text>
								</view>
								<view v-if="cell.isNew" class="badge badge-new">
									<text class="badge-text">{{ t('discover.latest') }}</text>
								</view>
							</view>
						</view>
						<text class="wf-title">{{ cell.item.title }}</text>
						<text v-if="descOf(cell.item).length > 0" class="wf-desc">{{ descOf(cell.item) }}</text>
						<view class="stat-row">
							<text class="stat">★ {{ cell.item.likes }}</text>
							<text class="stat">◎ {{ cell.item.views }}</text>
						</view>
					</view>
				</view>
			</view>
			<view v-if="loadingMore" class="more-row">
				<text class="more-text">{{ t('common.loading') }}</text>
			</view>
			<view v-else-if="!hasMore && (leftCol.length > 0 || rightCol.length > 0)" class="more-row">
				<text class="more-text">{{ t('common.noMore') }}</text>
			</view>
			<view class="scroll-pad"></view>
		</scroll-view>

		<view v-if="canPublish" class="fab" @click="goPublish">
			<text class="fab-text">＋</text>
		</view>

		<view class="wx-tabbar" :style="tabbarPadStyle">
			<view class="wx-tab" @click="goHome">
				<image class="wx-tab-icon" src="/static/login/s11.png" mode="aspectFit"></image>
			</view>
			<view class="wx-tab" @click="goRooms">
				<image class="wx-tab-icon" src="/static/login/s22.png" mode="aspectFit"></image>
			</view>
			<view class="wx-tab wx-tab-on">
				<image class="wx-tab-icon" src="/static/login/s3.png" mode="aspectFit"></image>
			</view>
			<view class="wx-tab" @click="goNotify">
				<image class="wx-tab-icon" src="/static/login/s44.png" mode="aspectFit"></image>
			</view>
			<view class="wx-tab" @click="goProfile">
				<image class="wx-tab-icon" src="/static/login/s55.png" mode="aspectFit"></image>
			</view>
		</view>
	</view>
</template>

<script setup lang="uts">
	import { ref, onMounted } from 'vue'
	import {
		fetchProjects,
		fetchProjectCategories,
		cmsAssetUrl,
		cmsHttpBase,
		openProjectDetail,
		CmsArchiveItem,
		CmsProjectCategory
	} from '@/common/cms.uts'
	import {
		fetchPlatformMe,
		canPublishProject,
		loadCachedVipLabel
	} from '@/common/platform.uts'
	import { t as __i18nT } from '@/common/i18n.uts'
	import { tabbarPadBottomStyle } from '@/common/app.uts'
	function t(key: string): string {
		return __i18nT(key)
	}
	const tabbarPadStyle = tabbarPadBottomStyle()

	type DiscoverTab = {
		id: number
		name: string
	}

	const tabs = ref<Array<DiscoverTab>>([
		{ id: 0, name: t('api.catAll') } as DiscoverTab
	] as Array<DiscoverTab>)
	const activeTabId = ref<number>(0)
	const keyword = ref<string>('')
	const searchFocused = ref<boolean>(false)
	const loading = ref<boolean>(false)
	const loadingMore = ref<boolean>(false)
	const page = ref<number>(1)
	const pageSize = 10
	const total = ref<number>(0)
	const hasMore = ref<boolean>(true)
	const canPublish = ref<boolean>(canPublishProject(loadCachedVipLabel()))

	function onSearchBoxTap(): void {
		searchFocused.value = true
	}
	function onSearchBlur(): void {
		searchFocused.value = false
	}
	type WaterfallCell = {
		item: CmsArchiveItem
		coverH: number
		isHot: boolean
		isNew: boolean
	}

	const leftCol = ref<Array<WaterfallCell>>([] as Array<WaterfallCell>)
	const rightCol = ref<Array<WaterfallCell>>([] as Array<WaterfallCell>)

	function coverOf(item: CmsArchiveItem): string {
		const img = item.image
		if (img.length == 0) return ''
		if (img.indexOf('blob:') == 0) return ''
		if (img.indexOf('/assets/') == 0) return cmsHttpBase() + img
		return cmsAssetUrl(img)
	}

	function stripHtml(raw: string): string {
		let s = raw.trim()
		if (s.length == 0) return ''
		let out = ''
		let i = 0
		while (i < s.length) {
			const c = s.charAt(i)
			if (c == '<') {
				const j = s.indexOf('>', i)
				if (j < 0) break
				i = j + 1
				continue
			}
			out += c
			i++
		}
		out = out.split('&nbsp;').join(' ')
		out = out.split('&lt;').join('<')
		out = out.split('&gt;').join('>')
		out = out.split('&amp;').join('&')
		out = out.split('\n').join(' ').trim()
		while (out.indexOf('  ') >= 0) {
			out = out.split('  ').join(' ')
		}
		return out
	}

	function descOf(item: CmsArchiveItem): string {
		const plain = stripHtml(item.description)
		if (plain.length == 0) return ''
		if (plain.length <= 48) return plain
		return plain.substring(0, 48) + '…'
	}

	function coverHOf(item: CmsArchiveItem): number {
		const m = item.id % 3
		if (m == 0) return 280
		if (m == 1) return 220
		return 340
	}

	function colEstHeight(col: Array<WaterfallCell>): number {
		let h = 0
		for (let i = 0; i < col.length; i++) {
			h += col[i].coverH + 120
		}
		return h
	}

	function applyWaterfall(list: Array<CmsArchiveItem>, append: boolean): void {
		const left: Array<WaterfallCell> = append ? leftCol.value.slice(0) : ([] as Array<WaterfallCell>)
		const right: Array<WaterfallCell> = append ? rightCol.value.slice(0) : ([] as Array<WaterfallCell>)
		let leftH = colEstHeight(left)
		let rightH = colEstHeight(right)
		for (let i = 0; i < list.length; i++) {
			const it = list[i]
			const coverH = coverHOf(it)
			const cell: WaterfallCell = {
				item: it,
				coverH: coverH,
				isHot: it.is_hot == 1,
				isNew: it.is_new == 1
			} as WaterfallCell
			const est = coverH + 120
			if (leftH <= rightH) {
				left.push(cell)
				leftH += est
			} else {
				right.push(cell)
				rightH += est
			}
		}
		leftCol.value = left
		rightCol.value = right
	}

	function tabLabel(tab: DiscoverTab): string {
		return tab.name
	}

	function onOpen(item: CmsArchiveItem): void {
		openProjectDetail(item.id)
	}

	function goHome(): void {
		uni.redirectTo({ url: '/pages/home/home' })
	}
	function goRooms(): void {
		uni.redirectTo({ url: '/pages/rooms/rooms' })
	}
	function goNotify(): void {
		uni.redirectTo({ url: '/pages/notify/notify' })
	}
	function goProfile(): void {
		uni.redirectTo({ url: '/pages/profile/profile' })
	}
	function goPublish(): void {
		if (!canPublish.value) {
			uni.showToast({ title: t('pub.visitorBlock'), icon: 'none' })
			return
		}
		uni.navigateTo({ url: '/pages/project/publish' })
	}

	async function refreshPublishGate(): Promise<void> {
		try {
			const me = await fetchPlatformMe()
			canPublish.value = canPublishProject(me.vip_label)
		} catch (e) {
			canPublish.value = canPublishProject(loadCachedVipLabel())
		}
	}

	async function loadCategories(): Promise<void> {
		try {
			const rows = await fetchProjectCategories()
			const next: Array<DiscoverTab> = []
			next.push({ id: 0, name: t('api.catAll') } as DiscoverTab)
			for (let i = 0; i < rows.length; i++) {
				const c = rows[i] as CmsProjectCategory
				next.push({ id: c.id, name: c.name } as DiscoverTab)
			}
			tabs.value = next
		} catch (e) {
			console.warn('加载分类失败', e)
		}
	}

	async function loadData(reset: boolean): Promise<void> {
		if (reset) {
			if (loading.value) return
			page.value = 1
			hasMore.value = true
			total.value = 0
			loading.value = true
		} else {
			if (loading.value || loadingMore.value || !hasMore.value) return
			loadingMore.value = true
		}
		const reqPage = page.value
		try {
			const res = await fetchProjects(activeTabId.value, keyword.value.trim(), reqPage, pageSize)
			total.value = res.total
			applyWaterfall(res.list, !reset)
			const loaded = leftCol.value.length + rightCol.value.length
			if (res.list.length == 0 || loaded >= res.total || res.list.length < pageSize) {
				hasMore.value = false
			} else {
				hasMore.value = true
				page.value = reqPage + 1
			}
		} catch (e) {
			console.warn('加载发现失败', e)
			if (reset) {
				leftCol.value = [] as Array<WaterfallCell>
				rightCol.value = [] as Array<WaterfallCell>
				hasMore.value = false
			}
		}
		loading.value = false
		loadingMore.value = false
	}

	function onScrollToLower(): void {
		loadData(false)
	}

	function onTab(tab: DiscoverTab): void {
		activeTabId.value = tab.id
		loadData(true)
	}

	async function onSearch(): Promise<void> {
		await loadData(true)
	}

	onMounted(() => {
		loadCategories().then(() => {
			loadData(true)
		})
		refreshPublishGate()
	})

	onShow(() => {
		refreshPublishGate()
	})
</script>

<style>
