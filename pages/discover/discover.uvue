	}
	.wf-cover-wrap {
		width: 100%;
		border-radius: 20rpx;
		overflow: hidden;
		margin-bottom: 12rpx;
		position: relative;
		background-color: #e8eef8;
	}
	.wf-cover {
		width: 100%;
		height: 100%;
	}
	.wf-cover-fallback {
		width: 100%;
		height: 100%;
		background-color: #93c5fd;
	}
	.badge-row {
		position: absolute;
