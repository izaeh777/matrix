		overflow: hidden;
	}
	.banner-title {
		font-size: 40rpx;
		font-weight: 800;
		color: #ffffff;
		margin-bottom: 12rpx;
	}
	.banner-sub {
		font-size: 24rpx;
		color: #dbeafe;
		margin-bottom: 24rpx;
	}
	.banner-btn {
		align-self: flex-start;
		background-color: #3b82f6;
		border-radius: 28rpx;
		padding: 12rpx 24rpx;
	}
	.banner-btn-text {
		font-size: 22rpx;
		color: #ffffff;
	}
	.waterfall {
		flex-direction: row;
		align-items: flex-start;
		padding: 0 20rpx 8rpx;
	}
	.waterfall-col {
		flex: 1;
