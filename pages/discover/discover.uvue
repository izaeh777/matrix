	.tabs {
		width: 100%;
		height: 80rpx;
		padding: 8rpx 0 4rpx;
	}
	.tabs-h5 {
		width: 100%;
		height: 80rpx;
		padding: 8rpx 0 4rpx;
		/* #ifdef H5 */
		overflow-x: auto;
		overflow-y: hidden;
		/* #endif */
	}
	.tabs-row {
		flex-direction: row;
		flex-wrap: nowrap;
		padding: 0 16rpx;
		align-items: center;
		/* #ifdef H5 */
		width: max-content;
		/* #endif */
	}
	.tab {
		padding: 12rpx 22rpx 16rpx;
		align-items: center;
		flex-shrink: 0;
	}
	.tab-text {
		font-size: 30rpx;
		color: #6b7280;
	}
	.tab-text-on {
		color: #2f6ff2;
