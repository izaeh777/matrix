<script setup lang="uts">
	import { ref, onMounted } from 'vue'
	import {
		fetchCmsHome,
		searchCmsArchives,
		fetchChannelArchives,
		cmsAssetUrl,
		openArchiveDetail,
		CmsArchiveItem
	} from '@/common/cms.uts'

	const tabs: Array<string> = ['全部', '金融', '直播', 'Web3', 'Defi', '项目']
	const activeTab = ref<string>('全部')
	const keyword = ref<string>('')
	const searchFocused = ref<boolean>(false)
	const loading = ref<boolean>(false)

	function onSearchBoxTap(): void {
		searchFocused.value = true
	}
	function onSearchBlur(): void {
		searchFocused.value = false
	}
	const hotList = ref<Array<CmsArchiveItem>>([])
	const latestList = ref<Array<CmsArchiveItem>>([])

	function coverOf(item: CmsArchiveItem): string {
		return cmsAssetUrl(item.image)
	}

	function tvlOf(item: CmsArchiveItem): number {
		const n = item.views
		if (n <= 0) return 163
		return 100 + (n % 800)
	}

	function rowWidth(count: number): string {
		if (count <= 0) return '100%'
		return (count * 320 + 40) + 'rpx'
	}

	function tabDiyname(tab: string): string {
		if (tab == '金融') return 'investment'
		if (tab == '直播') return 'internet'
		if (tab == 'Web3') return 'product'
		if (tab == 'Defi') return 'smarthome'
		if (tab == '项目') return 'download'
		return ''
	}

	function onOpen(item: CmsArchiveItem): void {
		openArchiveDetail(item.id)
	}

	function goHome(): void {
		uni.redirectTo({ url: '/pages/home/home' })
	}
	function goRooms(): void {
		uni.redirectTo({ url: '/pages/rooms/rooms' })
	}
	function goNotify(): void {
		uni.redirectTo({ url: '/pages/notify/notify' })
	}
	function goProfile(): void {
		uni.redirectTo({ url: '/pages/profile/profile' })
	}
	function goPublish(): void {
		uni.navigateTo({ url: '/pages/project/publish' })
	}

	async function loadData(): Promise<void> {
		loading.value = true
		try {
			const home = await fetchCmsHome()
			let hot = home.hot
			let latest = home.latest
			const tab = activeTab.value
			if (tab != '全部') {
				const filtered: Array<CmsArchiveItem> = []
				const all: Array<CmsArchiveItem> = []
				for (let i = 0; i < hot.length; i++) all.push(hot[i])
				for (let j = 0; j < latest.length; j++) all.push(latest[j])
				for (let k = 0; k < all.length; k++) {
					const t = all[k].title
					const d = all[k].description
					if (t.indexOf(tab) >= 0 || d.indexOf(tab) >= 0) filtered.push(all[k])
				}
				if (filtered.length > 0) {
					hot = filtered
					latest = filtered
				} else {
					const diy = tabDiyname(tab)
					if (diy.length > 0) {
						try {
							const more = await fetchChannelArchives(0, '', diy)
							if (more.length > 0) {
								hot = more
								latest = more
							}
						} catch (e2) {}
					}
				}
			}
			hotList.value = hot
			latestList.value = latest
		} catch (e) {
			console.warn('加载发现失败', e)
		}
		loading.value = false
	}

	function onTab(tab: string): void {
		activeTab.value = tab
		loadData()
	}

	async function onSearch(): Promise<void> {
		const kw = keyword.value.trim()
		if (kw.length == 0) {
			loadData()
			return
		}
		loading.value = true
		try {
			const list = await searchCmsArchives(kw)
			hotList.value = list
			latestList.value = list
		} catch (e) {
			console.warn('搜索失败', e)
		}
		loading.value = false
	}

	onMounted(() => {
		loadData()
	})
</script>

