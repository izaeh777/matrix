		flex: 1;
		background-color: #f3f7fc;
		flex-direction: column;
		position: relative;
	}
	.search-wrap {
		padding: 56rpx 40rpx 20rpx;
		background-color: #f3f7fc;
	}
	.search-box {
		flex-direction: row;
		align-items: center;
		justify-content: center;
		background-color: #ffffff;
		border-radius: 999rpx;
		height: 88rpx;
		padding: 0 36rpx;
		box-shadow: 0 10rpx 28rpx rgba(60, 100, 160, 0.10);
	}
	.search-placeholder {
		flex-direction: row;
		align-items: center;
		justify-content: center;
	}
	.search-ph-text {
		font-size: 28rpx;
		color: #9aa3af;
		line-height: 44rpx;
	}
	.search-inner {
		flex-direction: row;
		align-items: center;
		flex: 1;
	}
	.search-ico {
		font-size: 44rpx;
		color: #9aa3af;
		margin-right: 14rpx;
		margin-top: -6rpx;
		line-height: 44rpx;
		height: 44rpx;
		transform: scaleX(-1);
	}
	.search-input {
		flex: 1;
		font-size: 28rpx;
		color: #1a1a1a;
		height: 88rpx;
	}
