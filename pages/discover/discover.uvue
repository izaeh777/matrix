		position: absolute;
		right: 36rpx;
		bottom: 160rpx;
		width: 96rpx;
		height: 96rpx;
		border-radius: 48rpx;
		background-color: #2f6ff2;
		align-items: center;
		justify-content: center;
		z-index: 20;
	}
