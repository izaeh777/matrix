<template>
	<view class="group-page">
		<!-- #ifdef APP -->
		<view class="status-bar-holder"></view>
		<!-- #endif -->
		<view class="topbar">
			<view class="back-btn" @click="goBack">
				<image class="back-icon" src="/static/login/f.png" mode="aspectFit"></image>
			</view>
			<text class="topbar-title">{{ pageTitle }}</text>
			<view class="topbar-right"></view>
		</view>
		<scroll-view class="group-scroll" scroll-y>
			<view class="card">
				<view class="member-grid">
					<view
						v-for="m in previewMembers"
						:key="m.user_id"
						class="member-cell"
					>
						<view class="member-avatar-box">
							<image class="member-avatar" :src="memberAvatar(m)" mode="aspectFill"></image>
						</view>
						<text class="member-name">{{ memberLabel(m) }}</text>
					</view>
					<view class="member-cell" @click="onInvite">
						<view class="member-add">
							<text class="member-add-text">+</text>
						</view>
						<text class="member-name">{{ t('group.add') }}</text>
					</view>
					<view v-if="canKick" class="member-cell" @click="onRemove">
						<view class="member-add">
							<text class="member-add-text">-</text>
						</view>
						<text class="member-name">{{ t('group.remove') }}</text>
					</view>
				</view>
				<view v-if="showMoreMembers" class="more-members" @click="showAllMembers">
					<text class="more-members-text">{{ t('group.allMembers') }}</text>
					<text class="cell-arrow">›</text>
				</view>
			</view>

			<view v-if="isGroup" class="card">
				<view class="cell" @click="editName">
					<text class="cell-label">{{ t('group.name') }}</text>
					<text class="cell-value">{{ roomName }}</text>
					<text class="cell-arrow">›</text>
				</view>
				<view class="cell" @click="editTopic">
					<text class="cell-label">{{ t('group.notice') }}</text>
					<text class="cell-value">{{ topicText }}</text>
					<text class="cell-arrow">›</text>
				</view>
			</view>

			<view class="card">
				<view class="cell" @click="onSearchChat">
					<text class="cell-label">{{ t('group.searchHistory') }}</text>
					<text class="cell-arrow">›</text>
				</view>
			</view>

			<view class="card">
				<view class="cell" @click="toggleMute">
					<text class="cell-label">{{ t('group.mute') }}</text>
					<view class="wx-switch" :class="muted ? 'wx-switch-on' : ''">
						<view class="wx-switch-dot"></view>
					</view>
				</view>
				<view class="cell" @click="togglePin">
					<text class="cell-label">{{ t('group.pin') }}</text>
					<view class="wx-switch" :class="pinned ? 'wx-switch-on' : ''">
						<view class="wx-switch-dot"></view>
					</view>
				</view>
			</view>

			<view class="leave-wrap">
				<view class="leave-btn" @click="onLeave">
					<text class="leave-text">{{ isGroup ? t('group.leave') : t('group.deleteChat') }}</text>
				</view>
			</view>
		</scroll-view>
	</view>
</template>

<script setup lang="uts">
	import { ref, computed } from 'vue'
	import { t as __i18nT } from '@/common/i18n.uts'

	import { getMatrix, errText, RoomMember, roomIsGroup, memberDisplayName, MatrixRoom } from '@/common/matrix.uts'
	import { openGroupPick, openGroupMembers } from '@/common/app.uts'
	import { defaultAvatar } from '@/common/avatar.uts'
	function t(key: string): string {
		return __i18nT(key)
	}

	/** 微信：每行 5 个，折叠最多 3 行；末尾留给 + / - */
	const MEMBER_COLS = 5
	const MEMBER_MAX_ROWS = 3

	const roomId = ref<string>('')
	const roomName = ref<string>('')
	const topic = ref<string>('')
	const isGroup = ref<boolean>(true)
	const members = ref<Array<RoomMember>>([])
	const muted = ref<boolean>(false)
	const pinned = ref<boolean>(false)
	const canKick = ref<boolean>(false)
	/** 从加/移成员页返回时强制刷新一次成员 */
	let membersNeedRefresh = false

	const pageTitle = computed((): string => {
		if (isGroup.value) {
			const n = members.value.length
			if (n > 0) return t('group.info') + '(' + n + ')'
			return t('group.info')
		}
		return t('group.info')
	})

	/** 两人会话：头像区不展示自己；群聊展示全部 */
	const visibleMembers = computed((): Array<RoomMember> => {
		const list = members.value
		if (list.length != 2) return list
		const matrix = getMatrix()
		if (matrix == null) return list
		const me = matrix.userId
		if (me.length == 0) return list
		const out: Array<RoomMember> = []
		for (let i = 0; i < list.length; i++) {
			if (list[i].user_id != me) out.push(list[i])
		}
		return out
	})

	const maxPreviewCount = computed((): number => {
		const actions = canKick.value ? 2 : 1
		const slots = MEMBER_COLS * MEMBER_MAX_ROWS
		const n = slots - actions
		return n > 0 ? n : 1
	})

	/** 折叠后的成员预览 */
	const previewMembers = computed((): Array<RoomMember> => {
		const list = visibleMembers.value
		const max = maxPreviewCount.value
		if (list.length <= max) return list
		const out: Array<RoomMember> = []
		for (let i = 0; i < max; i++) {
			out.push(list[i])
		}
		return out
	})

	const showMoreMembers = computed((): boolean => {
		if (!isGroup.value) return false
		return visibleMembers.value.length > maxPreviewCount.value
	})

	const topicText = computed((): string => {
		if (topic.value.length > 0) return topic.value
		return t('group.unset')
	})

	function goBack(): void {
		uni.navigateBack()
	}

	function memberLabel(m: RoomMember): string {
		return memberDisplayName(m)
	}

	function memberAvatar(m: RoomMember): string {
		const matrix = getMatrix()
		if (matrix == null) return defaultAvatar(m.user_id)
		const av = m.avatar_url
		if (av != null && av.length > 0) {
			const http = matrix.mxcToHttp(av, 80, 80)
			if (http.length > 0) return http
		}
		return defaultAvatar(m.user_id)
	}

	function applySummary(summary: MatrixRoom): void {
		isGroup.value = roomIsGroup(summary)
		const n = summary.name
		if (n != null && n.length > 0) roomName.value = n
		const t = summary.topic
		if (t != null) topic.value = t
		if (summary.favourite == true) pinned.value = true
		if (summary.muted == true) muted.value = true
	}

	async function loadInfo(forceMembers: boolean = false): Promise<void> {
		const matrix = getMatrix()
		if (matrix == null) return
		if (roomId.value.length == 0) return
		// 成员与摘要并行：不再每次 invalidate，避免清掉缓存后连打两个重接口
		const membersPromise = matrix.getRoomMembers(roomId.value, forceMembers)
		try {
			const summary = await matrix.getRoomSummary(roomId.value)
			applySummary(summary)
		} catch (e) {}
		try {
			const list = await membersPromise
			const joined: Array<RoomMember> = []
			for (let i = 0; i < list.length; i++) {
				if (list[i].membership == 'join' || list[i].membership == 'invite') {
					joined.push(list[i])
				}
			}
			members.value = joined
		} catch (e) {}
		muted.value = matrix.isRoomMuted(roomId.value)
		pinned.value = matrix.isRoomFavourite(roomId.value)
		try {
			// 仅群主/管理员（power >= 50）可移出；普通成员不显示「移出」
			const manage = await matrix.canManageRoom(roomId.value)
			canKick.value = manage && members.value.length > 2
		} catch (e2) {
			canKick.value = false
		}
	}

	function onInvite(): void {
		membersNeedRefresh = true
		openGroupPick('invite', roomId.value)
	}

	function onRemove(): void {
		membersNeedRefresh = true
		openGroupPick('remove', roomId.value)
	}

	function showAllMembers(): void {
		openGroupMembers(roomId.value)
	}

	async function saveName(name: string): Promise<void> {
		const matrix = getMatrix()
		if (matrix == null) return
		try {
			await matrix.setRoomName(roomId.value, name)
			roomName.value = name
			uni.showToast({ title: t('group.updated'), icon: 'success' })
		} catch (e) {
			uni.showToast({ title: errText(e, t('group.updateFail')), icon: 'none' })
		}
	}

	function editName(): void {
		uni.showModal({
			title: t('group.name'),
			editable: true,
			content: roomName.value,
			success: (res) => {
				if (!res.confirm) return
				const raw = res.content
				const name = (raw != null) ? raw.trim() : ''
				if (name.length == 0) return
				saveName(name)
			}
		})
	}

	async function saveTopic(text: string): Promise<void> {
		const matrix = getMatrix()
		if (matrix == null) return
		try {
			await matrix.setRoomTopic(roomId.value, text)
			topic.value = text
			uni.showToast({ title: t('group.updated'), icon: 'success' })
		} catch (e) {
			uni.showToast({ title: errText(e, t('group.updateFail')), icon: 'none' })
		}
	}

	function editTopic(): void {
		uni.showModal({
			title: t('group.notice'),
			editable: true,
			content: topic.value,
			success: (res) => {
				if (!res.confirm) return
				const raw = res.content
				const text = (raw != null) ? raw.trim() : ''
				saveTopic(text)
			}
		})
	}

	function onSearchChat(): void {
		uni.navigateTo({ url: '/pages/search/search?roomId=' + encodeURIComponent(roomId.value) })
	}

	async function toggleMute(): Promise<void> {
		const matrix = getMatrix()
		if (matrix == null) return
		const next = !muted.value
		try {
			await matrix.setRoomMuted(roomId.value, next)
			muted.value = next
		} catch (e) {
			uni.showToast({ title: errText(e, t('group.setFail')), icon: 'none' })
		}
	}

	async function togglePin(): Promise<void> {
		const matrix = getMatrix()
		if (matrix == null) return
		const next = !pinned.value
		try {
			await matrix.favouriteRoom(roomId.value, next)
			pinned.value = next
		} catch (e) {
			uni.showToast({ title: errText(e, t('group.setFail')), icon: 'none' })
		}
	}

	async function leaveNow(): Promise<void> {
		const matrix = getMatrix()
		if (matrix == null) return
		uni.showLoading({ title: t('group.processing') })
		try {
			await matrix.leaveRoom(roomId.value)
			uni.hideLoading()
			uni.showToast({ title: t('group.left'), icon: 'success' })
			setTimeout((): void => {
				uni.reLaunch({ url: '/pages/rooms/rooms' })
			}, 400)
		} catch (e) {
			uni.hideLoading()
			uni.showToast({ title: errText(e, t('rooms.opFail')), icon: 'none' })
		}
	}

	function onLeave(): void {
		const title = isGroup.value ? t('group.leave') : t('group.deleteChat')
		const content = isGroup.value ? t('group.leaveConfirm') : t('group.deleteChatConfirm')
		uni.showModal({
			title: title,
			content: content,
			success: (res) => {
				if (res.confirm) leaveNow()
			}
		})
	}

	function optStr(obj: UTSJSONObject, key: string): string {
		try {
			const v = obj[key]
			if (v != null) {
				const s = '' + v
				if (s.length > 0 && s != 'null' && s != 'undefined') return s
			}
		} catch (e) {}
		return ''
	}

	onLoad((options: UTSJSONObject) => {
		const rid = optStr(options, 'roomId')
		if (rid.length > 0) {
			try {
				const decoded = decodeURIComponent(rid)
				roomId.value = decoded != null && decoded.length > 0 ? decoded : rid
			} catch (e) {
				roomId.value = rid
			}
		}
	})

	onShow(() => {
		if (roomId.value.length == 0) return
		const force = membersNeedRefresh
		membersNeedRefresh = false
		loadInfo(force)
	})
</script>

<style>
	.group-page {
		flex: 1;
		background-color: #ededed;
		flex-direction: column;
	}
	.topbar {
		flex-direction: row;
		align-items: center;
		padding: 24rpx 16rpx 16rpx 12rpx;
		background-color: #ededed;
	}
	.back-btn {
		width: 72rpx;
		height: 72rpx;
		align-items: center;
		justify-content: center;
	}
	.back-icon {
		width: 36rpx;
		height: 36rpx;
	}
	.topbar-title {
		flex: 1;
		text-align: center;
		font-size: 34rpx;
		font-weight: 700;
		color: #1a1a1a;
	}
	.topbar-right {
		width: 72rpx;
	}
	.group-scroll {
		flex: 1;
		height: 0;
	}
	.card {
		background-color: #ffffff;
		margin-top: 16rpx;
	}
	.member-grid {
		flex-direction: row;
		flex-wrap: wrap;
		padding: 24rpx 12rpx 8rpx 12rpx;
	}
	.member-cell {
		width: 20%;
		align-items: center;
		margin-bottom: 24rpx;
	}
	.member-avatar-box {
		width: 96rpx;
		height: 96rpx;
		position: relative;
	}
	.member-avatar {
		width: 96rpx;
		height: 96rpx;
		border-radius: 12rpx;
		background-color: #e0e0e6;
	}
	.member-add {
		width: 96rpx;
		height: 96rpx;
		border-radius: 12rpx;
		border-width: 2rpx;
		border-color: #d8d8d8;
		border-style: dashed;
		align-items: center;
		justify-content: center;
	}
	.member-add-text {
		font-size: 56rpx;
		color: #b2b2b2;
	}
	.member-name {
		font-size: 22rpx;
		color: #1a1a1a;
		margin-top: 8rpx;
		lines: 1;
		text-overflow: ellipsis;
		text-align: center;
		width: 120rpx;
	}
	.more-members {
		flex-direction: row;
		align-items: center;
		justify-content: center;
		padding: 8rpx 24rpx 24rpx 24rpx;
	}
	.more-members-text {
		font-size: 26rpx;
		color: #888888;
	}
	.cell {
		flex-direction: row;
		align-items: center;
		padding: 28rpx 32rpx;
		border-bottom-width: 1rpx;
		border-bottom-color: #f2f2f5;
	}
	.cell-label {
		font-size: 32rpx;
		color: #1a1a1a;
		flex: 1;
	}
	.cell-value {
		font-size: 28rpx;
		color: #888888;
		max-width: 360rpx;
		lines: 1;
		text-overflow: ellipsis;
		text-align: right;
		margin-right: 8rpx;
	}
	.cell-arrow {
		font-size: 36rpx;
		color: #c8c8c8;
	}
	.wx-switch {
		width: 102rpx;
		height: 62rpx;
		border-radius: 31rpx;
		background-color: #e5e5e5;
		padding: 4rpx;
		flex-direction: row;
		align-items: center;
	}
	.wx-switch-on {
		background-color: #07c160;
		justify-content: flex-end;
	}
	.wx-switch-dot {
		width: 54rpx;
		height: 54rpx;
		border-radius: 27rpx;
		background-color: #ffffff;
	}
	.leave-wrap {
		padding: 24rpx 0 80rpx 0;
	}
	.leave-btn {
		background-color: #ffffff;
		align-items: center;
		padding: 28rpx 0;
	}
	.leave-text {
		font-size: 32rpx;
		color: #fa5151;
	}
</style>
