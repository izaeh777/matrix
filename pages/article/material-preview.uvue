		padding: 0 16rpx;
	}
	.title-row {
		flex-direction: row;
		align-items: center;
	}
	.kind-tag {
		font-size: 20rpx;
		font-weight: 700;
		padding: 4rpx 12rpx;
		border-radius: 8rpx;
		margin-right: 12rpx;
	}
	.tag-pdf {
		background-color: #fff1f0;
		color: #f5222d;
		border-width: 1rpx;
		border-style: solid;
		border-color: #ffa39e;
	}
	.tag-ppt,
	.tag-pptx {
		background-color: #fff7e6;
		color: #fa8c16;
		border-width: 1rpx;
		border-style: solid;
		border-color: #ffd591;
	}
	.topbar-title {
		flex: 1;
		font-size: 30rpx;
		font-weight: 700;
		color: #1a1a1a;
		lines: 1;
		text-overflow: ellipsis;
	}
	.topbar-actions {
		flex-direction: row;
		align-items: center;
		justify-content: flex-end;
	}
	.action-btn {
		padding: 10rpx 22rpx;
		border-radius: 28rpx;
		align-items: center;
		justify-content: center;
		margin-left: 12rpx;
	}
	.action-btn-primary {
		background-color: #1861c8;
	}
	.action-btn-primary-text {
		font-size: 24rpx;
		color: #ffffff;
		font-weight: 600;
	}
	.action-btn-out {
		background-color: #eef4ff;
		border-width: 1rpx;
		border-style: solid;
		border-color: #c7d7f5;
	}
	.action-btn-out-text {
		font-size: 24rpx;
		color: #1861c8;
		font-weight: 600;
	}
	.preview-body {
		flex: 1;
		width: 100%;
		height: 100%;
		background-color: #f7f9fc;
		position: relative;
	}
	.preview-web {
		width: 100%;
		height: 100%;
		flex: 1;
	}
	.empty-state {
		flex: 1;
		align-items: center;
		justify-content: center;
		padding: 100rpx 40rpx;
	}
	.empty-text {
		font-size: 28rpx;
		color: #9aa3af;
		text-align: center;
		margin-bottom: 24rpx;
	}
	.retry-btn {
		padding: 12rpx 36rpx;
		background-color: #1861c8;
		border-radius: 32rpx;
	}
	.retry-btn-text {
		font-size: 26rpx;
		color: #ffffff;
	}
</style>
