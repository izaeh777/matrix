<template>
	<view class="detail-page">
		<!-- #ifdef APP -->
		<view class="status-bar-holder"></view>
		<!-- #endif -->
		<view class="topbar">
			<view class="back-btn" @click="goBack">
				<text class="back-text">‹</text>
			</view>
			<text class="topbar-title">{{ pageTitle }}</text>
			<view class="topbar-actions">
				<view v-if="showChatBtn" class="chat-btn" @click="onChatOwner">
					<text class="chat-btn-text">{{ t('article.chatOwner') }}</text>
				</view>
				<view
					v-if="showFollowBtn"
					class="follow-btn"
					:class="followed ? 'follow-btn-on' : ''"
					@click="onToggleFollow"
				>
					<text class="follow-btn-text" :class="followed ? 'follow-btn-text-on' : ''">{{ followBtnText }}</text>
				</view>
				<view v-if="!showChatBtn && !showFollowBtn" class="topbar-right"></view>
			</view>
		</view>

		<scroll-view class="body" direction="vertical" :show-scrollbar="false" :rebound="false">
			<view v-if="loading" class="state">
				<text class="state-text">{{ t('article.loading') }}</text>
			</view>
			<view v-else-if="errorText.length > 0" class="state">
				<text class="state-text">{{ errorText }}</text>
				<view class="retry" @click="loadDetail">
					<text class="retry-text">{{ t('article.retry') }}</text>
				</view>
			</view>
			<view v-else-if="hasDetail" class="article">
				<text class="title">{{ titleText }}</text>
				<view class="meta-row">
					<text v-if="channelText.length > 0" class="meta-chip">{{ channelText }}</text>
					<text v-if="authorText.length > 0" class="meta-text">{{ authorText }}</text>
					<text class="meta-text">{{ timeText }}</text>
				</view>
				<view class="stat-row">
					<text class="stat">{{ t('article.views') }} {{ viewsText }}</text>
					<text class="stat">{{ t('article.likes') }} {{ likesText }}</text>
					<text class="stat">{{ t('article.comments') }} {{ commentsText }}</text>
				</view>
				<image
					v-if="cover.length > 0"
					class="cover"
					:src="cover"
					mode="aspectFill"
				></image>
				<view v-if="tagList.length > 0" class="tags">
					<text v-for="tag in tagList" :key="tag" class="tag">{{ tag }}</text>
				</view>
				<video
					v-for="(vsrc, vidx) in videoList"
					:key="'vid-' + vidx"
					class="content-video"
					:src="vsrc"
					controls
					object-fit="contain"
					:show-center-play-btn="true"
				></video>
				<view v-if="fileList.length > 0" class="file-list">
					<view
						v-for="(furl, fidx) in fileList"
						:key="'file-' + fidx"
						class="file-row"
						@click="openFileUrl(furl)"
					>
						<text class="file-label">{{ fileLabelOf(furl) }}</text>
						<text class="file-arrow">›</text>
					</view>
				</view>
				<rich-text v-if="contentHtml.length > 0" class="content-html" :nodes="contentHtml"></rich-text>
				<text v-else-if="contentPlain.length > 0" class="content">{{ contentPlain }}</text>
				<view v-if="outlinkText.length > 0" class="outlink" @click="openOutlink">
					<text class="outlink-text">{{ t('article.origin') }}</text>
				</view>

				<view class="nav-block">
					<view
						v-if="prevId > 0"
						class="nav-item"
						@click="openSibling(prevId)"
					>
						<text class="nav-label">{{ t('article.prev') }}</text>
						<text class="nav-title">{{ prevTitle }}</text>
					</view>
					<view
						v-if="nextId > 0"
						class="nav-item"
						@click="openSibling(nextId)"
					>
						<text class="nav-label">{{ t('article.next') }}</text>
						<text class="nav-title">{{ nextTitle }}</text>
					</view>
				</view>
			</view>
			<view class="scroll-pad"></view>
		</scroll-view>
	</view>
</template>

<script setup lang="uts">
	import { ref, computed } from 'vue'
	import { t as __i18nT } from '@/common/i18n.uts'
	import {
		fetchArchiveDetail,
		fetchProjectDetail,
		fetchMyArchives,
		cmsAssetUrl,
		cmsHttpBase,
		formatPublishAgo,
		openCmsLink,
		parseContentMedia,
		CmsArchiveDetail
	} from '@/common/cms.uts'
	import {
		loadPlatformSession,
		followRelation,
		unfollowRelation,
		fetchFollowing
	} from '@/common/platform.uts'
	import { ensureMatrixClient, openChat } from '@/common/app.uts'

	function t(key: string): string {
		return __i18nT(key)
	}

	const loading = ref<boolean>(true)
	const errorText = ref<string>('')
	const detail = ref<CmsArchiveDetail | null>(null)
	const articleId = ref<number>(0)
	/** archive | project：我的发布走项目详情接口 */
	const detailType = ref<string>('archive')
	const followed = ref<boolean>(false)
	const followBusy = ref<boolean>(false)
	/** 是否当前登录用户自己发布的项目 */
	const isOwnProject = ref<boolean>(false)

	const followBtnText = computed((): string => {
		return followed.value ? t('follow.following') : t('follow.doFollow')
	})

	const pageTitle = computed((): string => {
		return detailType.value == 'project' ? t('article.projectTitle') : t('article.title')
	})

	const hasDetail = computed((): boolean => {
		return detail.value != null
	})
	/** 自己发布的项目（无论从哪打开）不显示关注 */
	const showFollowBtn = computed((): boolean => {
		return hasDetail.value && detailType.value == 'project' && !isOwnProject.value
	})

	const ownerImUser = computed((): string => {
		const d = detail.value
		if (d == null) return ''
		return d.owner_im_user.trim()
	})

	/** 有 owner.imUser 才显示去聊天 */
	const showChatBtn = computed((): boolean => {
		return detailType.value == 'project' && ownerImUser.value.length > 0
	})

	function ownerMatchesMe(ownerId: string): boolean {
		const s = loadPlatformSession()
		if (s == null) return false
		const me = s.user_id.trim()
		if (me.length == 0) return false
		const oid = ownerId.trim()
		if (oid.length == 0) return false
		return me == oid
	}

	async function resolveIsOwn(projectId: number, ownerId: string): Promise<boolean> {
		if (ownerMatchesMe(ownerId)) return true
		if (loadPlatformSession() == null) return false
		// 详情未带回作者时，用「我的发布」列表兜底
		try {
			const mine = await fetchMyArchives()
			for (let i = 0; i < mine.length; i++) {
				if (mine[i].id == projectId) return true
			}
		} catch (e) {
			console.warn('判断是否自己的项目失败', e)
		}
		return false
	}
	const titleText = computed((): string => {
		const d = detail.value
		return d != null ? d.title : ''
	})
	const channelText = computed((): string => {
		const d = detail.value
		return d != null ? d.channel_name : ''
	})
	const authorText = computed((): string => {
		const d = detail.value
		return d != null ? d.author : ''
	})
	const viewsText = computed((): string => {
		const d = detail.value
		return d != null ? ('' + d.views) : '0'
	})
	const likesText = computed((): string => {
		const d = detail.value
		return d != null ? ('' + d.likes) : '0'
	})
	const commentsText = computed((): string => {
		const d = detail.value
		return d != null ? ('' + d.comments) : '0'
	})
	function looksLikeHtml(s: string): boolean {
		const t = s.trim()
		return t.indexOf('<') >= 0 && t.indexOf('>') > t.indexOf('<')
	}

	const videoList = computed((): Array<string> => {
		const d = detail.value
		if (d == null) return [] as Array<string>
		return parseContentMedia(d.content, d.video_url, d.material_url).videos
	})

	const fileList = computed((): Array<string> => {
		const d = detail.value
		if (d == null) return [] as Array<string>
		return parseContentMedia(d.content, d.video_url, d.material_url).files
	})

	const contentHtml = computed((): string => {
		const d = detail.value
		if (d == null) return ''
		const html = parseContentMedia(d.content, d.video_url, d.material_url).html.trim()
		if (html.length == 0) return ''
		if (!looksLikeHtml(html)) return ''
		return html
	})

	const contentPlain = computed((): string => {
		const d = detail.value
		if (d == null) return ''
		if (looksLikeHtml(d.content)) return ''
		return d.content
	})

	const outlinkText = computed((): string => {
		const d = detail.value
		return d != null ? d.outlink : ''
	})

	function fileLabelOf(url: string): string {
		const lower = url.toLowerCase()
		if (lower.indexOf('.ppt') >= 0) return t('article.filePpt')
		if (lower.indexOf('.pdf') >= 0) return t('article.filePdf')
		if (lower.indexOf('.doc') >= 0) return t('article.fileDoc')
		if (lower.indexOf('.xls') >= 0) return t('article.fileXls')
		if (lower.indexOf('.zip') >= 0 || lower.indexOf('.rar') >= 0) return t('article.fileZip')
		return t('article.fileOther')
	}

	function openFileUrl(url: string): void {
		if (url.length == 0) return
		openCmsLink(url)
	}
	const tagList = computed((): Array<string> => {
		const d = detail.value
		return d != null ? d.tags : ([] as Array<string>)
	})
	const prevId = computed((): number => {
		const d = detail.value
		return d != null ? d.prev_id : 0
	})
	const prevTitle = computed((): string => {
		const d = detail.value
		return d != null ? d.prev_title : ''
	})
	const nextId = computed((): number => {
		const d = detail.value
		return d != null ? d.next_id : 0
	})
	const nextTitle = computed((): string => {
		const d = detail.value
		return d != null ? d.next_title : ''
	})
	const cover = computed((): string => {
		const d = detail.value
		if (d == null) return ''
		const img = d.image
		if (img.length == 0) return ''
		if (img.indexOf('blob:') == 0) return ''
		if (img.indexOf('/assets/') == 0) return cmsHttpBase() + img
		return cmsAssetUrl(img)
	})
	const timeText = computed((): string => {
		const d = detail.value
		if (d == null) return ''
		return formatPublishAgo(d.publishtime)
	})

	function goBack(): void {
		uni.navigateBack({})
	}

	function openOutlink(): void {
		const d = detail.value
		if (d == null) return
		openCmsLink(d.outlink)
	}

	async function refreshFollowState(projectId: number): Promise<void> {
		followed.value = false
		if (projectId <= 0) return
		if (loadPlatformSession() == null) return
		try {
			const list = await fetchFollowing('project')
			const idStr = '' + projectId
			for (let i = 0; i < list.length; i++) {
				if (list[i].target_id == idStr || list[i].target_id == ('' + projectId)) {
					followed.value = true
					return
				}
			}
		} catch (e) {
			console.warn('刷新关注状态失败', e)
		}
	}

	async function onChatOwner(): Promise<void> {
		const im = ownerImUser.value
		if (im.length == 0) return
		const matrix = ensureMatrixClient()
		if (matrix == null) return
		if (im == matrix.userId) {
			uni.showToast({ title: t('contact.selfChat'), icon: 'none' })
			return
		}
		uni.showLoading({ title: t('contact.opening'), mask: true })
		try {
			const roomId = await matrix.startDM(im)
			uni.hideLoading()
			openChat(roomId)
		} catch (e) {
			uni.hideLoading()
			let msg = ''
			try { msg = ('' + e).trim() } catch (e0) { msg = '' }
			if (msg.indexOf('Error:') == 0) msg = msg.substring(6).trim()
			uni.showToast({
				title: msg.length > 0 ? msg : t('contact.startFail'),
				icon: 'none'
			})
		}
	}

	async function onToggleFollow(): Promise<void> {
		const id = articleId.value
		if (id <= 0 || followBusy.value) return
		if (loadPlatformSession() == null) {
			uni.showToast({ title: t('profile.loginFirst'), icon: 'none' })
			return
		}
		followBusy.value = true
		const idStr = '' + id
		try {
			if (followed.value) {
				await unfollowRelation('project', idStr)
				followed.value = false
				uni.showToast({ title: t('follow.unfollowed'), icon: 'none' })
			} else {
				await followRelation('project', idStr)
				followed.value = true
				uni.showToast({ title: t('follow.followOk'), icon: 'none' })
			}
		} catch (e) {
			let msg = ''
			try { msg = ('' + e).trim() } catch (e0) { msg = '' }
			if (msg.indexOf('Error:') == 0) msg = msg.substring(6).trim()
			const fallback = followed.value ? t('follow.unfollowFail') : t('follow.followFail')
			uni.showToast({ title: msg.length > 0 ? msg : fallback, icon: 'none' })
		}
		followBusy.value = false
	}

	async function loadDetail(): Promise<void> {
		const id = articleId.value
		if (id <= 0) {
			errorText.value = t('article.noId')
			loading.value = false
			return
		}
		loading.value = true
		errorText.value = ''
		followed.value = false
		isOwnProject.value = false
		try {
			let d: CmsArchiveDetail
			if (detailType.value == 'project') {
				d = await fetchProjectDetail(id)
			} else {
				d = await fetchArchiveDetail(id)
			}
			detail.value = d
			isOwnProject.value = await resolveIsOwn(id, d.owner_id)
			if (!isOwnProject.value) {
				refreshFollowState(id)
			}
		} catch (e) {
			detail.value = null
			let msg = ''
			try { msg = ('' + e).trim() } catch (e0) { msg = '' }
			if (msg.indexOf('Error:') == 0) msg = msg.substring(6).trim()
			errorText.value = msg.length > 0 ? msg : t('article.loadFail')
			console.warn('加载详情失败', e)
		}
		loading.value = false
	}

	function openSibling(id: number): void {
		if (id <= 0) return
		articleId.value = id
		loadDetail()
	}

	onLoad((options: UTSJSONObject) => {
		try {
			const raw = options['id']
			if (raw != null) {
				const n = parseInt('' + raw)
				if (n == n && n > 0) articleId.value = n
			}
		} catch (e0) {}
		try {
			const typ = options['type']
			if (typ != null && ('' + typ).trim() == 'project') {
				detailType.value = 'project'
			}
		} catch (e1) {}
		loadDetail()
	})
</script>

<style>
	.detail-page {
		flex: 1;
		background-color: #ffffff;
		flex-direction: column;
	}
	/* #ifdef H5 */
	.detail-page ::-webkit-scrollbar {
		width: 0;
		height: 0;
		display: none;
	}
	.body {
		scrollbar-width: none;
		-ms-overflow-style: none;
	}
	/* #endif */
	.topbar {
		flex-direction: row;
		align-items: center;
		justify-content: space-between;
		padding: 48rpx 20rpx 16rpx;
		background-color: #ffffff;
		border-bottom-width: 1rpx;
		border-bottom-color: #f0f2f5;
	}
	.back-btn {
		width: 72rpx;
		height: 72rpx;
		align-items: center;
		justify-content: center;
	}
	.back-text {
		font-size: 56rpx;
		color: #181818;
		line-height: 56rpx;
	}
	.topbar-title {
		font-size: 32rpx;
		font-weight: 700;
		color: #1a1a1a;
	}
	.topbar-actions {
		flex-direction: row;
		align-items: center;
		justify-content: flex-end;
		min-width: 72rpx;
	}
	.topbar-right {
		width: 72rpx;
	}
	.chat-btn {
		padding: 10rpx 22rpx;
		margin-right: 12rpx;
		border-radius: 28rpx;
		background-color: #eef4ff;
		border-width: 1rpx;
		border-style: solid;
		border-color: #c7d7f5;
		align-items: center;
		justify-content: center;
	}
	.chat-btn-text {
		font-size: 24rpx;
		color: #1861c8;
		font-weight: 600;
	}
	.follow-btn {
		min-width: 120rpx;
		padding: 10rpx 22rpx;
		border-radius: 28rpx;
		background-color: #1861c8;
		align-items: center;
		justify-content: center;
	}
	.follow-btn-on {
		background-color: #eef2f7;
	}
	.follow-btn-text {
		font-size: 24rpx;
		color: #ffffff;
		font-weight: 600;
	}
	.follow-btn-text-on {
		color: #6b7280;
	}
	.body {
		flex: 1;
		height: 0;
		background-color: #ffffff;
	}
	.state {
		padding: 120rpx 40rpx;
		align-items: center;
	}
	.state-text {
		font-size: 28rpx;
		color: #9aa3af;
		text-align: center;
	}
	.retry {
		margin-top: 24rpx;
		padding: 14rpx 36rpx;
		background-color: #2f6ff2;
		border-radius: 32rpx;
	}
	.retry-text {
		font-size: 26rpx;
		color: #ffffff;
	}
	.article {
		padding: 28rpx 32rpx 40rpx;
		flex-direction: column;
	}
	.title {
		font-size: 40rpx;
		font-weight: 800;
		color: #111111;
		line-height: 56rpx;
		margin-bottom: 20rpx;
	}
	.meta-row {
		flex-direction: row;
		flex-wrap: wrap;
		align-items: center;
		margin-bottom: 12rpx;
	}
	.meta-chip {
		font-size: 22rpx;
		color: #2f6ff2;
		background-color: #eef4ff;
		padding: 4rpx 14rpx;
		border-radius: 20rpx;
		margin-right: 12rpx;
		margin-bottom: 8rpx;
	}
	.meta-text {
		font-size: 22rpx;
		color: #9aa3af;
		margin-right: 16rpx;
		margin-bottom: 8rpx;
	}
	.stat-row {
		flex-direction: row;
		margin-bottom: 24rpx;
	}
	.stat {
		font-size: 22rpx;
		color: #9aa3af;
		margin-right: 24rpx;
	}
	.cover {
		width: 100%;
		height: 360rpx;
		border-radius: 20rpx;
		background-color: #e8eef8;
		margin-bottom: 24rpx;
	}
	.tags {
		flex-direction: row;
		flex-wrap: wrap;
		margin-bottom: 24rpx;
	}
	.tag {
		font-size: 22rpx;
		color: #2f6ff2;
		background-color: #f3f6fb;
		padding: 6rpx 16rpx;
		border-radius: 20rpx;
		margin-right: 12rpx;
		margin-bottom: 10rpx;
	}
	.content {
		font-size: 30rpx;
		color: #333333;
		line-height: 48rpx;
	}
	.content-html {
		width: 100%;
		font-size: 30rpx;
		color: #333333;
		line-height: 48rpx;
		margin-top: 8rpx;
	}
	.content-video {
		width: 100%;
		height: 400rpx;
		border-radius: 16rpx;
		background-color: #111111;
		margin-bottom: 20rpx;
	}
	.file-list {
		flex-direction: column;
		margin-bottom: 20rpx;
	}
	.file-row {
		flex-direction: row;
		align-items: center;
		justify-content: space-between;
		padding: 22rpx 24rpx;
		margin-bottom: 12rpx;
		border-radius: 16rpx;
		background-color: #f3f6fb;
	}
	.file-label {
		flex: 1;
		font-size: 28rpx;
		color: #1861c8;
		font-weight: 600;
	}
	.file-arrow {
		font-size: 32rpx;
		color: #9aa3af;
		margin-left: 12rpx;
	}
	.outlink {
		margin-top: 32rpx;
		padding: 22rpx 0;
		align-items: center;
		border-top-width: 1rpx;
		border-top-color: #f0f2f5;
	}
	.outlink-text {
		font-size: 28rpx;
		color: #2f6ff2;
		font-weight: 600;
	}
	.nav-block {
		margin-top: 40rpx;
		border-top-width: 1rpx;
		border-top-color: #f0f2f5;
		padding-top: 16rpx;
	}
	.nav-item {
		padding: 20rpx 0;
		border-bottom-width: 1rpx;
		border-bottom-color: #f5f6f8;
	}
	.nav-label {
		font-size: 22rpx;
		color: #9aa3af;
		margin-bottom: 8rpx;
	}
	.nav-title {
		font-size: 28rpx;
		color: #1a1a1a;
		lines: 2;
		text-overflow: ellipsis;
	}
	.scroll-pad {
		height: 40rpx;
	}
</style>
