<script setup lang="uts">
	import { bootstrapMatrix } from '@/common/app.uts'
	import { getMatrix } from '@/common/matrix.uts'
	import { bindCallToMatrix } from '@/common/call.uts'
	import { captureTpCallbackFromIntent, readAndroidLaunchUri } from '@/common/tp-wallet.uts'
	import { handleLaunchDeepLink } from '@/common/deeplink.uts'

	// #ifdef APP-ANDROID || APP-HARMONY
	let firstBackTime = 0
	// #endif

	function maybeTpSchema(): void {
		// #ifdef APP
		try { captureTpCallbackFromIntent() } catch (e) {}
		// #endif
	}

	function maybeAppDeepLink(): void {
		// #ifdef APP
		try {
			const uri = readAndroidLaunchUri()
			if (uri.length > 0) {
				handleLaunchDeepLink(uri)
			}
		} catch (e) {}
		// #endif
	}

	onLaunch(() => {
		console.log('App Launch')
		const matrix = bootstrapMatrix()
		bindCallToMatrix()
		if (matrix != null) {
			matrix.startSync()
		}
		maybeTpSchema()
		maybeAppDeepLink()
	})

	onAppShow(() => {
		console.log('App Show')
		bindCallToMatrix()
		const m = getMatrix()
		if (m != null) m.startSync()
		maybeTpSchema()
		maybeAppDeepLink()
	})

	onAppHide(() => {
		console.log('App Hide')
	})

	// #ifdef APP-ANDROID || APP-HARMONY
	onLastPageBackPress(() => {
		console.log('App LastPageBackPress')
		if (firstBackTime == 0) {
			uni.showToast({
				title: '再按一次退出应用',
				position: 'bottom',
			})
			firstBackTime = Date.now()
			setTimeout(() => {
				firstBackTime = 0
			}, 2000)
		} else if (Date.now() - firstBackTime < 2000) {
			firstBackTime = Date.now()
			uni.exit()
		}
	})
	// #endif

	onExit(() => {
		console.log('App Exit')
		const m = getMatrix()
		if (m != null) m.stopSync()
	})
</script>

<style>
	/* 每个页面公共 css */
	.uni-row {
		flex-direction: row;
	}

	.uni-column {
		flex-direction: column;
	}

	/* App 自定义导航：避开状态栏，并整体略下移 */
	/* #ifdef APP */
	.status-bar-holder {
		width: 100%;
		height: var(--status-bar-height);
		margin-bottom: 4px;
	}
	/* #endif */
</style>
